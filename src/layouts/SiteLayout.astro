---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-600.css';
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import PageSkeleton from '../components/site/PageSkeleton.astro';
import { getSessionUser } from '../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../lib/db.ts';
import { resolvePublicOrigin, trustedCanonical } from '../lib/public-origin.ts';
import { getSiteConfig } from '../lib/site-config.ts';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  workspace?: boolean;
}

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);
const siteConfig = await getSiteConfig(db, env);

const {
  title,
  description = siteConfig.defaultDescription || 'Browse proposals, join discussions, vote when eligible, and explore the policy registry from Fusion Party Australia.',
  canonical,
  image,
  imageAlt,
  ogType = 'website',
  noIndex = false,
  workspace = false,
} = Astro.props;

const privateHost =
  import.meta.env.DEV ||
  env.APP_MODE !== 'production' ||
  Astro.url.hostname === 'localhost' ||
  Astro.url.hostname === '127.0.0.1';
const preventIndexing = noIndex || privateHost || !siteConfig.allowPublicIndexing;
const path = Astro.url.pathname;

const originInput = {
  env,
  requestUrl: Astro.url,
  development: import.meta.env.DEV,
};
const publicOrigin = resolvePublicOrigin(originInput);
const canonicalHref = canonical
  ? trustedCanonical(canonical, originInput)
  : trustedCanonical(path, originInput);

const resolveSocialImage = (candidate?: string): string => {
  const chosen = (candidate || siteConfig.defaultOgImage || '/engage-og-card.png').trim();
  if (/^https?:\/\//i.test(chosen)) return chosen;
  return new URL(chosen.startsWith('/') ? chosen : `/${chosen}`, `${publicOrigin}/`).href;
};

const ogImageHref = resolveSocialImage(image);
const ogImageAltText = imageAlt || `${siteConfig.siteName} · ${siteConfig.organizationName}`;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#32105a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}

    <!-- OpenGraph / Facebook / Discord Link Unfurling -->
    <meta property="og:site_name" content={`${siteConfig.siteName} · ${siteConfig.organizationName}`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter / X Large Summary Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />
    <meta name="twitter:image:alt" content={ogImageAltText} />

    <link rel="icon" href="/fusion_horizon_logo_light.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'admin-body': workspace }} data-analytics-signed-in={user ? 'yes' : 'no'}>
    <svg class="icon-definitions" aria-hidden="true" focusable="false">
      <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></symbol>
      <symbol id="icon-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></symbol>
      <symbol id="icon-plus" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></symbol>
      <symbol id="icon-files" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v14M18 6H9a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Z" /><path d="M11 11h5M11 15h5" /></symbol>
      <symbol id="icon-book" viewBox="0 0 24 24"><path d="M12 7v14M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13h-5a4 4 0 0 0-4 4 4 4 0 0 0-4-4z" /></symbol>
      <symbol id="icon-vote" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /><path d="m2 12 1 1 2-2" /></symbol>
      <symbol id="icon-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4m0-4h.01" /></symbol>
      <symbol id="icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></symbol>
      <symbol id="icon-gauge" viewBox="0 0 24 24"><path d="M20.9 13a9 9 0 1 1-17.8 0M12 13l4-4M7 17h.01M12 19h.01M17 17h.01" /></symbol>
    </svg>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader user={user} path={path} siteConfig={siteConfig} />

    <PageSkeleton />

    <main id="main-content">
      <slot />
    </main>

    {!workspace && <SiteFooter user={user} siteConfig={siteConfig} />}
  </body>
  <script is:inline>
    if ('serviceWorker' in navigator && window.isSecureContext) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
      });
    }
  </script>
</html>
<script>
  import '../scripts/local-time.ts';
  import '../scripts/plausible.ts';
  document.querySelectorAll<HTMLButtonElement>('[data-signout]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        await fetch('/api/session', { method: 'DELETE', credentials: 'same-origin' });
        location.href = '/';
      } catch {
        btn.disabled = false;
      }
    });
  });

  // Same-origin hover/focus link prefetching for near-instant page navigation
  const prefetched = new Set<string>();
  const shouldPrefetch = (anchor: HTMLAnchorElement | null): anchor is HTMLAnchorElement => {
    if (!anchor || !anchor.href) return false;
    if (anchor.target && anchor.target !== '_self') return false;
    if (anchor.hasAttribute('download')) return false;
    let url: URL;
    try {
      url = new URL(anchor.href, location.origin);
    } catch {
      return false;
    }
    if (url.origin !== location.origin) return false;
    if (url.pathname === location.pathname && url.search === location.search) return false;
    if (url.pathname.startsWith('/api/')) return false;
    return !prefetched.has(url.href);
  };
  const prefetchLink = (anchor: HTMLAnchorElement | null) => {
    if (!shouldPrefetch(anchor)) return;
    prefetched.add(anchor.href);
    const link = document.createElement('link');
    link.rel = 'prefetch';
    link.href = anchor.href;
    link.as = 'document';
    document.head.appendChild(link);
  };
  document.addEventListener('mouseover', (e) => {
    const a = (e.target as Element | null)?.closest?.('a') as HTMLAnchorElement | null;
    if (a) prefetchLink(a);
  }, { passive: true });
  document.addEventListener('focusin', (e) => {
    const a = (e.target as Element | null)?.closest?.('a') as HTMLAnchorElement | null;
    if (a) prefetchLink(a);
  }, { passive: true });
</script>

