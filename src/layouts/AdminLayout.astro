---
import SiteLayout from './SiteLayout.astro';
import '../styles/admin.css';

interface Props {
  title: string;
  description: string;
  section?: 'policies' | 'members';
  isAdmin?: boolean;
}

const { title, description, section = 'policies', isAdmin = false } = Astro.props;
---
<SiteLayout title={`${title} · Engage Admin`} description={description} noIndex workspace>
  <div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Administration navigation">
      <nav class="admin-nav">
        <a href="/admin/" aria-current={section === 'policies' ? 'page' : undefined}>
          Policies &amp; Votes
        </a>
        {isAdmin && (
          <a href="/admin/members/" aria-current={section === 'members' ? 'page' : undefined}>
            Members &amp; Access
          </a>
        )}
      </nav>
      <p class="admin-sidebar-note">
        Manage policy proposals, open or close member voting, and verify party membership in one place.
      </p>
    </aside>

    <div class="admin-content">
      <header class="admin-intro">
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <slot />
    </div>
  </div>
</SiteLayout>
