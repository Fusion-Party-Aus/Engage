---
import { ballotExpired } from '../lib/ballot-deadline.ts';
import ProposalHighlights from '../components/ProposalHighlights.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import CommunityImage from '../components/site/CommunityImage.astro';
import { Card, CardContent } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Badge } from '../components/ui/badge';
import { Alert, AlertDescription, AlertTitle } from '../components/ui/alert';
import {
  ArrowRight,
  BookOpen,
  CheckCircle2,
  Compass,
  Gavel,
  Layers,
  MessageSquare,
  Plus,
  Vote,
} from 'lucide-react';
import { getSessionUser } from '../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../lib/db.ts';
import { loadBallotCryptoConfig } from '../lib/ballot-crypto.ts';
import { listOutstandingDecisions } from '../lib/voting-store.ts';
import { listProposals } from '../lib/proposals-store.ts';
import { attachPublicTallies, publicTallyLabel } from '../lib/public-proposals.ts';
import { findMemberVotes, proposalBallotId } from '../lib/vote-storage.ts';
import { getSiteConfig } from '../lib/site-config.ts';
import type { ProposalStage } from '../lib/types.ts';

export const prerender = false;
const authError = Astro.url.searchParams.get('error');
if (authError) return Astro.redirect(`/member/?error=${encodeURIComponent(authError)}`);

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([getDatabase(env), getSessionUser(Astro.request, env)]);
const siteConfig = await getSiteConfig(db, env);
const [proposalSummaries, publishedPolicyCount] = await Promise.all([
  listProposals(db, { includeArchived: false, user, includeDetails: false, includeVoteTallies: false }),
  db.collection('policy_registry').countDocuments({ publicationStatus: 'published' }),
]);
// Vote totals come from the display-only projection or the certified result.
// This page never scans `proposal_votes`.
const proposals = await attachPublicTallies(db, proposalSummaries);
const highlightProposals = proposals.filter((proposal) => proposal.tallyState !== 'pending');
const votes = proposals.filter((p) => p.stage === 'decide' && !ballotExpired(p));
const myVoteRows = user?.canParticipate
  ? await findMemberVotes(
      db,
      user.memberId,
      votes.map((p) => proposalBallotId(p.proposalId)),
      loadBallotCryptoConfig(env),
    )
  : [];
const mine = user?.canParticipate
  ? await listOutstandingDecisions(db, user.memberId, user, proposals, myVoteRows)
  : [];
const openProposalIds = new Set(votes.map((p) => p.proposalId));
const completedOpenVotesCount = new Set(
  myVoteRows.map((v: any) => String(v.proposalId ?? '')).filter((id) => openProposalIds.has(id)),
).size;
const totalEligibleOpenVotesCount = completedOpenVotesCount + mine.length;
const homeProgressPct =
  totalEligibleOpenVotesCount > 0
    ? Math.round((completedOpenVotesCount / totalEligibleOpenVotesCount) * 100)
    : 0;
const discussions = proposals.filter((p) => p.stage === 'deliberate');
const ideas = proposals.filter((p) => p.stage === 'propose');
const implementing = proposals.filter((p) => p.stage === 'implement');
const branch = user?.activeBranchIds?.length
  ? proposals.filter((p) => user.activeBranchIds?.includes(p.originatingBranchId ?? ''))
  : [];
const registryAvailable = publishedPolicyCount > 0;
const primaryCtaLabel = siteConfig.primaryCtaLabel || 'Suggest an idea';
const primaryCtaHref = siteConfig.primaryCtaHref || '/proposals/new/';

const featuredProposals = [...proposals]
  .sort((a, b) => {
    const priority: Record<ProposalStage, number> = {
      decide: 0,
      deliberate: 1,
      propose: 2,
      implement: 3,
      archived: 4,
    };
    return priority[a.stage] - priority[b.stage] || b.votes.total - a.votes.total;
  })
  .slice(0, 6);

const stageLabel = (s: ProposalStage) => {
  if (s === 'propose') return 'Propose';
  if (s === 'deliberate') return 'Deliberate';
  if (s === 'decide') return 'Open vote';
  if (s === 'implement') return 'Implement';
  return 'Archived';
};

const stageVariant = (s: ProposalStage) => {
  if (s === 'propose') return 'warning' as const;
  if (s === 'deliberate') return 'secondary' as const;
  if (s === 'decide') return 'info' as const;
  if (s === 'implement') return 'success' as const;
  return 'muted' as const;
};
---
<SiteLayout
  title="Engage · Fusion Party Australia"
  description="Fusion's home for participation. Share what matters, develop ideas together, and take part in decisions when eligible."
  canonical="/"
>
  <div class="page-wrap community-home">
    <section class="home-cover" aria-labelledby="home-heading">
      <div class="home-cover__copy">
        <p class="home-eyebrow">{user ? 'Your Engage' : "Fusion’s home for participation"}</p>
        <h1 id="home-heading">{user
          ? `Welcome back${user.name ? `, ${user.name.split(' ')[0]}` : ''}.`
          : <>Our communities.<br /><span>Our ideas.</span><br />Our future.</>}
        </h1>
        <p class="home-cover__lead">{user
          ? 'Find the discussions and decisions that matter to you. Start with your next step below.'
          : 'Bring your perspective. Share what matters where you live, develop ideas with others, and help shape what Fusion does next.'}</p>
        <div class="home-cover__actions">
          <Button href={user ? user.canParticipate ? '/proposals/?stage=decide&focus=needs-vote' : '/member/' : '/sense-box/'} size="lg">
            {user ? <Vote className="size-4" aria-hidden="true" /> : <MessageSquare className="size-4" aria-hidden="true" />}
            {user ? user.canParticipate ? 'Find my next ballot' : 'Check account status' : 'Share what matters'}
            <ArrowRight className="size-4" aria-hidden="true" />
          </Button>
          <Button href="/proposals/" size="lg" variant="outline">Explore proposals</Button>
        </div>
        <p class="home-cover__note">{user
          ? 'Your eligibility is checked for each ballot. You can change a recorded vote while voting remains open.'
          : 'Everyone can explore and share a local priority. Verified membership opens formal participation and voting rights where eligible.'}</p>
      </div>
      <div class="home-cover__visual"><CommunityImage scene="hero" priority sizes="(min-width: 801px) 50vw, 100vw" /></div>
    </section>

    {user && !user.canParticipate && (
      <Alert variant="warning">
        <AlertTitle>Check your membership status</AlertTitle>
        <AlertDescription>You can explore public activity and share a local priority. Formal participation depends on verification and ballot eligibility. <a href="/member/">View account status</a>.</AlertDescription>
      </Alert>
    )}

    {user ? (
      <section class="home-status-grid" aria-label="Your participation at a glance">
        <Card className="home-status-card"><CardContent className="grid gap-2 p-5">
          <Vote className="size-5" aria-hidden="true" /><span>Awaiting your vote</span><strong>{mine.length}</strong>
          <Button href="/proposals/?stage=decide&focus=needs-vote" variant="link" className="justify-start p-0">View my ballots <ArrowRight aria-hidden="true" /></Button>
        </CardContent></Card>
        <Card className="home-status-card"><CardContent className="grid gap-2 p-5">
          <CheckCircle2 className="size-5" aria-hidden="true" /><span>Open ballots completed</span><strong>{completedOpenVotesCount}<small> / {totalEligibleOpenVotesCount}</small></strong>
          {totalEligibleOpenVotesCount > 0 && <progress value={completedOpenVotesCount} max={totalEligibleOpenVotesCount} aria-label="Your eligible open ballots completed" />}
          <p>You may update your choice while a ballot is open.</p>
        </CardContent></Card>
        <Card className="home-status-card"><CardContent className="grid gap-2 p-5">
          <MessageSquare className="size-5" aria-hidden="true" /><span>In discussion</span><strong>{discussions.length}</strong>
          <Button href="/proposals/?stage=deliberate" variant="link" className="justify-start p-0">Join a discussion <ArrowRight aria-hidden="true" /></Button>
        </CardContent></Card>
        <Card className="home-status-card"><CardContent className="grid gap-2 p-5">
          <Layers className="size-5" aria-hidden="true" /><span>In your branches</span><strong>{branch.length}</strong>
          <Button href={user.activeBranchIds?.[0] ? `/proposals/?branch=${encodeURIComponent(user.activeBranchIds[0])}` : '/branches/'} variant="link" className="justify-start p-0">Explore branch activity <ArrowRight aria-hidden="true" /></Button>
        </CardContent></Card>
      </section>
    ) : (
      <section class="home-paths" aria-labelledby="start-heading">
        <div class="home-section-heading"><div><p class="home-eyebrow">A place for your perspective</p><h2 id="start-heading">Choose how to take part</h2></div><Button href="/how-it-works/" variant="link">New here? Start with the guide <ArrowRight aria-hidden="true" /></Button></div>
        <div class="home-path-grid">
          <Card className="home-path-card home-path-card--pink"><CardContent className="grid gap-4 p-6">
            <MessageSquare className="home-path-icon" aria-hidden="true" /><h3>Share a local priority</h3><p>Tell Fusion what matters in your community. No account or party membership needed.</p><Button href="/sense-box/" variant="outline" className="justify-self-start">Open Sense Box <ArrowRight aria-hidden="true" /></Button>
          </CardContent></Card>
          <Card className="home-path-card home-path-card--aqua"><CardContent className="grid gap-4 p-6">
            <Compass className="home-path-icon" aria-hidden="true" /><h3>Add your experience</h3><p>Find open invitations to share a story, photograph or perspective, with clear choices about publication.</p><Button href="/collaborate/" variant="outline" className="justify-self-start">Explore invitations <ArrowRight aria-hidden="true" /></Button>
          </CardContent></Card>
          <Card className="home-path-card"><CardContent className="grid gap-4 p-6">
            <Vote className="home-path-icon" aria-hidden="true" /><h3>Develop ideas together</h3><p>Read proposals and discussions. Verified members can contribute and vote when eligible.</p><Button href="/proposals/" variant="outline" className="justify-self-start">Browse proposals <ArrowRight aria-hidden="true" /></Button>
          </CardContent></Card>
        </div>
      </section>
    )}

    <div class="home-workspace">
      <div class="home-workspace__main">
        <section aria-labelledby="ballots-heading" class="home-section">
          <div class="home-section-heading">
            <div><p class="home-eyebrow">{user ? 'Your next step' : 'Explore the conversation'}</p><h2 id="ballots-heading">{user ? 'Open ballots for you' : 'Ideas taking shape'}</h2><p>{user ? 'Read the exact proposal wording before choosing how to vote.' : 'Discover current proposals, discussions and open ballots.'}</p></div>
            <Button href={user ? '/proposals/?stage=decide' : '/proposals/'} variant="link">View all <ArrowRight aria-hidden="true" /></Button>
          </div>
          {user ? (
            mine.length ? <div class="home-proposal-grid">{mine.slice(0, 6).map((p) => (
              <Card className="home-proposal-card"><CardContent className="grid gap-4 p-6">
                <div class="home-card-meta"><Badge variant="info">Open ballot</Badge><span>{p.space}</span></div>
                <h3><a href={`/proposals/${p.slug}/`}>{p.title}</a></h3><p>{p.summary}</p>
                <Button href={`/proposals/${p.slug}/#proposal-vote`} variant="outline" className="justify-self-start mt-auto">Read and vote <ArrowRight aria-hidden="true" /></Button>
              </CardContent></Card>
            ))}</div> : <Card><CardContent className="grid justify-items-start gap-3 p-6"><CheckCircle2 className="size-7" aria-hidden="true" /><h3>No ballots awaiting your vote</h3><p>Check your account status if you expected a ballot, or explore the discussions taking shape.</p><div class="home-inline-actions"><Button href="/member/" variant="outline">Account status</Button><Button href="/proposals/?stage=deliberate" variant="ghost">Join a discussion</Button></div></CardContent></Card>
          ) : (
            featuredProposals.length ? <div class="home-proposal-grid">{featuredProposals.map((p) => (
              <Card className="home-proposal-card"><CardContent className="grid gap-4 p-6">
                <div class="home-card-meta"><Badge variant={stageVariant(p.stage)}>{stageLabel(p.stage)}</Badge><span>{p.space}</span></div>
                <h3><a href={`/proposals/${p.slug}/`}>{p.title}</a></h3><p>{p.summary}</p>
                <p class="home-card-count">{p.commentCount} discussion {p.commentCount === 1 ? 'post' : 'posts'} · {publicTallyLabel(p) ?? `${p.votes.total} votes`}</p>
                <Button href={`/proposals/${p.slug}/`} variant="outline" className="justify-self-start mt-auto">{p.stage === 'decide' ? 'Read the ballot' : 'Explore the idea'} <ArrowRight aria-hidden="true" /></Button>
              </CardContent></Card>
            ))}</div> : <Card><CardContent className="grid justify-items-start gap-3 p-6"><h3>No public proposals yet</h3><p>You can still share a concern or an idea for your community.</p><Button href="/sense-box/">Share a local priority</Button></CardContent></Card>
          )}
        </section>

        {user && <section id="discussions" class="home-section" aria-labelledby="discussions-heading">
          <div class="home-section-heading"><div><p class="home-eyebrow">Build on each other’s ideas</p><h2 id="discussions-heading">In discussion now</h2></div><Button href="/proposals/?stage=deliberate" variant="link">All discussions <ArrowRight aria-hidden="true" /></Button></div>
          {discussions.length ? <div class="home-discussion-list">{discussions.slice(0, 4).map((p) => <Card><CardContent className="home-discussion-row p-5"><div><Badge variant="secondary">In discussion</Badge><h3><a href={`/proposals/${p.slug}/`}>{p.title}</a></h3><p>{p.commentCount} discussion {p.commentCount === 1 ? 'post' : 'posts'} · {p.space}</p></div><Button href={`/proposals/${p.slug}/#deliberation`} variant="ghost">Contribute <ArrowRight aria-hidden="true" /></Button></CardContent></Card>)}</div> : <p>No proposals are in deliberation right now. <a href="/proposals/">Explore all proposals</a>.</p>}
        </section>}
      </div>

      <aside class="home-rail" aria-label="Participation guide and useful links">
        <Card className="home-rail-card"><CardContent className="grid gap-4 p-6"><Plus className="size-6" aria-hidden="true" /><h2>Have an idea?</h2><p>Explain the change you want Fusion to support. Other members can help develop it.</p><Button href={primaryCtaHref}>{primaryCtaLabel} <ArrowRight aria-hidden="true" /></Button><p>Prefer to share a local concern? <a href="/sense-box/">Use Sense Box</a>.</p></CardContent></Card>
        <Card><CardContent className="grid gap-4 p-6"><BookOpen className="size-6" aria-hidden="true" /><h2>Follow the outcome</h2><p>A proposal, a ballot result and published policy are different records. Explore the wording Fusion has formally adopted.</p><Button href="/policies/" variant="outline">Policy registry <ArrowRight aria-hidden="true" /></Button>{registryAvailable && <p>{publishedPolicyCount} published {publishedPolicyCount === 1 ? 'record' : 'records'}</p>}</CardContent></Card>
        <div class="home-rail-links"><h2>Make yourself at home</h2><a href="/member/">{user ? 'My Engage and account settings' : 'Member sign in'}</a><a href="/branches/">Find your branch</a><a href="/collaborate/">Open invitations</a><a href="/how-it-works/">How participation works</a></div>
      </aside>
    </div>

    <section class="home-journey" aria-labelledby="journey-heading">
      <div class="home-section-heading"><div><p class="home-eyebrow">A clear path from idea to outcome</p><h2 id="journey-heading">Understand each step</h2></div><Button href="/how-it-works/" variant="outline">Read the full guide <ArrowRight aria-hidden="true" /></Button></div>
      <ol class="home-journey-grid">
        <li><span class="home-step-number">01</span><Plus aria-hidden="true" /><h3>Propose</h3><p>Describe an idea and why it matters. An eligible seconder starts deliberation.</p><a href={primaryCtaHref}>Explore proposing</a></li>
        <li><span class="home-step-number">02</span><MessageSquare aria-hidden="true" /><h3>Discuss</h3><p>Listen, contribute and suggest amendments to improve the wording.</p><a href="/proposals/?stage=deliberate">Find discussions</a></li>
        <li><span class="home-step-number">03</span><Vote aria-hidden="true" /><h3>Vote</h3><p>Eligible members vote on the exact, fixed wording of an open ballot.</p><a href="/proposals/?stage=decide">Explore open ballots</a></li>
        <li><span class="home-step-number">04</span><BookOpen aria-hidden="true" /><h3>Follow through</h3><p>Officers record outcomes. Policy ratification and publication are separate formal acts.</p><a href="/policies/">Read published policy</a></li>
      </ol>
    </section>

    <section class="home-community" aria-labelledby="community-heading"><CommunityImage sizes="(min-width: 801px) 50vw, 100vw" /><div><p class="home-eyebrow">Local perspectives. Shared possibilities.</p><h2 id="community-heading">There’s more than one way to contribute.</h2><p>A concern from your neighbourhood. A skill you can share. A thoughtful question. Find a way to take part that works for you.</p><div class="home-inline-actions"><Button href="/collaborate/">Explore invitations <ArrowRight aria-hidden="true" /></Button><Button href="/branches/" variant="outline">Find your branch</Button></div></div></section>

    <details class="home-highlights"><summary>Explore participation highlights</summary><ProposalHighlights proposals={highlightProposals} /></details>
  </div>
</SiteLayout>

<style>
  .community-home { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 5rem); padding-block: 1.5rem 4rem; }
  .home-cover { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.2fr); align-items: center; gap: clamp(1.5rem, 3vw, 3rem); padding: clamp(1.5rem, 3vw, 3rem); background: linear-gradient(120deg, var(--horizon-lavender-soft), var(--horizon-white) 58%, var(--horizon-voting-bg)); border-radius: 2rem; overflow: hidden; }
  .home-cover::after { content: ''; position: absolute; height: .5rem; left: 0; bottom: 0; right: 0; background: linear-gradient(90deg, var(--horizon-purple), var(--horizon-magenta), var(--horizon-pink), var(--horizon-accent)); }
  .home-cover__copy { display: grid; gap: 1.25rem; min-width: 0; }
  .home-eyebrow { font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 700; color: var(--horizon-purple); margin: 0; }
  .home-cover h1 { font-family: var(--font-outfit); margin: 0; font-size: clamp(2.6rem, 4.5vw, 4.5rem); font-weight: 750; line-height: 1.02; letter-spacing: -.045em; color: var(--horizon-purple); text-wrap: balance; overflow-wrap: anywhere; }
  .home-cover h1 span { color: var(--horizon-magenta); }
  .home-cover__lead { margin: 0; font-size: clamp(1.05rem, 1.5vw, 1.2rem); max-width: 46ch; line-height: 1.65; color: var(--horizon-muted); }
  .home-cover__actions, .home-inline-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .home-cover__actions :global([data-slot='button']) { max-width: 100%; }
  .home-cover__note { font-size: .85rem; color: var(--horizon-muted); line-height: 1.55; margin: 0; max-width: 55ch; }
  .home-cover__visual { min-width: 0; }
  .home-status-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  :global(.home-status-card) { border-top: 3px solid var(--horizon-accent); }
  :global(.home-status-card strong) { font-size: 2.1rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  :global(.home-status-card strong small) { font-size: 1rem; font-weight: 500; color: var(--horizon-muted); }
  :global(.home-status-card p) { font-size: .8rem; margin: 0; color: var(--horizon-muted); }
  progress { width: 100%; height: .5rem; accent-color: var(--horizon-magenta); }
  .home-paths, .home-section, .home-journey { display: grid; gap: 1.5rem; }
  .home-section-heading { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: end; gap: 1rem; }
  .home-section-heading :global([data-slot='button']) { max-width: 100%; white-space: normal; height: auto; min-height: 2.75rem; }
  h2 { font-family: var(--font-outfit); font-size: clamp(1.65rem, 2.4vw, 2.25rem); line-height: 1.15; letter-spacing: -.025em; font-weight: 700; color: var(--horizon-purple); margin: .4rem 0 0; }
  .home-section-heading p:not(.home-eyebrow) { margin: .6rem 0 0; color: var(--horizon-muted); }
  .home-path-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  :global(.home-path-card) { border-top: 4px solid var(--horizon-purple); background: var(--horizon-lavender-soft); }
  :global(.home-path-card--pink) { border-top-color: var(--horizon-magenta); }
  :global(.home-path-card--aqua) { border-top-color: var(--horizon-accent); }
  :global(.home-path-icon) { width: 2rem; height: 2rem; color: var(--horizon-purple); }
  :global(.home-path-card h3), :global(.home-proposal-card h3), :global(.home-discussion-row h3) { font-family: var(--font-outfit); font-size: 1.25rem; font-weight: 700; line-height: 1.25; color: var(--horizon-purple); margin: 0; }
  :global(.home-path-card p), :global(.home-proposal-card p), :global(.home-discussion-row p) { color: var(--horizon-muted); line-height: 1.6; margin: 0; }
  .home-workspace { display: grid; grid-template-columns: minmax(0, 2.3fr) minmax(16rem, 1fr); gap: 2rem; align-items: start; }
  .home-workspace__main { display: grid; gap: 3rem; min-width: 0; }
  .home-proposal-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  :global(.home-proposal-card) { border-radius: 1.2rem; overflow: hidden; }
  :global(.home-proposal-card [data-slot='card-content']) { height: 100%; align-content: start; grid-template-rows: auto auto 1fr auto auto; }
  :global(.home-proposal-card h3 a) { text-decoration: none; }
  :global(.home-proposal-card h3 a:hover) { text-decoration: underline; text-underline-offset: .18em; }
  .home-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: .8rem; color: var(--horizon-muted); }
  :global(p.home-card-count) { font-size: .8rem; }
  .home-rail { display: grid; gap: 1.25rem; }
  .home-rail :global(h2) { font-size: 1.35rem; margin: 0; }
  .home-rail :global(p) { margin: 0; line-height: 1.6; font-size: .95rem; color: var(--horizon-muted); }
  :global(.home-rail-card) { background: linear-gradient(135deg, var(--horizon-lavender-soft), var(--horizon-white)); border-top: 4px solid var(--horizon-magenta); }
  .home-rail-links { display: grid; gap: 1rem; padding: 1.5rem; }
  .home-rail-links a { text-underline-offset: .2em; }
  .home-discussion-list { display: grid; gap: .8rem; }
  :global(.home-discussion-row) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  :global(.home-discussion-row h3) { margin: .6rem 0; }
  :global(.home-discussion-row p) { font-size: .85rem; }
  .home-journey-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; gap: 1.5rem; }
  .home-journey-grid li { display: grid; gap: .8rem; align-content: start; border-top: 3px solid var(--horizon-purple); padding-top: 1.5rem; }
  .home-journey-grid li:nth-child(2) { border-color: var(--horizon-magenta); }
  .home-journey-grid li:nth-child(3), .home-journey-grid li:nth-child(4) { border-color: var(--horizon-accent); }
  .home-step-number { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--horizon-muted); }
  .home-journey-grid :global(svg) { height: 1.6rem; width: 1.6rem; color: var(--horizon-purple); }
  .home-journey-grid h3 { font-family: var(--font-outfit); font-size: 1.3rem; font-weight: 700; margin: 0; }
  .home-journey-grid p { font-size: .95rem; color: var(--horizon-muted); line-height: 1.65; margin: 0; }
  .home-journey-grid a { font-size: .9rem; text-underline-offset: .2em; }
  .home-community { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(1.5rem, 4vw, 4rem); }
