---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSessionUser } from '../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../lib/db.ts';
import { listPolicies } from '../lib/store.ts';

export const prerender = false;

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);
const proposals = await listPolicies(db, { includeDrafts: false });

const votingProposals = proposals.filter((p) => p.status === 'voting');
const partyProposals = proposals.filter((p) => p.kind === 'proposal');
const featuredVoting = [
  ...partyProposals.filter((p) => p.status === 'voting'),
  ...votingProposals.filter((p) => p.kind !== 'proposal'),
].slice(0, 6);

const categoryMap = new Map<
  string,
  { name: string; division: string; summary: string; total: number; voting: number }
>();

for (const item of proposals) {
  const existing = categoryMap.get(item.category) ?? {
    name: item.category,
    division: item.division,
    summary: item.categorySummary || '',
    total: 0,
    voting: 0,
  };
  existing.total += 1;
  if (item.status === 'voting') existing.voting += 1;
  if (!existing.summary && item.categorySummary) existing.summary = item.categorySummary;
  categoryMap.set(item.category, existing);
}

const categories = [...categoryMap.values()];
---
<SiteLayout
  title="Engage · Fusion Party Australia Proposals, Policies & Member Decisions"
  description="Review Fusion Party proposals and policies, share feedback, and vote on open party decisions."
  canonical={`${Astro.url.origin}/`}
>
  <section class="hero">
    <div class="page-wrap hero-layout">
      <div class="hero-copy">
        <h1>Read, shape, and vote on Fusion decisions.</h1>
        <p>
          Engage is Fusion Party Australia’s member consultation and voting platform—covering
          party proposals, visual identity and governance decisions, and our national policy
          library in one place.
        </p>
        <div class="hero-actions">
          <a class="button" href="/policies/">
            Browse all {proposals.length} proposals
          </a>
          <a class="button button--outline" href="/policies/?status=voting">
            Open votes ({votingProposals.length})
          </a>
          {!user && (
            <a class="text-cta" href="/member/">
              Sign in as a member →
            </a>
          )}
        </div>
      </div>

      <figure class="hero-media">
        <img
          src="/melbourne-station.webp"
          alt="Commuters moving through a sunlit Melbourne train station"
          width="640"
          height="460"
        />
      </figure>
    </div>
  </section>

  <section id="how-it-works" class="guide-section" aria-labelledby="guide-heading">
    <div class="page-wrap">
      <div class="guide-header">
        <h2 id="guide-heading">New to Engage? Here is how it works</h2>
        <p>
          Anyone can read published proposals and policies. Verified party members can comment,
          suggest wording changes, and vote directly on each proposal page.
        </p>
      </div>

      <div class="guide-steps">
        <div class="guide-step">
          <h3>Sign in and confirm membership</h3>
          <p>
            Sign in with a one-click email link or Google on the <a href="/member/">Member page</a>.
            An administrator checks your name against party membership records to unlock commenting
            and voting.
          </p>
        </div>

        <div class="guide-step">
          <h3>Read and suggest improvements</h3>
          <p>
            Open any item in <a href="/policies/">Proposals &amp; Policies</a>—whether it is a
            party decision, visual identity review, or policy commitment—and leave feedback or
            suggested wording right on the page.
          </p>
        </div>

        <div class="guide-step">
          <h3>Vote on open decisions</h3>
          <p>
            When a proposal or policy is open for voting, cast or update your Approve or Reject
            vote at the top of that page. You can change your vote at any time while voting is open.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="voting-section section-space" aria-labelledby="voting-heading">
    <div class="page-wrap">
      <div class="section-head">
        <div>
          <h2 id="voting-heading">Open for member consultation &amp; voting</h2>
          <p>
            Select any party proposal or policy below to read the full wording, review member
            comments, and cast your vote.
          </p>
        </div>
        <a class="button button--outline" href="/policies/?status=voting">
          View all {votingProposals.length} open votes →
        </a>
      </div>

      {featuredVoting.length === 0 ? (
        <p class="callout">
          No proposals are currently open for voting. Browse{' '}
          <a href="/policies/">all proposals &amp; policies</a> to read and comment.
        </p>
      ) : (
        <ul class="policy-rows">
          {featuredVoting.map((item) => (
            <li class="policy-row">
              <div class="policy-row__main">
                <div class="policy-row__meta">
                  <span class="badge badge--voting">Voting open</span>
                  <span class="badge">
                    {item.kind === 'proposal' ? 'Party proposal' : 'Policy'}
                  </span>
                  <span>{item.category}</span>
                  <span class="tabular">{item.policyId}</span>
                </div>
                <h3>
                  <a href={`/policies/${item.slug}/`}>{item.title}</a>
                </h3>
                <p>{item.statement}</p>
              </div>
              <div class="policy-row__side">
                <span class="tabular meta-stat">
                  {item.votes.total} {item.votes.total === 1 ? 'vote' : 'votes'} ·{' '}
                  {item.commentCount} {item.commentCount === 1 ? 'comment' : 'comments'}
                </span>
                <a class="button button--small" href={`/policies/${item.slug}/`}>
                  Read &amp; vote →
                </a>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="topics-section section-space" aria-labelledby="topics-heading">
    <div class="page-wrap">
      <div class="section-head">
        <div>
          <h2 id="topics-heading">Browse by area</h2>
          <p>Explore party decisions, organisational proposals, and policy areas.</p>
        </div>
        <a class="button button--outline" href="/policies/">
          Search all proposals →
        </a>
      </div>

      <ul class="topic-list">
        {categories.map((cat) => (
          <li class="topic-row">
            <div class="topic-row__info">
              <h3>
                <a href={`/policies/?category=${encodeURIComponent(cat.name)}`}>{cat.name}</a>
              </h3>
              <p>{cat.summary || `Proposals under ${cat.division}.`}</p>
            </div>
            <div class="topic-row__counts tabular">
              <span class="badge">{cat.total} proposals</span>
              {cat.voting > 0 && <span class="badge badge--voting">{cat.voting} voting</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.75rem);
    border-bottom: 1px solid var(--horizon-line);
    background: var(--horizon-white);
  }
  .hero-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .hero-copy h1 {
    margin: 0 0 1.1rem;
  }
  .hero-copy p {
    margin: 0 0 1.75rem;
    max-width: 56ch;
    color: var(--horizon-muted);
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.15rem;
  }
  .text-cta {
    font-weight: 700;
    color: var(--horizon-purple);
  }
  .hero-media {
    margin: 0;
  }
  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 25rem;
    object-fit: cover;
    border-radius: 0.85rem;
    border: 1px solid var(--horizon-line);
  }

  .guide-section {
    padding-block: clamp(2.75rem, 5vw, 4.25rem);
    background: var(--horizon-lavender);
    border-bottom: 1px solid var(--horizon-line);
  }
  .guide-header {
    max-width: 54rem;
    margin-bottom: 2rem;
  }
  .guide-header h2 {
    margin: 0 0 0.6rem;
  }
  .guide-header p {
    margin: 0;
    color: var(--horizon-muted);
    font-size: 1.05rem;
  }
  .guide-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--horizon-line);
  }
  .guide-step h3 {
    margin: 0 0 0.45rem;
    color: var(--horizon-purple-deep);
  }
  .guide-step p {
    margin: 0;
    color: var(--horizon-muted);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 1.75rem;
  }
  .section-head h2 {
    margin: 0 0 0.45rem;
  }
  .section-head p {
    margin: 0;
    max-width: 60ch;
    color: var(--horizon-muted);
  }

  .policy-rows,
  .topic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--horizon-line);
  }
  .policy-row,
  .topic-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 2rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--horizon-line);
  }
  .policy-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    color: var(--horizon-muted);
    font-weight: 600;
  }
  .policy-row h3,
  .topic-row h3 {
    margin: 0 0 0.35rem;
    font-family: Newsreader, Georgia, serif;
    font-size: clamp(1.35rem, 2vw, 1.65rem);
  }
  .policy-row h3 a,
  .topic-row h3 a {
    text-decoration: none;
  }
  .policy-row h3 a:hover,
  .topic-row h3 a:hover {
    text-decoration: underline;
  }
  .policy-row p,
  .topic-row p {
    margin: 0;
    max-width: 68ch;
    color: var(--horizon-muted);
    font-size: 0.96rem;
  }
  .policy-row__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.55rem;
  }
  .meta-stat {
    font-size: 0.85rem;
    color: var(--horizon-muted);
    font-weight: 600;
  }

  .topics-section {
    background: var(--horizon-lavender-soft);
    border-top: 1px solid var(--horizon-line);
  }
  .topic-row__counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 860px) {
    .hero-layout {
      grid-template-columns: 1fr;
    }
    .guide-steps {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .policy-row,
    .topic-row {
      grid-template-columns: 1fr;
      align-items: flex-start;
    }
    .policy-row__side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
  }
</style>
