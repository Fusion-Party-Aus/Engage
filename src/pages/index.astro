---
import SiteLayout from '../layouts/SiteLayout.astro';
import FeatureGrid from '../components/site/FeatureGrid.astro';
import { Button } from '../components/ui/button';
import { Alert, AlertDescription, AlertTitle } from '../components/ui/alert';
import { getSessionUser } from '../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../lib/db.ts';
import { listOutstandingDecisions, listProposals } from '../lib/store.ts';

export const prerender = false;
const authError = Astro.url.searchParams.get('error');
if (authError) return Astro.redirect(`/member/?error=${encodeURIComponent(authError)}`);
const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([getDatabase(env), getSessionUser(Astro.request, env)]);
const proposals = await listProposals(db, { includeArchived: false, user });
const votes = proposals.filter((p) => p.stage === 'decide');
const discussions = proposals.filter((p) => p.stage === 'deliberate');
const mine = user?.canParticipate ? await listOutstandingDecisions(db, user.memberId, user) : [];
const branch = user?.activeBranchIds?.length ? proposals.filter((p) => user.activeBranchIds?.includes(p.originatingBranchId ?? '')) : [];
const publishedPolicyCount = await db.collection('policy_registry').countDocuments({ publicationStatus: 'published' });
const registryAvailable = publishedPolicyCount > 0;
---
<SiteLayout title="Engage · Fusion Party Australia" description="Explore Fusion's ideas, take part when you choose, and follow proposals and official policy." canonical="/">
  {user ? (
    <div class="page-wrap section-space journey-home member-home">
      <header class="journey-hero">

        <h1>Welcome back{user.name ? `, ${user.name.split(' ')[0]}` : ''}.</h1>
        <p>Your votes, discussions and branch activity are here.</p>
      </header>
      <div class="home-summary" aria-label="Your Engage at a glance"><a href="/member/#awaiting-heading"><svg class="nav-icon" aria-hidden="true"><use href="#icon-vote" /></svg><strong>{mine.length}</strong><span>Votes for you</span></a><a href="/proposals/?stage=deliberate"><svg class="nav-icon" aria-hidden="true"><use href="#icon-files" /></svg><strong>{discussions.length}</strong><span>Discussions</span></a><a href="/member/#proposals-heading"><svg class="nav-icon" aria-hidden="true"><use href="#icon-home" /></svg><strong>{branch.length}</strong><span>Branch ideas</span></a></div>
      {!user.canParticipate && <Alert variant="warning" className="journey-notice"><AlertTitle>Your membership is being checked</AlertTitle><AlertDescription>You can read everything public now. Voting and contributions become available once your membership is verified and you are eligible for the relevant ballot. <a href="/member/">View account status →</a></AlertDescription></Alert>}
      <section class="journey-section" aria-labelledby="your-votes"><div class="journey-heading"><div><h2 id="your-votes">Votes for you</h2><p>Ballots you can vote on, with the exact wording on each page.</p></div><a href="/proposals/?stage=decide">See all open votes →</a></div>{mine.length ? <div class="journey-list">{mine.slice(0, 4).map((p) => <article><span class="journey-tag">Open vote</span><h3><a href={`/proposals/${p.slug}/`}>{p.title}</a></h3><p>{p.summary}</p><a href={`/proposals/${p.slug}/`}>Read and vote →</a></article>)}</div> : <p class="journey-empty">No votes need your attention.</p>}</section>
      <section class="journey-section" aria-labelledby="discussions"><div class="journey-heading"><div><h2 id="discussions">Join discussions</h2><p>Read, respond or suggest a wording change.</p></div><a href="/proposals/?stage=deliberate">Join discussions →</a></div><div class="journey-list">{discussions.slice(0, 3).map((p) => <article><span class="journey-tag">{p.space}</span><h3><a href={`/proposals/${p.slug}/`}>{p.title}</a></h3><p>{p.summary}</p><a href={`/proposals/${p.slug}/`}>Read and contribute →</a></article>)}</div></section>
      <section class="journey-next"><div><h2>Your participation</h2><p>Find your activity, account status and branch memberships in one place.</p><a href="/member/">Go to My Engage →</a></div><div><h2>Your branch</h2><p>{branch.length ? `${branch.length} visible proposals originate in your branches.` : 'Browse proposals from your branch and across Fusion.'}</p><a href={user.activeBranchIds?.[0] ? `/proposals/?branch=${encodeURIComponent(user.activeBranchIds[0])}` : '/branches/'}>Explore branch activity →</a></div><div><h2>Have an idea?</h2><p>Start with the change you want to see. You can refine the wording as members respond.</p><a href="/proposals/new/">Suggest an idea →</a></div></section>
    </div>
  ) : (
    <>
      <section class="journey-visitor-hero"><div class="page-wrap journey-hero-grid"><div><h1>Help shape what Fusion does next.</h1><p>Engage is where members share ideas, discuss proposed changes and vote on decisions. Anyone can browse what is being considered. {registryAvailable ? 'Published official policy is available in the policy registry.' : 'The policy registry is not yet populated with official records; proposals here are not ratified policy.'}</p><div class="journey-actions"><Button href="/proposals/">Browse proposals</Button><Button href="/policies/" variant="outline">{registryAvailable ? 'Read official policy' : 'About the policy registry'}</Button></div></div><img src="/melbourne-station.webp" alt="People moving through a sunlit Melbourne train station" width="640" height="460" /></div></section>
      <div class="page-wrap section-space journey-home"><FeatureGrid
        id="happening"
        eyebrow="On Engage"
        title="See what is happening"
        intro="Open votes, active discussions and the official policy record."
        action={{ href: '/proposals/', label: 'Browse all proposals' }}
        features={[
          {
            icon: 'vote',
            title: `${votes.length} open votes`,
            description: 'Read the wording before you decide.',
            href: '/proposals/?stage=decide',
            cta: 'See open votes',
          },
          {
            icon: 'files',
            title: `${discussions.length} discussions`,
            description: 'Read the discussion and suggested changes.',
            href: '/proposals/?stage=deliberate',
            cta: 'Join discussions',
          },
          {
            icon: 'book',
            title: 'Policy registry',
            description: registryAvailable
              ? 'Read formally adopted and published policy.'
              : 'Official policy records are not yet available in Engage. Proposals here are not ratified policy.',
            href: '/policies/',
            cta: registryAvailable ? 'Read official policy' : 'About the policy registry',
          },
        ]}
      /><section class="journey-section journey-invite"><h2>Want to take part?</h2><p>Members can suggest ideas and join discussions. Voting depends on the ballot and your membership.</p><Button href="/member/">Sign in or get started</Button><Button href="/how-it-works/" variant="link">How Engage works →</Button></section></div>
    </>
  )}
</SiteLayout>
<style>
.journey-home{max-width:1180px}.journey-hero h1,.journey-visitor-hero h1{max-width:13ch;font-size:clamp(2.8rem,6vw,5.5rem);line-height:1.04}.journey-hero p,.journey-visitor-hero p{max-width:62ch;font-size:1.15rem}.journey-visitor-hero{background:var(--horizon-purple);color:var(--horizon-white);padding:clamp(3rem,7vw,7rem) 0}.journey-hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:center}.journey-hero-grid img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:var(--horizon-radius-surface,.85rem)}.journey-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2rem}.journey-section{margin:3.5rem 0}.journey-heading{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:1.5rem}.journey-heading h2{font-size:clamp(2rem,4vw,3rem);margin:.3rem 0}.journey-heading p{margin:.3rem 0;max-width:60ch}.journey-list,.journey-next{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.journey-list article{display:block;padding:1.5rem 0;border-top:1px solid var(--horizon-line);color:var(--horizon-purple)}.journey-list h3,.journey-next h3{font-size:1.5rem;margin:.6rem 0}.journey-list p,.journey-next p{line-height:1.5}.journey-tag{font:700 .75rem Outfit,sans-serif;text-transform:uppercase;letter-spacing:.09em}.journey-notice,.journey-empty,.journey-invite{padding:1.5rem;background:var(--horizon-lavender-soft);border-radius:.85rem}.journey-invite{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}.journey-invite p{flex-basis:100%}@media(max-width:760px){.journey-hero-grid,.journey-list,.journey-next{grid-template-columns:1fr}.journey-hero-grid img{max-height:260px}.journey-heading{display:block}.journey-visitor-hero{padding:3rem 0}}

.journey-visitor-hero { position:relative; overflow:hidden; background:radial-gradient(ellipse at 65% 0%,#6335a0 0%,transparent 55%),#2c0b61; padding:0; }
.journey-hero-grid { width:min(100%,var(--content-width)); margin-inline:auto; grid-template-columns:1fr 1fr; min-height:29rem; gap:1rem; }
.journey-hero-grid>div { padding:clamp(2.2rem,5vw,5rem) 1.5rem; position:relative; z-index:1; }
.journey-hero-grid h1 { color:#fff; font:700 clamp(2.7rem,4.7vw,4.7rem)/1.02 Outfit,sans-serif; max-width:11ch; margin:0 0 1.25rem; }
.journey-hero-grid p { max-width:47ch; font-size:1.08rem; line-height:1.55; }
.journey-hero-grid img { width:100%; height:100%; max-height:none; aspect-ratio:auto; object-fit:cover; border-radius:0; clip-path:polygon(20% 0,100% 0,100% 100%,0 100%); }
.journey-actions [data-variant="outline"] { border-color:#fff; color:#fff; background:transparent; }
.journey-actions [data-variant="outline"]:hover { color:#250a57; background:#fff; }
.journey-home { max-width:84rem; }
.journey-home>.journey-section:first-child { margin-top:.5rem; }
.journey-section { margin:2.3rem 0; }
.journey-heading h2 { font-size:clamp(1.5rem,2vw,2rem); }
.journey-next { gap:1rem; }
.journey-next :global(a) { display:grid; gap:.35rem; padding:.35rem; text-decoration:none; }
.journey-next :global([data-slot="card"]):hover { border-color:#8e77c4; box-shadow:0 8px 20px #260b5914; }
.journey-next :global(a) .nav-icon { width:2rem; height:2rem; color:#6237bf; }
.journey-next h3 { font-size:1.2rem; }
.journey-next strong { color:#4223a3; }
.member-home .journey-hero { margin:-3.5rem calc((100vw - min(100vw - 3rem,var(--content-width)))/-2) 1.5rem; padding:2.4rem max(1.5rem,calc((100vw - var(--content-width))/2)); color:#fff; background:linear-gradient(112deg,#271060 38%,#54288b 72%,#214773 100%); }
.member-home .journey-hero h1 { max-width:none; font:700 clamp(2rem,3vw,3rem)/1.1 Outfit,sans-serif; margin:0 0 .25rem; }
.member-home .journey-hero p { margin:0; }
.member-home .journey-hero h1,.member-home .journey-hero p { color:#fff; }
.home-summary { display:grid; grid-template-columns:repeat(3,1fr); gap:.8rem; margin-top:-3.2rem; position:relative; }
.home-summary a { display:grid; gap:.2rem; padding:1.1rem 1.25rem; border:1px solid var(--horizon-line); border-radius:.65rem; background:#fff; text-decoration:none; }
.home-summary .nav-icon { color:#5633c0; width:1.55rem; height:1.55rem; }
.home-summary strong { font-size:1.55rem; line-height:1.1; }
.home-summary span { font-size:.85rem; }
.member-home .journey-list { grid-template-columns:1fr; gap:0; background:#fff; border:1px solid var(--horizon-line); border-radius:.7rem; padding:0 1.15rem; }
.member-home .journey-list article { display:grid; grid-template-columns:7rem minmax(0,1fr) auto; align-items:center; gap:1rem; padding:.9rem 0; border-top:0; border-bottom:1px solid var(--horizon-line); }
.member-home .journey-list article:last-child { border:0; }
.member-home .journey-list article h3 { font-size:1rem; margin:0; }
.member-home .journey-list article p { display:none; }
.member-home .journey-list article>a { font-weight:700; white-space:nowrap; }
@media(max-width:760px){.journey-hero-grid{grid-template-columns:1fr}.journey-hero-grid>div{padding:2.5rem 1rem}.journey-hero-grid img{height:15rem;clip-path:none}.home-summary{grid-template-columns:repeat(3,1fr)}.member-home .journey-hero{margin:-2rem -1rem 1.5rem;padding:2rem 1rem 4rem}.member-home .journey-list article{grid-template-columns:1fr;gap:.25rem}.member-home .journey-list article>a{white-space:normal}}
</style>
