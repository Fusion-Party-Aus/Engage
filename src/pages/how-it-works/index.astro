---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Card, CardContent } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import {
  ArrowRight,
  BookOpen,
  Compass,
  Lightbulb,
  MessageSquare,
  Vote,
} from 'lucide-react';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals } from '../../lib/store.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const [openVotes, discussions, recentProposals, publishedPolicies] = await Promise.all([
  listProposals(db, { user, stage: 'decide' }),
  listProposals(db, { user, stage: 'deliberate' }),
  listProposals(db, { user }),
  db.collection('policy_registry')
    .find({ publicationStatus: 'published' })
    .sort({ publishedAt: -1, ratifiedAt: -1 })
    .limit(1)
    .toArray(),
]);

const currentProposal =
  recentProposals.find((proposal) => proposal.stage === 'propose') ??
  recentProposals.find((proposal) => proposal.stage === 'deliberate') ??
  recentProposals[0];
const discussionProposal =
  discussions.find((proposal) => proposal.proposalId !== currentProposal?.proposalId) ??
  discussions[0];
const openVote =
  openVotes.find(
    (proposal) =>
      proposal.proposalId !== currentProposal?.proposalId &&
      proposal.proposalId !== discussionProposal?.proposalId,
  ) ?? openVotes[0];

const live = {
  idea: currentProposal
    ? { title: currentProposal.title, href: `/proposals/${currentProposal.slug}/` }
    : null,
  discussion: discussionProposal
    ? { title: discussionProposal.title, href: `/proposals/${discussionProposal.slug}/` }
    : null,
  vote: openVote
    ? { title: openVote.title, href: `/proposals/${openVote.slug}/` }
    : null,
  policy: publishedPolicies[0]
    ? {
        title: publishedPolicies[0].title,
        href: `/policies/${encodeURIComponent(publishedPolicies[0].policyId)}/`,
      }
    : null,
};

const stages = [
  {
    title: 'Propose',
    who: 'Members submit',
    body: 'A proposal sets out what would change, who it affects and why it matters. Members can put one forward; anyone can read it and follow its stage.',
    href: '/proposals/?stage=propose',
    action: 'Browse proposals',
  },
  {
    title: 'Deliberate',
    who: 'Members contribute',
    body: 'Members discuss the idea, raise concerns and suggest wording changes. A wording suggestion is informal and needs no seconder. A formal amendment is recorded against the wording and, once seconding is implemented, will require one independent eligible seconder before it progresses.',
    href: '/proposals/?stage=deliberate',
    action: 'Join discussions',
  },
  {
    title: 'Decide',
    who: 'Eligibility applies',
    body: 'Eligible members vote on the exact wording. A proposal ballot and any amendment ballot are separate decisions, and the ballot page states who can vote.',
    href: '/proposals/?stage=decide',
    action: 'See open votes',
  },
  {
    title: 'Implement',
    who: 'Everyone can follow',
    body: 'The decision is processed here. Required authorisation and publication steps occur where they apply, and subsequent progress can be tracked. Being at this stage does not by itself adopt or publish policy.',
    href: '/proposals/?stage=implement',
    action: 'See decision progress',
  },
];

const pathways = [
  {
    title: 'Browse proposals',
    who: 'Anyone',
    body: 'Read proposals at every stage, from new ideas to decisions being processed after the vote.',
    href: '/proposals/',
    action: 'Browse proposals',
    icon: Compass,
    liveLabel: 'Current proposal',
    live: live.idea,
    empty: 'No public proposals yet. Check back soon.',
  },
  {
    title: 'Join discussions',
    who: 'Members',
    body: 'Share support, concerns or an informal wording suggestion while an idea is open for discussion.',
    href: '/proposals/?stage=deliberate',
    action: 'Join discussions',
    icon: MessageSquare,
    liveLabel: 'In discussion',
    live: live.discussion,
    empty: 'No discussions are open right now.',
  },
  {
    title: 'See open votes',
    who: 'Eligibility applies',
    body: 'Read the exact wording and check the ballot’s eligibility before you vote.',
    href: '/proposals/?stage=decide',
    action: 'See open votes',
    icon: Vote,
    liveLabel: 'Open ballot',
    live: live.vote,
    empty: 'No ballots are open right now.',
  },
  {
    title: 'Policy registry',
    who: 'Anyone',
    body: 'Engage’s registry holds only wording formally adopted and authorised for publication. It is not yet populated in this release; proposals here are not ratified policy.',
    href: '/policies/',
    action: 'Open the policy registry',
    icon: BookOpen,
    liveLabel: 'Recently published',
    live: live.policy,
    empty: 'Engage does not yet hold official policy records. This does not mean Fusion has no adopted policy: those policies remain available through the party’s official channels.',
  },
];

const details: Array<{ title: string; body: string; link?: { href: string; label: string } }> = [
  {
    title: 'Wording suggestions, formal amendments and amendment ballots',
    body: 'A wording suggestion is an informal contribution during deliberation and needs no seconder. A formal amendment is a proposed substantive change to recorded wording. An amendment ballot is a separate vote on the recorded amendment revision where the applicable process requires one.',
  },
  {
    title: 'Seconding formal motions',
    body: 'Under the governance design for the upcoming lifecycle, every formal motion requires one independent eligible seconder, including new policy proposals, formal amendments and repeal proposals. The author cannot second their own motion. A seconder supports formal consideration, not necessarily approval. Minor editorial corrections need not restart seconding; material changes to formally seconded wording require renewed seconding. Seconding is not yet operational.',
  },
  {
    title: 'Proposal ballots and amendment ballots are separate',
    body: 'A proposal ballot decides whether the proposal wording should proceed. An amendment ballot decides whether a specific amendment revision should be endorsed. Each is tied to its own saved revision, and one does not automatically change the other.',
  },
  {
    title: 'Who can vote',
    body: 'Voting requires a verified membership and, where a ballot is scoped to a branch, active membership of that branch. Signing in alone does not grant voting rights. The ballot page states the eligibility that applies.',
    link: { href: '/member/', label: 'Check your account' },
  },
  {
    title: 'The wording is frozen for a ballot',
    body: 'When a ballot opens, it is bound to a specific wording revision. Later edits do not change what voters saw or how their votes are counted. Earlier revisions remain available so the change can be audited.',
  },
  {
    title: 'Current scope and limits',
    body: 'This page describes what Engage supports today. Seconding formal motions, automatic ratification and timed ballots are not yet implemented. Seconding will be described as available only after the lifecycle implementation and its tests are complete.',
  },
];
---
<SiteLayout
  title="How Engage works · Fusion Party Australia"
  description="A plain-language guide to how ideas move through Engage: propose, deliberate, decide and implement, and how a successful vote can become adopted policy."
>
  <div class="page-wrap section-space how-page">
    <header class="how-hero">
      <div class="how-hero__copy">
        <h1>How an idea becomes a decision.</h1>
        <p class="how-hero__lead">
          Engage is Fusion Party Australia’s place to explore ideas, discuss proposed changes, vote when eligible, and explore the policy registry. You can read everything public without an account.
        </p>
        <p class="how-hero__in-short">
          <strong>In short:</strong> an idea is discussed, voted on when eligible, and only becomes adopted policy after formal ratification and authorised publication.
        </p>
        <div class="how-hero__actions">
          <Button href="/proposals/">Browse proposals <ArrowRight aria-hidden="true" className="size-4" /></Button>
          <Button href="/policies/" variant="outline">Policy registry</Button>
        </div>
      </div>

      <Card className="how-legend">
        <CardContent className="grid gap-4 p-6">
          <div>
            <h2>Read freely. Take part when you are ready.</h2>
          </div>
          <ul class="how-legend__list">
            <li>
              <Compass aria-hidden="true" className="size-4" />
              <div><strong>Anyone</strong><span>Read public proposals and the policy registry.</span></div>
            </li>
            <li>
              <MessageSquare aria-hidden="true" className="size-4" />
              <div><strong>Members</strong><span>Join discussions and suggest wording changes.</span></div>
            </li>
            <li>
              <Vote aria-hidden="true" className="size-4" />
              <div><strong>Eligible members</strong><span>Vote in the ballots they qualify for.</span></div>
            </li>
          </ul>
        </CardContent>
      </Card>
    </header>

    <nav class="how-nav" aria-label="On this page">
      <a href="#process">The four stages</a>
      <a href="#actions">What you can do</a>
      <a href="#details">The details</a>
    </nav>

    <section id="process" class="how-section" aria-labelledby="process-heading">
      <div class="section-head">
        <div>
          <h2 id="process-heading">Four stages, one recorded path.</h2>
        </div>
        <p class="section-head__note">Every proposal follows the same four stages. The wording and the decision record are kept at each step.</p>
      </div>

      <ol class="stage-list">
        {stages.map((stage, index) => (
          <li class="stage">
            <span class="stage__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="stage__body">
              <div class="stage__head">
                <h3>{stage.title}</h3>
                <Badge variant="outline">{stage.who}</Badge>
              </div>
              <p>{stage.body}</p>
              <Button href={stage.href} variant="link" className="h-auto gap-1.5 px-0">
                {stage.action} <ArrowRight aria-hidden="true" className="size-4" />
              </Button>
            </div>
          </li>
        ))}
      </ol>

      <Card className="after-vote">
        <div class="after-vote__inner">
          <div class="after-vote__copy">
            <div class="after-vote__eyebrow">
              <Badge variant="warning">Not automatic</Badge>
              <span>After the vote</span>
            </div>
            <h3>A successful ballot is not adopted policy.</h3>
            <p>A proposal ballot decides the wording. It does not ratify or publish policy. After the vote, the decision is processed through the steps below where they apply.</p>
            <Button href="/policies/" variant="outline">Policy registry <ArrowRight aria-hidden="true" className="size-4" /></Button>
          </div>
          <ol class="after-vote__steps">
            <li>
              <span aria-hidden="true">01</span>
              <div><strong>Formal ratification</strong><p>An authorised party authority records the adopted wording and the decision event.</p></div>
            </li>
            <li>
              <span aria-hidden="true">02</span>
              <div><strong>Authorised publication</strong><p>Only then does the exact wording appear in the policy registry.</p></div>
            </li>
          </ol>
        </div>
      </Card>
    </section>

    <section id="actions" class="how-section" aria-labelledby="actions-heading">
      <div class="section-head">
        <div>
          <h2 id="actions-heading">Start with what you need.</h2>
        </div>
        <p class="section-head__note">Some actions require a verified membership; voting also depends on the ballot.</p>
      </div>

      <div class="pathway-grid">
        {pathways.map((pathway) => {
          const Icon = pathway.icon;
          return (
            <Card className="pathway">
              <div class="pathway__inner">
                <div class="pathway__top">
                  <span class="pathway__icon"><Icon aria-hidden="true" /></span>
                  <Badge variant="outline">{pathway.who}</Badge>
                </div>
                <h3>{pathway.title}</h3>
                <p>{pathway.body}</p>
                {pathway.live ? (
                  <p class="pathway__live">
                    <span>{pathway.liveLabel}</span>
                    <a href={pathway.live.href}>{pathway.live.title}</a>
                  </p>
                ) : (
                  <p class="pathway__empty">{pathway.empty}</p>
                )}
                <Button href={pathway.href} variant="outline" className="mt-auto w-fit gap-1.5">
                  {pathway.action} <ArrowRight aria-hidden="true" className="size-4" />
                </Button>
              </div>
            </Card>
          );
        })}
      </div>

      <Card className="idea-cta">
        <div class="idea-cta__inner">
          <div>
            <h3>Have an idea? Members can put a proposal forward.</h3>
            <p>Start with the change you want to see. You can refine the wording as members respond.</p>
          </div>
          <Button href={user?.canParticipate ? '/proposals/new/' : '/member/'}>
            {user?.canParticipate ? 'Suggest an idea' : user ? 'Check your account' : 'Sign in to suggest an idea'}
            <Lightbulb aria-hidden="true" className="size-4" />
          </Button>
        </div>
      </Card>
    </section>

    <section id="details" class="how-section" aria-labelledby="details-heading">
      <div class="details-layout">
        <div class="details-intro">
          <h2 id="details-heading">When you need the exact rule.</h2>
          <p>These distinctions keep the wording, the vote and the final policy record clear. Open a topic for the detail.</p>
        </div>
        <div class="details-list">
          {details.map((detail) => (
            <details class="detail">
              <summary>
                <span>{detail.title}</span>
                <span class="detail__mark" aria-hidden="true">+</span>
              </summary>
              <div class="detail__body">
                <p>{detail.body}{' '}
                  {detail.link && <a href={detail.link.href}>{detail.link.label}</a>}
                </p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="how-close" aria-labelledby="close-heading">
      <div>
        <h2 id="close-heading">Participation is optional. Start where you are.</h2>
        <p>Read what interests you. Sign in when you want to contribute or vote.</p>
      </div>
      <div class="how-close__actions">
        <Button href="/proposals/">Browse proposals <ArrowRight aria-hidden="true" className="size-4" /></Button>
        <Button href="/member/" variant="outline" className="border-white/50 bg-transparent text-white hover:bg-white hover:text-[#250a57]">
          Sign in or get started
        </Button>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .how-page {
    max-width: 84rem;
  }

  .how-page p {
    text-wrap: pretty;
  }

  .how-page :global([data-slot="button"]) {
    min-height: 2.75rem;
  }

  /* Hero */
  .how-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-bottom: 2.5rem;
  }
  .how-hero h1 {
    max-width: 15ch;
    margin: 0 0 1.25rem;
    font: 600 clamp(2.7rem, 5.4vw, 4.6rem)/1.02 Newsreader, Georgia, serif;
    letter-spacing: -0.035em;
    color: var(--horizon-purple);
  }
  .how-hero__lead {
    max-width: 60ch;
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--horizon-muted);
  }
  .how-hero__in-short {
    max-width: 62ch;
    margin: 1.1rem 0 0;
    padding-left: 0.9rem;
    border-left: 3px solid var(--horizon-accent);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--horizon-purple-deep);
  }
  .how-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .how-legend {
    padding: 0;
    border: 1px solid var(--horizon-line);
    background: var(--horizon-lavender-soft);
  }
  .how-legend h2 {
    margin: 0;
    font: 600 1.6rem/1.15 Newsreader, Georgia, serif;
    color: var(--horizon-purple);
  }
  .how-legend__list {
    display: grid;
    gap: 1rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .how-legend__list li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .how-legend__list svg {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    color: var(--horizon-purple);
  }
  .how-legend__list strong {
    display: block;
    font-size: 0.94rem;
    color: var(--horizon-purple-deep);
  }
  .how-legend__list span {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--horizon-muted);
  }

  /* Section nav */
  .how-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.5rem;
    padding: 0.35rem 0;
    border-top: 1px solid var(--horizon-line);
    border-bottom: 1px solid var(--horizon-line);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .how-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 0;
    color: var(--horizon-purple);
    text-decoration: none;
  }
  .how-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .how-nav a:focus-visible {
    outline: 3px solid var(--horizon-focus);
    outline-offset: 3px;
    border-radius: 0.2rem;
  }

  /* Shared section rhythm */
  .how-section {
    padding-top: clamp(2.8rem, 5vw, 4.5rem);
    scroll-margin-top: 1.5rem;
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(16rem, 0.95fr);
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .section-head h2,
  .details-intro h2,
  .how-close h2 {
    margin: 0;
    font: 600 clamp(1.9rem, 3.4vw, 2.8rem)/1.08 Newsreader, Georgia, serif;
    letter-spacing: -0.03em;
    color: var(--horizon-purple);
  }
  .section-head__note {
    max-width: 52ch;
    margin: 0 0 0.3rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--horizon-muted);
  }

  /* Four stages */
  .stage-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--horizon-line);
  }
  .stage {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--horizon-line);
  }
  .stage__number {
    font: 600 2.2rem/1 Newsreader, Georgia, serif;
    color: #8e77c4;
    font-variant-numeric: tabular-nums;
  }
  .stage__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
  }
  .stage__head h3 {
    margin: 0;
    font: 700 1.3rem/1.2 Outfit, sans-serif;
    color: var(--horizon-purple-deep);
  }
  .stage__body {
    min-width: 0;
  }
  .stage__body p {
    max-width: 72ch;
    margin: 0.45rem 0 0.55rem;
    line-height: 1.6;
    color: var(--horizon-muted);
  }

  /* After the vote */
  .after-vote {
    margin-top: 1.5rem;
    padding: 0;
    border: 1px solid var(--horizon-line);
    background: var(--horizon-lavender-soft);
  }
  .after-vote__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .after-vote__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .after-vote__eyebrow > span {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--horizon-muted);
  }
  .after-vote h3 {
    max-width: 24ch;
    margin: 0;
    font: 600 clamp(1.5rem, 2.6vw, 2rem)/1.15 Newsreader, Georgia, serif;
    color: var(--horizon-purple);
  }
  .after-vote__copy > p {
    max-width: 58ch;
    margin: 0.75rem 0 1.15rem;
    line-height: 1.6;
    color: var(--horizon-muted);
  }
  .after-vote__steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--horizon-line);
  }
  .after-vote__steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--horizon-line);
  }
  .after-vote__steps li > span {
    font: 700 0.8rem/1.4 Outfit, sans-serif;
    color: var(--horizon-purple);
    font-variant-numeric: tabular-nums;
  }
  .after-vote__steps strong {
    display: block;
    font-size: 0.96rem;
    color: var(--horizon-purple-deep);
  }
  .after-vote__steps p {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--horizon-muted);
  }

  /* Task pathways */
  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .pathway {
    padding: 0;
    border: 1px solid var(--horizon-line);
    background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .pathway:hover {
    border-color: #9b8ad0;
    box-shadow: 0 8px 22px #20104a10;
  }
  .pathway__inner {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
    height: 100%;
    padding: 1.4rem;
  }
  .pathway__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pathway__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.5rem;
    background: var(--horizon-lavender);
    color: var(--horizon-purple);
  }
  .pathway__icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .pathway h3 {
    margin: 0;
    font: 700 1.15rem/1.25 Outfit, sans-serif;
    color: var(--horizon-purple-deep);
  }
  .pathway__inner > p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--horizon-muted);
  }
  .pathway__live,
  .pathway__empty {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid var(--horizon-line);
    font-size: 0.86rem;
  }
  .pathway__live {
    display: grid;
    gap: 0.2rem;
    color: var(--horizon-muted);
  }
  .pathway__live > span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--horizon-purple);
  }
  .pathway__live a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--horizon-purple-deep);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }
  .pathway__live a:hover {
    text-decoration-thickness: 2px;
  }
  .pathway__live a:focus-visible {
