---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import {
  ArrowRight,
  BookOpen,
  CheckCircle2,
  Clock,
  Code2,
  Compass,
  Database,
  FileText,
  Gavel,
  GitBranch,
  HardDrive,
  Layers,
  Lock,
  MessageSquare,
  Plus,
  Server,
  ShieldCheck,
  Vote,
} from 'lucide-react';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals } from '../../lib/store.ts';
import { getSiteConfig } from '../../lib/site-config.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);
const siteConfig = await getSiteConfig(db, env);

const [recentProposals, publishedPolicies] = await Promise.all([
  listProposals(db, { user }),
  db
    .collection('policy_registry')
    .find({ publicationStatus: 'published' })
    .sort({ publishedAt: -1, ratifiedAt: -1 })
    .limit(1)
    .toArray(),
]);
const openVotes = recentProposals.filter((p) => p.stage === 'decide');
const discussions = recentProposals.filter((p) => p.stage === 'deliberate');

const primaryCtaLabel = siteConfig.primaryCtaLabel || 'Suggest an idea';
const primaryCtaHref = siteConfig.primaryCtaHref || '/proposals/new/';

const walkthroughSteps = [
  {
    step: '01',
    stage: '1. Propose',
    duration: '15 sec',
    who: 'Verified members submit · Anyone can read',
    title: 'An idea is placed on the public record',
    body: 'A member submits a clear title, summary, topic space, key commitments, and supporting rationale or images. Engage saves an immutable starting wording revision.',
    href: '/proposals/?stage=propose',
    linkLabel: 'Browse new ideas',
  },
  {
    step: '02',
    stage: '2. Deliberate',
    duration: '15 sec',
    who: 'Verified members contribute · Publicly readable',
    title: 'Members debate and file wording amendments',
    body: 'Members post structured stances (Support, Concern, Wording suggestion, or Comment), endorse constructive feedback, or file formal amendments against a specific base revision.',
    href: '/proposals/?stage=deliberate',
    linkLabel: `Join ${discussions.length} active discussions`,
  },
  {
    step: '03',
    stage: '3. Decide',
    duration: '15 sec',
    who: 'Eligible verified members vote',
    title: 'A ballot opens on a frozen wording snapshot',
    body: 'When a ballot opens, it is cryptographically bound to a specific wording revision ID. Later edits cannot alter what voters saw. Proposal ballots and amendment ballots are decided separately.',
    href: '/proposals/?stage=decide',
    linkLabel: `See ${openVotes.length} open ballots`,
  },
  {
    step: '04',
    stage: '4. Implement & Ratify',
    duration: '15 sec',
    who: 'Authorised party governance · Public registry',
    title: 'Formal ratification and authorised policy publication',
    body: 'A successful member ballot does not automatically publish policy. An authorised party body records formal ratification, and a national administrator authorises publication into the Policy Registry.',
    href: '/policies/',
    linkLabel: 'Open Policy Registry',
  },
];

const publicAccessItems = [
  {
    title: 'Proposal register & full wording',
    detail: `Browse all ${recentProposals.length} public proposals across every stage, including summaries, commitments, and rationales.`,
    href: '/proposals/',
  },
  {
    title: 'Deliberation threads & stances',
    detail: 'Read member support, implementation concerns, and informal wording suggestions on public proposals.',
    href: '/proposals/?stage=deliberate',
  },
  {
    title: 'Immutable wording revisions & diffs',
    detail: 'Inspect every saved wording snapshot, SHA-256 content hash, and side-by-side formal amendment comparison.',
    href: '/proposals/',
  },
  {
    title: 'Aggregate ballot tallies & outcomes',
    detail: 'See approve, abstain, and reject totals plus recorded returning-officer outcomes (individual member ballot choices are never public).',
    href: '/proposals/?stage=decide',
  },
  {
    title: 'Official Policy Registry & Branch directory',
    detail: 'Examine formally ratified and published party policies, provenance lineage, and recognised branches.',
    href: '/policies/',
  },
  {
    title: 'Public JSON API v1 & OpenAPI 3.1 schema',
    detail: 'Machine-readable endpoints for policies, versions, categories, and branches.',
    href: '/api/v1/policies',
  },
];

const memberAccessItems = [
  {
    title: 'Suggest a new policy idea or resolution',
    detail: 'Submit a new proposal into Stage 1 (Propose) with commitments, rationale, and supporting attachments.',
  },
  {
    title: 'Post deliberation stances & endorse feedback',
    detail: 'Contribute Support, Concern, Wording suggestions, or Comments, and endorse helpful member contributions.',
  },
  {
    title: 'Propose formal wording amendments',
    detail: 'Submit a structured replacement diff against the current proposal revision during Propose or Deliberate.',
  },
  {
    title: 'Vote in eligible party-wide & branch ballots',
    detail: 'Cast or update your Approve, Abstain, or Reject ballot when verified and eligible for the ballot’s jurisdiction.',
  },
  {
    title: 'My Engage personal governance dashboard',
    detail: 'Track your outstanding ballots, catch-up digest since your last visit, and personal voting & contribution log.',
  },
];

const underDevelopmentItems = [
  {
    status: 'Under development',
    title: 'Independent seconder workflow for formal motions',
    detail: 'Under the upcoming governance lifecycle, formal policy proposals, substantive amendments, and repeal motions will require one independent eligible seconder before advancing (authors cannot second their own motion).',
  },
  {
    status: siteConfig.publicPulsePollEnabled ? 'Enabled (30-day evaluation)' : 'Planned after member review',
    title: 'Public pulse poll vs. binding member ballot',
    detail: 'Following the initial member review period, Engage will trial a non-binding public Agree/Disagree pulse indicator alongside the binding verified-member ballot so the party can compare general public sentiment with formal member decisions.',
  },
  {
    status: 'Intentional release state',
    title: 'Official Policy Registry population',
    detail: publishedPolicies.length > 0
      ? `${publishedPolicies.length} ratified policy record(s) published in the registry.`
      : 'Engage’s Policy Registry holds only wording formally ratified and authorised for publication inside Engage. Existing party policies remain on fusionparty.org.au until formally migrated.',
  },
  {
    status: 'Roadmap',
    title: 'Scheduled ballot windows & privacy-preserving traffic analytics',
    detail: 'Automated opening/closing timestamps for ballots and aggregate, cookie-free page traffic reporting for governance organisers.',
  },
];

const sourceMaterialLinks = [
  {
    label: 'Live Proposal Register & Provenance Records',
    description: 'Every seeded proposal cites its prior policy predecessor, constitutional authority, or working-group lineage.',
    href: '/proposals/',
    cta: 'Inspect proposals →',
  },
  {
    label: 'Public Governance API v1 (/api/v1/policies)',
    description: 'Read-only JSON feed of published policies, version histories, and branch records with canonical Link headers.',
    href: '/api/v1/policies',
    cta: 'Open JSON endpoint →',
  },
  {
    label: 'OpenAPI 3.1 Specification (/api/v1/openapi.json)',
    description: 'Complete machine-readable contract for external verifiers, researchers, and civic tech integrations.',
    href: '/api/v1/openapi.json',
    cta: 'View OpenAPI spec →',
  },
  {
    label: 'Engage Source Repository & Architecture Docs',
    description: 'Container definitions, database schemas, deterministic ballot migration scripts, and governance ADRs.',
    href: siteConfig.repoUrl || 'https://github.com/Fusion-Party-Aus/Engage',
    cta: 'Examine source repository ↗',
    external: true,
  },
];

const governanceRules = [
  {
    title: 'Wording suggestions vs. formal amendments vs. amendment ballots',
    body: 'A wording suggestion is an informal comment posted during deliberation and needs no seconder. A formal amendment is a structured diff recorded against a specific base revision ID. An amendment ballot is a separate vote on whether to endorse that amendment revision; it does not cast your vote on the main proposal.',
  },
  {
    title: 'Ballot wording is frozen to an immutable revision',
    body: 'When a ballot enters Stage 3 (Decide), it is bound to a single immutable wording revision (`ballotRevisionId`). Substantive text is locked once voting begins or votes are cast. Earlier revisions remain visible in the revision log so anyone can audit what changed.',
  },
  {
    title: 'A successful ballot is not automatic policy adoption',
    body: 'Engage separates member voting from constitutional ratification and publication. After a successful ballot is recorded by the returning officer, the wording moves to Stage 4 (Implement) and only appears in the Policy Registry after formal ratification and administrator publication.',
  },
  {
    title: 'Branch jurisdiction and electorate eligibility',
    body: 'Every proposal records its originating branch, governance authority, and jurisdiction separately. Branch-scoped ballots check active membership in that recognised branch electorate; party-wide ballots are open to all verified Fusion members.',
  },
];
---
<SiteLayout
  title="How Engage works · 60-Second Guide & Governance Reference"
  description="A 60-second factual walkthrough of Engage, backed by a one-page explanation of what is publicly accessible, what requires membership, what remains under development, source material links, and Docker backup & handover continuity."
  canonical="/how-it-works/"
>
  <div class="page-wrap section-space how-workspace">
    <!-- Top Hero Header -->
    <header class="how-header">
      <div class="how-header__main">
        <div class="how-header__badges">
          <Badge variant="info">60-Second Walkthrough</Badge>
          <Badge variant="outline">One-Page Governance &amp; Operations Reference</Badge>
        </div>
        <h1>How Engage works.</h1>
        <p class="how-header__lead">
          Engage is Fusion Party Australia’s participatory governance platform. Ideas are proposed by members, refined through transparent deliberation and formal amendments, voted on against frozen wording revisions, and ratified into official policy.
        </p>
        <div class="how-header__actions">
          <Button href={primaryCtaHref}>
            <Plus className="size-4" aria-hidden="true" />
            {primaryCtaLabel}
          </Button>
          <Button href="/proposals/" variant="outline">
            Browse {recentProposals.length} proposals
          </Button>
          <Button href="/policies/" variant="ghost">
            Policy registry →
          </Button>
        </div>
      </div>

      <aside class="how-summary-box" aria-label="At a glance">
        <h2>In 3 sentences</h2>
        <ol>
          <li><strong>Anyone</strong> can read public proposals, deliberation threads, revision histories, ballot tallies, and the JSON API without an account.</li>
          <li><strong>Verified members</strong> can suggest ideas, post deliberation stances, file formal amendments, and vote in ballots they qualify for.</li>
          <li><strong>No vote auto-publishes policy:</strong> every ballot is bound to an immutable wording revision and requires formal ratification before entering the Policy Registry.</li>
        </ol>
      </aside>
    </header>

    <!-- Sticky Jump Bar -->
    <nav class="how-jump-nav" aria-label="On this page">
      <a href="#walkthrough">1. 60-Second Walkthrough</a>
      <a href="#access-matrix">2. Public vs. Member Access</a>
      <a href="#roadmap">3. Under Development</a>
      <a href="#source-material">4. Source Material &amp; API</a>
      <a href="#operations">5. Backup &amp; Handover Strategy</a>
      <a href="#rules">6. Exact Governance Rules</a>
    </nav>

    <!-- SECTION 1: 60-Second Factual Walkthrough -->
    <section id="walkthrough" class="how-section" aria-labelledby="walkthrough-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><Clock className="size-3.5" aria-hidden="true" /> Part 1 · 60-Second Factual Walkthrough</span>
          <h2 id="walkthrough-heading">Four stages, one auditable record.</h2>
        </div>
        <p class="section-bar__note">
          Every proposal moves through the same four stages. Wording snapshots and decision events are preserved at each step.
        </p>
      </div>

      <div class="walkthrough-grid">
        {walkthroughSteps.map((item) => (
          <article class="walkthrough-card">
            <div class="walkthrough-card__top">
              <span class="walkthrough-step tabular">{item.step}</span>
              <Badge variant="outline">{item.stage}</Badge>
              <span class="walkthrough-time tabular">{item.duration}</span>
            </div>
            <h3>{item.title}</h3>
            <p class="walkthrough-who">{item.who}</p>
            <p class="walkthrough-body">{item.body}</p>
            <a href={item.href} class="walkthrough-link">
              {item.linkLabel} <ArrowRight className="size-3.5" aria-hidden="true" />
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 2: One-Page Breakdown: Publicly Accessible vs. Requires Membership -->
    <section id="access-matrix" class="how-section" aria-labelledby="access-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><ShieldCheck className="size-3.5" aria-hidden="true" /> Part 2 · Access &amp; Permissions Matrix</span>
          <h2 id="access-heading">What is publicly accessible vs. what requires membership.</h2>
        </div>
        <p class="section-bar__note">
          Engage defaults to public transparency for governance records while restricting participation and voting to verified Fusion members.
        </p>
      </div>

      <div class="matrix-two-col">
        <div class="matrix-panel">
          <div class="matrix-panel__head">
            <div class="matrix-panel__title">
              <Compass className="size-5 text-primary" aria-hidden="true" />
              <h3>Publicly accessible (No account required)</h3>
            </div>
            <Badge variant="success">Open to everyone</Badge>
          </div>
          <ul class="matrix-list">
            {publicAccessItems.map((item) => (
              <li>
                <CheckCircle2 className="size-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
                <div>
                  <strong><a href={item.href}>{item.title}</a></strong>
                  <p>{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="matrix-panel is-member">
          <div class="matrix-panel__head">
            <div class="matrix-panel__title">
              <Vote className="size-5 text-primary" aria-hidden="true" />
              <h3>Requires verified Fusion membership</h3>
            </div>
            <Badge variant="info">Verified members</Badge>
          </div>
          <ul class="matrix-list">
            {memberAccessItems.map((item) => (
              <li>
                <Lock className="size-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
                <div>
                  <strong>{item.title}</strong>
                  <p>{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
          <div class="matrix-panel__footer">
            <Button href={user ? '/member/' : '/member/'} size="sm">
              {user ? 'Open My Engage' : 'Sign in or verify membership'}
            </Button>
            <Button href={primaryCtaHref} variant="outline" size="sm">
              {primaryCtaLabel}
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3 & 4: What Remains Under Development + Where to Examine Source Material -->
    <div class="how-split-sections">
      <section id="roadmap" class="how-section" aria-labelledby="roadmap-heading">
        <div class="section-bar is-compact">
          <div>
            <span class="section-kicker"><Layers className="size-3.5" aria-hidden="true" /> Part 3 · Roadmap &amp; Scope</span>
            <h2 id="roadmap-heading">What remains under development.</h2>
          </div>
        </div>

        <div class="roadmap-list">
          {underDevelopmentItems.map((item) => (
            <article class="roadmap-item">
              <div class="roadmap-item__head">
                <strong>{item.title}</strong>
                <Badge variant="warning">{item.status}</Badge>
              </div>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="source-material" class="how-section" aria-labelledby="source-heading">
        <div class="section-bar is-compact">
          <div>
            <span class="section-kicker"><Code2 className="size-3.5" aria-hidden="true" /> Part 4 · Verifiable Source Material</span>
            <h2 id="source-heading">Where to examine the source material.</h2>
          </div>
        </div>

        <div class="source-list">
          {sourceMaterialLinks.map((item) => (
            <article class="source-card">
              <div>
                <h3>
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.label}
                  </a>
                </h3>
                <p>{item.description}</p>
              </div>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="source-card__cta"
              >
                {item.cta}
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>

    <!-- SECTION 5: Backup, Containerisation & Handover Strategy -->
    <section id="operations" class="how-section" aria-labelledby="operations-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><Server className="size-3.5" aria-hidden="true" /> Part 5 · Operational Continuity, Backups &amp; Handover</span>
          <h2 id="operations-heading">How Engage is backed up and handed over if a maintainer leaves.</h2>
        </div>
        <p class="section-bar__note">
          Engage is engineered with zero proprietary lock-in so any party system administrator can back up, restore, or transfer the platform in minutes.
        </p>
      </div>

      <div class="ops-grid">
        <article class="ops-card">
          <div class="ops-card__head">
            <HardDrive className="size-5 text-primary" aria-hidden="true" />
            <h3>1. Self-contained Docker architecture</h3>
          </div>
          <p>{siteConfig.backupSummary}</p>
          <ul class="ops-checklist">
            <li><strong>Application container:</strong> Stateless Astro standalone Node server built from the root <code>Dockerfile</code>.</li>
            <li><strong>Database container:</strong> Single-node MongoDB 8.0 replica set (required for multi-document ACID vote transactions) persisted in the <code>mongo_data</code> volume.</li>
            <li><strong>No external lock-in:</strong> Runs on any Linux host, VPS, NUC, or Coolify instance with Docker Compose.</li>
          </ul>
        </article>

        <article class="ops-card">
          <div class="ops-card__head">
            <Database className="size-5 text-primary" aria-hidden="true" />
            <h3>2. Automated backup &amp; restore drill</h3>
          </div>
          <p>
            Logical database backups use <code>mongodump --archive --gzip</code> and can be verified into an isolated restore-drill database without touching production records:
          </p>
          <pre class="ops-code"><code># 1. Create compressed backup archive + SHA-256 checksum
mongodump --uri="$MONGODB_URI" --db=engage_production \
  --archive=/backups/engage-$(date +%F).archive.gz --gzip

# 2. Verify restore into an isolated drill database
scripts/restore-preview.sh /backups/engage-YYYY-MM-DD.archive.gz</code></pre>
        </article>

        <article class="ops-card">
          <div class="ops-card__head">
            <GitBranch className="size-5 text-primary" aria-hidden="true" />
            <h3>3. Maintainer handover checklist</h3>
          </div>
          <p>{siteConfig.handoverSummary}</p>
          <ol class="ops-steps">
            <li><strong>Repository &amp; docs:</strong> Clone <code>Fusion-Party-Aus/Engage</code>; review <code>docs/operations.md</code> and <code>docs/engage-release-handover-2026-11-08.md</code>.</li>
            <li><strong>Environment secrets:</strong> Transfer the <code>.env</code> secrets (<code>MONGODB_URI</code>, <code>SESSION_SECRET</code>, <code>BETTER_AUTH_SECRET</code>, OAuth/Resend keys) via the party’s password manager.</li>
            <li><strong>Admin role delegation:</strong> Grant the incoming maintainer’s verified account the <code>administrator</code> role in <a href="/admin/members/">/admin/members/</a> and update platform settings in <a href="/admin/settings/">/admin/settings/</a>.</li>
          </ol>
        </article>
      </div>
    </section>

    <!-- SECTION 6: Detailed Governance Rules -->
    <section id="rules" class="how-section" aria-labelledby="rules-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><Gavel className="size-3.5" aria-hidden="true" /> Part 6 · Governance Safeguards</span>
          <h2 id="rules-heading">When you need the exact rule.</h2>
        </div>
        <p class="section-bar__note">
          These safeguards keep proposal wording, member ballots, and the official policy registry distinct and auditable.
        </p>
      </div>

      <div class="rules-accordion">
        {governanceRules.map((rule, idx) => (
          <details class="rule-item" open={idx === 0}>
            <summary>
              <span>{rule.title}</span>
              <span class="rule-item__mark" aria-hidden="true">+</span>
            </summary>
            <div class="rule-item__body">
              <p>{rule.body}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .how-workspace {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .how-header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    gap: 2rem;
    align-items: start;
  }

  .how-header__main {
    display: grid;
    gap: 0.9rem;
  }

  .how-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .how-header h1 {
    margin: 0;
    font: 600 clamp(2.4rem, 4.5vw, 3.6rem)/1.04 Newsreader, Georgia, serif;
    letter-spacing: -0.03em;
    color: var(--horizon-ink);
  }

  .how-header__lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--horizon-muted);
    max-width: 64ch;
  }

  .how-header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .how-summary-box {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    background: var(--horizon-lavender-soft);
    display: grid;
    gap: 0.65rem;
  }

  .how-summary-box h2 {
    margin: 0;
    font: 700 1rem/1.2 Outfit, sans-serif;
    color: var(--horizon-purple-deep);
  }

  .how-summary-box ol {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--horizon-muted);
  }

  .how-summary-box strong {
    color: var(--horizon-ink);
  }

  /* Sticky Jump Nav */
  .how-jump-nav {
    position: sticky;
    top: 4.25rem;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--horizon-line);
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .how-jump-nav a {
    color: var(--horizon-purple-deep);
    text-decoration: none;
    padding: 0.2rem 0;
    white-space: nowrap;
  }

  .how-jump-nav a:hover {
    color: var(--horizon-purple);
    text-decoration: underline;
  }

  .how-section {
    display: grid;
    gap: 1.15rem;
    scroll-margin-top: 8.5rem;
  }

  .section-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--horizon-line);
  }

  .section-bar.is-compact {
    margin-bottom: 0.1rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--horizon-purple);
    margin-bottom: 0.25rem;
  }

  .section-bar h2 {
    margin: 0;
    font: 600 clamp(1.55rem, 2.6vw, 2.1rem)/1.12 Newsreader, Georgia, serif;
    color: var(--horizon-ink);
  }

  .section-bar__note {
    margin: 0;
    max-width: 50ch;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--horizon-muted);
  }

  /* 4-Stage Walkthrough Cards */
  .walkthrough-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
