---
import CommunityImage from '../../components/site/CommunityImage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import {
  ArrowRight,
  CheckCircle2,
  Clock,
  Code2,
  Compass,
  Database,
  Gavel,
  GitBranch,
  HardDrive,
  Layers,
  Lock,
  Plus,
  Server,
  ShieldCheck,
  Vote,
} from 'lucide-react';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals } from '../../lib/proposals-store.ts';
import { getSiteConfig } from '../../lib/site-config.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);
const siteConfig = await getSiteConfig(db, env);

const [recentProposals, publishedPolicies] = await Promise.all([
  listProposals(db, { user }),
  db
    .collection('policy_registry')
    .find({ publicationStatus: 'published' })
    .sort({ publishedAt: -1, ratifiedAt: -1 })
    .limit(1)
    .toArray(),
]);
const openVotes = recentProposals.filter((p) => p.stage === 'decide');
const discussions = recentProposals.filter((p) => p.stage === 'deliberate');

const primaryCtaLabel = siteConfig.primaryCtaLabel || 'Suggest an idea';
const primaryCtaHref = siteConfig.primaryCtaHref || '/proposals/new/';

const walkthroughSteps = [
  {
    step: '01', stage: '1. Propose', duration: 'Start here',
    who: 'Verified members', title: 'What would you like to change?',
    body: 'Put forward an idea, explain why it matters and set out what you want Fusion to do. Another verified member must second your proposal before it moves into deliberation.',
    href: '/proposals/?stage=propose', linkLabel: 'Browse new ideas',
  },
  {
    step: '02', stage: '2. Deliberate', duration: 'Usually 30 days',
    who: 'Members discuss', title: 'Work through the idea together',
    body: 'Ask questions, raise concerns and suggest improvements. For a specific change to the text, submit a formal amendment so members can consider the wording separately.',
    href: '/proposals/?stage=deliberate', linkLabel: `See ${discussions.length} discussions`,
  },
  {
    step: '03', stage: '3. Decide', duration: 'Usually 30 days',
    who: 'Eligible members vote', title: 'Have your say on the wording',
    body: 'Read the ballot text before voting. That wording stays fixed for the ballot, and you can change your vote until it closes. An amendment ballot is separate from the vote on the main proposal.',
    href: '/proposals/?stage=decide', linkLabel: `See ${openVotes.length} proposals at Decide`,
  },
  {
    step: '04', stage: '4. Implement', duration: 'After the decision',
    who: 'Officers record the outcome', title: 'Put the decision into practice',
    body: 'Members decide the policy. Officers certify the process, record the adopted wording and publish it in the policy registry. Certification checks the process; it does not give officers a veto over members’ policy choices.',
    href: '/policies/', linkLabel: 'Read adopted policy',
  },
];

const publicAccessItems = [
  { title: 'Ideas and proposals', detail: 'Read public proposals, the changes they call for and the reasons behind them.', href: '/proposals/' },
  { title: 'Discussion', detail: 'Read what members support, the concerns they raise and the changes they suggest on public proposals.', href: '/proposals/?stage=deliberate' },
  { title: 'Changes to the wording', detail: 'Follow saved revisions and compare formal amendments on public proposal pages.', href: '/proposals/' },
  { title: 'Ballot totals and outcomes', detail: 'See Approve, Abstain and Reject totals and recorded outcomes. Individual members’ votes are not public.', href: '/proposals/?stage=decide' },
  { title: 'Adopted policy', detail: 'Read published policies and the recorded basis for their adoption.', href: '/policies/' },
  { title: 'Policy data', detail: 'Use the public API to read published policies, versions, categories and branches.', href: '/api/v1/policies' },
];

const memberAccessItems = [
  { title: 'Put forward an idea', detail: 'Explain what you want to change and why. You can also second another member’s proposal to start deliberation.' },
  { title: 'Join the discussion', detail: 'Ask a question, share evidence, raise a concern or endorse a useful contribution.' },
  { title: 'Propose an amendment', detail: 'Suggest exact replacement wording while the proposal is in Propose or Deliberate.' },
  { title: 'Vote on a decision', detail: 'Vote in national ballots and branch ballots you are eligible for. You can change your vote while the ballot is open.' },
  { title: 'Follow your contributions', detail: 'Use My Engage to find relevant ballots and revisit your votes, ideas and comments.' },
];

const underDevelopmentItems = [
  { status: 'In use', title: 'Seconding and deadlines', detail: 'Seconding starts the usual 30-day deliberation period, followed by a 30-day ballot. Scheduled transitions still depend on the lifecycle job running. Check each proposal for its actual dates, including any extended first-round timetable.' },
  { status: 'Still being developed', title: 'Handling successful amendments', detail: 'Successful member decisions are intended to take effect without a separate executive approval. Automatic ratification and the rules for resolving competing amendments are not yet complete.' },
  { status: 'Not available yet', title: 'Public pulse poll', detail: 'An informal public poll is planned but is not available yet. It would be separate from the formal member ballot.' },
  { status: 'Policy record', title: 'What the registry includes', detail: publishedPolicies.length > 0 ? 'The registry contains published policy. Each record explains the basis for its adoption, including authorised branch imports where applicable.' : 'No policy has been published in this registry yet. Proposals are not adopted policy. Existing national policies have not been imported here.' },
];

const sourceMaterialLinks = [
  { label: 'Proposals and their history', description: 'Read the reasons, references and saved wording supplied for each proposal. A reference to an earlier policy does not establish how that policy was adopted.', href: '/proposals/', cta: 'Browse proposals →' },
  { label: 'Published policy data', description: 'A read-only feed for anyone using published Fusion policy in another website or research project.', href: '/api/v1/policies', cta: 'Open policy data →' },
  { label: 'API reference', description: 'Technical documentation for developers using the public policy API.', href: '/api/v1/openapi.json', cta: 'Read the API specification →' },
  { label: 'Source code and documentation', description: 'See how Engage works, review its documented limitations or contribute an improvement.', href: siteConfig.repoUrl || 'https://github.com/Fusion-Party-Aus/Engage', cta: 'Visit the repository ↗', external: true },
];

const governanceRules = [
  { title: 'Suggestions, amendments and votes', body: 'A comment can suggest a change without creating a formal amendment. A formal amendment proposes exact changes to a saved version of the text. Voting on an amendment does not cast your vote on the main proposal, and a successful amendment cannot turn a failed main proposal into adopted policy.' },
  { title: 'The wording you vote on', body: 'Each ballot refers to one saved version of the proposal. Later edits cannot change what your vote means. Earlier wording remains available in the proposal’s revision history.' },
  { title: 'How the result becomes published policy', body: 'Members decide the policy; officers certify that the process and result are valid. Ratification records the adopted wording, including successful amendments, and publication puts it in the registry. These are separate steps. Automatic ratification is not yet complete, so a successful ballot may still await those recorded steps.' },
  { title: 'Who can vote', body: 'National ballots are open to verified Fusion members. Branch ballots require active membership of the branch concerned. Eligibility is checked when you vote. Following a branch or holding an administrative role does not by itself give you a vote in its ballots.' },
  { title: 'How many people need to vote', body: 'Engage needs at least 30 eligible registered members before its ballots can make decisions. Each ballot also needs enough people to take part. That number depends on how many eligible members have recently been active on Engage. You can vote for, vote against or abstain: all three count towards participation. If too few people take part, the proposal is neither approved nor rejected. The vote is inconclusive.' },
];
---
<SiteLayout
  title="How Engage works · Fusion Party Australia"
  description="How to suggest an idea, discuss policy and vote on Fusion’s decisions. Read about membership, amendments and how decisions become published policy."
  canonical="/how-it-works/"
>
  <div class="page-wrap section-space how-workspace">
    <!-- Top Hero Header -->
    <header class="how-header">
      <div class="how-header__main">
        <div class="how-header__badges">
          <Badge variant="info">Getting involved</Badge>
          <Badge variant="outline">From idea to decision</Badge>
        </div>
        <h1>Find your way into Engage.</h1>
        <p class="how-header__lead">
          Explore Fusion’s work, share a local priority or contribute to an open invitation. Verified members can develop proposals, join formal discussions and vote when eligible.
        </p>
        <div class="how-header__actions">
          <Button href={primaryCtaHref}>
            <Plus className="size-4" aria-hidden="true" />
            {primaryCtaLabel}
          </Button>
          <Button href="/proposals/" variant="outline">
            Browse {recentProposals.length} proposals
          </Button>
          <Button href="/policies/" variant="ghost">
            Policy registry →
          </Button>
        </div>
      </div>

      <aside class="how-summary-box" aria-label="At a glance">
        <CommunityImage sizes="(min-width: 900px) 30vw, 100vw" />
        <h2>At a glance</h2>
        <ol>
          <li><strong>Read along:</strong> public proposals, discussions and ballot totals are available without an account.</li>
          <li><strong>Take part:</strong> verified members can propose ideas, contribute to discussions and vote where eligible.</li>
          <li><strong>Follow the outcome:</strong> members decide policy, then officers record the adopted wording and publish it.</li>
        </ol>
      </aside>
    </header>

    <!-- Sticky Jump Bar -->
    <nav class="how-jump-nav" aria-label="On this page">
      <a href="#walkthrough">1. From idea to decision</a>
      <a href="#access-matrix">2. Reading and taking part</a>
      <a href="#roadmap">3. Current progress</a>
      <a href="#source-material">4. Sources and records</a>
      <a href="#operations">5. Keeping Engage running</a>
      <a href="#rules">6. Decision rules</a>
    </nav>

    <!-- SECTION 1: 60-Second Factual Walkthrough -->
    <section id="walkthrough" class="how-section" aria-labelledby="walkthrough-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><Clock className="size-3.5" aria-hidden="true" /> Part 1 · The process</span>
          <h2 id="walkthrough-heading">From an idea to a decision</h2>
        </div>
        <p class="section-bar__note">
          Policy proposals move through Propose, Deliberate, Decide and Implement. Some ideas are withdrawn or archived along the way.
        </p>
      </div>

      <div class="walkthrough-grid">
        {walkthroughSteps.map((item) => (
          <article class="walkthrough-card">
            <div class="walkthrough-card__top">
              <span class="walkthrough-step tabular">{item.step}</span>
              <Badge variant="outline">{item.stage}</Badge>
              <span class="walkthrough-time tabular">{item.duration}</span>
            </div>
            <h3>{item.title}</h3>
            <p class="walkthrough-who">{item.who}</p>
            <p class="walkthrough-body">{item.body}</p>
            <a href={item.href} class="walkthrough-link">
              {item.linkLabel} <ArrowRight className="size-3.5" aria-hidden="true" />
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 2: One-Page Breakdown: Publicly Accessible vs. Requires Membership -->
    <section id="access-matrix" class="how-section" aria-labelledby="access-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><ShieldCheck className="size-3.5" aria-hidden="true" /> Part 2 · Taking part</span>
          <h2 id="access-heading">Read along or join in</h2>
        </div>
        <p class="section-bar__note">
          You can read public discussions without signing in. To contribute or vote, sign in and have your Fusion membership verified.
        </p>
      </div>

      <div class="matrix-two-col">
        <div class="matrix-panel">
          <div class="matrix-panel__head">
            <div class="matrix-panel__title">
              <Compass className="size-5 text-primary" aria-hidden="true" />
              <h3>Read without an account</h3>
            </div>
            <Badge variant="success">Open to everyone</Badge>
          </div>
          <ul class="matrix-list">
            {publicAccessItems.map((item) => (
              <li>
                <CheckCircle2 className="size-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
                <div>
                  <strong><a href={item.href}>{item.title}</a></strong>
                  <p>{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="matrix-panel is-member">
          <div class="matrix-panel__head">
            <div class="matrix-panel__title">
              <Vote className="size-5 text-primary" aria-hidden="true" />
              <h3>Take part as a verified member</h3>
            </div>
            <Badge variant="info">Verified members</Badge>
          </div>
          <ul class="matrix-list">
            {memberAccessItems.map((item) => (
              <li>
                <Lock className="size-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
                <div>
                  <strong>{item.title}</strong>
                  <p>{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
          <div class="matrix-panel__footer">
            <Button href={user ? '/member/' : '/member/'} size="sm">
              {user ? 'Open My Engage' : 'Sign in or verify membership'}
            </Button>
            <Button href={primaryCtaHref} variant="outline" size="sm">
              {primaryCtaLabel}
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3 & 4: What Remains Under Development + Where to Examine Source Material -->
    <div class="how-split-sections">
      <section id="roadmap" class="how-section" aria-labelledby="roadmap-heading">
        <div class="section-bar is-compact">
          <div>
            <span class="section-kicker"><Layers className="size-3.5" aria-hidden="true" /> Part 3 · Current progress</span>
            <h2 id="roadmap-heading">What works now, and what’s still being built</h2>
          </div>
        </div>

        <div class="roadmap-list">
          {underDevelopmentItems.map((item) => (
            <article class="roadmap-item">
              <div class="roadmap-item__head">
                <strong>{item.title}</strong>
                <Badge variant="warning">{item.status}</Badge>
              </div>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="source-material" class="how-section" aria-labelledby="source-heading">
        <div class="section-bar is-compact">
          <div>
            <span class="section-kicker"><Code2 className="size-3.5" aria-hidden="true" /> Part 4 · Sources and records</span>
            <h2 id="source-heading">Follow the evidence</h2>
          </div>
        </div>

        <div class="source-list">
          {sourceMaterialLinks.map((item) => (
            <article class="source-card">
              <div>
                <h3>
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.label}
                  </a>
                </h3>
                <p>{item.description}</p>
              </div>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="source-card__cta"
              >
                {item.cta}
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>

    <!-- SECTION 5: Backup, Containerisation & Handover Strategy -->
    <section id="operations" class="how-section" aria-labelledby="operations-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><Server className="size-3.5" aria-hidden="true" /> Part 5 · Keeping Engage running</span>
          <h2 id="operations-heading">Looking after the party’s records</h2>
        </div>
        <p class="section-bar__note">
          Engage’s source code and operating instructions are available for future maintainers. Backups, access and recovery still need people to look after them.
        </p>
      </div>

      <div class="ops-grid">
        <article class="ops-card">
          <div class="ops-card__head">
            <HardDrive className="size-5 text-primary" aria-hidden="true" />
            <h3>Keep the records safe</h3>
          </div>
          <p>A working copy of Engage needs its database, uploaded files and security keys as well as the application code. Keeping the code alone is not a backup of members’ contributions or votes.</p>
        </article>
        <article class="ops-card">
          <div class="ops-card__head">
            <Database className="size-5 text-primary" aria-hidden="true" />
            <h3>Check that recovery works</h3>
          </div>
          <p>A backup needs a tested way to restore it. Maintainers must check recovery in an isolated environment and protect the keys needed to read encrypted ballots.</p>
        </article>
        <article class="ops-card">
          <div class="ops-card__head">
            <GitBranch className="size-5 text-primary" aria-hidden="true" />
            <h3>Support the next maintainer</h3>
          </div>
          <p>The repository contains deployment and handover instructions. Taking over also requires authorised access to hosting, backups and security keys; an Engage account alone is not enough.</p>
          <a href="https://github.com/Fusion-Party-Aus/Engage/blob/main/docs/architecture/build-deploy-operations.md">Read the operating guide →</a>
        </article>
      </div>
    </section>

    <!-- SECTION 6: Detailed Governance Rules -->
    <section id="rules" class="how-section" aria-labelledby="rules-heading">
      <div class="section-bar">
        <div>
          <span class="section-kicker"><Gavel className="size-3.5" aria-hidden="true" /> Part 6 · Decision rules</span>
          <h2 id="rules-heading">Before you vote</h2>
        </div>
        <p class="section-bar__note">
          Check the wording, who is eligible and the closing date on each ballot. Discussion and informal endorsements are separate from a formal vote.
        </p>
      </div>

      <div class="rules-accordion">
        {governanceRules.map((rule, idx) => (
          <details class="rule-item" open={idx === 0}>
            <summary>
              <span>{rule.title}</span>
              <span class="rule-item__mark" aria-hidden="true">+</span>
            </summary>
            <div class="rule-item__body">
              <p>{rule.body}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .how-workspace {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .how-header {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: linear-gradient(115deg, var(--horizon-lavender-soft), var(--horizon-white));
    border-radius: 1.5rem;
    border-top: 4px solid var(--horizon-accent);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    gap: 2rem;
    align-items: start;
  }

  .how-header__main {
    display: grid;
    gap: 0.9rem;
  }

  .how-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .how-header h1 {
    margin: 0;
    font: 600 clamp(2.4rem, 4.5vw, 3.6rem)/1.04 var(--font-outfit);
    letter-spacing: -0.03em;
    color: var(--horizon-ink);
  }

  .how-header__lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--horizon-muted);
    max-width: 64ch;
  }

  .how-header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .how-summary-box {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    background: var(--horizon-lavender-soft);
    display: grid;
    gap: 0.65rem;
  }

  .how-summary-box h2 {
    margin: 0;
    font: 700 1rem/1.2 var(--font-outfit);
    color: var(--horizon-purple-deep);
  }

  .how-summary-box ol {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--horizon-muted);
  }

  .how-summary-box strong {
    color: var(--horizon-ink);
  }

  /* Sticky Jump Nav */
  .how-jump-nav {
    position: sticky;
    top: 4.25rem;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--horizon-line);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--horizon-white) 95%, transparent);
    backdrop-filter: blur(10px);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .how-jump-nav a {
    color: var(--horizon-purple-deep);
    text-decoration: none;
    padding: 0.2rem 0;
    white-space: nowrap;
  }

  .how-jump-nav a:hover {
    color: var(--horizon-purple);
    text-decoration: underline;
  }

  .how-section {
    display: grid;
    gap: 1.15rem;
    scroll-margin-top: 8.5rem;
  }

  .section-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--horizon-line);
  }

  .section-bar.is-compact {
    margin-bottom: 0.1rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--horizon-purple);
    margin-bottom: 0.25rem;
  }

  .section-bar h2 {
    margin: 0;
    font: 600 clamp(1.55rem, 2.6vw, 2.1rem)/1.12 var(--font-outfit);
    color: var(--horizon-ink);
  }

  .section-bar__note {
    margin: 0;
    max-width: 50ch;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--horizon-muted);
  }

  /* 4-Stage Walkthrough Cards */
  .walkthrough-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    background: var(--horizon-white);
    overflow: hidden;
  }

  .walkthrough-card {
    padding: 1.15rem;
    border-right: 1px solid var(--horizon-line);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .walkthrough-card:last-child {
    border-right: 0;
  }

  .walkthrough-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .walkthrough-step {
    font: 600 1.4rem/1 var(--font-outfit);
    color: var(--horizon-purple);
  }

  .walkthrough-time {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--horizon-muted);
  }

  .walkthrough-card h3 {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--horizon-ink);
  }

  .walkthrough-who {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--horizon-purple-deep);
  }

  .walkthrough-body {
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.5;
    color: var(--horizon-muted);
    flex: 1;
  }

  .walkthrough-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--horizon-purple-deep);
    text-decoration: none;
  }

  .walkthrough-link:hover {
    text-decoration: underline;
  }

  /* Access Matrix */
  .matrix-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    background: var(--horizon-white);
    overflow: hidden;
  }

  .matrix-panel {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .matrix-panel + .matrix-panel {
    border-left: 1px solid var(--horizon-line);
  }

  .matrix-panel.is-member {
    background: var(--horizon-lavender-soft);
  }

  .matrix-panel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
