  }

  .next-action-bar.is-complete {
    border-color: rgba(20, 108, 67, 0.28);
    background: #f1fbf6;
  }

  .next-action-bar__copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1 1 24rem;
  }

  .next-action-bar__kicker {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--horizon-purple);
    letter-spacing: 0.01em;
  }

  .next-action-bar.is-complete .next-action-bar__kicker {
    color: var(--horizon-success-ink);
  }

  .next-action-bar__title {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.4;
    color: var(--horizon-purple-deep);
  }

  .next-action-bar__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .next-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.15rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.12s ease, background 0.15s ease;
  }

  .next-action-btn.is-primary {
    background: var(--horizon-purple);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(38, 11, 89, 0.18);
  }

  .next-action-btn.is-primary:hover {
    background: var(--horizon-purple-deep);
  }

  .next-action-btn.is-secondary {
    background: #ffffff;
    color: var(--horizon-purple-deep);
    border: 1px solid var(--horizon-line-strong);
  }

  .next-action-btn.is-secondary:hover {
    background: #faf9fd;
    border-color: var(--horizon-purple);
  }

  /* 4-Step Workflow Banner */
  .workflow-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.5rem;
    background: #f8f6fc;
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.15rem;
  }

  .workflow-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workflow-step {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--horizon-muted);
  }

  .workflow-step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(38, 11, 89, 0.08);
    color: var(--horizon-muted);
  }

  .workflow-step.is-past {
    color: var(--horizon-purple);
  }

  .workflow-step.is-past .workflow-step__num {
    background: var(--horizon-success-bg);
    color: var(--horizon-success-ink);
  }

  .workflow-step.is-current {
    background: var(--horizon-purple);
    color: #ffffff;
    font-weight: 600;
  }

  .workflow-step.is-current .workflow-step__num {
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }

  .workflow-caption {
    margin: 0;
    font-size: 0.86rem;
    color: var(--horizon-muted);
    line-height: 1.45;
  }

  /* Scannable Governance Facts Strip */
  .governance-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--horizon-line);
  }

  .governance-fact {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    min-width: 0;
  }

  .governance-fact dt {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--horizon-muted);
  }

  .governance-fact dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.92rem;
    color: var(--horizon-purple-deep);
  }

  .governance-fact dd > strong {
    font-weight: 650;
    line-height: 1.35;
  }

  .governance-fact dd:first-of-type {
    flex-direction: row;
    align-items: center;
    gap: 0.45rem;
  }

  .fact-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 999px;
    background: #ede8f8;
    color: var(--horizon-purple);
    font-size: 0.72rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .fact-sub {
    font-size: 0.8rem;
    color: var(--horizon-muted);
  }

  .fact-link {
    font-weight: 650;
    color: var(--horizon-purple);
    text-decoration: none;
  }

  .fact-link:hover {
    text-decoration: underline;
  }

  /* Sticky Section Jump Navigation */
  .reading-nav {
    position: sticky;
    top: 3.75rem;
    z-index: 15;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    margin-bottom: 1.5rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    overflow-x: auto;
  }

  .reading-nav__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .reading-nav__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--horizon-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .reading-nav__links a:hover {
    color: var(--horizon-purple-deep);
    background: #f5f2fc;
  }

  .reading-nav__links a[aria-current="location"] {
    color: var(--horizon-purple-deep);
    background: #efeaf9;
  }

  .nav-count {
    font-size: 0.76rem;
    padding: 0.08rem 0.42rem;
    border-radius: 999px;
    background: rgba(38, 11, 89, 0.08);
    color: var(--horizon-purple);
  }

  .reading-nav__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.9rem;
    border-radius: 0.55rem;
    background: var(--horizon-purple);
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .reading-nav__cta:hover {
    background: var(--horizon-purple-deep);
  }

  /* Two-Column Workspace */
  .proposal-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 23rem;
    gap: 1.75rem;
    align-items: start;
  }

  .proposal-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Document Cards & Sections */
  .doc-card,
  .doc-section {
    background: #ffffff;
    border: 1px solid var(--horizon-line);
    border-radius: 1rem;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .doc-section__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--horizon-line);
  }

  .doc-title-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .doc-section__header h2 {
    margin: 0;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    font-weight: 650;
    color: var(--horizon-purple-deep);
  }

  .doc-section__sub {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--horizon-muted);
    line-height: 1.5;
  }

  .doc-count {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #f4f1fb;
    color: var(--horizon-purple);
    font-size: 0.8rem;
    font-weight: 650;
  }

  /* Attachment Card */
  .attachment-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #fcfbfe;
  }

  .attachment-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 16rem;
    padding: 1rem;
    background: #ffffff;
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .attachment-preview img {
    max-height: 14rem;
    width: auto;
    object-fit: contain;
  }

  .attachment-card__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .attachment-card__info {
    min-width: 0;
    flex: 1;
  }

  .attachment-card__title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    color: var(--horizon-purple-deep);
  }

  .attachment-card__info p {
    margin: 0.25rem 0 0;
    font-size: 0.88rem;
    color: var(--horizon-muted);
  }

  /* Implementation Banner */
  .implementation-banner {
    background: #f5f9ff;
    border-color: rgba(11, 92, 171, 0.24);
  }

  .implementation-banner__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .implementation-banner__head h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--horizon-purple-deep);
  }

  .implementation-banner p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .impl-edit-details {
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(11, 92, 171, 0.16);
  }

  .impl-edit-details summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--horizon-purple);
  }

  .impl-edit-details form {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.5rem;
  }

  .impl-note-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Commitments List */
  .commitments-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .commitment-item {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.9rem 1rem;
    background: #faf9fd;
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
  }

  .commitment-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.5rem;
    background: #ede8f8;
    color: var(--horizon-purple);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .commitment-item p {
    margin: 0.1rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--horizon-purple-deep);
  }

  /* Rationale & Prose */
  .prose-content {
    font-size: 1rem;
    line-height: 1.7;
    color: #26183c;
    max-width: 70ch;
  }

  .prose-content :global(p) {
    margin: 0 0 1rem;
  }

  .prose-content :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Amendments */
  .amendment-list {
    display: grid;
    gap: 0.9rem;
  }

  .amendment-card {
    border: 1px solid var(--horizon-line);
    border-radius: 0.85rem;
    padding: 1rem 1.15rem;
    background: #fcfbfe;
  }

  .amendment-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .amendment-card__title {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .amendment-badge {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--horizon-purple);
  }

  .amendment-card__title strong {
    font-size: 1rem;
    color: var(--horizon-purple-deep);
  }

  .amendment-meta {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--horizon-muted);
  }

  .amendment-conflict {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--horizon-danger-bg);
    color: var(--horizon-danger-ink);
    font-size: 0.85rem;
  }

  .amendment-card__body {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.6rem;
  }

  .diff-drawer {
    border-top: 1px solid var(--horizon-line);
    padding-top: 0.6rem;
  }

  .diff-drawer summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--horizon-purple);
  }

  .amendment-diff {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.6rem;
  }

  .diff-pane {
    padding: 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid var(--horizon-line);
    background: #ffffff;
    overflow-x: auto;
  }

  .diff-pane--after {
    background: #f4fbf8;
    border-color: rgba(20, 108, 67, 0.22);
  }

  .diff-label {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--horizon-muted);
    margin-bottom: 0.35rem;
  }

  .diff-pane pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: inherit;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .amendment-history-list {
    margin: 0.5rem 0 0;
    padding-left: 1.15rem;
    font-size: 0.82rem;
    color: var(--horizon-muted);
  }

  .amendment-vote-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.6rem;
    background: #ffffff;
    border: 1px solid var(--horizon-line);
  }

  .amendment-vote-form__info strong {
    display: block;
    font-size: 0.88rem;
  }

  .amendment-vote-form__info p {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--horizon-muted);
  }

  .amendment-vote-buttons {
    display: flex;
    gap: 0.4rem;
  }

  .amendment-compose {
    margin-top: 1rem;
    border: 1px dashed var(--horizon-line-strong);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    background: #faf9fd;
  }

  .amendment-compose summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--horizon-purple);
  }

  .amendment-compose__body {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--horizon-line);
  }

  .amendment-compose__body > p {
    margin: 0 0 0.75rem;
    font-size: 0.86rem;
    color: var(--horizon-muted);
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .empty-box {
    padding: 1rem 1.15rem;
    border-radius: 0.75rem;
    background: #faf9fd;
    border: 1px solid var(--horizon-line);
  }

  .empty-box p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--horizon-muted);
  }

  /* Member Discussion */
  .stance-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .stance-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--horizon-line);
    background: #faf9fd;
    color: var(--horizon-muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .stance-pill:hover {
    color: var(--horizon-purple-deep);
    border-color: var(--horizon-line-strong);
  }

  .stance-pill.is-active {
    background: var(--horizon-purple);
    border-color: var(--horizon-purple);
    color: #ffffff;
  }

  .deliberation-takeaways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .takeaway-box {
    padding: 0.75rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid var(--horizon-line);
    background: #faf9fd;
    display: grid;
    gap: 0.4rem;
  }

  .takeaway-box__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
  }

  .takeaway-meta {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--horizon-muted);
  }

  .takeaway-quote {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--horizon-purple-deep);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stance-starters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .stance-starters__hint {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--horizon-muted);
    margin-right: 0.15rem;
  }

  .starter-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--horizon-line);
    background: #ffffff;
    color: var(--horizon-purple-deep);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .starter-chip:hover,
  .starter-chip.is-active {
    background: var(--horizon-lavender);
    border-color: var(--horizon-purple);
  }

  .comments-thread {
    display: grid;
    gap: 0.85rem;
  }

  .comment-card {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  .comment-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: #ede8f8;
    color: var(--horizon-purple);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .comment-box {
    border: 1px solid var(--horizon-line);
    border-radius: 0.85rem;
    background: #ffffff;
    overflow: hidden;
  }

  .comment-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.95rem;
    background: #faf9fd;
    border-bottom: 1px solid var(--horizon-line);
  }

  .comment-author__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .author-name {
    font-size: 0.88rem;
    color: var(--horizon-purple-deep);
  }

  .comment-date {
    font-size: 0.78rem;
    color: var(--horizon-muted);
  }

  .comment-card__actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .endorse-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--horizon-line);
    background: #ffffff;
    color: var(--horizon-muted);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
  }

  .endorse-btn:hover:not(:disabled) {
    border-color: var(--horizon-purple);
    color: var(--horizon-purple);
  }

  .endorse-btn.is-endorsed {
    background: #efeaf9;
    border-color: var(--horizon-purple);
    color: var(--horizon-purple);
  }

  .delete-btn {
    border: 0;
    background: transparent;
    color: var(--horizon-danger-ink);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
  }

  .comment-card__body {
    padding: 0.85rem 0.95rem;
  }

  .comment-card__body p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--horizon-purple-deep);
  }

  /* Comment Composer */
  .comment-form {
    margin-top: 1.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--horizon-line);
    border-radius: 0.85rem;
    background: #faf9fd;
    display: grid;
    gap: 0.85rem;
  }

  .comment-form__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .comment-form__label {
    font-size: 0.9rem;
