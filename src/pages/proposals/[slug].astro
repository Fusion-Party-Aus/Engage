---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProposalBallot from '../../components/ui/ProposalBallot';
import PortableText from '../../components/PortableText.astro';
import { Button } from '../../components/ui/button';
import { Card, CardContent } from '../../components/ui/card';
import { Badge } from '../../components/ui/badge';
import { Field } from '../../components/ui/field';
import { Input } from '../../components/ui/input';
import { Textarea } from '../../components/ui/textarea';
import { NativeSelect } from '../../components/ui/native-select';
import { Alert, AlertDescription } from '../../components/ui/alert';
import BallotPrivacyNotice from '../../components/legal/BallotPrivacyNotice.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { getProposalDetail } from '../../lib/store.ts';
import { revisionDisplayLabel } from '../../lib/revision-label.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const detail = await getProposalDetail(db, Astro.params.slug ?? '', user);
if (!detail) {
  Astro.response.status = 404;
}

const proposal = detail?.proposal;
const revisions = proposal ? await db.collection('proposal_revisions').find({ proposalId: proposal.proposalId }).sort({ createdAt: -1 }).toArray() : [];
const ballotRevision = proposal?.ballotRevisionId
  ? revisions.find((revision: any) => revision.revisionId === proposal.ballotRevisionId)
  : null;
const ballotRevisionLabel = proposal?.ballotRevisionId
  ? revisionDisplayLabel({
      revisionId: String(proposal.ballotRevisionId),
      createdAt: ballotRevision?.createdAt ?? proposal.createdAt,
    })
  : 'being prepared';
const policyRecord = proposal ? await db.collection('policy_registry').findOne({ proposalId: proposal.proposalId }) : null;
const branchEligibility = proposal?.jurisdictionBranchId && user?.canParticipate
  ? await db.collection('branch_memberships').findOne({ memberId: user.memberId, branchId: proposal.jurisdictionBranchId, status: 'active' })
  : null;
const branchElectorate = proposal?.jurisdictionBranchId
  ? await db.collection('branches').findOne({ branchId: proposal.jurisdictionBranchId, recognised: true })
  : null;
const canVoteOnProposal = Boolean(user?.canParticipate && (!proposal?.jurisdictionBranchId || (branchEligibility && branchElectorate)));
const amendmentRows = proposal ? await db.collection('amendments').find({ proposalId: proposal.proposalId, status: { $ne: 'withdrawn' } }).sort({ createdAt: 1 }).toArray() : [];
for (const amendment of amendmentRows) {
  const history = await db.collection('amendment_revisions').find({ amendmentId: amendment.amendmentId }).sort({ createdAt: 1 }).toArray();
  amendment.revisionHistory = history;
  const current = history.find((row: any) => row.revisionId === amendment.currentRevisionId);
  if (current) amendment.changes = current.snapshot;
}
const comments = detail?.comments ?? [];
const myVote = detail?.myVote ?? null;
const myReason = detail?.myReason ?? '';

const stageLabel = (stage: ProposalStage) => {
  if (stage === 'propose') return '1. Propose';
  if (stage === 'deliberate') return '2. Deliberate';
  if (stage === 'decide') return '3. Decide';
  if (stage === 'implement') return '4. Implement';
  return 'Archived';
};

const stageBadgeVariant = (stage: ProposalStage) => {
  if (stage === 'propose') return 'warning' as const;
  if (stage === 'deliberate') return 'secondary' as const;
  if (stage === 'decide') return 'info' as const;
  if (stage === 'implement') return 'success' as const;
  return 'muted' as const;
};

const isImageAttachment = Boolean(
  proposal?.attachmentUrl && /\.(svg|png|webp|jpg|jpeg|gif)$/i.test(proposal.attachmentUrl),
);

const stages: ProposalStage[] = ['propose', 'deliberate', 'decide', 'implement'];
const currentStageIndex = proposal ? stages.indexOf(proposal.stage) : -1;

const stanceCounts = {
  all: comments.length,
  support: comments.filter((c) => c.stance === 'support').length,
  concern: comments.filter((c) => c.stance === 'concern').length,
  amendment: comments.filter((c) => c.stance === 'amendment').length,
  comment: comments.filter((c) => c.stance === 'comment').length,
};

const votes = proposal?.votes ?? { approve: 0, abstain: 0, reject: 0, total: 0 };

const isResolution = proposal
  ? proposal.kind === 'resolution' || proposal.proposalId.toUpperCase().startsWith('GOV-')
  : false;
---
<SiteLayout
  title={proposal ? `${proposal.title} · Engage` : 'Proposal not found · Engage'}
  description={proposal?.summary ?? 'Participatory proposal details, member deliberation, and voting.'}
  canonical={proposal ? `/proposals/${proposal.slug}/` : undefined}
>
  <div class="page-wrap section-space proposal-detail-page">
    {!proposal ? (
      <Card className="not-found-box">
        <CardContent className="grid justify-items-start gap-3 py-10">
          <h1>Proposal not found</h1>
          <p>That proposal could not be found or has been archived.</p>
          <Button href="/proposals/">Return to Proposals</Button>
        </CardContent>
      </Card>
    ) : (
      <>
        <!-- Top Nav & Meta Bar -->
        <div class="top-bar">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/proposals/">Proposals</a>
            <span aria-hidden="true">/</span>
            <a href={`/proposals/?space=${encodeURIComponent(proposal.space)}`}>
              {proposal.space}
            </a>
            <span aria-hidden="true">/</span>
            <span class="tabular" aria-current="page">{proposal.proposalId}</span>
          </nav>


        </div>

        {user?.isStaff && (
          <details class="staff-controls"><summary>Admin controls for this proposal</summary><div class="staff-bar">
            <span>
              <strong>Staff controls:</strong> Stage is <em>{stageLabel(proposal.stage)}</em>
            </span>
            <div class="staff-bar__actions">
              <Field label="Change stage" htmlFor="staff-stage-select" className="staff-select-label">
                <NativeSelect
                  id="staff-stage-select"
                  name="stage"
                  defaultValue={proposal.stage}
                  data-proposal-id={proposal.proposalId}
                  data-current-stage={proposal.stage}
                  data-vote-count={votes.total}
                >
                  <option value="propose">1. Propose</option>
                  <option value="deliberate">2. Deliberate</option>
                  <option value="decide">3. Decide (Voting)</option>
                  <option value="implement">4. Implement</option>
                  <option value="archived">Archived</option>
                </NativeSelect>
              </Field>
              <Button href={`/admin/proposals/?edit=${encodeURIComponent(proposal.proposalId)}`} variant="outline" size="sm">
                Edit in Admin
              </Button>
              <span id="staff-stage-msg" class="tabular" role="status" aria-live="polite"></span>
            </div>
          </div></details>
        )}

        <!-- Main Layout: 2 Columns on Desktop -->
        <div class="proposal-layout">
          <!-- Left Column: Content & Deliberation -->
          <div class="proposal-main">
            <header class="detail-header">
              <div class="detail-header__meta">
                <Badge variant={stageBadgeVariant(proposal.stage)}>
                  {stageLabel(proposal.stage)}
                </Badge>
                <Badge variant="outline">
                  {isResolution ? 'Governance Resolution' : 'Policy Proposal'}
                </Badge>
                <span class="space-pill">{proposal.space}</span>
              </div>

              <h1 class="detail-title">{proposal.title}</h1>
              <p class="proposal-reading-guide">{proposal.stage === 'decide' ? 'Voting is open. Read the exact wording and any separate amendment ballot before deciding.' : proposal.stage === 'deliberate' ? 'This idea is open for discussion. Read it, share a concern, or suggest a wording change.' : proposal.stage === 'implement' ? 'The vote has concluded. This stage records decision processing, including authorisation and publication where they apply. Check official policy for adopted wording.' : 'This is an idea for members to consider. Its wording may change before any vote.'}</p>
          <details class="proposal-process"><summary>Where this stands in the process</summary><nav class="lifecycle-stepper" aria-label="Proposal lifecycle progress">
            {stages.map((stg, idx) => {
              const isPast = currentStageIndex > idx;
              const isCurrent = proposal.stage === stg;
              return (
                <div class:list={['stepper-step', { 'is-past': isPast, 'is-current': isCurrent }]}>
                  <span class="stepper-marker">
                    {isPast ? '✓' : idx + 1}
                  </span>
                  <span class="stepper-label">{stg === 'propose' ? 'Idea' : stg === 'deliberate' ? 'Discuss' : stg === 'decide' ? 'Vote' : 'Implement'}</span>
                </div>
              );
            })}
          </nav></details>
              <nav class="reading-nav" aria-label="On this page"><a href="#outcomes-heading">The idea</a><a href="#deliberation">Discussion</a><a href="#amendments-heading">Wording changes</a><a href="#revision-history-heading">Earlier wording</a>{proposal.stage === 'decide' && <a href="#proposal-vote">Vote</a>}</nav>

              <div class="author-line">
                <span>Authored by <strong>{proposal.authorName || 'Fusion Working Group'}</strong></span>
                <span>·</span>
                <span class="tabular">Updated {new Date(proposal.updatedAt).toLocaleDateString('en-AU', { dateStyle: 'medium' })}</span>
              </div>
            </header>

            <!-- Asset Showcase (if proposal includes visual asset or document) -->
            {proposal.attachmentUrl && (
              <div class="asset-showcase">
                {isImageAttachment ? (
                  <div class="asset-frame">
                    <img src={proposal.attachmentUrl} alt={`${proposal.title} supporting asset`} />
                  </div>
                ) : null}
                <div class="asset-meta">
                  <span class="asset-tag">{isImageAttachment ? 'Attached Asset' : 'Supporting Document'}</span>
                  <h3>{isImageAttachment ? 'Supporting Asset & Specification' : 'Supporting Reference Document'}</h3>
                  {proposal.attachmentDescription ? (
                    <p>{proposal.attachmentDescription}</p>
                  ) : (
                    <p>Reference attachment and documentation supporting this proposal.</p>
                  )}
                  <Button href={proposal.attachmentUrl} target="_blank" rel="noopener noreferrer" variant="outline" size="sm">
                    {isImageAttachment ? 'Download full asset ↗' : 'View attachment ↗'}
                  </Button>
                </div>
              </div>
            )}

            <!-- Core Statement as Editorial Lead -->
            <div class="proposal-lead">
              <p>{proposal.summary}</p>
            </div>

            <!-- Stage 4: Implementation Tracking Banner -->
            {(proposal.stage === 'implement' || proposal.implementationNote) && (
              <section class="implementation-box" aria-labelledby="impl-heading">
                <div class="implementation-box__head">
                  <Badge variant="info">Stage 4 · Implement</Badge>
                  <h2 id="impl-heading">Decision processing and adoption status</h2>
                </div>
                <div class="implementation-content">
                  <p>
                    {proposal.implementationNote || (policyRecord
                      ? `This wording was formally adopted by ${policyRecord.ratification?.authorityBranchId ?? 'an authority not recorded'} and is recorded in the official policy library.`
                      : 'The decision is being processed. Required authorisation and publication steps have not been recorded, so this wording is not official policy.')}
                  </p>
                </div>
                {user?.isStaff && (
                  <details class="impl-edit-details">
                    <summary>Update decision-processing note</summary>
                    <form id="impl-note-form" data-proposal-id={proposal.proposalId}>
                      <Textarea
                        id="impl-note-text"
                        name="implementationNote"
                        rows={2}
                        defaultValue={proposal.implementationNote || ''}
                        placeholder="Record authorisation, publication or rollout progress..."
                      />
                      <div class="impl-note-actions">
                        <Button type="submit" size="sm" id="impl-note-btn">Save Note</Button>
                        <span id="impl-note-status" class="form-status" role="status"></span>
                      </div>
                    </form>
                  </details>
                )}
              </section>
            )}

            <!-- Key Commitments -->
            {proposal.outcomes.length > 0 && (
              <section class="content-section" aria-labelledby="outcomes-heading">
                <h2 id="outcomes-heading">Key Commitments</h2>
                <ul class="outcomes-list">
                  {proposal.outcomes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )}

            <!-- Detailed Rationale -->
            {(proposal.details || proposal.detailHtml) && (
              <section class="content-section" aria-labelledby="details-heading">
                <h2 id="details-heading">Rationale &amp; Context</h2>
                <div class="details-body">
                  <PortableText value={proposal.details} html={proposal.detailHtml} />
                </div>
              </section>
            )}

            <!-- Deliberation (Discussion) Section -->
            <section id="deliberation" class="deliberation-section" aria-labelledby="deliberate-heading">
              <div class="deliberation-header">
                <div>
                  <h2 id="deliberate-heading">Discussion</h2>
                  <p>Read what others think, then share your view.</p>
                </div>
                <Badge variant="muted" className="tabular">{comments.length}</Badge>
              </div>

              <!-- Stance Filter Tabs -->
              <div class="stance-filters" role="group" aria-label="Filter contributions by stance">
                <Button type="button" variant="outline" size="sm" className="stance-filter-btn is-active" data-stance="all" aria-pressed="true">
                  All ({stanceCounts.all})
                </Button>
                <Button type="button" variant="outline" size="sm" className="stance-filter-btn" data-stance="support" aria-pressed="false">
                  Support ({stanceCounts.support})
                </Button>
                <Button type="button" variant="outline" size="sm" className="stance-filter-btn" data-stance="concern" aria-pressed="false">
                  Concern ({stanceCounts.concern})
                </Button>
                <Button type="button" variant="outline" size="sm" className="stance-filter-btn" data-stance="amendment" aria-pressed="false">
                  Wording suggestions ({stanceCounts.amendment})
                </Button>
                <Button type="button" variant="outline" size="sm" className="stance-filter-btn" data-stance="comment" aria-pressed="false">
                  Comment ({stanceCounts.comment})
                </Button>
              </div>

              <!-- Contribution Input Form -->
              {user?.canParticipate ? (
                <form id="comment-form" class="comment-form" data-proposal-id={proposal.proposalId}>
                  <div class="stance-radio-group">
                    <label class="stance-label stance-label--support">
                      <input type="radio" name="stance" value="support" class="size-4 accent-primary" />
                      <span>✓ Support</span>
                    </label>
                    <label class="stance-label stance-label--concern">
                      <input type="radio" name="stance" value="concern" class="size-4 accent-primary" />
                      <span>! Concern</span>
                    </label>
                    <label class="stance-label stance-label--amendment">
                      <input type="radio" name="stance" value="amendment" class="size-4 accent-primary" />
                      <span>✎ Wording suggestion</span>
                    </label>
                    <label class="stance-label stance-label--comment">
                      <input type="radio" name="stance" value="comment" class="size-4 accent-primary" checked />
                      <span>💬 Comment</span>
                    </label>
                  </div>

                  <Field label="Your contribution" htmlFor="comment-body-input">
                    <Textarea
                      id="comment-body-input"
                      name="body"
                      required
                      minLength={3}
                      maxLength={4000}
                      rows={3}
                      placeholder="Share constructive feedback, identify concerns, or suggest a wording change..."
                    />
                  </Field>

                  <div class="comment-form__actions">
                    <Button type="submit" id="comment-submit-btn">
                      Post contribution
                    </Button>
                    <span id="comment-status-msg" class="tabular form-status" role="status" aria-live="polite"></span>
                  </div>
                </form>
              ) : user ? (
                <Alert className="signin-nudge" variant="warning">
                  <AlertDescription>
                    <p>Awaiting administrator verification before posting.</p>
                    <Button href="/member/" variant="outline" size="sm">Account status</Button>
                  </AlertDescription>
                </Alert>
              ) : (
                <Alert className="signin-nudge">
                  <AlertDescription>
                    <p>Sign in as a verified member to contribute to deliberations.</p>
                    <Button href="/member/" size="sm">Sign In</Button>
                  </AlertDescription>
                </Alert>
              )}

              <!-- Contributions Feed -->
              <div id="comments-list" class="comments-feed">
                {comments.length === 0 ? (
                  <p class="empty-feed">No contributions yet. Be the first to share your stance.</p>
                ) : (
                  comments.map((c) => {
                    const isAuthor = user && c.memberId === user.memberId;
                    const canDelete = isAuthor || user?.isStaff;
                    const hasEndorsed = user && c.upvotes.includes(user.memberId);
                    return (
                      <Card className="comment-card" data-stance={c.stance} data-comment-id={c.commentId}>
                        <div class="comment-card__head">
                          <div class="comment-author">
                            <span class="author-name">{c.authorName}</span>
                            <Badge variant={c.stance === 'support' ? 'success' : c.stance === 'concern' ? 'destructive' : c.stance === 'amendment' ? 'warning' : 'muted'}>
                              {c.stance}
                            </Badge>
                          </div>
                          <time class="tabular" datetime={new Date(c.createdAt).toISOString()}>
                            {new Date(c.createdAt).toLocaleDateString('en-AU', {
                              month: 'short',
                              day: 'numeric',
                            })}
                          </time>
                        </div>

                        <div class="comment-card__body">
                          <p>{c.body}</p>
                        </div>

                        <div class="comment-card__actions">
                          <Button
                            type="button"
                            variant="outline"
                            size="sm"
                            className={`endorse-btn ${hasEndorsed ? 'is-endorsed' : ''}`}
                            data-endorse-id={c.commentId}
                            disabled={!user?.canParticipate}
                            title={user?.canParticipate ? '+1 Endorse' : 'Sign in to endorse'}
                          >
                            <span class="endorse-icon">▲</span>
                            <span class="endorse-text">Endorse</span>
                            <span class="endorse-count tabular">{c.upvotes.length}</span>
                          </Button>

                          {canDelete && (
                            <Button
                              type="button"
                              variant="ghost"
                              size="sm"
                              className="delete-btn"
                              data-delete-comment={c.commentId}
                            >
                              Delete
                            </Button>
                          )}
                        </div>
                      </Card>
                    );
                  })
                )}
              </div>
            </section>
            <section class="content-section amendments-section" aria-labelledby="amendments-heading">
              <h2 id="amendments-heading">Wording suggestions and formal amendments</h2>
              <p>A wording suggestion is informal and needs no seconder. A formal amendment records a substantive change to the wording and, once seconding is implemented, will require one independent eligible seconder before its formal decision process. An amendment ballot is a separate decision; it does not approve the proposal or adopt the amendment.</p>
              {amendmentRows.length ? <div class="amendment-list">{amendmentRows.map((amendment: any) => {
                const base = revisions.find((revision: any) => revision.revisionId === amendment.baseRevisionId);
                return <Card className="amendment-card">
                  <div class="amendment-card__head"><strong>{amendment.changes?.title ?? 'Wording change'}</strong><Badge variant="outline">{amendment.status}</Badge></div>
                  <p>Based on proposal revision <code>{String(amendment.baseRevisionId).slice(0, 8)}</code> · formal amendment revision <code>{String(amendment.currentRevisionId ?? 'legacy').slice(0,8)}</code>{amendment.rebasedFromRevisionId ? ` · rebased from ${String(amendment.rebasedFromRevisionId).slice(0,8)}` : ''}</p>
                  {amendment.revisionHistory?.length > 1 && <details><summary>Formal amendment wording history ({amendment.revisionHistory.length} revisions)</summary><ol>{amendment.revisionHistory.map((row: any) => <li><code>{String(row.revisionId).slice(0,8)}</code> · {row.authorId === user?.memberId ? 'You' : 'Contributor'} · {new Date(row.createdAt).toLocaleDateString()}</li>)}</ol></details>}
                  {Object.entries(amendment.changes ?? {}).map(([field, value]: [string, any]) => <details><summary>Compare {field}</summary><div class="amendment-diff"><div><strong>Current at base</strong><pre>{Array.isArray(base?.snapshot?.[field]) ? base.snapshot[field].join('\n') : String(base?.snapshot?.[field] ?? '')}</pre></div><div><strong>Suggested wording</strong><pre>{Array.isArray(value) ? value.join('\n') : String(value ?? '')}</pre></div></div></details>)}
                  {amendment.conflicts?.length > 0 && <p role="status">This amendment overlaps with wording changed since its base revision. An administrator must resolve the conflict explicitly.</p>}
                  {amendment.status === 'voting' && canVoteOnProposal && <form class="amendment-vote-form" data-amendment-id={amendment.amendmentId} data-proposal-id={proposal.proposalId}><strong>Separate amendment ballot</strong><p>These votes record endorsement of the recorded amendment revision. They do not approve the proposal or adopt policy.</p><div class="amendment-vote-buttons">{['approve','abstain','reject'].map((choice) => <Button type="button" variant="outline" data-choice={choice}>{choice[0]!.toUpperCase() + choice.slice(1)}</Button>)}</div><span role="status" aria-live="polite"></span></form>}
                </Card>;
              })}</div> : <p>No formal amendments have been recorded yet.</p>}
              {user?.canParticipate && ['propose','deliberate'].includes(proposal.stage) && (
                <details class="amendment-compose">
                  <summary>Propose a formal amendment</summary>
                  <p>This records a formal amendment against the latest saved revision, currently <code>{revisions[0]?.revisionId ?? 'not yet versioned'}</code>. Seconding is not yet operational; once implemented, one independent eligible seconder will be required before it can progress.</p>
                  <form id="amendment-form" class="grid gap-4" data-proposal-id={proposal.proposalId} data-revision-id={revisions[0]?.revisionId ?? ''}>
                    <Field label="Proposed title (optional)" htmlFor="amendment-title">
                      <Input id="amendment-title" name="title" maxLength={200} placeholder="New title wording" />
                    </Field>
                    <Field label="Proposed summary" hint="At least 10 characters" htmlFor="amendment-summary">
                      <Textarea id="amendment-summary" name="summary" rows={4} minLength={10} maxLength={2000} placeholder="Write the replacement summary" required />
                    </Field>
                    <div class="form-actions">
                      <Button type="submit">Submit formal amendment</Button>
                      <span class="amendment-compose-status" role="status" aria-live="polite"></span>
                    </div>
                  </form>
                </details>
              )}
            </section>

            {revisions.length > 0 && (
              <section class="content-section revision-history" aria-labelledby="revision-history-heading">
                <h2 id="revision-history-heading">Revision history</h2>
                <p>Each entry is a saved wording snapshot. A proposal or amendment ballot is tied to the revision current when voting begins.</p>
                <ol>
                  {revisions.map((revision, index) => {
                    const parent = revisions[index + 1];
                    const changed = parent ? Object.keys(revision.snapshot).flatMap((field) => {
                      const before = parent.snapshot[field]; const after = revision.snapshot[field];
                      return JSON.stringify(before) === JSON.stringify(after) ? [] : [{ field, before, after }];
                    }) : [];
                    return (
                      <li>
                        <strong>{new Date(revision.createdAt).toLocaleString('en-AU')}</strong>
                        <span>{revisionDisplayLabel({ revisionId: String(revision.revisionId), createdAt: revision.createdAt, ordinal: revisions.length - index })} · <code title={String(revision.revisionId)}>{String(revision.revisionId).slice(0, 8)}</code> · {changed.length ? `${changed.length} changed ${changed.length === 1 ? 'field' : 'fields'}` : parent ? 'No wording changes' : 'Initial wording'}</span>
                        {changed.length > 0 && (
                          <details>
                            <summary>View wording changes</summary>
                            {changed.map((change) => (
                              <div class="revision-change">
                                <h3>{change.field}</h3>
                                <div><strong>Before</strong><pre>{Array.isArray(change.before) ? change.before.join('\n') : String(change.before ?? '')}</pre></div>
                                <div><strong>After</strong><pre>{Array.isArray(change.after) ? change.after.join('\n') : String(change.after ?? '')}</pre></div>
                              </div>
                            ))}
                          </details>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </section>
            )}

            <!-- Policy Provenance or Resolution Context -->
            {proposal.provenance && (
              <section class="content-section provenance-section" aria-labelledby="provenance-heading">
                <div class="provenance-header">
                  <div>
                    <h2 id="provenance-heading">
                      {isResolution ? 'Resolution Context & Authority' : 'Policy Provenance & Prior Approval'}
                    </h2>
                    <p class="provenance-lead">
                      {isResolution
                        ? 'Constitutional authority, organizational precedents, and scrutiny notes from party records.'
                        : 'Lineage and scrutiny details from party archives and published platform versions.'}
                    </p>
                  </div>
                  <Badge variant="outline" className={`prov-badge prov-badge--${proposal.provenance.category || 'unverified'}`}>
                    {proposal.provenance.label}
                  </Badge>
                </div>

                <p class="provenance-summary">{proposal.provenance.summary}</p>

                {proposal.provenance.uncertaintyNote && (
                  <div class="provenance-callout">
                    <strong>What is still uncertain:</strong> {proposal.provenance.uncertaintyNote}
                  </div>
                )}

                {proposal.provenance.lineage && proposal.provenance.lineage.length > 0 && (
                  <div class="provenance-subblock">
                    <h3>{isResolution ? 'Preceding Documents & Authorities' : 'Prior Policy Predecessors'}</h3>
                    <ul class="provenance-links">
                      {proposal.provenance.lineage.map((item) => (
                        <li>
                          {item.url ? (
                            <a href={item.url} target="_blank" rel="noopener noreferrer" class="lineage-link">
                              {item.label} ↗
                            </a>
                          ) : (
                            <span class="lineage-label">{item.label}</span>
                          )}
                          {item.description && <span class="lineage-desc"> — {item.description}</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {proposal.provenance.valuesAlignment && proposal.provenance.valuesAlignment.length > 0 && (
                  <div class="provenance-subblock">
                    <h3>Values &amp; Principles Alignment</h3>
                    <ul class="provenance-values">
                      {proposal.provenance.valuesAlignment.map((val) => (
                        <li>{val}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </section>
            )}

          </div>

          <!-- Right Column: Decision / Voting Action Sidebar -->
          <aside class="proposal-sidebar">
            <section id="proposal-vote" class="sidebar-box decision-sidebar-card rounded-lg border border-border bg-card text-card-foreground">
              <div class="decision-card-head">
                <div>
                  <span class="decision-sub">
                    {proposal.stage === 'decide' ? 'Stage 3 · Decision' : stageLabel(proposal.stage)}
                  </span>
                  <h3>Member Ballot</h3>
                </div>
                <Badge variant={proposal.stage === 'decide' ? 'success' : 'muted'}>
                  {proposal.stage === 'decide' ? 'Open' : 'Closed'}
                </Badge>
              </div>

              {proposal.stage === 'decide' && !canVoteOnProposal && (
                <div class="sidebar-vote-wrapper">
                  {user?.canParticipate && proposal.jurisdictionBranchId ? (
                    <Alert className="sidebar-nudge"><AlertDescription><p>{branchElectorate ? 'This decision is for an authorised branch electorate. Current branch eligibility is not on file for your account.' : 'This branch electorate is not currently recognised or available for voting.'}</p></AlertDescription></Alert>
                  ) : user ? (
                    <Alert className="sidebar-nudge">
                      <AlertDescription>
                        <p>Your account is not currently eligible for this ballot. Check your membership status.</p>
                        <Button href="/member/" variant="outline" size="sm">Account</Button>
                      </AlertDescription>
                    </Alert>
                  ) : (
                    <Alert className="sidebar-nudge">
                      <AlertDescription>
                        <p>Verified party members vote on active decisions.</p>
                        <Button href="/member/" size="sm">Sign in to vote</Button>
                      </AlertDescription>
                    </Alert>
                  )}
                </div>
              )}

              {proposal.stage === 'decide' || votes.total > 0 ? (
                <ProposalBallot
                  client:load
                  proposalId={proposal.proposalId}
                  initialChoice={myVote}
                  initialReason={myReason}
                  initialTally={votes}
                  open={proposal.stage === 'decide'}
                  canVote={canVoteOnProposal}
                />
              ) : (
                <p class="m-0 text-sm text-muted-foreground">Voting has not opened for this proposal.</p>
              )}

              <BallotPrivacyNotice />

              {proposal.ballotRevisionId && (
                <p class="ballot-revision">
                  Wording: <span title={String(proposal.ballotRevisionId)}>{ballotRevisionLabel}</span>
                </p>
              )}
            </section>

            <!-- Metadata info card -->
            <Card className="sidebar-meta-card">
              <div class="meta-row">
                <span>Classification:</span>
                <strong>{isResolution ? 'Governance Resolution' : 'Policy Proposal'}</strong>
              </div>
              <div class="meta-row">
                <span>Working Group:</span>
                <strong>{proposal.space}</strong>
              </div>
              <div class="meta-row">
                <span>Identifier:</span>
                <strong class="tabular">{proposal.proposalId}</strong>
              </div>
              <div class="meta-row">
                <span>Lifecycle Stage:</span>
                <strong>{stageLabel(proposal.stage)}</strong>
              </div>
              {proposal.provenance && (
                <div class="meta-row">
                  <span>{isResolution ? 'Authority / Context:' : 'Provenance:'}</span>
                  <strong>{proposal.provenance.label}</strong>
                </div>
              )}
            </Card>
          </aside>
        </div>
      </>
    )}
  </div>
</SiteLayout>

<script>
  // Staff stage selector with ballot integrity confirmation
  const stageSelect = document.getElementById('staff-stage-select') as HTMLSelectElement | null;
  const stageMsg = document.getElementById('staff-stage-msg');
  if (stageSelect && stageMsg) {
    stageSelect.addEventListener('change', async () => {
      const proposalId = stageSelect.dataset.proposalId;
      const currentStage = stageSelect.dataset.currentStage || stageSelect.value;
      const voteCount = parseInt(stageSelect.dataset.voteCount || '0', 10);
      const stage = stageSelect.value;
      if (currentStage === stage) return;

      let confirmMsg = '';
      if (stage === 'decide') {
        confirmMsg = `Open voting (Stage 3: Decide)? Once voting begins, substantive proposal content will be locked to protect ballot integrity.`;
      } else if (currentStage === 'decide' && voteCount > 0) {
        confirmMsg = `This ballot currently has ${voteCount} member vote(s). Moving to "${stage}" will conclude or pause active voting. All cast votes will remain safely preserved. Proceed?`;
      } else if (stage === 'implement') {
        confirmMsg = `Advance this proposal to Stage 4 (Implement)?`;
      } else if (stage === 'archived') {
        confirmMsg = `Archive this proposal? It will no longer be visible to general members.`;
      }

      if (confirmMsg && !confirm(confirmMsg)) {
        stageSelect.value = currentStage;
        return;
      }

      stageSelect.disabled = true;
      stageMsg.textContent = 'Updating...';

      try {
        const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId ?? '')}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stage }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Failed to update stage');
        location.reload();
      } catch (err: any) {
        stageMsg.textContent = err.message || 'Error';
        stageSelect.value = currentStage;
        stageSelect.disabled = false;
      }
    });
  }

  // Staff implementation note updater
  const implForm = document.getElementById('impl-note-form') as HTMLFormElement | null;
  const implBtn = document.getElementById('impl-note-btn') as HTMLButtonElement | null;
  const implStatus = document.getElementById('impl-note-status');
  if (implForm && implBtn && implStatus) {
    implForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const proposalId = implForm.dataset.proposalId;
      const textarea = document.getElementById('impl-note-text') as HTMLTextAreaElement | null;
      const implementationNote = textarea?.value ?? '';
      implBtn.disabled = true;
      implStatus.textContent = 'Saving...';

      try {
        const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId ?? '')}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ implementationNote }),
        });
        if (!res.ok) throw new Error('Failed to save');
        implStatus.textContent = 'Saved!';
        setTimeout(() => location.reload(), 500);
      } catch (err: any) {
        implStatus.textContent = err.message || 'Error';
        implBtn.disabled = false;
      }
    });
  }


  const amendmentForm = document.getElementById('amendment-form') as HTMLFormElement | null;
  amendmentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!amendmentForm.reportValidity()) return;
    const status = amendmentForm.querySelector<HTMLElement>('.amendment-compose-status');
    const button = amendmentForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const fd = new FormData(amendmentForm);
      const changes: Record<string, string> = {};
      for (const field of ['title', 'summary']) {
        const value = String(fd.get(field) ?? '').trim();
        if (value) changes[field] = value;
      }
      const response = await fetch('/api/amendments', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ proposalId: amendmentForm.dataset.proposalId, baseRevisionId: amendmentForm.dataset.revisionId, changes }) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Could not submit the amendment.');
      if (status) status.textContent = 'Amendment submitted. Reloading its status…';
      location.reload();
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'Could not submit the amendment.';
      if (button) button.disabled = false;
    }
  });

  document.querySelectorAll<HTMLFormElement>('.amendment-vote-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[role="status"]');
    form.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button) => button.addEventListener('click', async () => {
      if (status) status.textContent = 'Recording your endorsement…';
      form.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((item) => item.disabled = true);
      try {
        const response = await fetch('/api/votes', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ proposalId: form.dataset.proposalId, amendmentId: form.dataset.amendmentId, choice: button.dataset.choice }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Could not record endorsement.');
        if (status) status.textContent = 'Your endorsement vote was recorded.';
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : 'Could not record endorsement.';
        form.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((item) => item.disabled = false);
      }
    }));
  });



  // Stance tab filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.stance-filter-btn');
  const commentCards = document.querySelectorAll<HTMLElement>('.comment-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const stance = btn.dataset.stance;
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      filterBtns.forEach((item) => item.setAttribute('aria-pressed', String(item === btn)));

      commentCards.forEach((card) => {
        if (stance === 'all' || card.dataset.stance === stance) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Post comment / deliberation stance
  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
  const commentSubmitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null;
  const commentStatusMsg = document.getElementById('comment-status-msg');

  if (commentForm && commentSubmitBtn && commentStatusMsg) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const proposalId = commentForm.dataset.proposalId;
      const formData = new FormData(commentForm);
      const stance = formData.get('stance');
      const body = formData.get('body');

      commentSubmitBtn.disabled = true;
      commentStatusMsg.textContent = 'Posting…';

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proposalId, stance, body }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to post');

        commentStatusMsg.textContent = 'Posted!';
        location.reload();
      } catch (err: any) {
        commentStatusMsg.textContent = err.message || 'Error';
        commentSubmitBtn.disabled = false;
      }
    });
  }

  // Endorse contribution (+1)
  document.querySelectorAll<HTMLButtonElement>('[data-endorse-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const commentId = btn.dataset.endorseId;
      btn.disabled = true;
      try {
        const res = await fetch('/api/comments', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ commentId, action: 'upvote' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        const countSpan = btn.querySelector('.endorse-count');
        if (countSpan) countSpan.textContent = String(data.count ?? data.upvotes?.length ?? 0);
        btn.classList.toggle('is-endorsed', data.hasUpvoted ?? data.endorsed);
      } catch {
        // Ignore
      } finally {
        btn.disabled = false;
      }
    });
  });

  // Delete contribution
  document.querySelectorAll<HTMLButtonElement>('[data-delete-comment]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this contribution?')) return;
      const commentId = btn.dataset.deleteComment;
      btn.disabled = true;

      try {
        const res = await fetch(`/api/comments?commentId=${encodeURIComponent(commentId ?? '')}`, {
          method: 'DELETE',
        });
        if (!res.ok) throw new Error('Failed to delete');
        const card = document.querySelector(`[data-comment-id="${commentId}"]`);
        card?.remove();
      } catch {
        alert('Could not delete contribution.');
        btn.disabled = false;
      }
    });
  });
</script>

