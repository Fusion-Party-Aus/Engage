---
import { recordLifecycle } from '../../lib/member-lifecycle.ts';
import { ballotExpired } from '../../lib/ballot-deadline.ts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProposalBallot from '../../components/ui/ProposalBallot';
import SecondProposalButton from '../../components/ui/SecondProposalButton';
import StanceSelector from '../../components/ui/stance-selector';
import PortableText from '../../components/PortableText.astro';
import { AlertCircle, FileText, MessageCircle, PenLine, ThumbsUp } from 'lucide-react';
import { Button } from '../../components/ui/button';
import { Card, CardContent } from '../../components/ui/card';
import { Badge } from '../../components/ui/badge';
import { Field } from '../../components/ui/field';
import { Input } from '../../components/ui/input';
import { Textarea } from '../../components/ui/textarea';
import { NativeSelect } from '../../components/ui/native-select';
import BallotPrivacyNotice from '../../components/legal/BallotPrivacyNotice.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { canRespondToContribution, canViewProposal, getProposalDetail, isGovernanceResolution, listOutstandingDecisions, normalizeProposalDoc, resolveContributionEvidenceMap } from '../../lib/store.ts';
import { getProposalEligibility } from '../../lib/branch-participation.ts';
import { revisionDisplayLabel } from '../../lib/revision-label.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const detail = await getProposalDetail(db, Astro.params.slug ?? '', user);
if (!detail) {
  Astro.response.status = 404;
}
const proposal = detail?.proposal;
const [
  supersededByDetail,
  revisions,
  rawPolicyRecord,
  ballotResult,
  relatedProposals,
  amendmentRows,
  outstandingDecisions,
  eligibility,
  relatedBranches,
  evidenceMap,
] = proposal
  ? await Promise.all([
      proposal.supersededByProposalId
        ? getProposalDetail(db, proposal.supersededByProposalId, user)
        : Promise.resolve(null),
      db.collection('proposal_revisions').find({ proposalId: proposal.proposalId }).sort({ createdAt: -1 }).toArray(),
      db.collection('policy_registry').findOne({ proposalId: proposal.proposalId }),
      db.collection('ballot_results').findOne({ proposalId: proposal.proposalId }),
      db.collection('proposals')
        .find({ space: proposal.space, proposalId: { $ne: proposal.proposalId }, stage: { $ne: 'archived' } })
        .sort({ updatedAt: -1 })
        .limit(12)
        .toArray()
        .then((rows) => rows.filter((row: any) => canViewProposal(normalizeProposalDoc(row), user)).slice(0, 4)),
      db.collection('amendments').find({ proposalId: proposal.proposalId, status: { $ne: 'withdrawn' } }).sort({ createdAt: 1 }).toArray(),
      user?.canParticipate && proposal.stage === 'decide'
        ? listOutstandingDecisions(db, user.memberId, user)
        : Promise.resolve([]),
      getProposalEligibility(db, proposal, user),
      [proposal.originatingBranchId, proposal.governanceAuthorityBranchId, proposal.jurisdictionBranchId].filter((value): value is string => Boolean(value)).length
        ? db.collection('branches').find({ branchId: { $in: [...new Set([proposal.originatingBranchId, proposal.governanceAuthorityBranchId, proposal.jurisdictionBranchId].filter((value): value is string => Boolean(value)))] } }).toArray()
        : Promise.resolve([]),
      resolveContributionEvidenceMap(db, proposal, detail.comments, user),
    ])
  : [null, [], null, null, [], [], [], null, [], new Map()];

const supersededByProposal = supersededByDetail?.proposal ?? null;
const canRespondToFeedback = Boolean(detail?.proposal && canRespondToContribution(user, detail.proposal));
const feedbackStatusLabel = (status: string) =>
  status === 'incorporated'
    ? 'Incorporated'
    : status === 'considered'
      ? 'Considered'
      : status === 'deferred'
        ? 'Deferred'
        : 'Declined';
const feedbackStatusVariant = (status: string) =>
  status === 'incorporated'
    ? ('success' as const)
    : status === 'considered'
      ? ('info' as const)
      : status === 'deferred'
        ? ('warning' as const)
        : ('outline' as const);

const isResolution = proposal ? isGovernanceResolution(proposal) : false;
const policyRecord = !isResolution ? rawPolicyRecord : null;

const ballotRevision = proposal?.ballotRevisionId
  ? revisions.find((revision: any) => revision.revisionId === proposal.ballotRevisionId)
  : null;
const ballotRevisionLabel = proposal?.ballotRevisionId
  ? revisionDisplayLabel({
      revisionId: String(proposal.ballotRevisionId),
      createdAt: ballotRevision?.createdAt ?? proposal.createdAt,
    })
  : 'Draft wording (not yet bound)';

const allAmendmentRevisions = amendmentRows.length
  ? await db
      .collection('amendment_revisions')
      .find({ amendmentId: { $in: amendmentRows.map((a: any) => a.amendmentId) } })
      .sort({ createdAt: 1 })
      .toArray()
  : [];

const evidencePolicyPublic = Boolean(
  policyRecord && ['published', 'withdrawn', 'superseded'].includes(String(policyRecord.publicationStatus ?? '')),
);
const evidenceOptions = proposal
  ? [
      ...revisions.map((revision: any, index: number) => ({
        group: 'Proposal revisions',
        value: `revision:${String(revision.revisionId)}`,
        label: `${revisionDisplayLabel({ revisionId: String(revision.revisionId), createdAt: revision.createdAt, ordinal: revisions.length - index })}${revision.revisionId === proposal.ballotRevisionId ? ' (ballot wording)' : ''}`,
      })),
      ...amendmentRows.map((amendment: any) => ({
        group: 'Amendments',
        value: `amendment:${String(amendment.amendmentId)}`,
        label: `${String(amendment.changes?.title ?? amendment.title ?? 'Amendment')} (${String(amendment.status ?? 'proposed')})`,
      })),
      ...(ballotResult
        ? [{
            group: 'Recorded decision',
            value: `decision:${String(ballotResult.decisionEventId ?? proposal.proposalId)}`,
            label: `Ballot outcome: ${String(ballotResult.result ?? 'recorded')}`,
          }]
        : []),
      ...(policyRecord && (evidencePolicyPublic || user?.isStaff || user?.isAdmin)
        ? [{
            group: 'Policy registry',
            value: `policy:${String(policyRecord.policyId)}`,
            label: `${String(policyRecord.title ?? policyRecord.policyId)} (${String(policyRecord.publicationStatus ?? 'unpublished')})`,
          }]
        : []),
    ]
  : [];
const branchNameFor = (branchId?: string) =>
  branchId ? String(relatedBranches.find((branch: any) => branch.branchId === branchId)?.name ?? branchId) : 'Party-wide';
const canVoteOnProposal = Boolean(proposal && !ballotExpired(proposal) && eligibility?.eligible);
// D3: in Propose, the next required act is a seconder, which opens deliberation.
const awaitingSeconder = Boolean(proposal && proposal.stage === 'propose' && !proposal.secondedAt);
const canSecondProposal = Boolean(
  awaitingSeconder && user?.canParticipate && user.memberId !== proposal?.authorId,
);
if (user && canVoteOnProposal && proposal?.stage === 'decide' && proposal.ballotRevisionId) await recordLifecycle(db,user.memberId,'first_eligible_ballot_viewed');
for (const amendment of amendmentRows) {
  const history = allAmendmentRevisions.filter((row: any) => row.amendmentId === amendment.amendmentId);
  amendment.revisionHistory = history;
  const current = history.find((row: any) => row.revisionId === amendment.currentRevisionId);
  if (current) amendment.changes = current.snapshot;
}
const comments = detail?.comments ?? [];
const myVote = detail?.myVote ?? null;
const myReason = detail?.myReason ?? '';
const myPendingVote = detail?.myPendingVote ?? null;
const myPendingReason = detail?.myPendingReason ?? '';

const remainingBallots = proposal
  ? outstandingDecisions.filter((item) => item.proposalId !== proposal.proposalId)
  : [];
const nextBallotInfo = remainingBallots[0]
  ? {
      slug: remainingBallots[0].slug,
      title: remainingBallots[0].title,
      remainingCount: remainingBallots.length,
    }
  : null;

const topSupportComment = [...comments]
  .filter((c) => c.stance === 'support')
  .sort((a, b) => b.upvotes.length - a.upvotes.length || new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())[0] ?? null;

const topConcernComment = [...comments]
  .filter((c) => c.stance === 'concern')
  .sort((a, b) => b.upvotes.length - a.upvotes.length || new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())[0] ?? null;

const stagePillLabel = (stage: ProposalStage) => {
  if (stage === 'propose') return 'New idea';
  if (stage === 'deliberate') return 'In discussion';
  if (stage === 'decide') return 'Open vote';
  if (stage === 'implement') return 'Implementation';
  return 'Archived';
};

const stageStepLabel = (stage: ProposalStage) => {
  if (stage === 'propose') return '1. Idea';
  if (stage === 'deliberate') return '2. Discussion';
  if (stage === 'decide') return '3. Voting';
  if (stage === 'implement') return '4. Implementation';
  return 'Archived';
};

const stageGuideText = (stage: ProposalStage) => {
  if (stage === 'decide') {
    return 'Voting is open.';
  }
  if (stage === 'deliberate') {
    return 'Open for member discussion, scrutiny, and formal wording amendments before a ballot is opened.';
  }
  if (stage === 'implement') {
    return isResolution
      ? 'Ballot has closed. Recorded governance decisions are documented and implemented by the relevant branch or committee.'
      : 'Ballot has closed. Recorded decisions undergo constitutional ratification before publication in the Policy Registry.';
  }
  return 'Initial idea stage. Open for early feedback and refinement before advancing to formal deliberation.';
};

const isImageAttachment = Boolean(
  proposal?.attachmentUrl && /\.(svg|png|webp|jpg|jpeg|gif)$/i.test(proposal.attachmentUrl),
);
const isRasterImageAttachment = Boolean(
  proposal?.attachmentUrl && /\.(png|webp|jpg|jpeg|gif)$/i.test(proposal.attachmentUrl),
);
const inlineMarkdownImageMatch = proposal?.details
  ? proposal.details.match(/(?:!\[[^\]]*\]|\[\![^\]]*\])\(((?:https?:\/\/|\/)[^\s)]+\.(?:png|webp|jpg|jpeg|gif))\)/i)
  : null;
const proposalSocialImage = isRasterImageAttachment
  ? proposal?.attachmentUrl
  : inlineMarkdownImageMatch?.[1];

const stages: ProposalStage[] = ['propose', 'deliberate', 'decide', 'implement'];
const currentStageIndex = proposal ? stages.indexOf(proposal.stage) : -1;

const stanceCounts = {
  all: comments.length,
  support: comments.filter((c) => c.stance === 'support').length,
  concern: comments.filter((c) => c.stance === 'concern').length,
  amendment: comments.filter((c) => c.stance === 'amendment').length,
  comment: comments.filter((c) => c.stance === 'comment').length,
};

const votes = proposal?.votes ?? { approve: 0, abstain: 0, reject: 0, total: 0 };

const ballotState = proposal && ballotExpired(proposal) ? 'Voting closed' : proposal?.stage === 'decide' ? 'Ballot open' : votes.total > 0 ? 'Ballot closed' : 'Not yet open';

const policyStatusLabel = policyRecord
  ? policyRecord.publicationStatus === 'unpublished'
    ? 'Ratified · awaiting publication'
    : `${String(policyRecord.status ?? 'adopted')} · ${String(policyRecord.publicationStatus ?? 'unpublished')}`
  : ballotResult?.result === 'successful' || proposal?.stage === 'implement'
    ? 'Awaiting ratification'
    : 'Not yet adopted';

const resolutionStatusLabel = proposal?.supersededByProposalId
  ? supersededByProposal
    ? `Superseded by ${supersededByProposal.proposalId}`
    : 'Superseded'
  : proposal?.stage === 'archived'
    ? 'Archived'
    : proposal?.implementationNote
      ? 'Outcome recorded'
      : ballotResult
        ? `Ballot ${String(ballotResult.result ?? 'recorded')}`
        : proposal?.stage === 'implement'
          ? 'In implementation'
          : 'Pending decision';

const ballotResultLabel = ballotResult
  ? `${String(ballotResult.result ?? 'Recorded')}${ballotResult.recordedAt ? ` · ${new Date(ballotResult.recordedAt).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' })}` : ''}`
  : 'Not yet recorded';

const decisionChain = proposal
  ? [
      { label: 'Workflow stage', value: stageStepLabel(proposal.stage), href: '#proposal-brief', state: 'done' },
      { label: 'Ballot wording', value: proposal.ballotRevisionId ? ballotRevisionLabel : 'Wording not yet locked', href: proposal.ballotRevisionId ? `#revision-${encodeURIComponent(String(proposal.ballotRevisionId))}` : '#proposal-vote', state: proposal.ballotRevisionId ? 'done' : proposal.stage === 'decide' ? 'current' : 'pending' },
      { label: 'Returning officer result', value: ballotResultLabel, href: ballotResult ? '#proposal-vote' : undefined, state: ballotResult ? 'done' : 'pending' },
      isResolution
        ? {
            label: 'Resolution outcome',
            value: resolutionStatusLabel,
            href: supersededByProposal ? `/proposals/${supersededByProposal.slug}/` : undefined,
            state:
              proposal.supersededByProposalId ||
              proposal.stage === 'archived' ||
              proposal.implementationNote ||
              ballotResult
                ? 'done'
                : 'pending',
          }
        : {
            label: 'Policy Registry',
            value: policyStatusLabel,
            href: evidencePolicyPublic && policyRecord ? `/policies/${encodeURIComponent(String(policyRecord.policyId))}/` : undefined,
            state: policyRecord?.publicationStatus === 'published' ? 'done' : policyRecord ? 'current' : 'pending',
          },
    ]
  : [];

const activityEvents = proposal
  ? [
      ...(policyRecord?.ratification?.ratifiedAt
        ? [{
            date: new Date(policyRecord.ratification.ratifiedAt),
            actor: branchNameFor(policyRecord.ratification.authorityBranchId),
            action: 'ratified policy record',
            badge: String(policyRecord.publicationStatus ?? 'adopted'),
            href: `/policies/${encodeURIComponent(String(policyRecord.policyId))}/`,
          }]
        : []),
      ...(ballotResult?.recordedAt
        ? [{
            date: new Date(ballotResult.recordedAt),
            actor: 'Ballot returning officer',
            action: 'recorded ballot outcome',
            badge: String(ballotResult.result ?? 'recorded'),
            href: '#proposal-vote',
          }]
        : []),
      ...amendmentRows.slice(-3).map((amendment: any) => ({
        date: new Date(amendment.updatedAt ?? amendment.createdAt ?? proposal.updatedAt),
        actor: amendment.authorName || 'Member',
        action: 'submitted formal amendment',
        badge: String(amendment.status ?? 'proposed'),
        href: '#amendments-heading',
      })),
      ...revisions.slice(0, 3).map((revision: any, idx: number) => ({
        date: new Date(revision.createdAt ?? proposal.updatedAt),
        actor: proposal.authorName || 'Author',
        action: revision.revisionId === proposal.ballotRevisionId ? 'bound ballot wording' : 'saved wording snapshot',
        badge: revisionDisplayLabel({ revisionId: String(revision.revisionId), createdAt: revision.createdAt, ordinal: revisions.length - idx }),
        href: '#revision-history-heading',
      })),
      {
        date: new Date(proposal.createdAt),
        actor: proposal.authorName || 'Fusion Working Group',
        action: 'opened proposal record',
        badge: proposal.proposalId,
        href: '#proposal-brief',
      },
    ].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 6)
  : [];

const initialsFor = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('') || 'M';
---
<SiteLayout
  title={proposal ? `${proposal.title} · Engage` : 'Proposal not found · Engage'}
  description={proposal?.summary ?? 'Participatory proposal details, member deliberation, and voting.'}
  canonical={proposal ? `/proposals/${proposal.slug}/` : undefined}
  image={proposalSocialImage}
  imageAlt={proposal ? `${proposal.title} · Engage proposal` : undefined}
  ogType="article"
>
  <div class="page-wrap section-space proposal-detail-page" data-analytics-stage={proposal?.stage}>
    {!proposal ? (
      <Card className="not-found-box">
        <CardContent className="grid justify-items-start gap-3 py-10">
          <h1>Proposal not found</h1>
          <p>That proposal could not be found or has been archived.</p>
          <Button href="/proposals/">Return to Proposals</Button>
        </CardContent>
      </Card>
    ) : (
      <>
        <!-- Top Navigation & Staff Bar -->
        <div class="proposal-topbar">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/proposals/" class="back-link">← All proposals</a>
            <span aria-hidden="true" class="crumb-sep">/</span>
            <a href={`/proposals/?space=${encodeURIComponent(proposal.space)}`}>
              {proposal.space}
            </a>
            <span aria-hidden="true" class="crumb-sep">/</span>
            <span class="tabular crumb-id" aria-current="page">{proposal.proposalId}</span>
          </nav>

          {user?.isStaff && (
            <div class="staff-inline-bar">
              <label for="staff-stage-select" class="staff-inline-label">Stage:</label>
              <NativeSelect
                id="staff-stage-select"
                name="stage"
                defaultValue={proposal.stage}
                data-proposal-id={proposal.proposalId}
                data-current-stage={proposal.stage}
                data-vote-count={votes.total}
              >
                <option value="propose" selected={proposal.stage === 'propose'}>Stage 1 · Idea</option>
                <option value="deliberate" selected={proposal.stage === 'deliberate'}>Stage 2 · Discussion</option>
                <option value="decide" selected={proposal.stage === 'decide'}>Stage 3 · Voting</option>
                <option value="implement" selected={proposal.stage === 'implement'}>Stage 4 · Implementation</option>
                <option value="archived" selected={proposal.stage === 'archived'}>Archived</option>
              </NativeSelect>
              <Button href={`/admin/proposals/${proposal.slug}/`} variant="outline" size="sm">
                Admin workspace
              </Button>
              <span id="staff-stage-msg" class="tabular staff-msg" role="status" aria-live="polite"></span>
            </div>
          )}
        </div>

        <!-- Proposal Hero Header: Topic -> Title -> Lead Summary -> Workflow -> Facts -->
        <header id="proposal-brief" class="proposal-hero">
          <div class="proposal-hero__top">
            <div class="proposal-eyebrow">
              <span class="proposal-eyebrow__id tabular">{proposal.proposalId}</span>
              <span aria-hidden="true">·</span>
              <a href={`/proposals/?space=${encodeURIComponent(proposal.space)}`} class="proposal-eyebrow__space">
                {proposal.space}
              </a>
              <span aria-hidden="true">·</span>
              <span class="proposal-eyebrow__kind">
                {isResolution ? 'Governance resolution' : 'Policy proposal'}
              </span>
            </div>

            <div class="proposal-hero__badges">
              {proposal.stage === 'decide' && myVote && (
                <span class="personal-vote-chip is-voted">✓ You have voted</span>
              )}
              {proposal.stage === 'decide' && !myVote && myPendingVote && (
                <a href="#proposal-vote" class="personal-vote-chip is-action">Queued pending verification →</a>
              )}
              {proposal.stage === 'decide' && !myVote && canVoteOnProposal && (
                <a href="#proposal-vote" class="personal-vote-chip is-action">Your ballot: Unrecorded →</a>
              )}
              <span class:list={['stage-badge', `stage-badge--${proposal.stage}`]}>
                {stagePillLabel(proposal.stage)}
              </span>
            </div>
          </div>

          <h1 class="proposal-hero__title">{proposal.title}</h1>
          <p class="proposal-hero__summary">{proposal.summary}</p>
          {proposal.stage === 'archived' && (
            <div class="superseded-notice" role="status">
              <strong>Archived record (read-only):</strong>{' '}
              This proposal is no longer active for participation or voting. Historical wording and recorded outcomes remain visible for reference.
            </div>
          )}
          {proposal.supersededByProposalId && (
            <div class="superseded-notice">
              <strong>Superseded:</strong>{' '}
              {supersededByProposal ? (
                <>
                  This record has been superseded by{' '}
                  <a href={`/proposals/${supersededByProposal.slug}/`}>{supersededByProposal.proposalId} · {supersededByProposal.title}</a>.
                </>
              ) : (
                <>This record has been superseded.</>
              )}
              {proposal.supersededByNote && <span> {proposal.supersededByNote}</span>}
            </div>
          )}


          <!-- Immediate Next Action Banner (Zero-Friction Entry Point) -->
          <div class:list={[
            'next-action-bar',
            proposal.stage === 'decide' && myVote ? 'is-complete' : proposal.stage === 'decide' ? 'is-vote' : 'is-deliberate',
          ]} role="region" aria-label="Your immediate next action">
            <div class="next-action-bar__copy">
              <span class="next-action-bar__kicker">
                {proposal.stage === 'decide' && ballotExpired(proposal)
                  ? 'Voting has closed. Review the tally and recorded decision.'
                  : proposal.stage === 'decide'
                  ? myVote
                    ? 'Review or change · ~30 seconds'
                    : myPendingVote
                      ? '✓ Queued pending verification'
                      : canVoteOnProposal
                        ? 'Review & vote · About 2 minutes'
                        : !user
                          ? 'Your immediate action · Takes ~1 minute'
                          : eligibility?.level === 'follower'
                            ? 'Follower access · You can follow this proposal'
                            : eligibility?.level === 'not-connected'
                              ? 'Branch ballot · Verified members only'
                              : 'Save your ballot · Takes ~30 seconds'
                  : proposal.stage === 'deliberate' || proposal.stage === 'propose'
                    ? awaitingSeconder
                      ? 'One more member is needed to open deliberation.'
                      : 'Your immediate action · Takes ~1 minute'
                    : 'Stage 4 · Implementation'}
              </span>
              <strong class="next-action-bar__title">
                {proposal.stage === 'decide' && ballotExpired(proposal)
                  ? 'Voting has closed. Review the tally and recorded decision.'
                  : proposal.stage === 'decide'
                  ? myVote
                    ? `Your vote: ${myVote[0]!.toUpperCase() + myVote.slice(1)}. You can change it until voting closes.`
                    : myPendingVote
                      ? `Your "${myPendingVote[0]!.toUpperCase() + myPendingVote.slice(1)}" choice is saved on ${ballotRevisionLabel} and will be formally recorded once an administrator verifies your membership.`
                      : canVoteOnProposal
                        ? 'Review the proposal and cast your vote.'
                        : !user
                          ? 'Sign in to save your vote.'
                          : user.status === 'pending'
                            ? `Save your ballot choice on ${ballotRevisionLabel} now—it will be stored pending membership verification by an administrator.`
                            : eligibility?.level === 'follower' || eligibility?.level === 'not-connected'
                              ? eligibility.reason
                              : 'Verify your membership or branch eligibility to vote in this ballot.'
                  : proposal.stage === 'deliberate' || proposal.stage === 'propose'
                    ? awaitingSeconder
                      ? !user
                        ? 'Sign in to second this proposal and open deliberation.'
                        : canSecondProposal
                          ? 'Second this proposal to open 30 days of deliberation.'
                          : user.memberId === proposal?.authorId
                            ? 'Awaiting another member to second this proposal.'
                            : 'Verify your membership to second this proposal.'
                      : user?.canParticipate
                        ? 'Join the discussion or suggest a wording change.'
                        : 'Sign in as a verified member to post a discussion stance or propose a wording amendment.'
                    : policyRecord
                      ? `Adopted into the Policy Registry (${String(policyRecord.policyId)}). Inspect the official policy record.`
                      : 'Ballot has closed. Review the recorded vote breakdown and ratification status.'}
              </strong>
            </div>
            <div class="next-action-bar__actions">
              {proposal.stage === 'decide' && ballotExpired(proposal) ? <a href="#proposal-vote" class="next-action-btn is-primary">Review ballot &amp; decision →</a> : proposal.stage === 'decide' ? (
                canVoteOnProposal ? (
                  <a href="#proposal-vote" class="next-action-btn is-primary">
                    {myVote ? 'Review or update vote →' : 'Cast your vote now →'}
                  </a>
                ) : !user ? (
                  <a
                    href="#proposal-vote"
                    class="next-action-btn is-primary"
                  >
                    Preview &amp; cast ballot →
                  </a>
                ) : user.status === 'pending' ? (
                  <a href="#proposal-vote" class="next-action-btn is-primary">
                    {myPendingVote ? 'Update queued vote →' : 'Save vote pending verification →'}
                  </a>
                ) : (
                  <a
                    href={eligibility?.level === 'follower' || eligibility?.level === 'not-connected' ? '/member/?view=branches' : '/member/'}
                    class="next-action-btn is-secondary"
                  >
                    {eligibility?.level === 'follower' || eligibility?.level === 'not-connected' ? 'My branches →' : 'Check verification →'}
                  </a>
                )
              ) : proposal.stage === 'deliberate' || proposal.stage === 'propose' ? (
                <>
                  {awaitingSeconder ? (
                    canSecondProposal ? (
                      <SecondProposalButton
                        client:visible
                        proposalId={proposal.proposalId}
                      />
                    ) : !user ? (
                      <Button
                        href={`/member/?returnTo=${encodeURIComponent(`/proposals/${proposal.slug}/`)}&intent=second&title=${encodeURIComponent(proposal.title)}`}
                        size="sm"
                      >
                        Sign in to second
                      </Button>
                    ) : (
                      <Button href="/member/" size="sm" variant="outline">
                        {user.memberId === proposal.authorId
                          ? 'Awaiting a seconder'
                          : 'Verify to second'}
                      </Button>
                    )
                  ) : (
                    <a
                      href={user?.canParticipate ? '#comment-form' : '#deliberation'}
                      class="next-action-btn is-primary"
                    >
                      {user?.canParticipate ? 'Add your stance →' : `Read discussion (${comments.length}) →`}
                    </a>
                  )}
                  {awaitingSeconder && canSecondProposal && (
                    <a
                      href="#comment-form"
                      class="next-action-btn is-secondary"
                    >
                      Discuss instead →
                    </a>
                  )}
                  {!user && (
                    <a
                      href={`/member/?returnTo=${encodeURIComponent(`/proposals/${proposal.slug}/#deliberation`)}&intent=deliberate&title=${encodeURIComponent(proposal.title)}`}
                      class="next-action-btn is-secondary"
                    >
                      Sign in to contribute →
                    </a>
                  )}
                  {user?.canParticipate && (
                    <a href="#amendments-heading" class="next-action-btn is-secondary">
                      Propose amendment ({amendmentRows.length})
                    </a>
                  )}
                </>
              ) : policyRecord ? (
                <a href={`/policies/${encodeURIComponent(String(policyRecord.policyId))}/`} class="next-action-btn is-primary">
                  Open policy record →
                </a>
              ) : (
                <a href="#proposal-vote" class="next-action-btn is-secondary">
                  View ballot tally →
                </a>
              )}
            </div>
          </div>

          <!-- Clear 4-Step Lifecycle Progress Bar -->
          <div class="workflow-banner" aria-label="Proposal workflow stage">
            <ol class="workflow-steps">
              {stages.map((stg, idx) => {
                const isPast = currentStageIndex > idx;
                const isCurrent = proposal.stage === stg;
                return (
                  <li class:list={['workflow-step', { 'is-past': isPast, 'is-current': isCurrent }]}>
                    <span class="workflow-step__num tabular" aria-hidden="true">
                      {isPast ? '✓' : idx + 1}
                    </span>
                    <span class="workflow-step__label">
                      {stg === 'propose' ? 'Idea' : stg === 'deliberate' ? 'Discussion' : stg === 'decide' ? 'Voting' : 'Implementation'}
                    </span>
                  </li>
                );
              })}
            </ol>
            <p class="workflow-caption">{stageGuideText(proposal.stage)}</p>
          </div>

          <!-- Scannable Governance Facts Strip -->
          <dl class="governance-facts">
            <div class="governance-fact">
              <dt>Proposed by</dt>
              <dd>
                <span class="fact-avatar" aria-hidden="true">{initialsFor(proposal.authorName || 'Fusion Working Group')}</span>
                <strong>{proposal.authorName || 'Fusion Working Group'}</strong>
              </dd>
            </div>
            <div class="governance-fact">
              <dt>Applies to</dt>
              <dd>
                <strong>{branchNameFor(proposal.jurisdictionBranchId)}</strong>
                <span class="fact-sub">Authority: {branchNameFor(proposal.governanceAuthorityBranchId)}</span>
              </dd>
            </div>
            <div class="governance-fact">
              <dt>Ballot wording</dt>
              <dd>
                <strong>{ballotRevisionLabel}</strong>
                <span class="fact-sub tabular">
                  {votes.total} {votes.total === 1 ? 'ballot cast' : 'ballots cast'} · {comments.length} {comments.length === 1 ? 'contribution' : 'contributions'}
                </span>
              </dd>
            </div>
            <div class="governance-fact">
              <dt>{isResolution ? 'Resolution outcome' : 'Policy Registry'}</dt>
              <dd>
                {isResolution ? (
                  <strong>{resolutionStatusLabel}</strong>
                ) : evidencePolicyPublic && policyRecord ? (
                  <a class="fact-link" href={`/policies/${encodeURIComponent(String(policyRecord.policyId))}/`}>
                    {policyStatusLabel} →
                  </a>
                ) : (
                  <strong>{policyStatusLabel}</strong>
                )}
                <span class="fact-sub">
                  Updated <time class="tabular" datetime={new Date(proposal.updatedAt).toISOString()}>{new Date(proposal.updatedAt).toLocaleDateString('en-AU', { dateStyle: 'medium' })}</time>
                </span>
              </dd>
            </div>
          </dl>
        </header>

        {canVoteOnProposal && proposal.stage === 'decide' && (
          <nav class="proposal-progression" aria-label="Proposal progression">
            <span data-outstanding-after-vote={remainingBallots.length}>{remainingBallots.length + (myVote ? 0 : 1)} need your vote</span>
            {nextBallotInfo && <a href={`/proposals/${nextBallotInfo.slug}/`}>Skip for now →</a>}
            <a href="/proposals/?stage=decide&focus=all">All ballots</a>
          </nav>
        )}

        <!-- Sticky Section Jump Navigation -->
        <nav class="reading-nav" aria-label="Jump to proposal section">
          <div class="reading-nav__links">
            <a href="#proposal-brief" aria-current="location">Overview</a>
            {proposal.outcomes.length > 0 && (
              <a href="#outcomes-heading">
                Key commitments <span class="nav-count tabular">{proposal.outcomes.length}</span>
              </a>
            )}
            {(proposal.details || proposal.detailHtml) && (
              <a href="#details-heading">Rationale</a>
            )}
            <a href="#amendments-heading">
              Amendments <span class="nav-count tabular">{amendmentRows.length}</span>
            </a>
            <a href="#deliberation">
              Discussion <span class="nav-count tabular">{comments.length}</span>
            </a>
            <a href="#revision-history-heading">
              History <span class="nav-count tabular">{revisions.length}</span>
            </a>
          </div>
          <a href="#proposal-vote" class="reading-nav__cta">
            {proposal.stage === 'decide'
              ? myVote
                ? 'Review your vote →'
                : 'Review & vote →'
              : 'Ballot status →'}
          </a>
        </nav>

        <!-- Two-Column Workspace: Primary Content + Contextual Ballot & Governance Sidebar -->
        <div class="proposal-workspace">
          <!-- Primary Reading & Participation Column -->
          <div class="proposal-main">
            {proposal.attachmentUrl && (
              <section class="doc-card attachment-card" aria-label="Supporting attachment">
                {isImageAttachment && (
                  <a href={proposal.attachmentUrl} target="_blank" rel="noopener noreferrer" class="attachment-preview">
                    <img src={proposal.attachmentUrl} alt={`${proposal.title} supporting asset`} loading="lazy" />
                  </a>
                )}
                <div class="attachment-card__body">
                  <div class="attachment-card__info">
                    <div class="attachment-card__title">
                      <FileText className="size-4 text-muted-foreground" aria-hidden="true" />
                      <strong>{isImageAttachment ? 'Supporting visual specification' : 'Supporting reference document'}</strong>
                    </div>
                    <p>{proposal.attachmentDescription || 'Reference specification and documentation attached to this proposal record.'}</p>
                  </div>
                  <Button href={proposal.attachmentUrl} target="_blank" rel="noopener noreferrer" variant="outline" size="sm">
                    {isImageAttachment ? 'Open full image ↗' : 'Open document ↗'}
                  </Button>
                </div>
              </section>
            )}

            {(proposal.stage === 'implement' || proposal.implementationNote) && (
              <section class="doc-card implementation-banner" aria-labelledby="impl-heading">
                <div class="implementation-banner__head">
                  <Badge variant="info">Stage 4 · Implementation</Badge>
                  <h2 id="impl-heading">Decision processing &amp; ratification status</h2>
                </div>
                <p>
                  {proposal.implementationNote || (policyRecord
                    ? `This wording was formally adopted by ${branchNameFor(policyRecord.ratification?.authorityBranchId)} and is recorded in the official policy registry.`
                    : 'The decision is being processed. Required authorisation and publication steps have not been recorded, so this wording is not yet published as official policy.')}
                </p>
                {user?.isStaff && (
                  <details class="impl-edit-details">
                    <summary>Update implementation &amp; ratification note</summary>
                    <form id="impl-note-form" data-proposal-id={proposal.proposalId}>
                      <Textarea
                        id="impl-note-text"
                        name="implementationNote"
                        rows={2}
                        defaultValue={proposal.implementationNote || ''}
                        placeholder="Record authorisation, publication or rollout progress..."
                      />
                      <div class="impl-note-actions">
                        <Button type="submit" size="sm" id="impl-note-btn">Save note</Button>
                        <span id="impl-note-status" class="form-status" role="status"></span>
                      </div>
                    </form>
                  </details>
                )}
              </section>
            )}

            <!-- Key Commitments -->
            <section id="proposal-decision" class="decision-content" aria-label="Proposal summary and commitments">

            {proposal.outcomes.length > 0 && (
              <section aria-labelledby="outcomes-heading">
                <div class="doc-section__header">
                  <div>
                    <h2 id="outcomes-heading">Key commitments</h2>

                  </div>
                  <span class="doc-count tabular">{proposal.outcomes.length} {proposal.outcomes.length === 1 ? 'commitment' : 'commitments'}</span>
                </div>

                <ol class="commitments-list">
                  {proposal.outcomes.map((item, idx) => (
                    <li class="commitment-item">
                      <span class="commitment-num tabular" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
                      <p>{item}</p>
                    </li>
                  ))}
                </ol>
              </section>
            )}

            <!-- Rationale & Context -->
            {(proposal.details || proposal.detailHtml) && (
              <section class="decision-rationale" aria-labelledby="details-heading">
                <details>
                <summary class="rationale-toggle">Rationale &amp; background</summary>
                <div class="doc-section__header">
                  <div>
                    <h2 id="details-heading" class="sr-only">Rationale &amp; background</h2>

                  </div>
                </div>
                <div class="prose-content">
                  <PortableText value={proposal.details} html={proposal.detailHtml} />
                </div>
                </details>
              </section>
            )}

            </section>

            <section id="proposal-vote" class:list={['rail-card', 'rail-ballot', { 'is-open': proposal.stage === 'decide' }]}>
              <div class="rail-card__head">
                <div>
                  <h2>Member ballot</h2>
                </div>
                <span class:list={['stage-badge', proposal.stage === 'decide' ? 'stage-badge--decide' : 'stage-badge--muted']}>
                  {ballotState}
                </span>
              </div>

              <details id="ballot-context" class="ballot-context" open>
                <summary>What you’re deciding</summary>
                <p>{proposal.summary}</p>
                <a href="#proposal-decision">Review commitments</a>
              </details>
              <details class="ballot-record">
                <summary>Ballot record</summary>
                <p>Wording: {ballotRevisionLabel}</p>
                {ballotResult && <p>Returning officer result: {ballotResultLabel}</p>}
              </details>

              {proposal.stage === 'decide' && !canVoteOnProposal && (
                <div class="rail-notice">
                  {eligibility?.level === 'follower' || eligibility?.level === 'not-connected' || eligibility?.level === 'branch-unavailable' ? (
                    <div class="rail-notice__row">
                      <p>{eligibility.reason}</p>
                      {eligibility.level !== 'branch-unavailable' && (
                        <Button href="/member/?view=branches" variant="outline" size="sm">My branches</Button>
                      )}
                    </div>
                  ) : user ? (
                    <div class="rail-notice__row">
                      <p>
                        {myPendingVote
                          ? 'Your ballot choice is saved and will be recorded once an administrator verifies your membership.'
                          : 'Your membership is awaiting verification. You can save your ballot choice below now and it will be recorded once verified.'}
                      </p>
                      <Button href="/member/" variant="outline" size="sm">Account</Button>
                    </div>
                  ) : (
                    <div class="rail-notice__row">
                      <p>
                        {votes.total > 0
                          ? `Join ${votes.total} verified ${votes.total === 1 ? 'vote' : 'votes'} on this revision—choose your option below or sign in to record your ballot.`
                          : 'Choose your option below to preview your ballot, or sign in with your passkey or email link to vote.'}
                      </p>
                    </div>
                  )}
                </div>
              )}

              {proposal.stage === 'decide' || votes.total > 0 ? (
                <div class="rail-ballot__widget">
                  <ProposalBallot
                    client:idle
                    proposalId={proposal.proposalId}
                    proposalSlug={proposal.slug}
                    proposalTitle={proposal.title}
                    initialChoice={myVote}
                    initialReason={myReason}
                    initialPendingChoice={myPendingVote}
                    initialPendingReason={myPendingReason}
                    initialTally={votes}
                    open={proposal.stage === 'decide' && !ballotExpired(proposal)}
                    canVote={canVoteOnProposal}
                    ineligibleReason={!canVoteOnProposal ? eligibility?.reason : undefined}
                    isGuest={!user}
                    isPendingMember={Boolean(user && !user.canParticipate && user.status === 'pending')}
                    nextBallot={nextBallotInfo}
                    ballotClosesAt={proposal.ballotClosesAt ? new Date(proposal.ballotClosesAt).toISOString() : null}
                  />
                </div>
              ) : (
                <p class="rail-muted">
                  Formal voting has not opened yet. Join the member discussion or propose a wording amendment while this proposal is in deliberation.
                </p>
              )}

              <BallotPrivacyNotice />
            </section>

            <!-- Formal Amendments Section -->
            <section class="doc-section" aria-labelledby="amendments-heading">
              <div class="doc-section__header">
                <div>
                  <div class="doc-title-row">
                    <h2 id="amendments-heading">Formal amendments</h2>
                    <span class="doc-count tabular">{amendmentRows.length}</span>
                  </div>
                  <p class="doc-section__sub">
                    Structured wording changes recorded against a specific revision. Amendment endorsements do not cast your final proposal ballot.
                  </p>
                </div>
              </div>

              {amendmentRows.length > 0 ? (
                <div class="amendment-list">
                  {amendmentRows.map((amendment: any, index: number) => {
                    const base = revisions.find((revision: any) => revision.revisionId === amendment.baseRevisionId);
                    const statusTone = ['endorsed', 'applied', 'accepted'].includes(String(amendment.status))
                      ? 'success'
                      : amendment.status === 'conflict'
                        ? 'destructive'
                        : amendment.status === 'voting'
                          ? 'info'
                          : 'warning';
                    return (
                      <article class="amendment-card" id={`amendment-${String(amendment.amendmentId)}`}>
                        <div class="amendment-card__head">
                          <div class="amendment-card__title">
                            <span class="amendment-badge tabular">Amendment #{index + 1}</span>
                            <div>
                              <strong>{amendment.changes?.title ?? 'Proposed wording revision'}</strong>
                              <p class="amendment-meta">
                                Base revision <code>{String(amendment.baseRevisionId).slice(0, 8)}</code> · snapshot <code>{String(amendment.currentRevisionId ?? 'legacy').slice(0, 8)}</code>
                                {amendment.rebasedFromRevisionId ? ` · rebased from ${String(amendment.rebasedFromRevisionId).slice(0, 8)}` : ''}
                              </p>
                            </div>
                          </div>
                          <Badge variant={statusTone}>{amendment.status}</Badge>
                        </div>

                        {amendment.conflicts?.length > 0 && (
                          <p class="amendment-conflict" role="status">
                            This amendment overlaps with wording changed since its base revision. An administrator must resolve the conflict before it can be applied.
                          </p>
                        )}
                        {amendment.resolution?.reason && (
                          <p class="amendment-resolution-note">
                            <strong>Review note ({amendment.resolution.outcome}):</strong> {amendment.resolution.reason}
                          </p>
                        )}

                        <div class="amendment-card__body">
                          {Object.entries(amendment.changes ?? {}).map(([field, value]: [string, any]) => (
                            <details class="diff-drawer" open={amendmentRows.length === 1 && index === 0}>
                              <summary>Compare proposed change to <code>{field}</code></summary>
                              <div class="amendment-diff">
                                <div class="diff-pane diff-pane--before">
                                  <span class="diff-label">Current base wording</span>
                                  <pre>{Array.isArray(base?.snapshot?.[field]) ? base.snapshot[field].join('\n') : String(base?.snapshot?.[field] ?? '')}</pre>
                                </div>
                                <div class="diff-pane diff-pane--after">
                                  <span class="diff-label">Proposed replacement</span>
                                  <pre>{Array.isArray(value) ? value.join('\n') : String(value ?? '')}</pre>
                                </div>
                              </div>
                            </details>
                          ))}

                          {amendment.revisionHistory?.length > 1 && (
                            <details class="diff-drawer">
                              <summary>Amendment revision log ({amendment.revisionHistory.length} snapshots)</summary>
                              <ol class="amendment-history-list">
                                {amendment.revisionHistory.map((row: any) => (
                                  <li>
                                    <code>{String(row.revisionId).slice(0, 8)}</code> · {row.authorId === user?.memberId ? 'You' : 'Contributor'} · {new Date(row.createdAt).toLocaleDateString('en-AU')}
                                  </li>
                                ))}
                              </ol>
                            </details>
                          )}

                          {amendment.status === 'voting' && canVoteOnProposal && (
                            <form class="amendment-vote-form" data-amendment-id={amendment.amendmentId} data-proposal-id={proposal.proposalId}>
                              <div class="amendment-vote-form__info">
                                <strong>Endorse or reject this amendment</strong>
                                <p>Records support for adopting this wording revision. Separate from the main proposal ballot.</p>
                              </div>
                              <div class="amendment-vote-buttons">
                                {['approve', 'abstain', 'reject'].map((choice) => (
                                  <Button type="button" variant="outline" size="sm" data-choice={choice}>
                                    {choice[0]!.toUpperCase() + choice.slice(1)}
                                  </Button>
                                ))}
                              </div>
                              <span role="status" aria-live="polite"></span>
                            </form>
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              ) : (
                <div class="empty-box">
                  <p>No formal wording amendments have been filed against this proposal.</p>
                </div>
              )}

              {user?.canParticipate && ['propose', 'deliberate'].includes(proposal.stage) && (
                <details class="amendment-compose">
                  <summary>+ Propose a formal wording amendment</summary>
                  <div class="amendment-compose__body">
                    <p>
                      Records a formal amendment against the latest saved revision (<code>{String(revisions[0]?.revisionId ?? 'initial').slice(0, 8)}</code>). For general feedback, use the Member discussion section below.
                    </p>
                    <form id="amendment-form" class="grid gap-3" data-proposal-id={proposal.proposalId} data-revision-id={revisions[0]?.revisionId ?? ''}>
                      <Field label="Proposed title (optional)" htmlFor="amendment-title">
                        <Input id="amendment-title" name="title" maxLength={200} placeholder="Leave blank to keep current title" />
                      </Field>
                      <Field label="Replacement summary" hint="At least 10 characters" htmlFor="amendment-summary">
                        <Textarea id="amendment-summary" name="summary" rows={3} minLength={10} maxLength={2000} placeholder="Draft the exact replacement summary wording..." required />
                      </Field>
                      <div class="form-actions">
                        <Button type="submit" size="sm">Submit formal amendment</Button>
                        <span class="amendment-compose-status" role="status" aria-live="polite"></span>
                      </div>
                    </form>
                  </div>
                </details>
              )}
            </section>

            <!-- Member Deliberation / Discussion Section -->
            <section id="deliberation" class="doc-section deliberation-section" aria-labelledby="deliberate-heading">
              <div class="doc-section__header">
                <div>
                  <div class="doc-title-row">
                    <h2 id="deliberate-heading">Member discussion</h2>
                    <span class="doc-count tabular">{comments.length} {comments.length === 1 ? 'contribution' : 'contributions'}</span>
                  </div>
                  <p class="doc-section__sub">
                    Deliberative perspectives from verified members. Discussion stances inform refinement and do not count as formal ballots.
                  </p>
                </div>

                <!-- Stance Filter Pills + Sort -->
                <div class="deliberation-controls">
                  <div class="stance-filters" role="group" aria-label="Filter contributions by stance">
                    <Button type="button" variant="outline" size="sm" className="stance-pill" data-stance="all" aria-pressed="true">
                      All <span class="tabular">{stanceCounts.all}</span>
                    </Button>
                    <Button type="button" variant="outline" size="sm" className="stance-pill" data-stance="support" aria-pressed="false">
                      <ThumbsUp aria-hidden="true" /> Support <span class="tabular">{stanceCounts.support}</span>
                    </Button>
                    <Button type="button" variant="outline" size="sm" className="stance-pill" data-stance="concern" aria-pressed="false">
                      <AlertCircle aria-hidden="true" /> Concern <span class="tabular">{stanceCounts.concern}</span>
                    </Button>
                    <Button type="button" variant="outline" size="sm" className="stance-pill" data-stance="amendment" aria-pressed="false">
                      <PenLine aria-hidden="true" /> Wording <span class="tabular">{stanceCounts.amendment}</span>
                    </Button>
                    <Button type="button" variant="outline" size="sm" className="stance-pill" data-stance="comment" aria-pressed="false">
                      <MessageCircle aria-hidden="true" /> Comment <span class="tabular">{stanceCounts.comment}</span>
                    </Button>
                  </div>
                  {comments.length > 1 && (
                    <div class="comment-sort">
                      <NativeSelect id="comment-sort-select" data-comment-sort defaultValue="oldest" size="sm" wrapperClassName="w-auto" className="rounded-full" aria-label="Sort contributions">
                        <option value="top">Top endorsed</option>
                        <option value="newest">Newest first</option>
                        <option value="oldest" selected>Oldest first</option>
                      </NativeSelect>
                    </div>
                  )}
                </div>
              </div>

              {(topSupportComment || topConcernComment) && (
                <div class="deliberation-takeaways" aria-label="Key deliberation takeaways">
                  {topSupportComment && (
                    <div class="takeaway-box takeaway-box--support">
                      <div class="takeaway-box__head">
                        <Badge variant="success">Leading support</Badge>
                        <span class="takeaway-meta tabular">
                          {topSupportComment.authorName} · {topSupportComment.upvotes.length} {topSupportComment.upvotes.length === 1 ? 'endorsement' : 'endorsements'}
                        </span>
                      </div>
                      <p class="takeaway-quote">{topSupportComment.body}</p>
                    </div>
                  )}
                  {topConcernComment && (
                    <div class="takeaway-box takeaway-box--concern">
                      <div class="takeaway-box__head">
                        <Badge variant="destructive">Leading concern</Badge>
                        <span class="takeaway-meta tabular">
                          {topConcernComment.authorName} · {topConcernComment.upvotes.length} {topConcernComment.upvotes.length === 1 ? 'endorsement' : 'endorsements'}
                        </span>
                      </div>
                      <p class="takeaway-quote">{topConcernComment.body}</p>
                    </div>
                  )}
                </div>
              )}

              <!-- Reddit-style Top Contribution Composer -->
              {user?.canParticipate ? (
                <form id="comment-form" class="comment-composer" data-proposal-id={proposal.proposalId}>
                  <div class="comment-composer__box">
                    <label for="comment-body-input" class="sr-only">Join the discussion</label>
                    <Textarea
                      id="comment-body-input"
                      name="body"
                      required
                      minLength={5}
                      maxLength={4000}
                      rows={3}
                      placeholder="Join the conversation — share support, raise an implementation concern, or suggest wording..."
                      className="focus-visible:ring-0"
                    />

                    <div class="comment-composer__toolbar">
                      <StanceSelector client:idle />

                      <div class="comment-composer__submit">
                        <span id="comment-char-count" class="comment-char-count tabular">0 / 4000</span>
                        <span id="comment-status-msg" class="tabular form-status" role="status" aria-live="polite"></span>
                        <Button type="submit" size="sm" id="comment-submit-btn">
                          Post
                        </Button>
                      </div>
                    </div>
                  </div>

                  <div class="stance-starters" aria-label="Quick stance starters">
                    <span class="stance-starters__hint">Prompts:</span>
                    <Button
                      type="button"
                      className="starter-chip"
                      variant="outline"
                      size="sm"
                      data-starter-stance="support"
                      data-starter-placeholder="What makes this proposal valuable or effective? Share the evidence or outcomes you support..."
                    >
                      I support this because…
                    </Button>
                    <Button
                      type="button"
                      className="starter-chip"
                      variant="outline"
                      size="sm"
                      data-starter-stance="concern"
                      data-starter-placeholder="What unintended consequence, cost, or implementation risk should members consider?"
                    >
                      Implementation concern…
                    </Button>
                    <Button
                      type="button"
                      className="starter-chip"
                      variant="outline"
                      size="sm"
                      data-starter-stance="amendment"
                      data-starter-placeholder="Which sentence or commitment should be clarified, and what wording do you suggest?"
                    >
                      Suggested wording tweak…
                    </Button>
                    <Button
                      type="button"
                      className="starter-chip"
                      variant="outline"
                      size="sm"
                      data-starter-stance="comment"
                      data-starter-placeholder="Ask a clarifying question or share context for other members..."
                    >
                      Clarifying question…
                    </Button>
                  </div>
                </form>
              ) : user ? (
                <div class="participation-notice">
                  <div>
                    <strong>Membership verification pending</strong>
                    <p>Your account is awaiting membership verification before posting contributions.</p>
                  </div>
                  <Button href="/member/" variant="outline" size="sm">Check status</Button>
                </div>
              ) : (
                <div class="participation-notice">
                  <div>
                    <strong>Have a perspective on this proposal?</strong>
                    <p>
                      {comments.length > 0
                        ? `Join ${comments.length} member ${comments.length === 1 ? 'contribution' : 'contributions'}—sign in with a passkey or 1-click email link to add your stance or endorse feedback.`
                        : 'Sign in with a passkey or 1-click email link to share the first member perspective on this proposal.'}
                    </p>
                  </div>
                  <Button
                    href={`/member/?returnTo=${encodeURIComponent(`/proposals/${proposal.slug}/#deliberation`)}&intent=deliberate&title=${encodeURIComponent(proposal.title)}`}
                    size="sm"
                  >
                    Sign in to participate
                  </Button>
                </div>
              )}

              <!-- Contributions Thread -->
              <div id="comments-list" class="comments-thread">
                {comments.length === 0 ? (
                  <div class="empty-box">
                    <p>No member contributions yet. Share the first perspective below.</p>
                  </div>
                ) : (
                  comments.map((c) => {
                    const isAuthor = user && c.memberId === user.memberId;
                    const canDelete = isAuthor || user?.isStaff;
                    const hasEndorsed = user && c.upvotes.includes(user.memberId);
                    return (
                      <article
                        class="comment-card"
                        data-stance={c.stance}
                        data-comment-id={c.commentId}
                        data-upvotes={c.upvotes.length}
                        data-created-at={new Date(c.createdAt).getTime()}
                      >
                        <span class="comment-avatar" aria-hidden="true">{initialsFor(c.authorName || 'Member')}</span>
                        <div class="comment-box">
                          <div class="comment-card__head">
                            <div class="comment-author__meta">
                              <strong class="author-name">{c.authorName}</strong>
                              <Badge variant={c.stance === 'support' ? 'success' : c.stance === 'concern' ? 'destructive' : c.stance === 'amendment' ? 'warning' : 'muted'}>
                                {c.stance === 'amendment' ? 'Wording suggestion' : c.stance[0]!.toUpperCase() + c.stance.slice(1)}
                              </Badge>
                              <time class="tabular comment-date" datetime={new Date(c.createdAt).toISOString()}>
                                {new Date(c.createdAt).toLocaleDateString('en-AU', {
                                  month: 'short',
                                  day: 'numeric',
                                  year: 'numeric',
                                })}
                              </time>
                            </div>

                            <div class="comment-card__actions">
                              <Button
                                type="button"
                                variant={hasEndorsed ? 'secondary' : 'outline'}
                                size="sm"
                                className="endorse-btn"
                                data-endorse-id={c.commentId}
                                disabled={!user?.canParticipate}
                                title={user?.canParticipate ? 'Endorse contribution' : 'Sign in to endorse'}
                              >
                                <ThumbsUp aria-hidden="true" />
                                <span>Endorse</span>
                                <span class="endorse-count tabular">{c.upvotes.length}</span>
                              </Button>

                              {user?.canParticipate && (
                                <Button
                                  type="button"
                                  variant="ghost"
                                  size="sm"
                                  className="reply-btn"
                                  data-reply-author={c.authorName}
                                >
                                  Reply
                                </Button>
                              )}

                              {canDelete && (
                                <Button
                                  type="button"
                                  variant="ghost"
                                  size="sm"
                                  className="delete-btn text-[var(--horizon-danger-ink)]"
                                  data-delete-comment={c.commentId}
                                >
                                  Delete
                                </Button>
                              )}
                            </div>
                          </div>

                          <div class="comment-card__body">
                            <p>{c.body}</p>
                          </div>

                          <div class="comment-feedback-slot" data-feedback-slot={c.commentId}>
                            {c.feedback && (() => {
                              const resolvedEvidence = c.feedback.evidence
                                ? evidenceMap.get(`${c.feedback.evidence.kind}:${c.feedback.evidence.recordId}`)
                                : undefined;
                              return (
                                <div class="comment-feedback">
                                  <Badge variant={feedbackStatusVariant(c.feedback.status)}>
                                    {feedbackStatusLabel(c.feedback.status)}
                                  </Badge>
                                  <div class="comment-feedback__copy">
                                    {c.feedback.note && <p>{c.feedback.note}</p>}
                                    {resolvedEvidence && (
                                      <p class="comment-feedback__evidence">
                                        <strong>Evidence:</strong>{' '}
                                        {resolvedEvidence.href ? (
                                          <a href={resolvedEvidence.href}>{resolvedEvidence.label}</a>
                                        ) : (
                                          <span>{resolvedEvidence.label}</span>
                                        )}
                                      </p>
                                    )}
                                    <small>
                                      Response by {c.feedback.updatedByName} ·{' '}
                                      {new Date(c.feedback.updatedAt).toLocaleDateString('en-AU', {
                                        day: 'numeric',
                                        month: 'short',
                                        year: 'numeric',
                                      })}
                                    </small>
                                  </div>
                                </div>
                              );
                            })()}
                          </div>

                          {c.feedbackHistory && (c.feedbackHistory.length > 1 || (!c.feedback && c.feedbackHistory.length > 0)) && (
                            <details class="comment-feedback-history">
                              <summary>Response history ({c.feedbackHistory.length})</summary>
                              <ul>
                                {c.feedbackHistory.map((entry) => {
                                  const histEvidence = entry.evidence
                                    ? evidenceMap.get(`${entry.evidence.kind}:${entry.evidence.recordId}`)
                                    : undefined;
                                  return (
                                    <li>
                                      <strong>{entry.action === 'cleared' ? 'Cleared' : feedbackStatusLabel(entry.action)}</strong>
                                      {entry.note ? ` — ${entry.note}` : ''}
                                      {histEvidence ? (
                                        <>
                                          {' · '}
                                          {histEvidence.href ? (
                                            <a href={histEvidence.href}>{histEvidence.label}</a>
                                          ) : (
                                            <span>{histEvidence.label}</span>
                                          )}
                                        </>
                                      ) : null}
                                      {' · '}{entry.updatedByName} (
                                      {new Date(entry.updatedAt).toLocaleDateString('en-AU', {
                                        day: 'numeric',
                                        month: 'short',
                                        year: 'numeric',
                                      })})
                                    </li>
                                  );
                                })}
                              </ul>
                            </details>
                          )}

                          {canRespondToFeedback && (
                            <details class="comment-feedback-drawer">
                              <summary>{c.feedback ? 'Update response' : 'Record response'}</summary>
                              <form class="comment-feedback-form" data-comment-id={c.commentId}>
                                <div class="comment-feedback-form__row">
                                  <label for={`feedback-status-${c.commentId}`} class="sr-only">Contribution outcome</label>
                                  <NativeSelect
                                    id={`feedback-status-${c.commentId}`}
                                    name="status"
                                    defaultValue={c.feedback?.status ?? 'considered'}
                                    size="sm"
                                    wrapperClassName="w-auto"
                                  >
                                    <option value="incorporated" selected={(c.feedback?.status ?? 'considered') === 'incorporated'}>Incorporated</option>
                                    <option value="considered" selected={(c.feedback?.status ?? 'considered') === 'considered'}>Considered</option>
                                    <option value="deferred" selected={c.feedback?.status === 'deferred'}>Deferred</option>
                                    <option value="declined" selected={c.feedback?.status === 'declined'}>Declined</option>
                                    {c.feedback && <option value="clear">Clear response</option>}
                                  </NativeSelect>
                                  <label for={`feedback-note-${c.commentId}`} class="sr-only">Explanation for contributor (optional)</label>
                                  <Input
                                    id={`feedback-note-${c.commentId}`}
                                    type="text"
                                    name="note"
                                    maxLength={500}
                                    defaultValue={c.feedback?.note ?? ''}
                                    placeholder="Short explanation for the contributor (optional)"
                                  />
                                  <Button type="submit" variant="outline" size="sm" className="comment-feedback-save">Save</Button>
                                </div>
                                {evidenceOptions.length > 0 && (
                                  <div class="comment-feedback-form__evidence">
                                    <label for={`feedback-evidence-${c.commentId}`} class="sr-only">Supporting evidence (optional)</label>
                                    <NativeSelect
                                      id={`feedback-evidence-${c.commentId}`}
                                      name="evidenceRef"
                                      defaultValue={c.feedback?.evidence ? `${c.feedback.evidence.kind}:${c.feedback.evidence.recordId}` : ''}
                                      size="sm"
                                    >
                                      <option value="">Supporting evidence (optional) — None</option>
                                      {evidenceOptions.map((opt) => (
                                        <option value={opt.value} selected={c.feedback?.evidence ? `${c.feedback.evidence.kind}:${c.feedback.evidence.recordId}` === opt.value : false}>{opt.group}: {opt.label}</option>
                                      ))}
                                    </NativeSelect>
                                  </div>
                                )}
                                <span class="comment-feedback-status" role="status" aria-live="polite"></span>
                              </form>
                            </details>
                          )}
                        </div>
                      </article>
                    );
                  })
                )}
              </div>
            </section>

            <!-- Wording Revision Log & Provenance -->
            <section class="doc-section audit-section" aria-labelledby="revision-history-heading">
              <div class="doc-section__header">
                <div>
                  <div class="doc-title-row">
                    <h2 id="revision-history-heading">Wording revision history &amp; provenance</h2>
                    <span class="doc-count tabular">{revisions.length} {revisions.length === 1 ? 'snapshot' : 'snapshots'}</span>
                  </div>
                  <p class="doc-section__sub">
                    Immutable snapshots of proposal wording and constitutional lineage. Every formal ballot is bound to a single revision ID.
                  </p>
                </div>
              </div>

              {revisions.length > 0 && (
                <ol class="revision-list">
                  {revisions.map((revision, index) => {
                    const parent = revisions[index + 1];
                    const changed = parent ? Object.keys(revision.snapshot).flatMap((field) => {
                      const before = parent.snapshot[field];
                      const after = revision.snapshot[field];
                      return JSON.stringify(before) === JSON.stringify(after) ? [] : [{ field, before, after }];
                    }) : [];
                    return (
                      <li class="revision-row" id={`revision-${String(revision.revisionId)}`}>
                        <div class="revision-row__main">
                          <div class="revision-row__title">
                            <strong>{revisionDisplayLabel({ revisionId: String(revision.revisionId), createdAt: revision.createdAt, ordinal: revisions.length - index })}</strong>
                            <code title={String(revision.revisionId)}>{String(revision.revisionId).slice(0, 8)}</code>
                            {index === 0 && <Badge variant="muted">Latest</Badge>}
                            {revision.revisionId === proposal.ballotRevisionId && <Badge variant="info">Bound ballot wording</Badge>}
                          </div>
                          <span class="revision-row__meta tabular">
                            {new Date(revision.createdAt).toLocaleDateString('en-AU', { dateStyle: 'medium' })} · {changed.length ? `${changed.length} changed ${changed.length === 1 ? 'field' : 'fields'}` : parent ? 'No wording changes' : 'Initial wording snapshot'}
                          </span>
                        </div>
                        {changed.length > 0 && (
                          <details class="diff-drawer">
                            <summary>Inspect wording diff</summary>
                            {changed.map((change) => (
                              <div class="amendment-diff">
                                <div class="diff-pane diff-pane--before">
                                  <span class="diff-label">{change.field} (previous)</span>
                                  <pre>{Array.isArray(change.before) ? change.before.join('\n') : String(change.before ?? '')}</pre>
                                </div>
                                <div class="diff-pane diff-pane--after">
                                  <span class="diff-label">{change.field} (updated)</span>
                                  <pre>{Array.isArray(change.after) ? change.after.join('\n') : String(change.after ?? '')}</pre>
                                </div>
                              </div>
                            ))}
                          </details>
                        )}
                      </li>
                    );
                  })}
                </ol>
              )}

              {proposal.provenance && (
                <div id="provenance-heading" class="provenance-box">
                  <div class="provenance-box__head">
                    <div>
                      <h3>
                        {isResolution ? 'Resolution Context & Constitutional Authority' : 'Policy Provenance & Prior Approval'}
                      </h3>
                      <p class="provenance-box__sub">
                        {isResolution
                          ? 'Constitutional authority, organizational precedents, and scrutiny notes from party records.'
                          : 'Lineage and scrutiny details from party archives and published platform versions.'}
                      </p>
                    </div>
                    <Badge variant="outline">{proposal.provenance.label}</Badge>
                  </div>

                  <p class="provenance-summary">{proposal.provenance.summary}</p>

                  {proposal.provenance.uncertaintyNote && (
                    <div class="provenance-callout">
                      <strong>Scrutiny note:</strong> {proposal.provenance.uncertaintyNote}
                    </div>
                  )}

                  <div class="provenance-columns">
                    {proposal.provenance.lineage && proposal.provenance.lineage.length > 0 && (
                      <div class="provenance-subblock">
                        <h4>{isResolution ? 'Preceding documents & authorities' : 'Prior policy predecessors'}</h4>
                        <ul class="provenance-links">
                          {proposal.provenance.lineage.map((item) => (
                            <li>
                              {item.url ? (
                                <a href={item.url} target="_blank" rel="noopener noreferrer" class="lineage-link">
                                  {item.label} ↗
                                </a>
                              ) : (
                                <span class="lineage-label">{item.label}</span>
                              )}
                              {item.description && <span class="lineage-desc"> — {item.description}</span>}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {proposal.provenance.valuesAlignment && proposal.provenance.valuesAlignment.length > 0 && (
                      <div class="provenance-subblock">
                        <h4>Values &amp; principles alignment</h4>
                        <ul class="provenance-values">
                          {proposal.provenance.valuesAlignment.map((val) => (
                            <li>{val}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </section>
          </div>

          <!-- Right Rail: Formal Member Ballot, Decision Chain & Activity -->
          <aside class="proposal-rail" aria-label="Formal member ballot, decision chain, and related proposals">
            <!-- 1. Formal Member Ballot Card -->
            <!-- 2. Decision & Ratification Chain -->
            <section class="rail-card">
              <div class="rail-card__head">
                <h3>Decision &amp; Ratification Chain</h3>
                <a class="rail-head__link" href="#revision-history-heading">Full log</a>
              </div>

              <ol class="decision-chain">
                {decisionChain.map((node, index) => (
                  <li class:list={['decision-node', `is-${node.state}`]}>
                    <span class="decision-node__marker tabular" aria-hidden="true">
                      {node.state === 'done' ? '✓' : index + 1}
                    </span>
                    <div class="decision-node__body">
                      <span>{node.label}</span>
                      <strong>{node.value}</strong>
                    </div>
                    {node.href && <a class="decision-node__link" href={node.href}>View</a>}
                  </li>
                ))}
              </ol>

              <div class="rail-subhead">
                <h4>Recent record activity</h4>
              </div>
              <ol class="rail-activity-list">
                {activityEvents.map((ev) => (
                  <li class="rail-activity-item">
                    <span class="rail-activity-dot" aria-hidden="true"></span>
                    <div class="rail-activity-body">
                      <p>
                        <strong>{ev.actor}</strong> {ev.action}
                      </p>
                      <div class="rail-activity-meta">
                        {ev.href ? (
                          <a href={ev.href} class="rail-chip">{ev.badge}</a>
                        ) : (
                          <span class="rail-chip">{ev.badge}</span>
                        )}
                        <time class="tabular" datetime={ev.date.toISOString()}>
                          {ev.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                        </time>
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            </section>

            <!-- 3. Related Proposals in Space -->
            {relatedProposals.length > 0 && (
              <section class="rail-card">
                <div class="rail-card__head">
                  <h3>More in {proposal.space}</h3>
                  <a class="rail-head__link" href={`/proposals/?space=${encodeURIComponent(proposal.space)}`}>View all</a>
                </div>
                <div class="related-proposals">
                  {relatedProposals.map((related: any) => (
                    <a href={`/proposals/${related.slug}/`} class="related-item">
                      <div class="related-item__top">
                        <span class="related-id tabular">{related.proposalId}</span>
                        <span class:list={['stage-badge', 'stage-badge--sm', `stage-badge--${related.stage}`]}>
                          {stagePillLabel(related.stage)}
                        </span>
                      </div>
                      <strong class="related-title">{related.title}</strong>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </aside>
        </div>
      </>
    )}
  </div>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[href="#details-heading"]').forEach((link) => {
    link.addEventListener('click', () => {
      const rationale = document.querySelector<HTMLDetailsElement>('.decision-rationale details');
      if (rationale) rationale.open = true;
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('a[href="#proposal-vote"]').forEach((link) => {
    link.href = '#proposal-decision';
    link.addEventListener('click', () => {
      const context = document.querySelector<HTMLDetailsElement>('#ballot-context');
      if (context) context.open = true;
    });
  });

  window.addEventListener('engage:vote-saved', (event) => {
    const choice = (event as CustomEvent<{ choice: string }>).detail.choice;
    const title = document.querySelector('.next-action-bar__title');
    if (title) title.textContent = `Your vote: ${choice}. You can change it until voting closes.`;
    const outstanding = document.querySelector<HTMLElement>('[data-outstanding-after-vote]');
    if (outstanding) outstanding.textContent = `${outstanding.dataset.outstandingAfterVote} need your vote`;
    const bar = document.querySelector('.next-action-bar');
    bar?.classList.add('is-complete');
    const kicker = document.querySelector('.next-action-bar__kicker');
    if (kicker) kicker.textContent = 'Vote saved · Review or change · ~30 seconds';
    const chip = document.querySelector('.personal-vote-chip');
    if (chip) {
      chip.textContent = `Your vote: ${choice}`;
      chip.classList.remove('is-action');
      chip.classList.add('is-voted');
    }
    const action = document.querySelector('.next-action-bar a[href="#proposal-decision"]');
    if (action) action.textContent = 'Review your vote →';
  });

  import { trackEngage } from '../../lib/analytics.ts';
  // Staff stage selector with ballot integrity confirmation
  const stageSelect = document.getElementById('staff-stage-select') as HTMLSelectElement | null;
  const stageMsg = document.getElementById('staff-stage-msg');
  if (stageSelect && stageMsg) {
    stageSelect.addEventListener('change', async () => {
      const proposalId = stageSelect.dataset.proposalId;
      const currentStage = stageSelect.dataset.currentStage || stageSelect.value;
      const voteCount = parseInt(stageSelect.dataset.voteCount || '0', 10);
      const stage = stageSelect.value;
      if (currentStage === stage) return;

      let confirmMsg = '';
      if (stage === 'decide') {
        confirmMsg = `Open voting (Stage 3: Voting)? Once voting begins, substantive proposal content will be locked to protect ballot integrity.`;
      } else if (currentStage === 'decide' && voteCount > 0) {
        confirmMsg = `This ballot currently has ${voteCount} member vote(s). Moving to "${stage}" will conclude or pause active voting. All cast votes will remain safely preserved. Proceed?`;
      } else if (stage === 'implement') {
        confirmMsg = `Advance this proposal to Stage 4 (Implementation)?`;
      } else if (stage === 'archived') {
        confirmMsg = `Archive this proposal? It will no longer be visible to general members.`;
      }

      if (confirmMsg && !confirm(confirmMsg)) {
        stageSelect.value = currentStage;
        return;
      }

      stageSelect.disabled = true;
      stageMsg.textContent = 'Updating...';

      try {
        const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId ?? '')}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stage }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Failed to update stage');
        location.reload();
      } catch (err: any) {
        stageMsg.textContent = err.message || 'Error';
        stageSelect.value = currentStage;
        stageSelect.disabled = false;
      }
    });
  }

  // Staff implementation note updater
  const implForm = document.getElementById('impl-note-form') as HTMLFormElement | null;
  const implBtn = document.getElementById('impl-note-btn') as HTMLButtonElement | null;
  const implStatus = document.getElementById('impl-note-status');
  if (implForm && implBtn && implStatus) {
    implForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const proposalId = implForm.dataset.proposalId;
      const textarea = document.getElementById('impl-note-text') as HTMLTextAreaElement | null;
      const implementationNote = textarea?.value ?? '';
      implBtn.disabled = true;
      implStatus.textContent = 'Saving...';

      try {
        const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId ?? '')}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ implementationNote }),
        });
        if (!res.ok) throw new Error('Failed to save');
        implStatus.textContent = 'Saved!';
        implBtn.disabled = false;
      } catch (err: any) {
        implStatus.textContent = err.message || 'Error';
        implBtn.disabled = false;
      }
    });
  }

  const amendmentForm = document.getElementById('amendment-form') as HTMLFormElement | null;
  amendmentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!amendmentForm.reportValidity()) return;
    trackEngage('contribution_attempted', { action: 'amendment' });
    const status = amendmentForm.querySelector<HTMLElement>('.amendment-compose-status');
    const button = amendmentForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const fd = new FormData(amendmentForm);
      const changes: Record<string, string> = {};
      for (const field of ['title', 'summary']) {
        const value = String(fd.get(field) ?? '').trim();
        if (value) changes[field] = value;
      }
      const response = await fetch('/api/amendments', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          proposalId: amendmentForm.dataset.proposalId,
          baseRevisionId: amendmentForm.dataset.revisionId,
          changes,
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Could not submit the amendment.');
      trackEngage('contribution_result', { action: 'amendment', outcome: 'success' });
      if (status) status.textContent = 'Amendment submitted. Reloading…';
      location.reload();
    } catch (error) {
      trackEngage('contribution_result', { action: 'amendment', outcome: 'failed' });
      if (status) status.textContent = error instanceof Error ? error.message : 'Could not submit the amendment.';
      if (button) button.disabled = false;
    }
  });

  document.querySelectorAll<HTMLFormElement>('.amendment-vote-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[role="status"]');
    form.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button) =>
      button.addEventListener('click', async () => {
        trackEngage('contribution_attempted', { action: 'amendment_ballot' });
        if (status) status.textContent = 'Recording endorsement…';
        form.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((item) => (item.disabled = true));
        try {
          const response = await fetch('/api/votes', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              proposalId: form.dataset.proposalId,
              amendmentId: form.dataset.amendmentId,
              choice: button.dataset.choice,
            }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'Could not record endorsement.');
          trackEngage('contribution_result', { action: 'amendment_ballot', outcome: 'success' });
          if (status) status.textContent = 'Endorsement vote recorded.';
        } catch (error) {
          trackEngage('contribution_result', { action: 'amendment_ballot', outcome: 'failed' });
          if (status) status.textContent = error instanceof Error ? error.message : 'Could not record endorsement.';
          form.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((item) => (item.disabled = false));
        }
      }),
    );
  });

  // Stance tab filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.stance-pill');
  const commentCards = document.querySelectorAll<HTMLElement>('.comment-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const stance = btn.dataset.stance;
      filterBtns.forEach((b) => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });

      commentCards.forEach((card) => {
        if (stance === 'all' || card.dataset.stance === stance) {
          card.style.display = 'grid';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Quick Stance Starter chips (Cognitive Fluency & Micro-Commitments)
  const starterChips = document.querySelectorAll<HTMLButtonElement>('[data-starter-stance]');
  const commentBodyInput = document.getElementById('comment-body-input') as HTMLTextAreaElement | null;
  starterChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const targetStance = chip.dataset.starterStance;
      const placeholder = chip.dataset.starterPlaceholder;
      if (targetStance) {
        window.dispatchEvent(new CustomEvent('engage:stance', { detail: targetStance }));
      }
      if (commentBodyInput) {
        if (placeholder) commentBodyInput.placeholder = placeholder;
        commentBodyInput.focus();
      }
      starterChips.forEach((c) => c.classList.toggle('is-active', c === chip));
    });
  });

  const escapeHtmlClient = (value: string) =>
    value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

  // Post comment / deliberation stance (optimistic instant append — no full page reload)
  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
  const commentSubmitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null;
  const commentStatusMsg = document.getElementById('comment-status-msg');
  const commentsList = document.getElementById('comments-list');

  if (commentForm && commentSubmitBtn && commentStatusMsg) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const proposalId = commentForm.dataset.proposalId;
      const formData = new FormData(commentForm);
      const stance = String(formData.get('stance') ?? 'comment');
      const body = String(formData.get('body') ?? '').trim();
      if (body.length < 5) return;
      trackEngage('contribution_attempted', { action: 'deliberation' });

      commentSubmitBtn.disabled = true;
      commentStatusMsg.textContent = 'Posting…';

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proposalId, stance, body }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to post');
        trackEngage('contribution_result', { action: 'deliberation', outcome: 'success' });

        const created = data.comment ?? {
          commentId: `cmt-${Date.now()}`,
          authorName: 'You',
          stance,
          body,
          createdAt: new Date().toISOString(),
          upvotes: [],
        };
        const emptyBox = commentsList?.querySelector('.empty-box');
        emptyBox?.remove();

        const initials = String(created.authorName || 'M')
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((p: string) => p[0]?.toUpperCase() ?? '')
          .join('') || 'M';
        const stanceText =
          stance === 'amendment'
            ? 'Wording suggestion'
            : stance[0]!.toUpperCase() + stance.slice(1);
        const article = document.createElement('article');
        article.className = 'comment-card';
        article.dataset.stance = stance;
        article.dataset.commentId = String(created.commentId);
        article.innerHTML = `
          <span class="comment-avatar" aria-hidden="true">${escapeHtmlClient(initials)}</span>
          <div class="comment-box">
            <div class="comment-card__head">
              <div class="comment-author__meta">
                <strong class="author-name">${escapeHtmlClient(String(created.authorName || 'Verified Member'))}</strong>
                <span class="stage-badge stage-badge--sm stage-badge--deliberate">${escapeHtmlClient(stanceText)}</span>
                <time class="tabular comment-date">Just now</time>
              </div>
            </div>
            <div class="comment-card__body">
              <p>${escapeHtmlClient(String(created.body ?? body))}</p>
            </div>
          </div>
        `;
        commentsList?.prepend(article);
        const textarea = document.getElementById('comment-body-input') as HTMLTextAreaElement | null;
        if (textarea) {
          textarea.value = '';
          textarea.dispatchEvent(new Event('input'));
        }
        commentStatusMsg.textContent = 'Contribution posted!';
      } catch (err: any) {
        trackEngage('contribution_result', { action: 'deliberation', outcome: 'failed' });
        commentStatusMsg.textContent = err.message || 'Error';
      } finally {
        commentSubmitBtn.disabled = false;
      }
    });
  }

  // Reddit-style composer helpers: live character count, Cmd/Ctrl+Enter submit, Reply & Sort
  const commentTextarea = document.getElementById('comment-body-input') as HTMLTextAreaElement | null;
  const charCountEl = document.getElementById('comment-char-count');
  if (commentTextarea && charCountEl) {
    const syncCount = () => {
      charCountEl.textContent = `${commentTextarea.value.length} / 4000`;
    };
    commentTextarea.addEventListener('input', syncCount);
    commentTextarea.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        commentForm?.requestSubmit();
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-reply-author]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const author = btn.dataset.replyAuthor;
      if (!commentTextarea || !author) return;
      const prefix = `@${author} `;
      if (!commentTextarea.value.startsWith(prefix)) {
        commentTextarea.value = `${prefix}${commentTextarea.value}`;
        commentTextarea.dispatchEvent(new Event('input'));
      }
      commentTextarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
      commentTextarea.focus();
    });
  });

  const sortSelect = document.querySelector<HTMLSelectElement>('[data-comment-sort]');
  sortSelect?.addEventListener('change', () => {
    if (!commentsList) return;
    const cards = Array.from(commentsList.querySelectorAll<HTMLElement>('.comment-card'));
    const mode = sortSelect.value;
    cards.sort((a, b) => {
      if (mode === 'top') {
        return Number(b.dataset.upvotes || 0) - Number(a.dataset.upvotes || 0);
      }
      if (mode === 'newest') {
        return Number(b.dataset.createdAt || 0) - Number(a.dataset.createdAt || 0);
      }
      return Number(a.dataset.createdAt || 0) - Number(b.dataset.createdAt || 0);
    });
    for (const card of cards) commentsList.appendChild(card);
  });

  // Author / administrator contribution feedback (zero-reload)
  document.querySelectorAll<HTMLFormElement>('.comment-feedback-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const commentId = form.dataset.commentId;
      const saveBtn = form.querySelector<HTMLButtonElement>('.comment-feedback-save');
      const statusMsg = form.querySelector<HTMLElement>('.comment-feedback-status');
      if (!commentId || !saveBtn) return;
      const fields = new FormData(form);
      const status = String(fields.get('status') ?? 'considered');
      const note = String(fields.get('note') ?? '').trim();
      const evidenceRef = String(fields.get('evidenceRef') ?? '').trim();
      saveBtn.disabled = true;
      if (statusMsg) statusMsg.textContent = 'Saving...';
      try {
        const res = await fetch('/api/comments', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ commentId, status, note, evidenceRef }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Could not save response.');
        const slot = document.querySelector<HTMLElement>(`[data-feedback-slot="${commentId}"]`);
        const drawer = form.closest('details');
        const selectEl = form.querySelector<HTMLSelectElement>('select[name="status"]');
        const noteInput = form.querySelector<HTMLInputElement>('input[name="note"]');
        const evidenceSelect = form.querySelector<HTMLSelectElement>('select[name="evidenceRef"]');
        const summaryEl = drawer?.querySelector<HTMLElement>('summary');
        if (slot) {
          if (!data.feedback) {
            slot.innerHTML = '';
            selectEl?.querySelector('option[value="clear"]')?.remove();
            if (selectEl) selectEl.value = 'considered';
            if (noteInput) noteInput.value = '';
            if (evidenceSelect) evidenceSelect.value = '';
            if (summaryEl) summaryEl.textContent = 'Record response';
          } else {
            const labelMap: Record<string, string> = {
              incorporated: 'Incorporated',
              considered: 'Considered',
              deferred: 'Deferred',
              declined: 'Declined',
            };
            const badgeClassMap: Record<string, string> = {
              incorporated: 'border-transparent bg-[var(--horizon-success-bg)] text-[var(--horizon-success-ink)]',
              considered: 'border-transparent bg-[var(--horizon-voting-bg)] text-[var(--horizon-voting-ink)]',
              deferred: 'border-transparent bg-[var(--horizon-warn-bg)] text-[var(--horizon-warn-ink)]',
              declined: 'border-border bg-background text-foreground',
            };
            const statusKey = String(data.feedback.status);
            const label = labelMap[statusKey] ?? 'Considered';
            const variantClasses = badgeClassMap[statusKey] ?? badgeClassMap.declined;
            const noteHtml = data.feedback.note ? `<p>${escapeHtmlClient(String(data.feedback.note))}</p>` : '';
            const ev = data.feedback.evidence;
            let evidenceHtml = '';
            if (ev && ev.recordId) {
              const evHref =
                ev.kind === 'amendment'
                  ? `#amendment-${encodeURIComponent(String(ev.recordId))}`
                  : ev.kind === 'revision'
                    ? `#revision-${encodeURIComponent(String(ev.recordId))}`
                    : ev.kind === 'decision'
                      ? '#proposal-vote'
                      : ev.kind === 'policy' && String(ev.label ?? '').startsWith('Adopted policy:')
                        ? `/policies/${encodeURIComponent(String(ev.recordId))}/`
                        : '';
              const evLabel = escapeHtmlClient(String(ev.label || ev.recordId));
              evidenceHtml = `<p class="comment-feedback__evidence"><strong>Evidence:</strong> ${evHref ? `<a href="${evHref}">${evLabel}</a>` : `<span>${evLabel}</span>`}</p>`;
            }
            slot.innerHTML = `
              <div class="comment-feedback">
                <span data-slot="badge" class="inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap ${variantClasses}">${escapeHtmlClient(label)}</span>
                <div class="comment-feedback__copy">
                  ${noteHtml}
                  ${evidenceHtml}
                  <small>Response by ${escapeHtmlClient(String(data.feedback.updatedByName || 'Author'))} · just now</small>
                </div>
              </div>
            `;
            if (selectEl && !selectEl.querySelector('option[value="clear"]')) {
              const clearOpt = document.createElement('option');
              clearOpt.value = 'clear';
              clearOpt.textContent = 'Clear response';
              selectEl.appendChild(clearOpt);
            }
            if (selectEl) selectEl.value = String(data.feedback.status);
            if (summaryEl) summaryEl.textContent = 'Update response';
          }
        }
        if (drawer) drawer.open = false;
        if (statusMsg) statusMsg.textContent = 'Saved.';
      } catch (err: any) {
        if (statusMsg) statusMsg.textContent = err?.message || 'Could not save response.';
      } finally {
        saveBtn.disabled = false;
      }
    });
  });

  // Endorse contribution (+1)
  document.querySelectorAll<HTMLButtonElement>('[data-endorse-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      trackEngage('contribution_attempted', { action: 'endorsement' });
      const commentId = btn.dataset.endorseId;
      btn.disabled = true;
      try {
        const res = await fetch('/api/comments', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ commentId, action: 'upvote' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        trackEngage('contribution_result', { action: 'endorsement', outcome: 'success' });
        const countSpan = btn.querySelector('.endorse-count');
        if (countSpan) countSpan.textContent = String(data.count ?? data.upvotes?.length ?? 0);
        btn.classList.toggle('is-endorsed', data.hasUpvoted ?? data.endorsed);
      } catch {
        trackEngage('contribution_result', { action: 'endorsement', outcome: 'failed' });
      } finally {
        btn.disabled = false;
      }
    });
  });

  // Delete contribution
  document.querySelectorAll<HTMLButtonElement>('[data-delete-comment]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this contribution?')) return;
      const commentId = btn.dataset.deleteComment;
      btn.disabled = true;

      try {
        const res = await fetch(`/api/comments?commentId=${encodeURIComponent(commentId ?? '')}`, {
          method: 'DELETE',
        });
        if (!res.ok) throw new Error('Failed to delete');
        const card = document.querySelector(`[data-comment-id="${commentId}"]`);
        card?.remove();
      } catch {
        alert('Could not delete contribution.');
        btn.disabled = false;
      }
    });
  });

  // Highlight active section in sticky jump nav
  const readingLinks = [...document.querySelectorAll<HTMLAnchorElement>('.reading-nav__links a[href^="#"]')];
  const updateReadingHighlight = () => {
    const hash = location.hash || '#proposal-brief';
    for (const link of readingLinks) {
      if (link.getAttribute('href') === hash) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    }
  };
  window.addEventListener('hashchange', updateReadingHighlight);
  updateReadingHighlight();
</script>

