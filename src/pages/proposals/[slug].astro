---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { getProposalDetail } from '../../lib/store.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const detail = await getProposalDetail(db, Astro.params.slug ?? '', user);
if (!detail) {
  Astro.response.status = 404;
}

const proposal = detail?.proposal;
const comments = detail?.comments ?? [];
const myVote = detail?.myVote ?? null;
const myReason = detail?.myReason ?? '';

const stageLabel = (stage: ProposalStage) => {
  if (stage === 'propose') return '1. Propose';
  if (stage === 'deliberate') return '2. Deliberate';
  if (stage === 'decide') return '3. Decide';
  if (stage === 'implement') return '4. Implement';
  return 'Archived';
};

const isImageAttachment = Boolean(
  proposal?.attachmentUrl && /\.(svg|png|webp|jpg|jpeg|gif)$/i.test(proposal.attachmentUrl),
);

const detailBlocks = (proposal?.details ?? '')
  .split(/\n\s*\n/)
  .map((block) => block.trim())
  .filter(Boolean)
  .map((block) => {
    const headingMatch = block.match(/^\*\*(.+?)\*\*$/);
    if (headingMatch) {
      return { type: 'heading' as const, text: headingMatch[1]! };
    }
    return {
      type: 'paragraph' as const,
      text: block.replace(/\*\*(.+?)\*\*/g, '$1'),
    };
  });

const stages: ProposalStage[] = ['propose', 'deliberate', 'decide', 'implement'];
const currentStageIndex = proposal ? stages.indexOf(proposal.stage) : -1;

const stanceCounts = {
  all: comments.length,
  support: comments.filter((c) => c.stance === 'support').length,
  concern: comments.filter((c) => c.stance === 'concern').length,
  amendment: comments.filter((c) => c.stance === 'amendment').length,
  comment: comments.filter((c) => c.stance === 'comment').length,
};

const votes = proposal?.votes ?? { approve: 0, abstain: 0, reject: 0, total: 0 };
const approvePct = votes.total > 0 ? Math.round((votes.approve / votes.total) * 100) : 0;
const abstainPct = votes.total > 0 ? Math.round((votes.abstain / votes.total) * 100) : 0;
const rejectPct = votes.total > 0 ? Math.round((votes.reject / votes.total) * 100) : 0;
---
<SiteLayout
  title={proposal ? `${proposal.title} · Engage` : 'Proposal not found · Engage'}
  description={proposal?.summary ?? 'Participatory proposal details, member deliberation, and voting.'}
  canonical={proposal ? `${Astro.url.origin}/proposals/${proposal.slug}/` : undefined}
>
  <div class="page-wrap section-space proposal-detail-page">
    {!proposal ? (
      <div class="not-found-box">
        <h1>Proposal not found</h1>
        <p>That proposal could not be found or has been archived.</p>
        <a class="button button--primary" href="/proposals/">Return to Proposals</a>
      </div>
    ) : (
      <>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/proposals/">Proposals</a>
          <span aria-hidden="true">/</span>
          <a href={`/proposals/?space=${encodeURIComponent(proposal.space)}`}>
            {proposal.space}
          </a>
          <span aria-hidden="true">/</span>
          <span class="tabular" aria-current="page">{proposal.proposalId}</span>
        </nav>

        {user?.isStaff && (
          <div class="staff-bar">
            <span>
              <strong>Staff controls:</strong> Stage is <em>{stageLabel(proposal.stage)}</em>
            </span>
            <div class="staff-bar__actions">
              <label class="staff-select-label">
                <span>Change stage</span>
                <select id="staff-stage-select" data-proposal-id={proposal.proposalId}>
                  <option value="propose" selected={proposal.stage === 'propose'}>1. Propose</option>
                  <option value="deliberate" selected={proposal.stage === 'deliberate'}>2. Deliberate</option>
                  <option value="decide" selected={proposal.stage === 'decide'}>3. Decide (Voting)</option>
                  <option value="implement" selected={proposal.stage === 'implement'}>4. Implement</option>
                  <option value="archived" selected={proposal.stage === 'archived'}>Archived</option>
                </select>
              </label>
              <a class="button button--small button--outline" href={`/admin/?edit=${encodeURIComponent(proposal.proposalId)}`}>
                Edit in Admin
              </a>
              <span id="staff-stage-msg" class="tabular" role="status" aria-live="polite"></span>
            </div>
          </div>
        )}

        <!-- 4-Stage Lifecycle Stepper -->
        <nav class="lifecycle-stepper" aria-label="Proposal lifecycle progress">
          <div class="stepper-track">
            {stages.map((stg, idx) => {
              const isPast = currentStageIndex > idx;
              const isCurrent = proposal.stage === stg;
              return (
                <div class:list={['stepper-step', { 'is-past': isPast, 'is-current': isCurrent }]}>
                  <div class="stepper-marker">
                    {isPast ? (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    ) : (
                      <span>{idx + 1}</span>
                    )}
                  </div>
                  <span class="stepper-label">{stg}</span>
                </div>
              );
            })}
          </div>
        </nav>

        <header class="detail-header">
          <div class="detail-header__meta">
            <span class:list={['stage-pill', `stage-pill--${proposal.stage}`]}>
              {stageLabel(proposal.stage)}
            </span>
            <span class="space-pill">{proposal.space}</span>
            <span class="id-pill tabular">{proposal.proposalId}</span>
          </div>

          <h1 class="detail-title">{proposal.title}</h1>

          <div class="author-line">
            <span>Authored by <strong>{proposal.authorName || 'Fusion Working Group'}</strong></span>
            <span>·</span>
            <span class="tabular">Updated {new Date(proposal.updatedAt).toLocaleDateString('en-AU', { dateStyle: 'medium' })}</span>
          </div>
        </header>

        <!-- Decision Box (Prominently featured when voting is active or when decided) -->
        {(proposal.stage === 'decide' || proposal.stage === 'implement' || votes.total > 0) && (
          <section id="decision" class="decision-panel" aria-labelledby="decision-heading">
            <div class="decision-panel__head">
              <div>
                <h2 id="decision-heading">
                  {proposal.stage === 'decide' ? 'Stage 3: Decision Voting Open' : 'Decision Outcome'}
                </h2>
                <p>
                  {proposal.stage === 'decide'
                    ? 'Verified members: cast or update your position. You may change your vote while decision is open.'
                    : `Final voting tally for this proposal (${votes.total} verified member votes).`}
                </p>
              </div>

              {proposal.stage === 'decide' && (
                <span class="live-pill">Voting Active</span>
              )}
            </div>

            <!-- Tally visualization bar -->
            <div class="tally-box">
              <div class="tally-bar" role="progressbar" aria-label="Vote results breakdown">
                <div class="tally-bar__approve" style={`width: ${approvePct}%`} title={`Approve: ${approvePct}%`}></div>
                <div class="tally-bar__abstain" style={`width: ${abstainPct}%`} title={`Abstain: ${abstainPct}%`}></div>
                <div class="tally-bar__reject" style={`width: ${rejectPct}%`} title={`Reject: ${rejectPct}%`}></div>
              </div>

              <div class="tally-legend">
                <span class="legend-item legend-item--approve">
                  <strong>Approve:</strong> <span id="tally-approve-num" class="tabular">{votes.approve}</span> ({approvePct}%)
                </span>
                <span class="legend-item legend-item--abstain">
                  <strong>Abstain:</strong> <span id="tally-abstain-num" class="tabular">{votes.abstain}</span> ({abstainPct}%)
                </span>
                <span class="legend-item legend-item--reject">
                  <strong>Reject:</strong> <span id="tally-reject-num" class="tabular">{votes.reject}</span> ({rejectPct}%)
                </span>
                <span class="legend-item legend-item--total">
                  Total: <span id="tally-total-num" class="tabular">{votes.total}</span>
                </span>
              </div>
            </div>

            <!-- Voting actions for verified members -->
            {proposal.stage === 'decide' && (
              <div class="vote-actions-wrapper">
                {user?.canParticipate ? (
                  <form id="vote-form" data-proposal-id={proposal.proposalId}>
                    <p class="vote-prompt">
                      Your position: <strong id="current-vote-label">{myVote ? myVote.toUpperCase() : 'Not voted yet'}</strong>
                    </p>

                    <div class="vote-buttons" role="radiogroup" aria-label="Choose your vote">
                      <button
                        type="button"
                        class:list={['vote-btn', 'vote-btn--approve', { 'is-selected': myVote === 'approve' }]}
                        data-choice="approve"
                      >
                        ✓ Approve
                      </button>
                      <button
                        type="button"
                        class:list={['vote-btn', 'vote-btn--abstain', { 'is-selected': myVote === 'abstain' }]}
                        data-choice="abstain"
                      >
                        — Abstain
                      </button>
                      <button
                        type="button"
                        class:list={['vote-btn', 'vote-btn--reject', { 'is-selected': myVote === 'reject' }]}
                        data-choice="reject"
                      >
                        ✗ Reject
                      </button>
                    </div>

                    <label class="field vote-reason-field">
                      <span>Reason / statement for your vote (optional)</span>
                      <input
                        id="vote-reason-input"
                        type="text"
                        name="reason"
                        maxlength="500"
                        value={myReason}
                        placeholder="e.g. Strongly supports party growth; wording aligns with state policy."
                      />
                    </label>

                    <p id="vote-status-msg" class="tabular form-status" role="status" aria-live="polite"></p>
                  </form>
                ) : user ? (
                  <div class="vote-callout">
                    <p>
                      Your account is pending verification. Once an administrator confirms your party membership,
                      you will be able to cast votes directly on decisions.
                    </p>
                    <a class="button button--small button--outline" href="/member/">Check membership status</a>
                  </div>
                ) : (
                  <div class="vote-callout">
                    <p>Only verified Fusion Party Australia members may vote on party decisions.</p>
                    <a class="button button--small button--primary" href="/member/">Sign in to vote</a>
                  </div>
                )}
              </div>
            )}
          </section>
        )}

        <!-- Stage 4: Implementation Tracking Banner -->
        {(proposal.stage === 'implement' || proposal.implementationNote) && (
          <section class="implementation-box" aria-labelledby="impl-heading">
            <div class="implementation-box__head">
              <span class="badge-stage4">Stage 4: Implementation</span>
              <h2 id="impl-heading">Delivery &amp; Adoption Status</h2>
            </div>
            <div class="implementation-content">
              <p>
                {proposal.implementationNote ||
                  'This proposal has been adopted by the membership and is currently in the delivery and implementation phase.'}
              </p>
            </div>
            {user?.isStaff && (
              <details class="impl-edit-details">
                <summary>Staff: update implementation note</summary>
                <form id="impl-note-form" data-proposal-id={proposal.proposalId}>
                  <textarea
                    id="impl-note-text"
                    rows="3"
                    placeholder="Provide an update on implementation milestones, bill references, or platform deployment..."
                  >{proposal.implementationNote || ''}</textarea>
                  <div class="impl-note-actions">
                    <button class="button button--small" type="submit" id="impl-note-btn">Save Note</button>
                    <span id="impl-note-status" class="form-status" role="status"></span>
                  </div>
                </form>
              </details>
            )}
          </section>
        )}

        <!-- Core Proposal Summary -->
        <section class="proposal-core" aria-labelledby="core-heading">
          <h2 id="core-heading">Core Statement</h2>
          <div class="summary-card">
            <p>{proposal.summary}</p>
          </div>
        </section>

        <!-- Key Outcomes -->
        {proposal.outcomes.length > 0 && (
          <section class="proposal-outcomes" aria-labelledby="outcomes-heading">
            <h2 id="outcomes-heading">Key Commitments &amp; Outcomes</h2>
            <ul class="outcomes-list">
              {proposal.outcomes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- Attachment / Visual Media -->
        {proposal.attachmentUrl && (
          <section class="proposal-attachment" aria-labelledby="attachment-heading">
            <h2 id="attachment-heading">Visual &amp; Attachment Reference</h2>
            {isImageAttachment ? (
              <figure class="attachment-media">
                <img src={proposal.attachmentUrl} alt={`${proposal.title} preview`} loading="lazy" />
                <figcaption>
                  <a href={proposal.attachmentUrl} target="_blank" rel="noopener noreferrer">
                    Open full resolution asset ↗
                  </a>
                </figcaption>
              </figure>
            ) : (
              <div class="attachment-doc">
                <a class="button button--outline" href={proposal.attachmentUrl} target="_blank" rel="noopener noreferrer">
                  Download attachment asset ↗
                </a>
              </div>
            )}
          </section>
        )}

        <!-- Detailed Rationale -->
        {detailBlocks.length > 0 && (
          <section class="proposal-details" aria-labelledby="details-heading">
            <h2 id="details-heading">Detailed Rationale &amp; Context</h2>
            <div class="details-body">
              {detailBlocks.map((block) =>
                block.type === 'heading' ? <h3>{block.text}</h3> : <p>{block.text}</p>,
              )}
            </div>
          </section>
        )}

        <!-- Stage 2: Structured Deliberation Section -->
        <section id="deliberation" class="deliberation-section" aria-labelledby="deliberate-heading">
          <div class="deliberation-header">
            <div>
              <h2 id="deliberate-heading">Stage 2: Deliberation</h2>
              <p>
                Structured discussion to refine this proposal. Share your position using explicit stances:
                Support, Concern, Amendment, or Comment.
              </p>
            </div>
            <span class="badge tabular">{comments.length} {comments.length === 1 ? 'contribution' : 'contributions'}</span>
          </div>

          <!-- Stance Filter Tabs -->
          <div class="stance-filters" role="tablist" aria-label="Filter contributions by stance">
            <button type="button" class="stance-filter-btn is-active" data-stance="all">
              All ({stanceCounts.all})
            </button>
            <button type="button" class="stance-filter-btn stance-filter-btn--support" data-stance="support">
              Support ({stanceCounts.support})
            </button>
            <button type="button" class="stance-filter-btn stance-filter-btn--concern" data-stance="concern">
              Concern ({stanceCounts.concern})
            </button>
            <button type="button" class="stance-filter-btn stance-filter-btn--amendment" data-stance="amendment">
              Amendment ({stanceCounts.amendment})
            </button>
            <button type="button" class="stance-filter-btn stance-filter-btn--comment" data-stance="comment">
              Comment ({stanceCounts.comment})
            </button>
          </div>

          <!-- Contribution Input Form -->
          {user?.canParticipate ? (
            <form id="comment-form" class="comment-form" data-proposal-id={proposal.proposalId}>
              <div class="stance-picker">
                <span>Select your contribution stance:</span>
                <div class="stance-radio-group">
                  <label class="stance-label stance-label--support">
                    <input type="radio" name="stance" value="support" />
                    <span>✓ Support</span>
                  </label>
                  <label class="stance-label stance-label--concern">
                    <input type="radio" name="stance" value="concern" />
                    <span>! Concern</span>
                  </label>
                  <label class="stance-label stance-label--amendment">
                    <input type="radio" name="stance" value="amendment" />
                    <span>✎ Amendment</span>
                  </label>
                  <label class="stance-label stance-label--comment">
                    <input type="radio" name="stance" value="comment" checked />
                    <span>💬 Comment</span>
                  </label>
                </div>
              </div>

              <label class="field">
                <span class="sr-only">Contribution text</span>
                <textarea
                  id="comment-body-input"
                  name="body"
                  required
                  minlength="3"
                  maxlength="4000"
                  rows="4"
                  placeholder="Share constructive feedback, identify concerns, or suggest specific amendments to this proposal..."
                ></textarea>
              </label>

              <div class="comment-form__actions">
                <button class="button button--primary" type="submit" id="comment-submit-btn">
                  Post contribution
                </button>
                <span id="comment-status-msg" class="tabular form-status" role="status" aria-live="polite"></span>
              </div>
            </form>
          ) : user ? (
            <div class="signin-nudge">
              <p>Your membership is awaiting administrator verification before you can post in deliberations.</p>
              <a class="button button--outline" href="/member/">View Account Status</a>
            </div>
          ) : (
            <div class="signin-nudge">
              <p>Sign in as a verified member to contribute to deliberations and suggest amendments.</p>
              <a class="button button--primary" href="/member/">Member Sign In</a>
            </div>
          )}

          <!-- Contributions Feed -->
          <div id="comments-list" class="comments-feed">
            {comments.length === 0 ? (
              <p class="empty-feed">No deliberation contributions yet. Be the first to share your stance or suggest an amendment.</p>
            ) : (
              comments.map((c) => {
                const isAuthor = user && c.memberId === user.memberId;
                const canDelete = isAuthor || user?.isStaff;
                const hasEndorsed = user && c.upvotes.includes(user.memberId);
                return (
                  <article class="comment-card" data-stance={c.stance} data-comment-id={c.commentId}>
                    <div class="comment-card__head">
                      <div class="comment-author">
                        <span class="author-name">{c.authorName}</span>
                        <span class:list={['stance-tag', `stance-tag--${c.stance}`]}>
                          {c.stance}
                        </span>
                      </div>
                      <time class="tabular" datetime={new Date(c.createdAt).toISOString()}>
                        {new Date(c.createdAt).toLocaleDateString('en-AU', {
                          month: 'short',
                          day: 'numeric',
                          year: 'numeric',
                        })}
                      </time>
                    </div>

                    <div class="comment-card__body">
                      <p>{c.body}</p>
                    </div>

                    <div class="comment-card__actions">
                      <button
                        type="button"
                        class:list={['endorse-btn', { 'is-endorsed': hasEndorsed }]}
                        data-endorse-id={c.commentId}
                        disabled={!user?.canParticipate}
                        title={user?.canParticipate ? '+1 Endorse this contribution' : 'Sign in to endorse'}
                      >
                        <span class="endorse-icon">▲</span>
                        <span class="endorse-text">Endorse</span>
                        <span class="endorse-count tabular">{c.upvotes.length}</span>
                      </button>

                      {canDelete && (
                        <button
                          type="button"
                          class="delete-btn"
                          data-delete-comment={c.commentId}
                        >
                          Delete
                        </button>
                      )}
                    </div>
                  </article>
                );
              })
            )}
          </div>
        </section>
      </>
    )}
  </div>
</SiteLayout>

<script>
  // Staff stage selector
  const stageSelect = document.getElementById('staff-stage-select') as HTMLSelectElement | null;
  const stageMsg = document.getElementById('staff-stage-msg');
  if (stageSelect && stageMsg) {
    stageSelect.addEventListener('change', async () => {
      const proposalId = stageSelect.dataset.proposalId;
      const stage = stageSelect.value;
      stageSelect.disabled = true;
      stageMsg.textContent = 'Updating stage...';

      try {
        const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId ?? '')}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stage }),
        });
        if (!res.ok) throw new Error('Failed to update stage');
        stageMsg.textContent = 'Updated!';
        location.reload();
      } catch (err: any) {
        stageMsg.textContent = err.message || 'Error updating';
        stageSelect.disabled = false;
      }
    });
  }

  // Staff implementation note updater
  const implForm = document.getElementById('impl-note-form') as HTMLFormElement | null;
  const implBtn = document.getElementById('impl-note-btn') as HTMLButtonElement | null;
  const implStatus = document.getElementById('impl-note-status');
  if (implForm && implBtn && implStatus) {
    implForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const proposalId = implForm.dataset.proposalId;
      const textarea = document.getElementById('impl-note-text') as HTMLTextAreaElement | null;
      const implementationNote = textarea?.value ?? '';
      implBtn.disabled = true;
      implStatus.textContent = 'Saving note...';

      try {
        const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId ?? '')}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ implementationNote }),
        });
        if (!res.ok) throw new Error('Failed to save note');
        implStatus.textContent = 'Saved!';
        setTimeout(() => location.reload(), 600);
      } catch (err: any) {
        implStatus.textContent = err.message || 'Error';
        implBtn.disabled = false;
      }
    });
  }

  // Voting interaction
  const voteForm = document.getElementById('vote-form') as HTMLFormElement | null;
  const voteBtns = document.querySelectorAll<HTMLButtonElement>('.vote-btn');
  const voteStatusMsg = document.getElementById('vote-status-msg');
  const currentVoteLabel = document.getElementById('current-vote-label');
  const reasonInput = document.getElementById('vote-reason-input') as HTMLInputElement | null;

  voteBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!voteForm || !voteStatusMsg) return;
      const proposalId = voteForm.dataset.proposalId;
      const choice = btn.dataset.choice;
      const reason = reasonInput?.value ?? '';

      voteBtns.forEach((b) => (b.disabled = true));
      voteStatusMsg.textContent = 'Casting vote...';

      try {
        const res = await fetch('/api/votes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proposalId, choice, reason }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to submit vote');

        voteBtns.forEach((b) => {
          b.classList.toggle('is-selected', b.dataset.choice === choice);
          b.disabled = false;
        });

        if (currentVoteLabel) currentVoteLabel.textContent = (choice || '').toUpperCase();
        voteStatusMsg.textContent = 'Vote recorded!';

        // Update tally counts in view
        const { votes } = data;
        const approveNum = document.getElementById('tally-approve-num');
        const abstainNum = document.getElementById('tally-abstain-num');
        const rejectNum = document.getElementById('tally-reject-num');
        const totalNum = document.getElementById('tally-total-num');
        if (approveNum) approveNum.textContent = String(votes.approve);
        if (abstainNum) abstainNum.textContent = String(votes.abstain);
        if (rejectNum) rejectNum.textContent = String(votes.reject);
        if (totalNum) totalNum.textContent = String(votes.total);

        // Update bar widths
        const barApprove = document.querySelector<HTMLElement>('.tally-bar__approve');
        const barAbstain = document.querySelector<HTMLElement>('.tally-bar__abstain');
        const barReject = document.querySelector<HTMLElement>('.tally-bar__reject');
        if (votes.total > 0) {
          if (barApprove) barApprove.style.width = `${Math.round((votes.approve / votes.total) * 100)}%`;
          if (barAbstain) barAbstain.style.width = `${Math.round((votes.abstain / votes.total) * 100)}%`;
          if (barReject) barReject.style.width = `${Math.round((votes.reject / votes.total) * 100)}%`;
        }
      } catch (err: any) {
        voteStatusMsg.textContent = err.message || 'Error recording vote';
        voteBtns.forEach((b) => (b.disabled = false));
      }
    });
  });

  // Stance tab filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.stance-filter-btn');
  const commentCards = document.querySelectorAll<HTMLElement>('.comment-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const stance = btn.dataset.stance;
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      commentCards.forEach((card) => {
        if (stance === 'all' || card.dataset.stance === stance) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Post comment / deliberation stance
  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
  const commentSubmitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null;
  const commentStatusMsg = document.getElementById('comment-status-msg');

  if (commentForm && commentSubmitBtn && commentStatusMsg) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const proposalId = commentForm.dataset.proposalId;
      const formData = new FormData(commentForm);
      const stance = formData.get('stance');
      const body = formData.get('body');

      commentSubmitBtn.disabled = true;
      commentStatusMsg.textContent = 'Posting contribution...';

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proposalId, stance, body }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to post contribution');

        commentStatusMsg.textContent = 'Posted!';
        location.reload();
      } catch (err: any) {
        commentStatusMsg.textContent = err.message || 'Error posting contribution';
        commentSubmitBtn.disabled = false;
      }
    });
  }

  // Endorse contribution (+1)
  document.querySelectorAll<HTMLButtonElement>('[data-endorse-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const commentId = btn.dataset.endorseId;
      btn.disabled = true;
      try {
        const res = await fetch('/api/comments', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ commentId, action: 'upvote' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        const countSpan = btn.querySelector('.endorse-count');
        if (countSpan) countSpan.textContent = String(data.upvotes.length);
        btn.classList.toggle('is-endorsed', data.hasUpvoted);
      } catch {
        // Ignore
      } finally {
        btn.disabled = false;
      }
    });
  });

  // Delete contribution
  document.querySelectorAll<HTMLButtonElement>('[data-delete-comment]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to delete this contribution?')) return;
      const commentId = btn.dataset.deleteComment;
      btn.disabled = true;

      try {
        const res = await fetch(`/api/comments?commentId=${encodeURIComponent(commentId ?? '')}`, {
          method: 'DELETE',
        });
        if (!res.ok) throw new Error('Failed to delete');
        const card = document.querySelector(`[data-comment-id="${commentId}"]`);
        card?.remove();
      } catch {
        alert('Could not delete contribution.');
        btn.disabled = false;
      }
    });
  });
</script>

