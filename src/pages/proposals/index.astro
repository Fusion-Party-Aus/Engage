---
import { discoveryFocus } from '../../lib/proposal-discovery.ts';
import { ballotDeadlineLabel, ballotExpired } from '../../lib/ballot-deadline.ts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Button } from '../../components/ui/button';
import { Checkbox } from '../../components/ui/checkbox';
import { Input } from '../../components/ui/input';
import { NativeSelect } from '../../components/ui/native-select';
import { Badge } from '../../components/ui/badge';
import {
  CheckCircle2,
  MessageSquare,
  Plus,
  Search,
  Vote,
  X,
} from 'lucide-react';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { loadBallotCryptoConfig } from '../../lib/ballot-crypto.ts';
import { listOutstandingDecisions, listProposals, normalizeStage } from '../../lib/store.ts';
import { findMemberVotes, proposalBallotId } from '../../lib/vote-storage.ts';
import { getSiteConfig } from '../../lib/site-config.ts';
import { rankProposals } from '../../lib/proposal-metrics.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);
const siteConfig = await getSiteConfig(db, env);

const initialQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const initialSpace = (Astro.url.searchParams.get('space') ?? Astro.url.searchParams.get('category') ?? 'all').trim();
const initialBranch = (Astro.url.searchParams.get('branch') ?? 'all').trim();
const initialFocus = discoveryFocus(Astro.url.searchParams, Boolean(user?.canParticipate), Astro.cookies.get('engage_voting_focus')?.value);
const initialSort = (Astro.url.searchParams.get('sort') ?? 'priority').trim();
const branches = (await db.collection('branches').find({ recognised: true }).sort({ name: 1 }).toArray()).map(({ branchId, name }) => ({ branchId, name }));
const rawStage = (Astro.url.searchParams.get('stage') ?? Astro.url.searchParams.get('status') ?? 'all').trim();
const initialStage = rawStage === 'all' ? 'all' : normalizeStage(rawStage);
if (initialStage === 'decide' && (Astro.url.searchParams.has('focus') || Astro.url.searchParams.has('needsVote'))) {
  Astro.cookies.set('engage_voting_focus', initialFocus, { path: '/proposals/', sameSite: 'lax', httpOnly: true, maxAge: 60 * 60 * 24 * 90 });
}
const joinedOnly = Astro.url.searchParams.get('joined') === '1' || initialFocus === 'discussion';

const [allAvailableProposals, joinedComments] = await Promise.all([
  listProposals(db, {
    includeArchived: Boolean(user?.isStaff),
    user,
  }),
  user ? db.collection('comments').find({ memberId: user.memberId }).project({ proposalId: 1 }).toArray() : Promise.resolve([]),
]);

const memberVotesPromise = user
  ? findMemberVotes(
      db,
      user.memberId,
      allAvailableProposals.map((p) => proposalBallotId(p.proposalId)),
      loadBallotCryptoConfig(env),
    )
  : Promise.resolve([]);

const [myVotesRaw, myOutstandingVotes] = await Promise.all([
  memberVotesPromise,
  user?.canParticipate
    ? listOutstandingDecisions(db, user.memberId, user, allAvailableProposals, memberVotesPromise)
    : Promise.resolve([]),
]);

const baseProposals = allAvailableProposals.filter((p) => p.stage !== 'archived');

const joinedIds = new Set(joinedComments.map((comment) => String(comment.proposalId)));

const queryLower = initialQuery.toLowerCase();
const rawProposals = allAvailableProposals.filter((p) => {
  if (initialSpace && initialSpace !== 'all' && p.space !== initialSpace) return false;
  if (
    initialBranch &&
    initialBranch !== 'all' &&
    ![p.originatingBranchId, p.governanceAuthorityBranchId, p.jurisdictionBranchId].includes(initialBranch)
  ) {
    return false;
  }
  if (queryLower) {
    const haystack = `${p.proposalId} ${p.title} ${p.space} ${p.summary} ${p.details}`.toLowerCase();
    if (!haystack.includes(queryLower)) return false;
  }
  return true;
});

const outstandingIds = new Set(myOutstandingVotes.map((item) => item.proposalId));
const votedProposalIds = new Set(
  myVotesRaw
    .filter((v: any) => v.proposalId && v.ballotId === proposalBallotId(String(v.proposalId)) && allAvailableProposals.some((proposal) => proposal.proposalId === String(v.proposalId) && proposal.ballotRevisionId === v.revisionId))
    .map((v: any) => String(v.proposalId)),
);

const countDataset = rawProposals.filter((proposal) => {
  if (joinedOnly && !joinedIds.has(proposal.proposalId)) return false;
  if (initialFocus === 'needs-vote') return outstandingIds.has(proposal.proposalId);
  return true;
});

const focusFiltered = countDataset.filter((proposal) =>
  initialStage === 'all' || (proposal.stage === initialStage && (initialStage !== 'decide' || Boolean(proposal.ballotRevisionId) && !ballotExpired(proposal))),
);

const effectiveSort = initialFocus === 'recent' && initialSort === 'priority' ? 'recent' : initialSort;

const visibleProposals = ["divisive", "approved", "active"].includes(effectiveSort)
 ? rankProposals(focusFiltered, effectiveSort as "divisive" | "approved" | "active")
 : [...focusFiltered].sort((a, b) => {
  if (effectiveSort === 'recent') {
    return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();
  }
  if (effectiveSort === 'ballots') {
    return b.votes.total - a.votes.total || b.commentCount - a.commentCount;
  }
  if (effectiveSort === 'contributions') {
    return b.commentCount - a.commentCount || b.votes.total - a.votes.total;
  }
  const priority = { decide: 0, deliberate: 1, propose: 2, implement: 3, archived: 4 };
  return (
    priority[a.stage] - priority[b.stage] ||
    new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
  );
});

const pageSize = 15;
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const pageCount = Math.max(1, Math.ceil(visibleProposals.length / pageSize));
const currentPage = Number.isFinite(requestedPage) ? Math.min(Math.max(requestedPage, 1), pageCount) : 1;
const pageProposals = visibleProposals.slice((currentPage - 1) * pageSize, currentPage * pageSize);

const buildFilterUrl = (overrides: Record<string, string | null>) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(overrides)) {
    if (
      !v ||
      (v === 'all' && k !== 'focus') ||
      (k === 'sort' && v === 'priority') ||
      (k === 'page' && v === '1')
    ) {
      params.delete(k);
    } else {
      params.set(k, v);
    }
  }
  const qs = params.toString();
  return `/proposals/${qs ? `?${qs}` : ''}`;
};

const pageUrl = (page: number) => buildFilterUrl({ page: String(page) });

const spaces = [...new Set(baseProposals.map((p) => p.space))].sort();


const stageCounts = {
  all: rawProposals.length,
  propose: rawProposals.filter((p) => p.stage === 'propose').length,
  deliberate: rawProposals.filter((p) => p.stage === 'deliberate').length,
  decide: rawProposals.filter((p) => p.stage === 'decide' && p.ballotRevisionId && !ballotExpired(p)).length,
  implement: rawProposals.filter((p) => p.stage === 'implement').length,
};

const stageTabs: Array<{
  id: 'all' | ProposalStage;
  label: string;
  count: number;
}> = [
  {
    id: 'all',
    label: 'All',
    count: stageCounts.all,
  },
  {
    id: 'propose',
    label: 'Ideas',
    count: stageCounts.propose,
  },
  {
    id: 'deliberate',
    label: 'Discussion',
    count: stageCounts.deliberate,
  },
  {
    id: 'decide',
    label: 'Voting',
    count: stageCounts.decide,
  },
  {
    id: 'implement',
    label: 'Implementation',
    count: stageCounts.implement,
  },
];

const stageVariant = (s: ProposalStage) => {
  if (s === 'propose') return 'warning' as const;
  if (s === 'deliberate') return 'secondary' as const;
  if (s === 'decide') return 'info' as const;
  if (s === 'implement') return 'success' as const;
  return 'muted' as const;
};

const stageLabel = (s: ProposalStage) => {
  if (s === 'propose') return 'New idea';
  if (s === 'deliberate') return 'In discussion';
  if (s === 'decide') return 'Open vote';
  if (s === 'implement') return 'Implementation';
  return 'Archived';
};

const hasActiveFilters =
  Boolean(initialQuery) ||
  initialSpace !== 'all' ||
  initialBranch !== 'all' ||
  initialStage !== 'all' ||
  initialFocus !== 'all' ||
  initialSort !== 'priority';
---
<SiteLayout
  title="Browse proposals · Engage"
  description="Browse proposals across all stages: explore ideas, join discussions, see open votes, and follow decisions after the vote."
  canonical="/proposals/"
>
  <div class="page-wrap section-space proposals-page">
    <div class="proposals-surface">
      <!-- Top Header -->
      <header class="proposals-top">
        <div class="proposals-top__heading">
          <h1>Browse proposals</h1>
          <span class="proposals-total tabular">{baseProposals.length} proposals</span>
        </div>
        <div class="proposals-top__actions">
          <Button href={siteConfig.primaryCtaHref || '/proposals/new/'} size="sm">
            <Plus className="size-4" aria-hidden="true" />
            {siteConfig.primaryCtaLabel || 'Suggest an idea'}
          </Button>
        </div>
      </header>


      <!-- Workflow Tabs & Personal Relevance Shortcuts -->
      <div class="workflow-bar">
        <div class="workflow-tabs-row">
          <nav class="workflow-tabs" aria-label="Filter proposals by workflow stage">
            {stageTabs.map((tab) => {
              const isCurrent = initialStage === tab.id;
              return (
                <a
                  href={buildFilterUrl({ stage: tab.id, focus: null, needsVote: null, page: '1' })}
                  class:list={['workflow-tab', { 'is-active': isCurrent }]}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  <span>{tab.label}</span>
                  <span class="workflow-tab__count tabular">{tab.count}</span>
                </a>
              );
            })}
          </nav>

        </div>

      </div>

      <!-- Search & Quiet Secondary Filters -->
      <form data-analytics-collection="proposals" data-analytics-results={visibleProposals.length} id="proposals-filter-form" class="search-controls" role="search" method="get" action="/proposals/">
        {initialStage !== 'all' && <input type="hidden" name="stage" value={initialStage} />}

        <fieldset class="participation-filters">
          <legend>For me</legend>
          <input type="hidden" name="focus" value={initialFocus === 'recent' ? 'recent' : 'all'} />
          {user?.canParticipate && initialStage === 'decide' && <label><Checkbox id="needs-my-vote" name="needsVote" value="1" defaultChecked={initialFocus === 'needs-vote'} data-auto-submit /> Needs my vote <span class="tabular">{myOutstandingVotes.length}</span></label>}
          {user?.canParticipate && initialStage !== 'decide' && <a class="personal-vote-link" href={buildFilterUrl({ stage: 'decide', focus: 'needs-vote', needsVote: null, page: '1' })}>Needs my vote <span class="tabular">{myOutstandingVotes.length}</span></a>}
          {user && <label><Checkbox id="joined-discussions" name="joined" value="1" defaultChecked={joinedOnly} data-auto-submit /> Discussions I’ve joined</label>}
        </fieldset>
        <div class="search-row">
          <label for="proposal-search" class="sr-only">Search proposals by title, topic or ID</label>
          <Search className="search-row__icon size-4" aria-hidden="true" />
          <Input
            id="proposal-search"
            name="q"
            type="search"
            defaultValue={initialQuery}
            placeholder="Search proposals by title, topic or ID..."
            autoComplete="off"
            className="search-row__input"
          />
          {initialQuery && (
            <a href={buildFilterUrl({ q: null, page: '1' })} class="search-row__clear" aria-label="Clear search">
              <X className="size-4" aria-hidden="true" />
            </a>
          )}
        </div>

        <div class="secondary-filters-row">
          <div class="quiet-filters">

            <div class="quiet-select-wrap">
              <label for="proposal-space" class="sr-only">Space</label>
              <NativeSelect
                id="proposal-space"
                name="space"
                defaultValue={initialSpace}
                data-auto-submit
              >
                <option value="all" selected={!initialSpace || initialSpace === 'all'}>All spaces ({spaces.length})</option>
                {spaces.map((sp) => (
                  <option value={sp} selected={initialSpace === sp}>{sp}</option>
                ))}
              </NativeSelect>
            </div>

            <div class="quiet-select-wrap">
              <label for="proposal-branch" class="sr-only">Branch</label>
              <NativeSelect
                id="proposal-branch"
                name="branch"
                defaultValue={initialBranch}
                data-auto-submit
              >
                <option value="all" selected={!initialBranch || initialBranch === 'all'}>All branches</option>
                {branches.map((branch) => (
                  <option value={branch.branchId} selected={initialBranch === branch.branchId}>{branch.name}</option>
                ))}
              </NativeSelect>
            </div>

            {hasActiveFilters && (
              <a href="/proposals/" class="clear-filters-link">
                <X className="size-3.5" aria-hidden="true" />
                Clear filters
              </a>
            )}
          </div>

          <div class="results-and-sort">
            <span class="results-count tabular" id="live-results-count">
              Showing {pageProposals.length} of {visibleProposals.length} proposal{visibleProposals.length === 1 ? '' : 's'}
            </span>

            <div class="quiet-select-wrap">
              <label for="proposal-sort" class="sr-only">Sort proposals</label>
              <NativeSelect
                id="proposal-sort"
                name="sort"
                defaultValue={effectiveSort}
                data-auto-submit
              >
                <option value="priority" selected={effectiveSort === 'priority'}>Sort: Stage priority</option>
                <option value="recent" selected={effectiveSort === 'recent'}>Sort: Recently updated</option>
                <option value="divisive" selected={effectiveSort === 'divisive'}>Sort: Most divisive (5+ votes)</option>
                <option value="approved" selected={effectiveSort === 'approved'}>Sort: Most approved (5+ votes)</option>
                <option value="active" selected={effectiveSort === 'active'}>Sort: Most active</option>
                <option value="ballots" selected={effectiveSort === 'ballots'}>Sort: Ballots cast</option>
                <option value="contributions" selected={effectiveSort === 'contributions'}>Sort: Contributions</option>
              </NativeSelect>
            </div>

            <noscript>
              <Button type="submit" size="sm" variant="outline">Apply</Button>
            </noscript>
          </div>
        </div>
      </form>

      <details class="explore-proposals">
        <summary>Explore</summary>
        <div>
          <a href={buildFilterUrl({ sort: 'divisive', page: '1' })}>Most divisive</a>
          <a href={buildFilterUrl({ sort: 'approved', page: '1' })}>Most approved</a>
          <a href={buildFilterUrl({ sort: 'active', page: '1' })}>Most active</a>
        </div>
      </details>
      <!-- Spacious Proposal List -->
      {visibleProposals.length === 0 ? (
        <div class="empty-register">
          <h2>{initialFocus === 'needs-vote' && myOutstandingVotes.length === 0 ? "You're up to date" : 'No matching proposals'}</h2>
          {initialFocus === 'needs-vote' && myOutstandingVotes.length === 0 ? (
            <Button href={buildFilterUrl({ stage: 'decide', focus: 'all', q: null, branch: null, space: null })} variant="outline" size="sm">Browse active ballots</Button>
          ) : <Button href="/proposals/" variant="outline" size="sm">Clear filters</Button>}
        </div>
      ) : (
        <div class="proposal-list" role="list" id="proposal-list">
          {pageProposals.map((item) => {
            const branchName = item.jurisdictionBranchId
              ? branches.find((branch) => branch.branchId === item.jurisdictionBranchId)?.name ?? null
              : null;
            const hasVoted = votedProposalIds.has(item.proposalId);
            const needsVote = outstandingIds.has(item.proposalId);

            const actionLabel =
              item.stage === 'decide' && ballotExpired(item)
                ? 'Review closed ballot →'
                : item.stage === 'decide'
                ? hasVoted
                  ? 'Review ballot →'
                  : 'Review & vote →'
                : item.stage === 'deliberate'
                  ? 'Join discussion →'
                  : item.stage === 'implement'
                    ? 'Implementation status →'
                    : 'Read idea →';

            return (
              <article
                class="proposal-item"
                data-stage={item.stage}
                data-search={`${item.proposalId} ${item.title} ${item.space} ${item.summary}`.toLowerCase()}
                role="listitem"
              >
                <!-- Line 1: Topic Context (left) + Stage Pill (right) -->
                <div class="proposal-item__eyebrow">
                  <div class="proposal-item__context">
                    <a
                      class="proposal-item__space"
                      href={buildFilterUrl({ space: item.space, page: '1' })}
                    >
                      {item.space}
                    </a>
                    {branchName && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span class="proposal-item__branch">{branchName}</span>
                      </>
                    )}
                  </div>

                  <Badge variant={stageVariant(item.stage)}>{item.stage === 'decide' && ballotExpired(item) ? 'Voting closed' : stageLabel(item.stage)}</Badge>
                </div>

                <!-- Line 2: Prominent Visual Anchor Title -->
                {item.ballotClosesAt && <p><time datetime={new Date(item.ballotClosesAt).toISOString()} data-ballot-deadline data-prefix={ballotExpired(item) ? "Voting closed" : "Voting closes"}>{ballotExpired(item) ? "Voting closed" : "Voting closes"}: {ballotDeadlineLabel(item.ballotClosesAt)}</time></p>}
                <h2 class="proposal-item__title">
                  <a href={`/proposals/${item.slug}/`}>{item.title}</a>
                </h2>

                <!-- Line 3: Clear Description -->
                <p class="proposal-item__summary">{item.summary}</p>

                <!-- Line 4: Meaningful Participation Metadata (left) + Action Link (right) -->
                <div class="proposal-item__footer">
                  <div class="proposal-item__participation tabular">
                    <span class="participation-stat">
                      <MessageSquare className="size-3.5" aria-hidden="true" />
                      {item.commentCount} {item.commentCount === 1 ? 'contribution' : 'contributions'}
                    </span>

                    {(item.stage === 'decide' || item.votes.total > 0) && (
                      <>
                        <span class="participation-dot" aria-hidden="true">·</span>
                        <span class="participation-stat is-ballot">
                          <Vote className="size-3.5" aria-hidden="true" />
                          {item.votes.total} {item.votes.total === 1 ? 'vote' : 'votes'}
                        </span>
                      </>
                    )}

                    {hasVoted && (
                      <>
                        <span class="participation-dot" aria-hidden="true">·</span>
                        <span class="participation-personal is-voted">
                          <CheckCircle2 className="size-3.5" aria-hidden="true" />
                          You have voted
                        </span>
                      </>
                    )}

                    {!hasVoted && needsVote && (
                      <>
                        <span class="participation-dot" aria-hidden="true">·</span>
                        <span class="participation-personal is-needs-vote">
                          Needs your vote
                        </span>
                      </>
                    )}
                  </div>

                  <a class="proposal-item__cta" href={`/proposals/${item.slug}/`}>
                    {actionLabel}
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}

      <!-- Bottom Pagination Bar -->
      <footer class="proposals-bottom">
        <span class="results-count tabular">
          Showing {pageProposals.length} of {visibleProposals.length} proposal{visibleProposals.length === 1 ? '' : 's'}
        </span>

        {pageCount > 1 && (
          <nav class="pagination" aria-label="Proposal pages">
            <Button
              href={pageUrl(currentPage - 1)}
              variant="outline"
              size="sm"
              aria-disabled={currentPage === 1}
              tabIndex={currentPage === 1 ? -1 : undefined}
            >
              ← Previous
            </Button>
            <span class="tabular">Page {currentPage} of {pageCount}</span>
            <Button
              href={pageUrl(currentPage + 1)}
              variant="outline"
              size="sm"
              aria-disabled={currentPage === pageCount}
              tabIndex={currentPage === pageCount ? -1 : undefined}
            >
              Next →
            </Button>
          </nav>
        )}
      </footer>
    </div>
  </div>
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#proposals-filter-form');
  const searchInput = document.querySelector<HTMLInputElement>('#proposal-search');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.proposal-item'));
  const liveCount = document.querySelector<HTMLElement>('#live-results-count');

  // Auto-submit quiet dropdown filters on change
  document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-auto-submit]').forEach((select) => {
    select.addEventListener('change', () => {
      form?.requestSubmit();
    });
  });

  // Immediate client-side filtering on the current page, plus debounced URL sync
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    let matched = 0;
    for (const item of items) {
      const hay = item.dataset.search ?? '';
      const show = !query || hay.includes(query);
      item.hidden = !show;
      if (show) matched += 1;
    }
    if (liveCount && query) {
      liveCount.textContent = `Showing ${matched} matching on this page (press Enter to search all)`;
    }

    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      if (searchInput.value.trim() !== (new URLSearchParams(location.search).get('q') ?? '').trim()) {
        form?.requestSubmit();
      }
    }, 550);
  });
</script>

<style>
  .participation-filters { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; border: 0; padding: 0; margin: 0; }
  .participation-filters legend { float: left; margin-right: 1rem; font-weight: 600; }
  .participation-filters label { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; font-size: .9rem; }
  .personal-vote-link { display: inline-flex; gap: .5rem; min-height: 44px; align-items: center; color: var(--horizon-purple-deep); text-decoration: underline; text-underline-offset: .2em; font-size: .9rem; }
  .participation-filters input { width: 1.1rem; height: 1.1rem; accent-color: var(--horizon-purple); }
  .explore-proposals { font-size: .9rem; }
  .explore-proposals summary { cursor: pointer; width: fit-content; }
  .explore-proposals > div { display: flex; flex-wrap: wrap; gap: 1.5rem; padding: .75rem 0; }

  .proposals-page {
    max-width: 68rem;
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .proposals-surface {
    background: #ffffff;
    border: 1px solid var(--horizon-line);
    border-radius: 0.9rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    box-shadow: 0 2px 8px rgba(29, 10, 73, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  /* Header */
  .proposals-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  .proposals-top__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem 1rem;
  }

  .proposals-top h1 {
    margin: 0;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--horizon-ink);
  }

  .proposals-total {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--horizon-muted);
  }

  /* Workflow Tabs */
  .workflow-bar {
    display: grid;
    gap: 0.5rem;
  }

  .workflow-tabs-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
