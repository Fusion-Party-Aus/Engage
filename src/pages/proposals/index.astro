---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProposalStageNav from '../../components/ui/ProposalStageNav';
import { Card, CardContent } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Field } from '../../components/ui/field';
import { Input } from '../../components/ui/input';
import { NativeSelect } from '../../components/ui/native-select';
import { Badge } from '../../components/ui/badge';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals, normalizeStage } from '../../lib/store.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const initialQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const initialSpace = (Astro.url.searchParams.get('space') ?? Astro.url.searchParams.get('category') ?? 'all').trim();
const initialBranch = (Astro.url.searchParams.get('branch') ?? 'all').trim();
const branches = (await db.collection('branches').find({ recognised: true }).sort({ name: 1 }).toArray()).map(({ branchId, name }) => ({ branchId, name }));
const rawStage = (Astro.url.searchParams.get('stage') ?? Astro.url.searchParams.get('status') ?? 'all').trim();
const initialStage = rawStage === 'all' ? 'all' : normalizeStage(rawStage);

const allProposals = await listProposals(db, {
  includeArchived: Boolean(user?.isStaff),
  user,
  search: initialQuery,
  space: initialSpace,
  stage: initialStage,
  branch: initialBranch,
});
const visibleProposals = initialStage === 'all'
  ? [...allProposals].sort((a, b) => {
      const priority = { decide: 0, deliberate: 1, propose: 2, implement: 3, archived: 4 };
      return priority[a.stage] - priority[b.stage] || new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();
    })
  : allProposals;

const pageSize = 12;
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const pageCount = Math.max(1, Math.ceil(visibleProposals.length / pageSize));
const currentPage = Number.isFinite(requestedPage) ? Math.min(Math.max(requestedPage, 1), pageCount) : 1;
const pageProposals = visibleProposals.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const pageUrl = (page: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('page', String(page));
  return `/proposals/?${params.toString()}`;
};

// All spaces for filter dropdown
const baseProposals = await listProposals(db, { includeArchived: false, user });
const spaces = [...new Set(baseProposals.map((p) => p.space))].sort();

// Counts per stage
const stageCounts = {
  all: baseProposals.length,
  propose: baseProposals.filter((p) => p.stage === 'propose').length,
  deliberate: baseProposals.filter((p) => p.stage === 'deliberate').length,
  decide: baseProposals.filter((p) => p.stage === 'decide').length,
  implement: baseProposals.filter((p) => p.stage === 'implement').length,
};

const stageVariant = (s: ProposalStage) => {
  if (s === 'propose') return 'warning' as const;
  if (s === 'deliberate') return 'secondary' as const;
  if (s === 'decide') return 'info' as const;
  if (s === 'implement') return 'success' as const;
  return 'muted' as const;
};

const stageLabel = (s: ProposalStage) => {
  if (s === 'propose') return 'New idea';
  if (s === 'deliberate') return 'In discussion';
  if (s === 'decide') return 'Open vote';
  if (s === 'implement') return 'Implement';
  return 'Archived';
};
---
<SiteLayout
  title="Proposals & Participatory Decisions · Engage"
  description="Browse proposals across all stages: explore ideas, join discussions, see open votes, and follow decisions after the vote."
  canonical="/proposals/"
>
  <div class="page-wrap section-space proposals-page">
    <header class="proposals-header">
      <div>
        <h1>Browse proposals</h1>
        <p>Explore ideas, join discussions, or read an open ballot.</p>
      </div>
      {user?.canParticipate ? (
        <Button href="/proposals/new/">Suggest an idea</Button>
      ) : user ? (
        <Button href="/member/" variant="outline">Verify account to propose</Button>
      ) : (
        <Button href="/member/" variant="outline">Member sign in</Button>
      )}
    </header>

    <ProposalStageNav active={initialStage === 'archived' ? 'all' : initialStage} space={initialSpace} counts={stageCounts} />

    <form class="filter-bar" role="search" method="get" action="/proposals/">
      {initialStage !== 'all' && <input type="hidden" name="stage" value={initialStage} />}

      <Field label="Search" htmlFor="proposal-search">
        <Input
          id="proposal-search"
          name="q"
          type="search"
          defaultValue={initialQuery}
          placeholder="Search by title, keyword, ID (e.g. Horizon, housing, voting)"
          autoComplete="off"
        />
      </Field>

      <Field label="Topic" htmlFor="proposal-space">
        <NativeSelect id="proposal-space" name="space" defaultValue={initialSpace}>
          <option value="all">All spaces ({spaces.length})</option>
          {spaces.map((sp) => <option value={sp}>{sp}</option>)}
        </NativeSelect>
      </Field>

      <Field label="Decision-making branch" htmlFor="proposal-branch">
        <NativeSelect id="proposal-branch" name="branch" defaultValue={initialBranch}>
          <option value="all">All branches</option>
          {branches.map((branch) => <option value={branch.branchId}>{branch.name}</option>)}
        </NativeSelect>
      </Field>

      <div class="filter-bar__actions">
        <Button type="submit">Filter</Button>
        {(initialQuery || initialSpace !== 'all' || initialBranch !== 'all' || initialStage !== 'all') && (
          <Button href="/proposals/" variant="outline">Reset</Button>
        )}
      </div>
    </form>

    <p class="results-count">{visibleProposals.length} proposal{visibleProposals.length === 1 ? '' : 's'}</p>
    <details class="terms-help">
      <summary>What do these terms mean?</summary>
      <dl>
        <dt>Proposal</dt><dd>An idea or wording change submitted for Fusion members to consider.</dd>
        <dt>Deliberation</dt><dd>Discussion before a decision, where members share support, concerns and suggested changes.</dd>
        <dt>Wording suggestion</dt><dd>An informal contribution during discussion. It needs no seconder.</dd>
        <dt>Formal amendment</dt><dd>A proposed substantive change to recorded wording. It is decided separately from the proposal and will require one independent eligible seconder once seconding is implemented.</dd>
        <dt>Amendment ballot</dt><dd>A separate vote on a recorded amendment revision where the process requires one.</dd>
        <dt>Ballot</dt><dd>A vote on wording frozen to a particular revision.</dd>
        <dt>Ratification</dt><dd>Formal adoption by an authorised party authority after a successful ballot. Publication is a separate action.</dd>
      </dl>
    </details>

    {visibleProposals.length === 0 ? (
      <Card>
        <CardContent className="grid justify-items-center gap-3 py-12 text-center">
          <h2>No proposals found</h2>
          <p>No proposals match your current filter criteria.</p>
          <Button href="/proposals/" variant="outline">Browse all proposals</Button>
        </CardContent>
      </Card>
    ) : (
      <div class="proposals-grid">
        {pageProposals.map((item) => (
          <Card className="proposal-card" data-stage={item.stage}>
            <div class="proposal-card__meta">
              <Badge variant={stageVariant(item.stage)}>{stageLabel(item.stage)}</Badge>
              <span class="space-pill">{item.space}</span>
              {item.jurisdictionBranchId && <span class="space-pill">{branches.find((branch) => branch.branchId === item.jurisdictionBranchId)?.name ?? 'Branch scoped'}</span>}
            </div>

            <h2 class="proposal-card__title">
              <a href={`/proposals/${item.slug}/`}>{item.title}</a>
            </h2>

            <p class="proposal-card__summary">{item.summary}</p>

            <div class="proposal-card__footer">
              <div class="proposal-card__stats">
                <Badge variant="muted" title="Deliberation contributions">
                  <strong class="tabular">{item.commentCount}</strong> {item.commentCount === 1 ? 'stance' : 'stances'}
                </Badge>

                {item.stage === 'decide' && (
                  <Badge variant="info">
                    <strong class="tabular">{item.votes.total}</strong> {item.votes.total === 1 ? 'vote' : 'votes'}
                  </Badge>
                )}
                {item.stage === 'implement' && (
                  <Badge variant="success">
                    Ballot result · {item.votes.approve} approve votes
                  </Badge>
                )}
              </div>

              <a class="proposal-card__link" href={`/proposals/${item.slug}/`}>
                {item.stage === 'decide' ? 'Review the ballot →' : item.stage === 'deliberate' ? 'Join discussions →' : item.stage === 'implement' ? 'See decision progress →' : 'Read the idea →'}
              </a>
            </div>
          </Card>
        ))}
      </div>
    )}

    {pageCount > 1 && (
      <nav class="pagination" aria-label="Proposal pages">
        <Button href={pageUrl(currentPage - 1)} variant="outline" size="sm" aria-disabled={currentPage === 1} tabIndex={currentPage === 1 ? -1 : undefined}>Previous</Button>
        <span>Page {currentPage} of {pageCount}</span>
        <Button href={pageUrl(currentPage + 1)} variant="outline" size="sm" aria-disabled={currentPage === pageCount} tabIndex={currentPage === pageCount ? -1 : undefined}>Next</Button>
      </nav>
    )}
  </div>
</SiteLayout>

<style>
  .proposals-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .proposals-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .proposals-header > div { min-width: 0; }

  @media (max-width: 640px) {
    .proposals-header > div { width: 100%; flex: 1 1 100%; }
  }

  .proposals-header h1 {
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
    color: var(--horizon-purple-deep);
    overflow-wrap: anywhere;
  }

  .proposals-header p {
    color: var(--horizon-muted);
    font-size: 1.1rem;
    max-width: 65ch;
  }

  .stage-tabs {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scrollbar-width: thin;
    overscroll-behavior-inline: contain;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--horizon-line);
  }

  .stage-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--horizon-purple);
    background: var(--horizon-white);
    border: 1px solid var(--horizon-line);
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .stage-tab:hover {
    color: var(--horizon-purple-deep);
    border-color: var(--horizon-purple);
    background: var(--horizon-lavender-soft);
  }

  .stage-tab.is-active {
    color: var(--horizon-white);
    background: var(--horizon-purple);
    border-color: var(--horizon-purple);
  }

  .stage-tab .badge {
    background: var(--horizon-lavender);
    color: var(--horizon-purple-deep);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .stage-tab.is-active .badge {
    background: rgba(255, 255, 255, 0.2);
    color: var(--horizon-white);
  }

  .filter-bar {
    display: grid;
    grid-template-columns: 2fr 1fr auto;
    gap: 1rem;
    align-items: end;
    background: var(--horizon-lavender-soft);
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--horizon-line);
    min-width: 0;
  }

  .filter-bar [data-slot="field"] { min-width: 0; }

  @media (max-width: 380px) {
    .proposals-header h1 { font-size: 2rem; }
    .filter-bar { padding: 1rem; }
  }

  @media (max-width: 768px) {
    .filter-bar {
      grid-template-columns: 1fr;
    }
  }

  .filter-bar__actions {
    display: flex;
    gap: 0.5rem;
  }

  .stage-explainer {
    background: var(--horizon-lavender);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    padding: 1rem 1.35rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--horizon-purple);
  }

  .stage-explainer strong {
    color: var(--horizon-purple-deep);
  }

  .proposals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .proposal-card {
    display: flex;
    flex-direction: column;
    background: var(--horizon-white);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    padding: 1.35rem;
    box-shadow: 0 1px 3px rgba(50, 16, 90, 0.05);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .proposal-card:hover {
    border-color: var(--horizon-purple);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(50, 16, 90, 0.08);
  }

  .proposal-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
  }

  .stage-pill {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.75rem;
  }

  .stage-pill--propose {
    background: var(--horizon-warn-bg);
    color: var(--horizon-warn-ink);
    border: 1px solid #ebd49f;
  }

  .stage-pill--deliberate {
    background: var(--horizon-lavender);
    color: var(--horizon-purple-deep);
    border: 1px solid var(--horizon-line);
  }

  .stage-pill--decide {
    background: var(--horizon-voting-bg);
    color: var(--horizon-voting-ink);
    border: 1px solid #a3e7eb;
  }

  .stage-pill--implement {
    background: var(--horizon-success-bg);
    color: var(--horizon-success-ink);
    border: 1px solid #b7e8cb;
  }

  .stage-pill--archived {
    background: #f0f0f0;
    color: var(--horizon-muted);
  }

  .prov-pill {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 240px;
  }

  .prov-pill--existing-repackaged {
    background: #eafaf1;
    color: #165a36;
    border: 1px solid #c2eecf;
  }

  .prov-pill--materially-revised {
    background: #fef9eb;
    color: #8a5a00;
    border: 1px solid #fae1a0;
  }

  .prov-pill--new-proposal {
    background: #e6f9fa;
    color: #006770;
    border: 1px solid #b7edf0;
  }

  .prov-pill--party-governance {
    background: var(--horizon-lavender);
    color: var(--horizon-purple-deep);
    border: 1px solid var(--horizon-line);
  }

  .prov-pill--draft-derived {
    background: #fef2f2;
    color: #9b1c1c;
    border: 1px solid #fed7d7;
  }

  .prov-pill--unverified {
    background: var(--horizon-lavender-soft);
    color: var(--horizon-purple-muted);
    border: 1px solid var(--horizon-line);
  }

  .space-pill {
    color: var(--horizon-muted);
    font-weight: 500;
  }

  .id-pill {
    margin-left: auto;
    color: var(--horizon-muted);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .proposal-card__title {
    font-size: 1.25rem;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
  }

  .proposal-card__title a {
    color: var(--horizon-purple-deep);
    text-decoration: none;
    font-weight: 700;
  }

  .proposal-card__title a:hover {
    color: var(--horizon-focus);
    text-decoration: underline;
  }

  .proposal-card__summary {
    color: var(--horizon-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proposal-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--horizon-line);
    padding-top: 0.85rem;
    font-size: 0.88rem;
  }

  .proposal-card__stats {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--horizon-purple);
    font-weight: 500;
  }

  .vote-badge--active {
    background: var(--horizon-voting-bg);
    color: var(--horizon-voting-ink);
    border: 1px solid #a3e7eb;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.78rem;
  }

  .vote-badge--implementation {
    background: var(--horizon-lavender-soft);
    color: var(--horizon-ink);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.78rem;
  }

  .proposal-card__link {
    color: var(--horizon-purple-deep);
    font-weight: 700;
    text-decoration: underline;
    white-space: nowrap;
  }

  .proposal-card__link:hover {
    color: var(--horizon-focus);
  }

  .submit-section {
    background: var(--horizon-white);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    padding: 2.25rem;
    margin-top: 2rem;
    box-shadow: 0 1px 3px rgba(50, 16, 90, 0.05);
  }

  .submit-section h2 {
    font-size: 1.85rem;
    margin-bottom: 0.5rem;
    color: var(--horizon-purple-deep);
  }

  .submit-section p {
    color: var(--horizon-muted);
    margin-bottom: 1.5rem;
    max-width: 65ch;
    font-size: 1.05rem;
  }

  .submit-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--horizon-white);
    border-radius: 0.75rem;
    border: 1px solid var(--horizon-line);
  }

  .empty-state h2 {
    font-size: 1.65rem;
    margin-bottom: 0.5rem;
    color: var(--horizon-purple-deep);
  }

  .empty-state p {
    color: var(--horizon-muted);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .pagination { display:flex; justify-content:center; align-items:center; gap:1.2rem; padding:1rem; font-size:.9rem; font-weight:700; }
  .pagination a[aria-disabled="true"] { opacity:.4; pointer-events:none; }
  .proposals-page { gap:1.2rem; }
  .proposals-header { align-items:center; }
  .proposals-header h1 { font:700 clamp(2.2rem,3.6vw,3.2rem)/1.05 Outfit,sans-serif; margin:0 0 .4rem; }
  .proposals-header p { margin:0; font-size:1rem; }
  .stage-tabs { gap:1.35rem; padding:0; border-bottom:1px solid var(--horizon-line); }
  .stage-tab,.stage-tab:hover,.stage-tab.is-active { padding:.7rem .1rem; border:0; border-radius:0; background:none; color:var(--horizon-purple); }
  .stage-tab.is-active { box-shadow:inset 0 -3px var(--horizon-purple); }
  .stage-tab .badge,.stage-tab.is-active .badge { background:var(--horizon-lavender); color:var(--horizon-purple); }
  .filter-bar { background:transparent; border:0; border-radius:0; padding:0; grid-template-columns:2fr 1fr 1fr auto; }
  .results-count { margin:0; font-size:.9rem; font-weight:700; }
  .terms-help { align-self:stretch; font-size:.86rem; border-top:1px solid var(--horizon-line); border-bottom:1px solid var(--horizon-line); padding:.6rem 0; }
  .terms-help summary { cursor:pointer; font-weight:700; }
  .terms-help dl { display:grid; grid-template-columns:max-content 1fr; gap:.35rem 1rem; margin:.75rem 0 0; }
  .terms-help dt { font-weight:700; }
  .terms-help dd { margin:0; color:var(--horizon-muted); }
  .proposals-grid { display:grid; grid-template-columns:1fr; gap:.55rem; }
  .proposal-card { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.15rem 1.25rem; padding:1rem 1.3rem; background:#fff; border:1px solid var(--horizon-line); border-radius:.65rem; box-shadow:0 2px 7px #20104a0a; }
  .proposal-card:hover { border-color:#9b8ad0; box-shadow:0 6px 18px #20104a14; }
  .proposal-card__meta { grid-column:1; grid-row:1; }
  .proposal-card__title { grid-column:1; grid-row:2; margin:0; font:700 1.13rem/1.25 Outfit,sans-serif; }
  .proposal-card__summary { grid-column:1; grid-row:3; margin:.1rem 0 0; max-width:44ch; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; font-size:.9rem; }
  .proposal-card__footer { grid-column:2; grid-row:1 / 4; display:grid; justify-items:end; gap:.45rem; align-self:center; }
  .proposal-card__link { font-weight:700; font-size:.85rem; }
  .submit-section { max-width:52rem; margin-inline:auto; background:#fff; border:1px solid var(--horizon-line); border-radius:.8rem; padding:2rem; }
  @media(max-width:850px){.filter-bar{grid-template-columns:1fr 1fr}.filter-bar [data-slot="field"]:first-child{grid-column:1/-1}}
  @media(max-width:600px){.proposal-card{display:block}.proposal-card__footer{display:flex;justify-content:space-between;align-items:center;margin-top:.7rem}.proposal-card__stats{display:none}.submit-section{padding:1.1rem}.filter-bar{grid-template-columns:1fr}.filter-bar .field:first-child{grid-column:auto}}
</style>
