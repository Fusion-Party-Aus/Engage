---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { NativeSelect } from '../../components/ui/native-select';
import { Badge } from '../../components/ui/badge';
import {
  CheckCircle2,
  MessageSquare,
  Plus,
  Search,
  Vote,
  X,
} from 'lucide-react';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listOutstandingDecisions, listProposals, normalizeStage } from '../../lib/store.ts';
import { PROPOSAL_VOTES, proposalBallotId } from '../../lib/vote-storage.ts';
import { getSiteConfig } from '../../lib/site-config.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);
const siteConfig = await getSiteConfig(db, env);

const initialQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const initialSpace = (Astro.url.searchParams.get('space') ?? Astro.url.searchParams.get('category') ?? 'all').trim();
const initialBranch = (Astro.url.searchParams.get('branch') ?? 'all').trim();
const initialFocus = (Astro.url.searchParams.get('focus') ?? 'all').trim();
const initialSort = (Astro.url.searchParams.get('sort') ?? 'priority').trim();
const branches = (await db.collection('branches').find({ recognised: true }).sort({ name: 1 }).toArray()).map(({ branchId, name }) => ({ branchId, name }));
const rawStage = (Astro.url.searchParams.get('stage') ?? Astro.url.searchParams.get('status') ?? 'all').trim();
const initialStage = rawStage === 'all' ? 'all' : normalizeStage(rawStage);

const [allAvailableProposals, myOutstandingVotes, myVotesRaw] = await Promise.all([
  listProposals(db, {
    includeArchived: Boolean(user?.isStaff),
    user,
  }),
  user?.canParticipate ? listOutstandingDecisions(db, user.memberId, user) : Promise.resolve([]),
  user
    ? db
        .collection(PROPOSAL_VOTES)
        .find({ memberId: user.memberId })
        .project({ proposalId: 1, ballotId: 1 })
        .toArray()
    : Promise.resolve([]),
]);

const baseProposals = allAvailableProposals.filter((p) => p.stage !== 'archived');

const queryLower = initialQuery.toLowerCase();
const rawProposals = allAvailableProposals.filter((p) => {
  if (initialSpace && initialSpace !== 'all' && p.space !== initialSpace) return false;
  if (initialStage && initialStage !== 'all' && p.stage !== initialStage) return false;
  if (
    initialBranch &&
    initialBranch !== 'all' &&
    ![p.originatingBranchId, p.governanceAuthorityBranchId, p.jurisdictionBranchId].includes(initialBranch)
  ) {
    return false;
  }
  if (queryLower) {
    const haystack = `${p.proposalId} ${p.title} ${p.space} ${p.summary} ${p.details}`.toLowerCase();
    if (!haystack.includes(queryLower)) return false;
  }
  return true;
});

const outstandingIds = new Set(myOutstandingVotes.map((item) => item.proposalId));
const votedProposalIds = new Set(
  myVotesRaw
    .filter((v: any) => v.proposalId && v.ballotId === proposalBallotId(String(v.proposalId)))
    .map((v: any) => String(v.proposalId)),
);

const focusFiltered = rawProposals.filter((proposal) => {
  if (initialFocus === 'needs-vote') {
    return outstandingIds.has(proposal.proposalId);
  }
  if (initialFocus === 'discussion') {
    return proposal.stage === 'deliberate';
  }
  if (initialFocus === 'recent') {
    return true;
  }
  return true;
});

const effectiveSort = initialFocus === 'recent' && initialSort === 'priority' ? 'recent' : initialSort;

const visibleProposals = [...focusFiltered].sort((a, b) => {
  if (effectiveSort === 'recent') {
    return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();
  }
  if (effectiveSort === 'ballots') {
    return b.votes.total - a.votes.total || b.commentCount - a.commentCount;
  }
  if (effectiveSort === 'contributions') {
    return b.commentCount - a.commentCount || b.votes.total - a.votes.total;
  }
  const priority = { decide: 0, deliberate: 1, propose: 2, implement: 3, archived: 4 };
  return (
    priority[a.stage] - priority[b.stage] ||
    new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
  );
});

const pageSize = 15;
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const pageCount = Math.max(1, Math.ceil(visibleProposals.length / pageSize));
const currentPage = Number.isFinite(requestedPage) ? Math.min(Math.max(requestedPage, 1), pageCount) : 1;
const pageProposals = visibleProposals.slice((currentPage - 1) * pageSize, currentPage * pageSize);

const buildFilterUrl = (overrides: Record<string, string | null>) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(overrides)) {
    if (
      !v ||
      v === 'all' ||
      (k === 'sort' && v === 'priority') ||
      (k === 'page' && v === '1')
    ) {
      params.delete(k);
    } else {
      params.set(k, v);
    }
  }
  const qs = params.toString();
  return `/proposals/${qs ? `?${qs}` : ''}`;
};

const pageUrl = (page: number) => buildFilterUrl({ page: String(page) });

const spaces = [...new Set(baseProposals.map((p) => p.space))].sort();

const stageCounts = {
  all: baseProposals.length,
  propose: baseProposals.filter((p) => p.stage === 'propose').length,
  deliberate: baseProposals.filter((p) => p.stage === 'deliberate').length,
  decide: baseProposals.filter((p) => p.stage === 'decide').length,
  implement: baseProposals.filter((p) => p.stage === 'implement').length,
};

const stageTabs: Array<{
  id: 'all' | ProposalStage;
  label: string;
  count: number;
  description: string;
}> = [
  {
    id: 'all',
    label: 'All',
    count: stageCounts.all,
    description: 'All public proposals across every governance stage.',
  },
  {
    id: 'propose',
    label: 'Ideas',
    count: stageCounts.propose,
    description: 'Early-stage ideas submitted for initial feedback.',
  },
  {
    id: 'deliberate',
    label: 'Discussion',
    count: stageCounts.deliberate,
    description: 'Proposals open for member contributions and wording amendments.',
  },
  {
    id: 'decide',
    label: 'Voting',
    count: stageCounts.decide,
    description: 'Proposals with an active ballot bound to a frozen wording revision.',
  },
  {
    id: 'implement',
    label: 'Implementation',
    count: stageCounts.implement,
    description: 'Decisions being processed for ratification and policy publication.',
  },
];

const activeStageMeta =
  stageTabs.find((tab) => tab.id === initialStage) ?? stageTabs[0]!;

const stageVariant = (s: ProposalStage) => {
  if (s === 'propose') return 'warning' as const;
  if (s === 'deliberate') return 'secondary' as const;
  if (s === 'decide') return 'info' as const;
  if (s === 'implement') return 'success' as const;
  return 'muted' as const;
};

const stageLabel = (s: ProposalStage) => {
  if (s === 'propose') return 'New idea';
  if (s === 'deliberate') return 'In discussion';
  if (s === 'decide') return 'Open vote';
  if (s === 'implement') return 'Implementation';
  return 'Archived';
};

const hasActiveFilters =
  Boolean(initialQuery) ||
  initialSpace !== 'all' ||
  initialBranch !== 'all' ||
  initialStage !== 'all' ||
  initialFocus !== 'all' ||
  initialSort !== 'priority';
---
<SiteLayout
  title="Browse proposals · Engage"
  description="Browse proposals across all stages: explore ideas, join discussions, see open votes, and follow decisions after the vote."
  canonical="/proposals/"
>
  <div class="page-wrap section-space proposals-page">
    <div class="proposals-surface">
      <!-- Top Header -->
      <header class="proposals-top">
        <div class="proposals-top__heading">
          <h1>Browse proposals</h1>
          <span class="proposals-total tabular">{baseProposals.length} proposals</span>
        </div>
        <div class="proposals-top__actions">
          <Button href={siteConfig.primaryCtaHref || '/proposals/new/'} size="sm">
            <Plus className="size-4" aria-hidden="true" />
            {siteConfig.primaryCtaLabel || 'Suggest an idea'}
          </Button>
        </div>
      </header>

      <!-- Workflow Tabs & Personal Relevance Shortcuts -->
      <div class="workflow-bar">
        <div class="workflow-tabs-row">
          <nav class="workflow-tabs" aria-label="Filter proposals by workflow stage">
            {stageTabs.map((tab) => {
              const isCurrent = initialStage === tab.id && initialFocus === 'all';
              return (
                <a
                  href={buildFilterUrl({ stage: tab.id, focus: null, page: '1' })}
                  class:list={['workflow-tab', { 'is-active': isCurrent }]}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  <span>{tab.label}</span>
                  <span class="workflow-tab__count tabular">{tab.count}</span>
                </a>
              );
            })}
          </nav>

          <div class="personal-shortcuts" role="group" aria-label="Quick focus filters">
            {user?.canParticipate && (
              <a
                href={buildFilterUrl({
                  focus: initialFocus === 'needs-vote' ? null : 'needs-vote',
                  stage: 'decide',
                  page: '1',
                })}
                class:list={['shortcut-pill', { 'is-active': initialFocus === 'needs-vote' }]}
              >
                Needs your vote
                <span class="tabular">{myOutstandingVotes.length}</span>
              </a>
            )}
            <a
              href={buildFilterUrl({
                focus: initialFocus === 'discussion' ? null : 'discussion',
                stage: 'deliberate',
                page: '1',
              })}
              class:list={['shortcut-pill', { 'is-active': initialFocus === 'discussion' }]}
            >
              Join the discussion
              <span class="tabular">{stageCounts.deliberate}</span>
            </a>
            <a
              href={buildFilterUrl({
                focus: initialFocus === 'recent' ? null : 'recent',
                sort: 'recent',
                page: '1',
              })}
              class:list={['shortcut-pill', { 'is-active': initialFocus === 'recent' || effectiveSort === 'recent' }]}
            >
              Recently updated
            </a>
          </div>
        </div>

        <p class="workflow-caption">{activeStageMeta.description}</p>
      </div>

      <!-- Search & Quiet Secondary Filters -->
      <form data-analytics-collection="proposals" data-analytics-results={visibleProposals.length} id="proposals-filter-form" class="search-controls" role="search" method="get" action="/proposals/">
        {initialStage !== 'all' && <input type="hidden" name="stage" value={initialStage} />}
        {initialFocus !== 'all' && <input type="hidden" name="focus" value={initialFocus} />}

        <div class="search-row">
          <label for="proposal-search" class="sr-only">Search proposals by title, topic or ID</label>
          <Search className="search-row__icon size-4" aria-hidden="true" />
          <Input
            id="proposal-search"
            name="q"
            type="search"
            defaultValue={initialQuery}
            placeholder="Search proposals by title, topic or ID..."
            autoComplete="off"
            className="search-row__input"
          />
          {initialQuery && (
            <a href={buildFilterUrl({ q: null, page: '1' })} class="search-row__clear" aria-label="Clear search">
              <X className="size-4" aria-hidden="true" />
            </a>
          )}
        </div>

        <div class="secondary-filters-row">
          <div class="quiet-filters">
            <div class="quiet-select-wrap">
              <label for="proposal-stage-select" class="sr-only">Stage</label>
              <NativeSelect
                id="proposal-stage-select"
                name="stage"
                defaultValue={initialStage}
                data-auto-submit
              >
                <option value="all">All stages</option>
                <option value="propose">Ideas ({stageCounts.propose})</option>
                <option value="deliberate">Discussion ({stageCounts.deliberate})</option>
                <option value="decide">Voting ({stageCounts.decide})</option>
                <option value="implement">Implementation ({stageCounts.implement})</option>
              </NativeSelect>
            </div>

            <div class="quiet-select-wrap">
              <label for="proposal-space" class="sr-only">Space</label>
              <NativeSelect
                id="proposal-space"
                name="space"
                defaultValue={initialSpace}
                data-auto-submit
              >
                <option value="all">All spaces ({spaces.length})</option>
                {spaces.map((sp) => (
                  <option value={sp}>{sp}</option>
                ))}
              </NativeSelect>
            </div>

            <div class="quiet-select-wrap">
              <label for="proposal-branch" class="sr-only">Branch</label>
              <NativeSelect
                id="proposal-branch"
                name="branch"
                defaultValue={initialBranch}
                data-auto-submit
              >
                <option value="all">All branches</option>
                {branches.map((branch) => (
                  <option value={branch.branchId}>{branch.name}</option>
                ))}
              </NativeSelect>
            </div>

            {hasActiveFilters && (
              <a href="/proposals/" class="clear-filters-link">
                <X className="size-3.5" aria-hidden="true" />
                Clear filters
              </a>
            )}
          </div>

          <div class="results-and-sort">
            <span class="results-count tabular" id="live-results-count">
              Showing {pageProposals.length} of {visibleProposals.length} proposal{visibleProposals.length === 1 ? '' : 's'}
            </span>

            <div class="quiet-select-wrap">
              <label for="proposal-sort" class="sr-only">Sort proposals</label>
              <NativeSelect
                id="proposal-sort"
                name="sort"
                defaultValue={effectiveSort}
                data-auto-submit
              >
                <option value="priority">Sort: Stage priority</option>
                <option value="recent">Sort: Recently updated</option>
                <option value="ballots">Sort: Ballots cast</option>
                <option value="contributions">Sort: Contributions</option>
              </NativeSelect>
            </div>

            <noscript>
              <Button type="submit" size="sm" variant="outline">Apply</Button>
            </noscript>
          </div>
        </div>
      </form>

      <!-- Spacious Proposal List -->
      {visibleProposals.length === 0 ? (
        <div class="empty-register">
          <h2>No proposals match these filters</h2>
          <p>Try clearing your search query or switching back to all workflow stages.</p>
          <Button href="/proposals/" variant="outline" size="sm">Clear filters</Button>
        </div>
      ) : (
        <div class="proposal-list" role="list" id="proposal-list">
          {pageProposals.map((item) => {
            const branchName = item.jurisdictionBranchId
              ? branches.find((branch) => branch.branchId === item.jurisdictionBranchId)?.name ?? null
              : null;
            const hasVoted = votedProposalIds.has(item.proposalId);
            const needsVote = outstandingIds.has(item.proposalId);

            const actionLabel =
              item.stage === 'decide'
                ? hasVoted
                  ? 'Review ballot →'
                  : 'Review & vote →'
                : item.stage === 'deliberate'
                  ? 'Join discussion →'
                  : item.stage === 'implement'
                    ? 'Implementation status →'
                    : 'Read idea →';

            return (
              <article
                class="proposal-item"
                data-stage={item.stage}
                data-search={`${item.proposalId} ${item.title} ${item.space} ${item.summary}`.toLowerCase()}
                role="listitem"
              >
                <!-- Line 1: Topic Context (left) + Stage Pill (right) -->
                <div class="proposal-item__eyebrow">
                  <div class="proposal-item__context">
                    <span class="proposal-item__id tabular">{item.proposalId}</span>
                    <span aria-hidden="true">·</span>
                    <a
                      class="proposal-item__space"
                      href={buildFilterUrl({ space: item.space, page: '1' })}
                    >
                      {item.space}
                    </a>
                    {branchName && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span class="proposal-item__branch">{branchName}</span>
                      </>
                    )}
                  </div>

                  <Badge variant={stageVariant(item.stage)}>{stageLabel(item.stage)}</Badge>
                </div>

                <!-- Line 2: Prominent Visual Anchor Title -->
                <h2 class="proposal-item__title">
                  <a href={`/proposals/${item.slug}/`}>{item.title}</a>
                </h2>

                <!-- Line 3: Clear Description -->
                <p class="proposal-item__summary">{item.summary}</p>

                <!-- Line 4: Meaningful Participation Metadata (left) + Action Link (right) -->
                <div class="proposal-item__footer">
                  <div class="proposal-item__participation tabular">
                    <span class="participation-stat">
                      <MessageSquare className="size-3.5" aria-hidden="true" />
                      {item.commentCount} {item.commentCount === 1 ? 'contribution' : 'contributions'}
                    </span>

                    {(item.stage === 'decide' || item.votes.total > 0) && (
                      <>
                        <span class="participation-dot" aria-hidden="true">·</span>
                        <span class="participation-stat is-ballot">
                          <Vote className="size-3.5" aria-hidden="true" />
                          Formal ballot · {item.votes.total} {item.votes.total === 1 ? 'ballot cast' : 'ballots cast'}
                        </span>
                      </>
                    )}

                    {hasVoted && (
                      <>
                        <span class="participation-dot" aria-hidden="true">·</span>
                        <span class="participation-personal is-voted">
                          <CheckCircle2 className="size-3.5" aria-hidden="true" />
                          You have voted
                        </span>
                      </>
                    )}

                    {!hasVoted && needsVote && (
                      <>
                        <span class="participation-dot" aria-hidden="true">·</span>
                        <span class="participation-personal is-needs-vote">
                          Needs your vote
                        </span>
                      </>
                    )}
                  </div>

                  <a class="proposal-item__cta" href={`/proposals/${item.slug}/`}>
                    {actionLabel}
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}

      <!-- Bottom Pagination Bar -->
      <footer class="proposals-bottom">
        <span class="results-count tabular">
          Showing {pageProposals.length} of {visibleProposals.length} proposal{visibleProposals.length === 1 ? '' : 's'}
        </span>

        {pageCount > 1 && (
          <nav class="pagination" aria-label="Proposal pages">
            <Button
              href={pageUrl(currentPage - 1)}
              variant="outline"
              size="sm"
              aria-disabled={currentPage === 1}
              tabIndex={currentPage === 1 ? -1 : undefined}
            >
              ← Previous
            </Button>
            <span class="tabular">Page {currentPage} of {pageCount}</span>
            <Button
              href={pageUrl(currentPage + 1)}
              variant="outline"
              size="sm"
              aria-disabled={currentPage === pageCount}
              tabIndex={currentPage === pageCount ? -1 : undefined}
            >
              Next →
            </Button>
          </nav>
        )}
      </footer>
    </div>
  </div>
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#proposals-filter-form');
  const searchInput = document.querySelector<HTMLInputElement>('#proposal-search');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.proposal-item'));
  const liveCount = document.querySelector<HTMLElement>('#live-results-count');

  // Auto-submit quiet dropdown filters on change
  document.querySelectorAll<HTMLSelectElement>('[data-auto-submit]').forEach((select) => {
    select.addEventListener('change', () => {
      form?.requestSubmit();
    });
  });

  // Immediate client-side filtering on the current page, plus debounced URL sync
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    let matched = 0;
    for (const item of items) {
      const hay = item.dataset.search ?? '';
      const show = !query || hay.includes(query);
      item.hidden = !show;
      if (show) matched += 1;
    }
    if (liveCount && query) {
      liveCount.textContent = `Showing ${matched} matching on this page (press Enter to search all)`;
    }

    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      if (searchInput.value.trim() !== (new URLSearchParams(location.search).get('q') ?? '').trim()) {
        form?.requestSubmit();
      }
    }, 550);
  });
</script>

<style>
  .proposals-page {
    max-width: 68rem;
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .proposals-surface {
    background: #ffffff;
    border: 1px solid var(--horizon-line);
    border-radius: 0.9rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    box-shadow: 0 2px 8px rgba(29, 10, 73, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  /* Header */
  .proposals-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  .proposals-top__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem 1rem;
  }

  .proposals-top h1 {
    margin: 0;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--horizon-ink);
  }

  .proposals-total {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--horizon-muted);
  }

  /* Workflow Tabs */
  .workflow-bar {
    display: grid;
    gap: 0.5rem;
  }

  .workflow-tabs-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    border-bottom: 1px solid var(--horizon-line);
    padding-bottom: 0.1rem;
  }

  .workflow-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.15rem;
  }

  .workflow-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.45rem 0.1rem 0.6rem;
    margin-bottom: -2px;
    border-bottom: 2px solid transparent;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--horizon-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .workflow-tab:hover {
    color: var(--horizon-ink);
  }

  .workflow-tab.is-active {
    color: var(--horizon-purple-deep);
    border-bottom-color: var(--horizon-purple);
  }

  .workflow-tab__count {
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    background: var(--horizon-lavender);
    color: var(--horizon-purple-deep);
  }

  .personal-shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.4rem;
  }

  .shortcut-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--horizon-line);
    background: var(--horizon-lavender-soft);
    color: var(--horizon-muted);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
  }

  .shortcut-pill:hover {
    border-color: #b7a2df;
    color: var(--horizon-purple-deep);
  }

  .shortcut-pill.is-active {
    background: var(--horizon-purple);
    border-color: var(--horizon-purple);
    color: #ffffff;
  }

  .workflow-caption {
    margin: 0;
    font-size: 0.82rem;
    color: var(--horizon-muted);
  }

  /* Search & Secondary Filters */
  .search-controls {
    display: grid;
    gap: 0.75rem;
  }

  .search-row {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-row__icon {
