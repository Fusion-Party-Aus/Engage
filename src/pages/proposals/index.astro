---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals, normalizeStage } from '../../lib/store.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const initialQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const initialSpace = (Astro.url.searchParams.get('space') ?? Astro.url.searchParams.get('category') ?? 'all').trim();
const rawStage = (Astro.url.searchParams.get('stage') ?? Astro.url.searchParams.get('status') ?? 'all').trim();
const initialStage = rawStage === 'all' ? 'all' : normalizeStage(rawStage);

const allProposals = await listProposals(db, {
  includeArchived: Boolean(user?.isStaff),
  search: initialQuery,
  space: initialSpace,
  stage: initialStage,
});

// All spaces for filter dropdown
const baseProposals = await listProposals(db, { includeArchived: false });
const spaces = [...new Set(baseProposals.map((p) => p.space))].sort();

// Counts per stage
const stageCounts = {
  all: baseProposals.length,
  propose: baseProposals.filter((p) => p.stage === 'propose').length,
  deliberate: baseProposals.filter((p) => p.stage === 'deliberate').length,
  decide: baseProposals.filter((p) => p.stage === 'decide').length,
  implement: baseProposals.filter((p) => p.stage === 'implement').length,
};

const stageLabel = (s: ProposalStage) => {
  if (s === 'propose') return '1. Propose';
  if (s === 'deliberate') return '2. Deliberate';
  if (s === 'decide') return '3. Decide';
  if (s === 'implement') return '4. Implement';
  return 'Archived';
};
---
<SiteLayout
  title="Proposals & Participatory Decisions · Engage"
  description="Explore proposals across all stages: propose ideas, deliberate with amendments, vote on decisions, and track implementation."
  canonical={`${Astro.url.origin}/proposals/`}
>
  <div class="page-wrap section-space proposals-page">
    <header class="proposals-header">
      <div>
        <h1>Proposals &amp; Decisions</h1>
        <p>Browse party proposals, contribute to deliberations, and vote on active ballots.</p>
      </div>
      {user?.canParticipate ? (
        <a class="button button--primary" href="#submit-proposal">
          + Submit proposal
        </a>
      ) : user ? (
        <a class="button button--outline" href="/member/">
          Verify account to propose
        </a>
      ) : (
        <a class="button button--outline" href="/member/">
          Member sign in
        </a>
      )}
    </header>

    <!-- Lifecycle Tabs -->
    <nav class="stage-tabs" aria-label="Proposal lifecycle stages">
      <a
        href={initialSpace !== 'all' ? `/proposals/?space=${encodeURIComponent(initialSpace)}` : '/proposals/'}
        class:list={['stage-tab', { 'is-active': initialStage === 'all' }]}
      >
        <span>All</span>
        <span class="badge tabular">{stageCounts.all}</span>
      </a>
      <a
        href={`/proposals/?stage=propose${initialSpace !== 'all' ? `&space=${encodeURIComponent(initialSpace)}` : ''}`}
        class:list={['stage-tab', { 'is-active': initialStage === 'propose' }]}
      >
        <span>1. Propose</span>
        <span class="badge tabular">{stageCounts.propose}</span>
      </a>
      <a
        href={`/proposals/?stage=deliberate${initialSpace !== 'all' ? `&space=${encodeURIComponent(initialSpace)}` : ''}`}
        class:list={['stage-tab', { 'is-active': initialStage === 'deliberate' }]}
      >
        <span>2. Deliberate</span>
        <span class="badge tabular">{stageCounts.deliberate}</span>
      </a>
      <a
        href={`/proposals/?stage=decide${initialSpace !== 'all' ? `&space=${encodeURIComponent(initialSpace)}` : ''}`}
        class:list={['stage-tab', { 'is-active': initialStage === 'decide' }]}
      >
        <span>3. Decide (Voting)</span>
        <span class="badge tabular">{stageCounts.decide}</span>
      </a>
      <a
        href={`/proposals/?stage=implement${initialSpace !== 'all' ? `&space=${encodeURIComponent(initialSpace)}` : ''}`}
        class:list={['stage-tab', { 'is-active': initialStage === 'implement' }]}
      >
        <span>4. Implement</span>
        <span class="badge tabular">{stageCounts.implement}</span>
      </a>
    </nav>

    <!-- Filter Bar -->
    <form class="filter-bar" role="search" method="get" action="/proposals/">
      {initialStage !== 'all' && <input type="hidden" name="stage" value={initialStage} />}

      <label class="field">
        <span>Search</span>
        <input
          id="proposal-search"
          name="q"
          type="search"
          value={initialQuery}
          placeholder="Search by title, keyword, ID (e.g. Horizon, housing, voting)"
          autocomplete="off"
        />
      </label>

      <label class="field">
        <span>Space / Topic</span>
        <select id="proposal-space" name="space">
          <option value="all" selected={initialSpace === 'all'}>All spaces ({spaces.length})</option>
          {spaces.map((sp) => (
            <option value={sp} selected={initialSpace === sp}>
              {sp}
            </option>
          ))}
        </select>
      </label>

      <div class="filter-bar__actions">
        <button class="button" type="submit">Filter</button>
        {(initialQuery || initialSpace !== 'all' || initialStage !== 'all') && (
          <a class="button button--outline" href="/proposals/">
            Reset
          </a>
        )}
      </div>
    </form>

    <!-- Proposals List -->
    {allProposals.length === 0 ? (
      <div class="empty-state">
        <h2>No proposals found</h2>
        <p>No proposals match your current filter criteria.</p>
        <a class="button button--outline" href="/proposals/">View all proposals</a>
      </div>
    ) : (
      <div class="proposals-grid">
        {allProposals.map((item) => (
          <article class="proposal-card" data-stage={item.stage}>
            <div class="proposal-card__meta">
              <span class:list={['stage-pill', `stage-pill--${item.stage}`]}>
                {stageLabel(item.stage)}
              </span>
              <span class="space-pill">{item.space}</span>
              <span class="id-pill tabular">{item.proposalId}</span>
              {item.provenance && (
                <span class:list={['prov-pill', `prov-pill--${item.provenance.category || 'unverified'}`]}>
                  {item.provenance.label}
                </span>
              )}
            </div>

            <h2 class="proposal-card__title">
              <a href={`/proposals/${item.slug}/`}>{item.title}</a>
            </h2>

            <p class="proposal-card__summary">{item.summary}</p>

            <div class="proposal-card__footer">
              <div class="proposal-card__stats">
                <span class="stat-badge" title="Deliberation contributions">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <strong class="tabular">{item.commentCount}</strong> {item.commentCount === 1 ? 'stance' : 'stances'}
                </span>

                {item.stage === 'decide' && (
                  <span class="vote-badge vote-badge--active">
                    <strong class="tabular">{item.votes.total}</strong> {item.votes.total === 1 ? 'vote' : 'votes'}
                  </span>
                )}
                {item.stage === 'implement' && (
                  <span class="vote-badge vote-badge--adopted">
                    Adopted ({item.votes.approve} / {item.votes.total})
                  </span>
                )}
              </div>

              <a class="proposal-card__link" href={`/proposals/${item.slug}/`}>
                {item.stage === 'decide' ? 'Cast your vote →' : item.stage === 'deliberate' ? 'Deliberate →' : item.stage === 'implement' ? 'View delivery →' : 'Read proposal →'}
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

    <!-- Submit proposal section for verified members -->
    {user?.canParticipate && (
      <section id="submit-proposal" class="submit-section" aria-labelledby="submit-heading">
        <h2 id="submit-heading">Submit a proposal</h2>
        <p>Introduce a new proposal or motion for community review.</p>

        <form id="new-proposal-form" class="submit-form">
          <div class="form-grid">
            <label class="field">
              <span>Proposal Title *</span>
              <input
                type="text"
                name="title"
                required
                minlength="4"
                maxlength="200"
                placeholder="e.g. Modernising Party Delegate Elections"
              />
            </label>

            <label class="field">
              <span>Space / Topic *</span>
              <input
                type="text"
                name="space"
                required
                minlength="2"
                maxlength="100"
                placeholder="e.g. Governance, Climate, Digital Rights, Economy"
                list="space-suggestions"
              />
              <datalist id="space-suggestions">
                {spaces.map((sp) => (
                  <option value={sp} />
                ))}
              </datalist>
            </label>
          </div>

          <label class="field">
            <span>Core Statement / Summary *</span>
            <textarea
              name="summary"
              required
              minlength="10"
              maxlength="2000"
              rows="3"
              placeholder="A concise 1-3 sentence summary of what this proposal establishes or changes."
            ></textarea>
          </label>

          <label class="field">
            <span>Key Outcomes (one per line)</span>
            <textarea
              name="outcomes"
              rows="3"
              placeholder="Direct member participation in delegate ballots&#10;Transparency in internal executive votes"
            ></textarea>
          </label>

          <label class="field">
            <span>Detailed Rationale &amp; Background</span>
            <textarea
              name="details"
              rows="6"
              placeholder="Provide background context, problems solved, and operational details..."
            ></textarea>
          </label>

          <div class="form-actions">
            <button class="button button--primary" type="submit" id="submit-btn">
              Submit proposal
            </button>
            <span id="submit-status" class="form-status" role="status" aria-live="polite"></span>
          </div>
        </form>
      </section>
    )}
  </div>
</SiteLayout>

<script>
  const form = document.getElementById('new-proposal-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('submit-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !statusEl) return;

      submitBtn.disabled = true;
      statusEl.textContent = 'Submitting proposal...';

      const formData = new FormData(form);
      const outcomesRaw = String(formData.get('outcomes') ?? '');
      const outcomes = outcomesRaw
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean);

      const payload = {
        title: formData.get('title'),
        space: formData.get('space'),
        summary: formData.get('summary'),
        details: formData.get('details'),
        outcomes,
        stage: 'propose',
      };

      try {
        const res = await fetch('/api/proposals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Failed to submit proposal.');
        }

        statusEl.textContent = 'Proposal submitted! Redirecting...';
        location.href = `/proposals/${data.proposal.slug}/`;
      } catch (err: any) {
        statusEl.textContent = err.message || 'Error submitting proposal.';
        submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .proposals-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .proposals-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .proposals-header h1 {
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
    color: var(--horizon-purple-deep);
  }

  .proposals-header p {
    color: var(--horizon-muted);
    font-size: 1.1rem;
    max-width: 65ch;
  }

  .stage-tabs {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--horizon-line);
  }

  .stage-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--horizon-purple);
    background: var(--horizon-white);
    border: 1px solid var(--horizon-line);
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .stage-tab:hover {
    color: var(--horizon-purple-deep);
    border-color: var(--horizon-purple);
    background: var(--horizon-lavender-soft);
  }

  .stage-tab.is-active {
    color: var(--horizon-white);
    background: var(--horizon-purple);
    border-color: var(--horizon-purple);
  }

  .stage-tab .badge {
    background: var(--horizon-lavender);
    color: var(--horizon-purple-deep);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .stage-tab.is-active .badge {
    background: rgba(255, 255, 255, 0.2);
    color: var(--horizon-white);
  }

  .filter-bar {
    display: grid;
    grid-template-columns: 2fr 1fr auto;
    gap: 1rem;
    align-items: end;
    background: var(--horizon-lavender-soft);
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--horizon-line);
  }

  @media (max-width: 768px) {
    .filter-bar {
      grid-template-columns: 1fr;
    }
  }

  .filter-bar__actions {
    display: flex;
    gap: 0.5rem;
  }

  .stage-explainer {
    background: var(--horizon-lavender);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    padding: 1rem 1.35rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--horizon-purple);
  }

  .stage-explainer strong {
    color: var(--horizon-purple-deep);
  }

  .proposals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .proposal-card {
    display: flex;
    flex-direction: column;
    background: var(--horizon-white);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    padding: 1.35rem;
    box-shadow: 0 1px 3px rgba(50, 16, 90, 0.05);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .proposal-card:hover {
    border-color: var(--horizon-purple);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(50, 16, 90, 0.08);
  }

  .proposal-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
  }

  .stage-pill {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.75rem;
  }

  .stage-pill--propose {
    background: var(--horizon-warn-bg);
    color: var(--horizon-warn-ink);
    border: 1px solid #ebd49f;
  }

  .stage-pill--deliberate {
    background: var(--horizon-lavender);
    color: var(--horizon-purple-deep);
    border: 1px solid var(--horizon-line);
  }

  .stage-pill--decide {
    background: var(--horizon-voting-bg);
    color: var(--horizon-voting-ink);
    border: 1px solid #a3e7eb;
  }

  .stage-pill--implement {
    background: var(--horizon-success-bg);
    color: var(--horizon-success-ink);
    border: 1px solid #b7e8cb;
  }

  .stage-pill--archived {
    background: #f0f0f0;
    color: var(--horizon-muted);
  }

  .prov-pill {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 240px;
  }

  .prov-pill--existing-repackaged {
    background: #eafaf1;
    color: #165a36;
    border: 1px solid #c2eecf;
  }

  .prov-pill--materially-revised {
    background: #fef9eb;
    color: #8a5a00;
    border: 1px solid #fae1a0;
  }

  .prov-pill--new-proposal {
    background: #e6f9fa;
    color: #006770;
    border: 1px solid #b7edf0;
  }

  .prov-pill--party-governance {
    background: var(--horizon-lavender);
    color: var(--horizon-purple-deep);
    border: 1px solid var(--horizon-line);
  }

  .prov-pill--draft-derived {
    background: #fef2f2;
    color: #9b1c1c;
    border: 1px solid #fed7d7;
  }

  .prov-pill--unverified {
    background: var(--horizon-lavender-soft);
    color: var(--horizon-purple-muted);
    border: 1px solid var(--horizon-line);
  }

  .space-pill {
    color: var(--horizon-muted);
    font-weight: 500;
  }

  .id-pill {
    margin-left: auto;
    color: var(--horizon-muted);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .proposal-card__title {
    font-size: 1.25rem;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
  }

  .proposal-card__title a {
    color: var(--horizon-purple-deep);
    text-decoration: none;
    font-weight: 700;
  }

  .proposal-card__title a:hover {
    color: var(--horizon-focus);
    text-decoration: underline;
  }

  .proposal-card__summary {
    color: var(--horizon-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proposal-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--horizon-line);
    padding-top: 0.85rem;
    font-size: 0.88rem;
  }

  .proposal-card__stats {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--horizon-purple);
    font-weight: 500;
  }

  .vote-badge--active {
    background: var(--horizon-voting-bg);
    color: var(--horizon-voting-ink);
    border: 1px solid #a3e7eb;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.78rem;
  }

  .vote-badge--adopted {
    background: var(--horizon-success-bg);
    color: var(--horizon-success-ink);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.78rem;
  }

  .proposal-card__link {
    color: var(--horizon-purple-deep);
    font-weight: 700;
    text-decoration: underline;
    white-space: nowrap;
  }

  .proposal-card__link:hover {
    color: var(--horizon-focus);
  }

  .submit-section {
    background: var(--horizon-white);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    padding: 2.25rem;
    margin-top: 2rem;
    box-shadow: 0 1px 3px rgba(50, 16, 90, 0.05);
  }

  .submit-section h2 {
    font-size: 1.85rem;
    margin-bottom: 0.5rem;
    color: var(--horizon-purple-deep);
  }

  .submit-section p {
    color: var(--horizon-muted);
    margin-bottom: 1.5rem;
    max-width: 65ch;
    font-size: 1.05rem;
  }

  .submit-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--horizon-white);
    border-radius: 0.75rem;
    border: 1px solid var(--horizon-line);
  }

  .empty-state h2 {
    font-size: 1.65rem;
    margin-bottom: 0.5rem;
    color: var(--horizon-purple-deep);
  }

  .empty-state p {
    color: var(--horizon-muted);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }
</style>
