---
import CivicIntro from '../../../components/site/CivicIntro.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { Button } from '../../../components/ui/button';
import { Badge } from '../../../components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle } from '../../../components/ui/card';
import { Field } from '../../../components/ui/field';
import { Input } from '../../../components/ui/input';
import { Label } from '../../../components/ui/label';
import { Textarea } from '../../../components/ui/textarea';
import { Checkbox } from '../../../components/ui/checkbox';
import { Alert, AlertDescription } from '../../../components/ui/alert';
import {
  POLICY_CHANGE_GUIDANCE,
  POLICY_CHANGE_TYPES,
  defaultPolicyChangeTitle,
  isPolicyChangeType,
} from '../../../lib/policy-change.ts';
import { policyCanonicalPath } from '../../../lib/policy-registry.ts';
import ProposalScopeSelector from '../../../components/proposal/ProposalScopeSelector';
import PolicyChangeTypeSelector from '../../../components/proposal/PolicyChangeTypeSelector';
import { ImagePlus, Link as LinkIcon } from 'lucide-react';
import { getSessionUser } from '../../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../../lib/db.ts';
import { canViewProposal, normalizeProposalDoc } from '../../../lib/proposal-helpers.ts';
import { getSenseSubmission, SenseError } from '../../../lib/sense-box.ts';
import { SENSE_TOPICS } from '../../../lib/sense-box-options.ts';
import {
  defaultProposalScopeKey,
  listProposalSubmissionScopes,
} from '../../../lib/proposal-scope.ts';

export const prerender = false;
const env = runtimeEnv(Astro.locals);
const [user, db] = await Promise.all([getSessionUser(Astro.request, env), getDatabase(env)]);
// Submission destinations are a participation list, not an administrative
// scope. Every verified member can submit to every recognised branch.
const branches = user?.canParticipate
  ? await db.collection('branches').find({ recognised: true }).sort({ kind: 1, name: 1 }).toArray()
  : [];
const scopeOptions = listProposalSubmissionScopes(branches);
const defaultScopeKey = user ? defaultProposalScopeKey(user, scopeOptions) : 'national';
const showScopeSelector = Boolean(user?.canParticipate && scopeOptions.length > 1);

const quickTopics = [
  'Climate & Energy',
  'Housing & Planning',
  'Transport & Infrastructure',
  'Digital Rights & AI',
  'Healthcare',
  'Education & Science',
  'Economy & Tax',
  'Party Governance',
];

// A proposal may start from an adopted policy. The change is recorded against
// that exact published revision; the policy itself does not change until a
// successful ballot is ratified.
const requestedTargetPolicyId = (Astro.url.searchParams.get('targetPolicyId') ?? '').trim();
const requestedChange = Astro.url.searchParams.get('change');
const changeType = isPolicyChangeType(requestedChange) ? requestedChange : 'amend';
const targetPolicy = requestedTargetPolicyId
  ? await db.collection('policy_registry').findOne({
      policyId: requestedTargetPolicyId,
      publicationStatus: 'published',
    })
  : null;
const isPolicyChange = Boolean(targetPolicy);
const changeTypeOptions = POLICY_CHANGE_TYPES.map((type) => ({
  value: type,
  label: POLICY_CHANGE_GUIDANCE[type].label,
  description: POLICY_CHANGE_GUIDANCE[type].description,
}));
const guidance = POLICY_CHANGE_GUIDANCE[changeType];

// A reviewer may develop a proposal from a Sense Box priority. The source is
// only a drafting aid: it grants no governance authority and does not publish
// the original submission.
const requestedSenseId = (Astro.url.searchParams.get('sense') ?? '').trim();
let senseSource: Awaited<ReturnType<typeof getSenseSubmission>> = null;
let senseError = '';
if (requestedSenseId && user) {
  try {
    senseSource = await getSenseSubmission(db, user, requestedSenseId);
    if (!senseSource) senseError = 'That Sense Box priority was not found.';
  } catch (error) {
    senseError = error instanceof SenseError ? error.message : 'Couldn’t load that Sense Box priority.';
  }
}
const senseIsPublished = senseSource?.visibility === 'published';
const privateSenseSource = Boolean(senseSource && !senseIsPublished);
const sensePrefill = senseSource
  ? {
      displayTitle: senseSource.title,
      title: senseIsPublished ? senseSource.title : '',
      summary: senseIsPublished ? senseSource.detail : '',
      details: senseIsPublished
        ? `This proposal was developed from a Sense Box priority raised in ${senseSource.locality || 'the community'}.\n\n${senseSource.detail}`
        : '',
      space: SENSE_TOPICS[senseSource.topic],
    }
  : null;

const defaultTitle = targetPolicy
  ? defaultPolicyChangeTitle(changeType, String(targetPolicy.title ?? ''))
  : sensePrefill?.title ?? '';
const inheritedSpace = targetPolicy
  ? String(targetPolicy.category ?? '').trim() || 'General'
  : sensePrefill?.space ?? '';
const targetJurisdictionBranchId = targetPolicy?.jurisdictionBranchId
  ? String(targetPolicy.jurisdictionBranchId)
  : '';
const targetBranch = targetJurisdictionBranchId
  ? branches.find(
      (branch) => String(branch.branchId) === targetJurisdictionBranchId,
    )
  : null;
const jurisdictionLabel = targetBranch?.name
  ? String(targetBranch.name).replace(/^Fusion\s+/i, '')
  : targetPolicy?.jurisdiction
    ? String(targetPolicy.jurisdiction).split(',')[0]!.trim()
    : '';

// A member should see that a discussion already exists before writing a
// duplicate. Visibility is resolved with the same rule as the proposal page.
const openPolicyChangeProposals = targetPolicy
  ? (
      await db
        .collection('proposals')
        .find({
          targetPolicyId: targetPolicy.policyId,
          stage: { $in: ['propose', 'deliberate', 'decide'] },
        })
        .sort({ createdAt: -1 })
        .limit(5)
        .toArray()
    ).filter((row) => canViewProposal(normalizeProposalDoc(row), user))
  : [];

const changeLabel = (value: unknown) =>
  isPolicyChangeType(value) ? POLICY_CHANGE_GUIDANCE[value].label : 'Change';
const changeStageLabel = (stage: string) =>
  stage === 'decide'
    ? 'Voting'
    : stage === 'deliberate'
      ? 'In discussion'
      : 'Gathering support';

const signInReturnTo = `${Astro.url.pathname}${Astro.url.search}`;
---
<SiteLayout
  title={isPolicyChange ? 'Propose a policy change · Engage' : 'Suggest an idea · Engage'}
  description={isPolicyChange ? 'Propose a change to an existing Fusion policy.' : 'Suggest a proposal for Fusion members to consider.'}
  noIndex
>
  <div class="page-wrap section-space compose-page">
    <Button href="/proposals/" variant="ghost" size="sm">← Browse proposals</Button>
    <CivicIntro eyebrow="Develop an idea" tone="purple">
      <div class="compose-header__top">
        <h1>{isPolicyChange ? 'Propose a change to this policy' : 'Suggest an idea'}</h1>
        <Badge variant="info">{isPolicyChange ? 'Policy change' : 'New proposal'}</Badge>
      </div>
      <p>{isPolicyChange
        ? 'Members can propose changes to existing Fusion policies, including removing them entirely.'
        : 'Explain what you want Fusion to do and why. Another verified member must second your proposal before it moves into discussion.'}</p>
    </CivicIntro>

    {isPolicyChange && (
      <section class="policy-change-context" aria-label="Current policy">
        <div>
          <span class="policy-change-context__eyebrow">
            Current policy{jurisdictionLabel ? ` · ${jurisdictionLabel}` : ''}
          </span>
          <a class="policy-change-context__title" href={policyCanonicalPath(targetPolicy!)}>{targetPolicy!.title}</a>
          <p>{targetPolicy!.summary}</p>
        </div>
      </section>
    )}

    {senseError && (
      <Alert className="callout" variant="warning">
        <AlertDescription><p>{senseError}</p></AlertDescription>
      </Alert>
    )}

    {sensePrefill && (
      <Card className="policy-change-existing">
        <CardHeader>
          <CardTitle>
            {privateSenseSource
              ? 'Developing an independent proposal from a private priority'
              : 'Developing a proposal from a Sense Box priority'}
          </CardTitle>
        </CardHeader>
        <CardContent>
          <p class="mt-0"><strong>{sensePrefill.displayTitle}</strong></p>
          {privateSenseSource ? (
            <Alert variant="warning">
              <AlertDescription>
                <p>This priority has not been published. Its text is deliberately not copied into the draft. Use it as a lead and write the proposal independently. You must confirm this below before submitting.</p>
              </AlertDescription>
            </Alert>
          ) : (
            <p>{sensePrefill.summary}</p>
          )}
          <p class="text-sm text-muted-foreground">
            {privateSenseSource
              ? 'Submitting this proposal does not publish the original priority or reveal its text.'
              : 'The draft below is prefilled from the priority. Edit it into a proposal in your own words. This does not publish the original submission or link it automatically.'}
          </p>
        </CardContent>
      </Card>
    )}

    {isPolicyChange && openPolicyChangeProposals.length > 0 && (
      <Card className="policy-change-existing">
        <CardHeader>
          <CardTitle>
            {openPolicyChangeProposals.length === 1
              ? 'This policy already has an open proposal'
              : 'This policy already has open proposals'}
          </CardTitle>
        </CardHeader>
        <CardContent>
          <ul class="policy-change-existing__list">
            {openPolicyChangeProposals.map((proposal) => (
              <li>
                <a href={`/proposals/${proposal.slug}/`}>{proposal.title}</a>
                <span>{changeLabel(proposal.changeType)} · {changeStageLabel(String(proposal.stage))}</span>
              </li>
            ))}
          </ul>
          <p>Join the discussion there, or propose a different change below.</p>
        </CardContent>
      </Card>
    )}

    {!user ? (
      <Alert className="callout">
        <AlertDescription>
          <p>{isPolicyChange
            ? 'Sign in to propose a change. You’ll return to this form afterwards.'
            : 'Sign in to suggest an idea. You’ll return to this form afterwards.'}</p>
          <Button href={`/member/?returnTo=${encodeURIComponent(signInReturnTo)}&intent=propose`}>
            {isPolicyChange ? 'Sign in to propose a change' : 'Sign in to suggest an idea'}
          </Button>
        </AlertDescription>
      </Alert>
    ) : !user.canParticipate ? (
      <Alert className="callout" variant="warning">
        <AlertDescription>
          <p>This account cannot submit proposals yet. Check your membership status in My Engage.</p>
          <Button href="/member/" variant="outline">Check your account</Button>
        </AlertDescription>
      </Alert>
    ) : (
      <form
        id="new-proposal-form"
        class="compose-form"
        data-policy-change={isPolicyChange ? 'true' : undefined}
        data-policy-title={isPolicyChange ? String(targetPolicy!.title) : undefined}
      >
        {senseSource && <input type="hidden" name="sourceSenseSubmissionId" value={senseSource.submissionId} />}
        {privateSenseSource && (
          <div class="rounded-lg border border-dashed p-4">
            <label class="flex items-start gap-3">
              <Checkbox name="privateSourceAcknowledgement" required className="mt-1 size-5 shrink-0" />
              <span class="text-sm">
                I confirm this proposal is independently written and does not reproduce the private priority’s text.
              </span>
            </label>
          </div>
        )}
        {isPolicyChange ? (
          <>
            <input type="hidden" name="targetPolicyId" value={targetPolicy!.policyId} />
            <input type="hidden" name="space" value={inheritedSpace} />
            <PolicyChangeTypeSelector
              client:load
              options={changeTypeOptions}
              defaultValue={changeType}
              describedBy="policy-change-effect"
            />
            <p id="policy-change-effect" class="policy-change-effect">{guidance.effect}</p>

            <Field>
              <Label htmlFor="proposal-summary" id="policy-summary-label">{guidance.summaryLabel}</Label>
              <Textarea
                id="proposal-summary"
                name="summary"
                required
                minLength={10}
                maxLength={2000}
                rows={5}
                placeholder={guidance.summaryPlaceholder}
                aria-describedby="policy-summary-hint"
                defaultValue={sensePrefill?.summary}
              />
              <p class="field-hint" id="policy-summary-hint">{guidance.summaryHint}</p>
            </Field>

            <div data-change-panel="amend" hidden={changeType !== 'amend'}>
              <Field
                label="Which part should change?"
                htmlFor="proposal-target-section"
                hint="Name a commitment or section if you can. Leave blank if the whole policy should change."
              >
                <Input
                  id="proposal-target-section"
                  name="targetSection"
                  maxLength={300}
                  placeholder="For example: Commitment 2, or the section on accessible stops"
                />
              </Field>
            </div>

            <div data-change-panel="replace" hidden={changeType !== 'replace'}>
              <Field
                label="Proposed wording"
                htmlFor="proposal-proposed-wording"
                hint="Optional. You can work on the exact wording during discussion."
              >
                <Textarea
                  id="proposal-proposed-wording"
                  name="proposedWording"
                  rows={6}
                  maxLength={5000}
                  placeholder="Write the replacement policy wording, if you have it."
                />
              </Field>
            </div>

            <Field label="Proposal title" htmlFor="proposal-title">
              <Input
                id="proposal-title"
                name="title"
                required
                minLength={4}
                maxLength={200}
                defaultValue={defaultTitle}
              />
            </Field>
          </>
        ) : (
          <>
            <Field label="Title" htmlFor="proposal-title">
              <Input id="proposal-title" name="title" required minLength={4} maxLength={200} defaultValue={defaultTitle} placeholder="For example: Run regional trains more often" />
            </Field>

            <div class="topic-field-block">
              <Field label="Topic" htmlFor="proposal-topic">
                <Input id="proposal-topic" name="space" required minLength={2} maxLength={100} defaultValue={sensePrefill?.space} placeholder="Choose a topic below or type your own (e.g. Housing, Climate)" />
              </Field>
              <div class="topic-chips" role="group" aria-label="Suggested topics">
                {quickTopics.map((topic) => (
                  <Button type="button" className="topic-chip" variant="outline" size="sm" data-topic-value={topic}>
                    {topic}
                  </Button>
                ))}
              </div>
            </div>

            {showScopeSelector && (
              <ProposalScopeSelector
                client:load
                options={scopeOptions.map(({ key, label, kind, branchName, parentName }) => ({
                  key,
                  label,
                  kind,
                  ...(branchName && branchName !== label ? { branchName } : {}),
                  ...(parentName ? { parentName } : {}),
                }))}
                defaultValue={defaultScopeKey}
                hint="Choose National or the branch you want to consider this idea. You can submit to any recognised branch, but voting in its ballots requires membership of that branch."
              />
            )}

            <Field label="What would change?" htmlFor="proposal-summary">
              <Textarea id="proposal-summary" name="summary" required minLength={10} maxLength={2000} rows={4} defaultValue={sensePrefill?.summary} placeholder="Describe what should change and why. Other members will refine the wording during discussion." />
            </Field>
          </>
        )}

        <details class="optional-drawer">
          <summary>
            <span>Add supporting information</span>
            <Badge variant="outline">Optional</Badge>
          </summary>
          <div class="compose-details-grid">
            {isPolicyChange ? (
              <div data-change-outcomes hidden={changeType === 'repeal'}>
                <Field
                  label="What should the policy commit to? (one commitment per line)"
                  htmlFor="proposal-outcomes"
                  hint="Each line becomes a key commitment in the proposal."
                >
                  <Textarea id="proposal-outcomes" name="outcomes" rows={4} placeholder="More frequent services&#10;Better connections between trains and buses" />
                </Field>
              </div>
            ) : (
              <Field label="What should this achieve? (one commitment per line)" htmlFor="proposal-outcomes">
                <Textarea id="proposal-outcomes" name="outcomes" rows={4} placeholder="More frequent services&#10;Better connections between trains and buses" />
              </Field>
            )}

            <div class="markdown-field-group">
              <div class="markdown-field-head">
                <Label htmlFor="proposal-details">Background and evidence</Label>
                <div class="markdown-toolbar">
                  <Button type="button" className="toolbar-btn" id="insert-image-btn" variant="outline" size="sm">
                    <ImagePlus aria-hidden="true" />
                    Add image
                  </Button>
                  <Button type="button" className="toolbar-btn" id="insert-link-btn" variant="outline" size="sm">
                    <LinkIcon aria-hidden="true" />
                    Add link
                  </Button>
                </div>
              </div>
              <Textarea
                id="proposal-details"
                name="details"
                rows={7}
                defaultValue={sensePrefill?.details}
                placeholder="Explain the problem, share evidence and link to useful references."
              />
              <p class="field-hint">
                You can use Markdown for headings and lists. Use Add image or Add link to insert a reference.
              </p>
            </div>

            <div class="attachment-fields-row">
              <Field label="Image or reference link" htmlFor="proposal-attachment-url">
                <Input
                  id="proposal-attachment-url"
                  name="attachmentUrl"
                  placeholder="https://example.com/diagram.png or /path/to/file.pdf"
                />
              </Field>
              <Field label="Description" htmlFor="proposal-attachment-desc">
                <Input
                  id="proposal-attachment-desc"
                  name="attachmentDescription"
                  placeholder="Describe the image or document"
                />
              </Field>
            </div>
          </div>
        </details>

        <div class="form-actions">
          <Button type="submit" id="submit-btn">Submit proposal</Button>
          <span id="submit-status" class="form-status" role="status" aria-live="polite"></span>
        </div>
      </form>
    )}
  </div>
</SiteLayout>

{isPolicyChange && (
  <script type="application/json" id="policy-change-copy" set:html={JSON.stringify(POLICY_CHANGE_GUIDANCE)} />
)}

<script>
  import { trackEngage } from '../../../lib/analytics.ts';

  interface PolicyChangeCopyEntry {
    label: string;
    description: string;
    summaryLabel: string;
    summaryPlaceholder: string;
    summaryHint: string;
    effect: string;
  }

  const form = document.querySelector<HTMLFormElement>('#new-proposal-form');
  const status = document.querySelector<HTMLElement>('#submit-status');
  const button = document.querySelector<HTMLButtonElement>('#new-proposal-form button[type="submit"]');
  const topicInput = document.querySelector<HTMLInputElement>('#proposal-topic');
  const topicChips = document.querySelectorAll<HTMLButtonElement>('[data-topic-value]');
  const detailsTextarea = document.querySelector<HTMLTextAreaElement>('#proposal-details');
  const insertImageBtn = document.querySelector<HTMLButtonElement>('#insert-image-btn');
  const insertLinkBtn = document.querySelector<HTMLButtonElement>('#insert-link-btn');

  const isPolicyChangeForm = form?.dataset.policyChange === 'true';
  const changeTypeInput = form?.querySelector<HTMLInputElement>('input[name="changeType"]');
  const summaryInput = document.querySelector<HTMLTextAreaElement>('#proposal-summary');
  const summaryLabel = document.getElementById('policy-summary-label');
  const summaryHint = document.getElementById('policy-summary-hint');
  const effectNote = document.getElementById('policy-change-effect');
  const titleInput = document.querySelector<HTMLInputElement>('#proposal-title');
  const changePanels = document.querySelectorAll<HTMLElement>('[data-change-panel]');
  const changeOutcomes = document.querySelector<HTMLElement>('[data-change-outcomes]');
  const policyTitle = form?.dataset.policyTitle ?? '';
  let titleTouched = false;

  let policyCopy: Record<string, PolicyChangeCopyEntry> | null = null;
  try {
    const copyElement = document.getElementById('policy-change-copy');
    policyCopy = copyElement?.textContent
      ? JSON.parse(copyElement.textContent)
      : null;
  } catch {
    policyCopy = null;
  }

  // The chosen action is the organising principle of the form. The selector is
  // a hydrated island, so it announces the choice and this page follows it.
  const applyChangeType = (type: string) => {
    const copy = policyCopy?.[type];
    if (!copy) return;
    if (summaryLabel) summaryLabel.textContent = copy.summaryLabel;
    if (summaryHint) summaryHint.textContent = copy.summaryHint;
    if (effectNote) effectNote.textContent = copy.effect;
    if (summaryInput) summaryInput.placeholder = copy.summaryPlaceholder;
    changePanels.forEach((panel) => {
      panel.hidden = panel.dataset.changePanel !== type;
    });
    if (changeOutcomes) changeOutcomes.hidden = type === 'repeal';
    if (titleInput && !titleTouched) {
      titleInput.value = `${copy.label}: ${policyTitle}`;
    }
  };

  if (changeTypeInput) applyChangeType(changeTypeInput.value);

  window.addEventListener('policy-change-type', (event) => {
    const type = (event as CustomEvent<unknown>).detail;
    if (typeof type === 'string') applyChangeType(type);
  });

  titleInput?.addEventListener('input', () => {
    titleTouched = true;
  });

  topicChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const val = chip.dataset.topicValue;
      if (!topicInput || !val) return;
      topicInput.value = val;
      topicChips.forEach((c) => c.classList.toggle('is-active', c === chip));
    });
  });

  topicInput?.addEventListener('input', () => {
    const current = topicInput.value.trim();
    topicChips.forEach((c) => c.classList.toggle('is-active', c.dataset.topicValue === current));
  });

  insertImageBtn?.addEventListener('click', () => {
    if (!detailsTextarea) return;
    const url = prompt('Enter image URL (starting with https:// or /):', 'https://');
    if (!url || !url.trim()) return;
    const alt = prompt('Enter image description (alt text):', 'Supporting diagram') || 'Supporting image';
    const snippet = `\n![${alt.trim()}](${url.trim()})\n`;
    const start = detailsTextarea.selectionStart ?? detailsTextarea.value.length;
    const end = detailsTextarea.selectionEnd ?? detailsTextarea.value.length;
    detailsTextarea.value =
      detailsTextarea.value.slice(0, start) + snippet + detailsTextarea.value.slice(end);
    detailsTextarea.focus();
  });

  insertLinkBtn?.addEventListener('click', () => {
    if (!detailsTextarea) return;
    const url = prompt('Enter link URL (starting with https:// or /):', 'https://');
    if (!url || !url.trim()) return;
    const label = prompt('Enter link text:', 'Reference document') || 'Reference link';
    const snippet = `[${label.trim()}](${url.trim()})`;
    const start = detailsTextarea.selectionStart ?? detailsTextarea.value.length;
    const end = detailsTextarea.selectionEnd ?? detailsTextarea.value.length;
    detailsTextarea.value =
      detailsTextarea.value.slice(0, start) + snippet + detailsTextarea.value.slice(end);
    detailsTextarea.focus();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button) return;
    button.disabled = true;
    status.textContent = isPolicyChangeForm ? 'Submitting your proposal…' : 'Submitting your idea…';
    trackEngage('contribution_attempted', { action: 'proposal' });
    const data = new FormData(form);
    const attachmentUrl = String(data.get('attachmentUrl') ?? '').trim();
    const attachmentDescription = String(data.get('attachmentDescription') ?? '').trim();
    const scopeKey = String(data.get('scope') ?? '').trim();
    const targetPolicyId = String(data.get('targetPolicyId') ?? '').trim();
    const changeType = String(data.get('changeType') ?? '').trim();
    const targetSection = String(data.get('targetSection') ?? '').trim();
    const proposedWording = String(data.get('proposedWording') ?? '').trim();
    const sourceSenseSubmissionId = String(data.get('sourceSenseSubmissionId') ?? '').trim();
    const privateSourceAcknowledgement = data.get('privateSourceAcknowledgement') === 'on';
    const declaresPolicyChange = Boolean(targetPolicyId && changeType);
    const outcomes = String(data.get('outcomes') ?? '')
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean);
    const payload = {
      title: data.get('title'),
      space: data.get('space'),
      summary: data.get('summary'),
      details: data.get('details'),
      ...(declaresPolicyChange
        ? {
            targetPolicyId,
            changeType,
            ...(changeType === 'amend' ? { targetSection } : {}),
            ...(changeType === 'replace' ? { proposedWording } : {}),
          }
        : {}),
      ...(changeType !== 'repeal' ? { outcomes } : {}),
      ...(attachmentUrl ? { attachmentUrl } : {}),
      ...(attachmentDescription ? { attachmentDescription } : {}),
      ...(sourceSenseSubmissionId ? { sourceSenseSubmissionId } : {}),
      ...(privateSourceAcknowledgement ? { privateSourceAcknowledgement: true } : {}),
      stage: 'propose',
      ...(scopeKey ? { scope: scopeKey } : {}),
    };
    try {
      const response = await fetch('/api/proposals', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Could not submit your proposal.');
      trackEngage('contribution_result', { action: 'proposal', outcome: 'success' });
      location.href = `/proposals/${result.proposal.slug}/`;
    } catch (error) {
      trackEngage('contribution_result', { action: 'proposal', outcome: 'failed' });
      status.textContent =
        error instanceof Error
          ? error.message
          : isPolicyChangeForm
            ? 'Could not submit your proposal. Please try again.'
            : 'Could not submit your idea. Please try again.';
      button.disabled = false;
    }
  });
</script>

<style>
  .compose-page {
    max-width: 54rem;
  }

  .compose-header {
    margin: 1rem 0 1.5rem;
    display: grid;
    gap: 0.45rem;
  }

  .compose-header__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  h1 {
    margin: 0;
    font: 600 clamp(2.1rem, 4vw, 2.8rem)/1.08 var(--font-outfit);
  }

  .compose-header p {
