---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { Button } from '../../../components/ui/button';
import { Badge } from '../../../components/ui/badge';
import { Field } from '../../../components/ui/field';
import { Input } from '../../../components/ui/input';
import { Label } from '../../../components/ui/label';
import { Textarea } from '../../../components/ui/textarea';
import { Alert, AlertDescription } from '../../../components/ui/alert';
import { isPolicyChangeType, policyChangeLabel } from '../../../lib/policy-change.ts';
import { policyCanonicalPath } from '../../../lib/policy-registry.ts';
import ProposalScopeSelector from '../../../components/proposal/ProposalScopeSelector';
import PolicyChangeTypeSelector from '../../../components/proposal/PolicyChangeTypeSelector';
import { ImagePlus, Link as LinkIcon } from 'lucide-react';
import { getSessionUser } from '../../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../../lib/db.ts';
import {
  defaultProposalScopeKey,
  listProposalSubmissionScopes,
} from '../../../lib/proposal-scope.ts';

export const prerender = false;
const env = runtimeEnv(Astro.locals);
const [user, db] = await Promise.all([getSessionUser(Astro.request, env), getDatabase(env)]);
// Submission destinations are a participation list, not an administrative
// scope. Every verified member can submit to every recognised branch.
const branches = user?.canParticipate
  ? await db.collection('branches').find({ recognised: true }).sort({ kind: 1, name: 1 }).toArray()
  : [];
const scopeOptions = listProposalSubmissionScopes(branches);
const defaultScopeKey = user ? defaultProposalScopeKey(user, scopeOptions) : 'national';
const showScopeSelector = Boolean(user?.canParticipate && scopeOptions.length > 1);

const quickTopics = [
  'Climate & Energy',
  'Housing & Planning',
  'Transport & Infrastructure',
  'Digital Rights & AI',
  'Healthcare',
  'Education & Science',
  'Economy & Tax',
  'Party Governance',
];

// A proposal may start from an adopted policy. The change is recorded against
// that exact published revision; the policy itself does not change until a
// successful ballot is ratified.
const requestedTargetPolicyId = (Astro.url.searchParams.get('targetPolicyId') ?? '').trim();
const requestedChange = Astro.url.searchParams.get('change');
const changeType = isPolicyChangeType(requestedChange) ? requestedChange : 'amend';
const targetPolicy = requestedTargetPolicyId
  ? await db.collection('policy_registry').findOne({
      policyId: requestedTargetPolicyId,
      publicationStatus: 'published',
    })
  : null;
const isPolicyChange = Boolean(targetPolicy);
const changeTypeOptions = ['amend', 'replace', 'repeal'] as const;
const defaultTitle = targetPolicy
  ? `${changeType === 'repeal' ? 'Repeal' : changeType === 'replace' ? 'Replace' : 'Amend'}: ${targetPolicy.title}`
  : '';
const summaryPlaceholder = changeType === 'repeal'
  ? 'Explain why this policy should be repealed and what should happen instead.'
  : 'Describe what should change and why. Other members will refine the wording during deliberation.';
const signInReturnTo = `${Astro.url.pathname}${Astro.url.search}`;
---
<SiteLayout title="Suggest an idea · Engage" description="Suggest a proposal for Fusion members to consider." noIndex>
  <div class="page-wrap section-space compose-page">
    <Button href="/proposals/" variant="ghost" size="sm">← Browse proposals</Button>
    <header class="compose-header">
      <div class="compose-header__top">
        <h1>{isPolicyChange ? `${policyChangeLabel(changeType)}` : 'Suggest an idea'}</h1>
        <Badge variant="info">New proposal</Badge>
      </div>
      <p>{isPolicyChange
        ? 'This proposal refers to the published policy below. Submitting it leaves that policy unchanged. Adopted amendments and replacements take effect when published; a repeal takes effect at ratification.'
        : 'Explain what you want Fusion to do and why. Another verified member must second your proposal before it moves into discussion.'}</p>
    </header>

    {isPolicyChange && (
      <section class="policy-change-context" aria-label="Policy being changed">
        <div>
          <span class="policy-change-context__eyebrow">Changing current policy</span>
          <a class="policy-change-context__title" href={policyCanonicalPath(targetPolicy!)}>{targetPolicy!.title}</a>
          <p>{targetPolicy!.summary}</p>
        </div>
        <Badge variant="outline">{targetPolicy!.jurisdiction ?? 'Jurisdiction not recorded'}</Badge>
      </section>
    )}

    {!user ? (
      <Alert className="callout">
        <AlertDescription>
          <p>Sign in to suggest an idea. You’ll return to this form afterwards.</p>
          <Button href={`/member/?returnTo=${encodeURIComponent(signInReturnTo)}&intent=propose`}>
            {isPolicyChange ? 'Sign in to propose a change' : 'Sign in to suggest an idea'}
          </Button>
        </AlertDescription>
      </Alert>
    ) : !user.canParticipate ? (
      <Alert className="callout" variant="warning">
        <AlertDescription>
          <p>This account cannot submit ideas yet. Check your membership status in My Engage.</p>
          <Button href="/member/" variant="outline">Check your account</Button>
        </AlertDescription>
      </Alert>
    ) : (
      <form id="new-proposal-form" class="compose-form">
        {isPolicyChange && (
          <>
            <input type="hidden" name="targetPolicyId" value={targetPolicy!.policyId} />
            <PolicyChangeTypeSelector
              client:load
              options={changeTypeOptions.map((option) => ({ value: option, label: policyChangeLabel(option) }))}
              defaultValue={changeType}
              hint="Submitting leaves the current policy unchanged. An adopted amendment or replacement takes effect when published; a repeal takes effect at ratification."
            />
          </>
        )}
        <Field label="Title" htmlFor="proposal-title">
          <Input id="proposal-title" name="title" required minLength={4} maxLength={200} defaultValue={defaultTitle} placeholder="For example: Run regional trains more often" />
        </Field>

        <div class="topic-field-block">
          <Field label="Topic" htmlFor="proposal-topic">
            <Input id="proposal-topic" name="space" required minLength={2} maxLength={100} placeholder="Choose a topic below or type your own (e.g. Housing, Climate)" />
          </Field>
          <div class="topic-chips" role="group" aria-label="Suggested topics">
            {quickTopics.map((topic) => (
              <Button type="button" className="topic-chip" variant="outline" size="sm" data-topic-value={topic}>
                {topic}
              </Button>
            ))}
          </div>
        </div>

        {showScopeSelector && !isPolicyChange && (
          <ProposalScopeSelector
            client:load
            options={scopeOptions.map(({ key, label, kind, branchName, parentName }) => ({
              key,
              label,
              kind,
              ...(branchName && branchName !== label ? { branchName } : {}),
              ...(parentName ? { parentName } : {}),
            }))}
            defaultValue={defaultScopeKey}
            hint="Choose National or the branch you want to consider this idea. You can submit to any recognised branch, but voting in its ballots requires membership of that branch."
          />
        )}

        <Field label="What would change?" htmlFor="proposal-summary">
          <Textarea id="proposal-summary" name="summary" required minLength={10} maxLength={2000} rows={4} placeholder={summaryPlaceholder} />
        </Field>

        <details class="optional-drawer">
          <summary>
            <span>Add commitments, background or images</span>
            <Badge variant="outline">Optional</Badge>
          </summary>
          <div class="compose-details-grid">
            <Field label="What should this achieve? (one commitment per line)" htmlFor="proposal-outcomes">
              <Textarea id="proposal-outcomes" name="outcomes" rows={4} placeholder="More frequent services&#10;Better connections between trains and buses" />
            </Field>

            <div class="markdown-field-group">
              <div class="markdown-field-head">
                <Label htmlFor="proposal-details">Why does it matter?</Label>
                <div class="markdown-toolbar">
                  <Button type="button" className="toolbar-btn" id="insert-image-btn" variant="outline" size="sm">
                    <ImagePlus aria-hidden="true" />
                    Add image
                  </Button>
                  <Button type="button" className="toolbar-btn" id="insert-link-btn" variant="outline" size="sm">
                    <LinkIcon aria-hidden="true" />
                    Add link
                  </Button>
                </div>
              </div>
              <Textarea
                id="proposal-details"
                name="details"
                rows={7}
                placeholder="Explain the problem, share evidence and link to useful references."
              />
              <p class="field-hint">
                You can use Markdown for headings and lists. Use Add image or Add link to insert a reference.
              </p>
            </div>

            <div class="attachment-fields-row">
              <Field label="Image or reference link (optional)" htmlFor="proposal-attachment-url">
                <Input
                  id="proposal-attachment-url"
                  name="attachmentUrl"
                  placeholder="https://example.com/diagram.png or /path/to/file.pdf"
                />
              </Field>
              <Field label="Attachment description (optional)" htmlFor="proposal-attachment-desc">
                <Input
                  id="proposal-attachment-desc"
                  name="attachmentDescription"
                  placeholder="Describe the image or document"
                />
              </Field>
            </div>
          </div>
        </details>

        <div class="form-actions">
          <Button type="submit" id="submit-btn">Submit proposal</Button>
          <span id="submit-status" class="form-status" role="status" aria-live="polite"></span>
        </div>
      </form>
    )}
  </div>
</SiteLayout>

<script>
  import { trackEngage } from '../../../lib/analytics.ts';
  const form = document.querySelector<HTMLFormElement>('#new-proposal-form');
  const status = document.querySelector<HTMLElement>('#submit-status');
  const button = document.querySelector<HTMLButtonElement>('#new-proposal-form button[type="submit"]');
  const topicInput = document.querySelector<HTMLInputElement>('#proposal-topic');
  const topicChips = document.querySelectorAll<HTMLButtonElement>('[data-topic-value]');
  const detailsTextarea = document.querySelector<HTMLTextAreaElement>('#proposal-details');
  const insertImageBtn = document.querySelector<HTMLButtonElement>('#insert-image-btn');
  const insertLinkBtn = document.querySelector<HTMLButtonElement>('#insert-link-btn');

  topicChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const val = chip.dataset.topicValue;
      if (!topicInput || !val) return;
      topicInput.value = val;
      topicChips.forEach((c) => c.classList.toggle('is-active', c === chip));
    });
  });

  topicInput?.addEventListener('input', () => {
    const current = topicInput.value.trim();
    topicChips.forEach((c) => c.classList.toggle('is-active', c.dataset.topicValue === current));
  });

  insertImageBtn?.addEventListener('click', () => {
    if (!detailsTextarea) return;
    const url = prompt('Enter image URL (starting with https:// or /):', 'https://');
    if (!url || !url.trim()) return;
    const alt = prompt('Enter image description (alt text):', 'Supporting diagram') || 'Supporting image';
    const snippet = `\n![${alt.trim()}](${url.trim()})\n`;
    const start = detailsTextarea.selectionStart ?? detailsTextarea.value.length;
    const end = detailsTextarea.selectionEnd ?? detailsTextarea.value.length;
    detailsTextarea.value =
      detailsTextarea.value.slice(0, start) + snippet + detailsTextarea.value.slice(end);
    detailsTextarea.focus();
  });

  insertLinkBtn?.addEventListener('click', () => {
    if (!detailsTextarea) return;
    const url = prompt('Enter link URL (starting with https:// or /):', 'https://');
    if (!url || !url.trim()) return;
    const label = prompt('Enter link text:', 'Reference document') || 'Reference link';
    const snippet = `[${label.trim()}](${url.trim()})`;
    const start = detailsTextarea.selectionStart ?? detailsTextarea.value.length;
    const end = detailsTextarea.selectionEnd ?? detailsTextarea.value.length;
    detailsTextarea.value =
      detailsTextarea.value.slice(0, start) + snippet + detailsTextarea.value.slice(end);
    detailsTextarea.focus();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button) return;
    button.disabled = true;
    status.textContent = 'Submitting your idea…';
    trackEngage('contribution_attempted', { action: 'proposal' });
    const data = new FormData(form);
    const attachmentUrl = String(data.get('attachmentUrl') ?? '').trim();
    const attachmentDescription = String(data.get('attachmentDescription') ?? '').trim();
    const scopeKey = String(data.get('scope') ?? '').trim();
    const targetPolicyId = String(data.get('targetPolicyId') ?? '').trim();
    const changeType = String(data.get('changeType') ?? '').trim();
    const payload = {
      title: data.get('title'),
      space: data.get('space'),
      summary: data.get('summary'),
      details: data.get('details'),
      ...(targetPolicyId && changeType ? { targetPolicyId, changeType } : {}),
      outcomes: String(data.get('outcomes') ?? '')
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean),
      ...(attachmentUrl ? { attachmentUrl } : {}),
      ...(attachmentDescription ? { attachmentDescription } : {}),
      stage: 'propose',
      ...(scopeKey ? { scope: scopeKey } : {}),
    };
    try {
      const response = await fetch('/api/proposals', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Could not submit your idea.');
      trackEngage('contribution_result', { action: 'proposal', outcome: 'success' });
      location.href = `/proposals/${result.proposal.slug}/`;
    } catch (error) {
      trackEngage('contribution_result', { action: 'proposal', outcome: 'failed' });
      status.textContent =
        error instanceof Error ? error.message : 'Could not submit your idea. Please try again.';
      button.disabled = false;
    }
  });
</script>

<style>
  .compose-page {
    max-width: 54rem;
  }

  .compose-header {
    margin: 1rem 0 1.5rem;
    display: grid;
    gap: 0.45rem;
  }

  .compose-header__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  h1 {
    margin: 0;
    font: 600 clamp(2.1rem, 4vw, 2.8rem)/1.08 Newsreader, Georgia, serif;
  }

  .compose-header p {
    margin: 0;
    max-width: 62ch;
    color: var(--horizon-muted);
  }

  .compose-form {
    display: grid;
    gap: 1.15rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    background: #fff;
    border: 1px solid var(--horizon-line);
    border-radius: 0.8rem;
  }

  .topic-field-block {
    display: grid;
    gap: 0.5rem;
  }

  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  :global(.topic-chip.is-active) {
    background: var(--horizon-purple);
    border-color: var(--horizon-purple);
    color: #ffffff;
  }

  .optional-drawer {
    border-top: 1px solid var(--horizon-line);
    padding-top: 1rem;
  }

  .optional-drawer summary {
    cursor: pointer;
    font-weight: 700;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    list-style: none;
  }

  .optional-drawer summary::-webkit-details-marker {
    display: none;
  }

  .optional-drawer[open] summary {
    margin-bottom: 1rem;
  }

  .compose-details-grid {
    display: grid;
    gap: 1.1rem;
  }

  .markdown-field-group {
    display: grid;
    gap: 0.45rem;
  }

  .markdown-field-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .markdown-field-head label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--horizon-ink);
  }

  .markdown-toolbar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .field-hint {
    margin: 0;
    font-size: 0.78rem;
    color: var(--horizon-muted);
  }

  .attachment-fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .form-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .callout p {
    margin: 0 0 0.75rem;
  }

  .policy-change-context {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--horizon-line);
    border-left: 3px solid var(--horizon-purple);
    border-radius: 0.55rem;
    background: var(--horizon-surface);
  }

  .policy-change-context__eyebrow {
    display: block;
    color: var(--horizon-muted);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .policy-change-context__title {
    display: inline-block;
    margin: 0.2rem 0 0.35rem;
    font-weight: 650;
  }

  .policy-change-context p {
    margin: 0;
    max-width: 62ch;
    color: var(--horizon-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .attachment-fields-row {
      grid-template-columns: 1fr;
    }
  }
</style>

