---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Card, CardContent } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { getSiteConfig } from '../../lib/site-config.ts';
import { listProposals } from '../../lib/proposals-store.ts';
import { branchPublicSlug, policyBranchPath } from '../../lib/policy-registry.ts';
export const prerender = false;
const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([getDatabase(env), getSessionUser(Astro.request, env)]);
const [branches, proposals, siteConfig] = await Promise.all([
  db.collection('branches').find({ recognised: true }).sort({ name: 1 }).toArray(),
  listProposals(db, { includeArchived: false, user }),
  getSiteConfig(db, env),
]);
const kinds = ['national', 'state', 'territory', 'constituent'];
const grouped = kinds.map((kind) => ({ kind, items: branches.filter((branch: any) => branch.kind === kind) })).filter((group) => group.items.length);
const relevant = user?.activeBranchIds?.length ? branches.filter((branch: any) => user.activeBranchIds?.includes(branch.branchId)) : [];
const countFor = (branchId: string) => proposals.filter((proposal) => [proposal.originatingBranchId, proposal.governanceAuthorityBranchId, proposal.jurisdictionBranchId].includes(branchId)).length;
const policyRows = await db
  .collection('policy_registry')
  .find({ publicationStatus: 'published' }, { projection: { policyId: 1, jurisdictionBranchId: 1 } })
  .toArray();
const policyCountFor = (branchId: string) => policyRows.filter((policy: any) => policy.jurisdictionBranchId === branchId).length;
const branchLinks = (branch: any) => ({
  ideas: countFor(branch.branchId),
  policies: policyCountFor(branch.branchId),
});
---
<SiteLayout title="Branches · Engage" description="Find your Fusion branch, read its proposals and explore its published policies." canonical="/branches/">
  <div class="page-wrap section-space branch-directory">
    <header class="page-intro">
      <h1>Find your branch</h1>
      <p>Find what your branch is discussing and the policies it has adopted. You can follow a branch for updates; voting in its ballots requires membership.</p>
    </header>

    {relevant.length > 0 && (
      <section class="branch-group" aria-labelledby="your-branches-heading">
        <h2 id="your-branches-heading">Your branches</h2>
        <div class="branch-rows">
          {relevant.map((branch: any) => (
            <Card className="flex-row items-center justify-between gap-4 px-5 py-4">
              <CardContent className="min-w-0 p-0">
                <strong class="block">{branch.name}</strong>
                <span class="text-sm text-muted-foreground">
                  {countFor(branch.branchId)} proposals{branchLinks(branch).policies > 0 ? ` · ${branchLinks(branch).policies} published ${branchLinks(branch).policies === 1 ? 'policy' : 'policies'}` : ''}
                </span>
              </CardContent>
              <div class="flex flex-wrap gap-2">
                <Button href={`/proposals/?branch=${encodeURIComponent(branch.branchId)}`} variant="outline" size="sm">View ideas →</Button>
                {branchLinks(branch).policies > 0 && branchPublicSlug(branch) && (
                  <Button href={policyBranchPath(branchPublicSlug(branch)!)} variant="outline" size="sm">Policy registry →</Button>
                )}
              </div>
            </Card>
          ))}
        </div>
      </section>
    )}

    {grouped.map((group) => (
      <section class="branch-group" aria-labelledby={`branch-${group.kind}`}>
        <h2 id={`branch-${group.kind}`}>{group.kind === 'constituent' ? 'Constituent branches' : `${group.kind[0]!.toUpperCase()}${group.kind.slice(1)} branches`}</h2>
        <div class="branch-rows">
          {group.items.map((branch: any) => (
            <Card className="flex-row items-center justify-between gap-4 px-5 py-4">
              <CardContent className="min-w-0 p-0">
                <strong class="block">{branch.name}</strong>
                <span class="text-sm text-muted-foreground">
                  {countFor(branch.branchId)} proposals{branchLinks(branch).policies > 0 ? ` · ${branchLinks(branch).policies} published ${branchLinks(branch).policies === 1 ? 'policy' : 'policies'}` : ''}
                </span>
              </CardContent>
              <div class="flex flex-wrap gap-2">
                <Button href={`/proposals/?branch=${encodeURIComponent(branch.branchId)}`} variant="outline" size="sm">View ideas →</Button>
                {branchLinks(branch).policies > 0 && branchPublicSlug(branch) && (
                  <Button href={policyBranchPath(branchPublicSlug(branch)!)} variant="outline" size="sm">Policy registry →</Button>
                )}
              </div>
            </Card>
          ))}
        </div>
      </section>
    ))}

    {!grouped.length && <p>No branches are listed here yet.</p>}

    {siteConfig.stateSites.length > 0 && (
      <section class="branch-group" aria-labelledby="state-sites-heading">
        <h2 id="state-sites-heading">State &amp; territory websites and Facebook pages</h2>
        <div class="branch-rows">
          {siteConfig.stateSites.map((site) => (
            <Card className="flex-row items-center justify-between gap-4 px-5 py-4">
              <CardContent className="min-w-0 p-0">
                <strong class="block">{site.code} · {site.name}</strong>
                <span class="text-sm text-muted-foreground">{site.websiteHref.replace(/^https?:\/\//, '')}</span>
              </CardContent>
              <div class="flex flex-wrap items-center gap-2">
                <Button href={site.websiteHref} target="_blank" rel="noopener noreferrer" variant="outline" size="sm">Website ↗</Button>
                {site.facebookHref && (
                  <Button href={site.facebookHref} target="_blank" rel="noopener noreferrer" variant="outline" size="sm">Facebook ↗</Button>
                )}
              </div>
            </Card>
          ))}
        </div>
      </section>
    )}
  </div>
</SiteLayout>

<style>
  .branch-directory { max-width:66rem; }
  .branch-group { margin:2rem 0 3rem; }
  .branch-group h2 { font-size:clamp(1.6rem,3vw,2.2rem); }
  .branch-rows { display:grid; gap:.65rem; }
  @media(max-width:600px) {
    .branch-rows :global([data-slot="card"]) { align-items:flex-start; flex-direction:column; }
  }
</style>
