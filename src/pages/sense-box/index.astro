---
import {getSessionUser} from '../../lib/auth.ts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { STANDARD_BRANCHES } from '../../lib/migrations.ts';
import SenseBox from '../../components/SenseBox';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { senseDestinations } from '../../lib/sense-box.ts';
export const prerender=false;
const env=runtimeEnv(Astro.locals);
const [db,user]=await Promise.all([getDatabase(env),getSessionUser(Astro.request,env)]);
Astro.response.headers.set('Cache-Control','private, no-store');
const branches=await senseDestinations(db);
const requested=Astro.url.searchParams.get('branch') || `branch-${(Astro.url.searchParams.get('state') || '').toLowerCase()}`;
const initialBranch=branches.find(b=>b.branchId===requested)?.branchId || branches.find(b=>b.name===STANDARD_BRANCHES.find(s=>s.branchId===requested)?.name)?.branchId || branches.find(b=>b.code!=='branch-nat' && user?.verifiedBranchIds?.includes(b.branchId))?.branchId || '';
---
<SiteLayout title="Sense Box · Engage" description="Tell Fusion what matters to your community. Share a concern, suggestion or local priority in your state or territory." canonical="/sense-box/">
<div class="page-wrap section-space sense-page">
<header class="page-intro"><p class="text-sm font-semibold uppercase tracking-widest">Sense Box · About 2 minutes</p><h1>What matters where you live?</h1><p>Share a concern, suggestion or idea with Fusion. Everyone is welcome — no membership or formal proposal needed.</p></header>
<div class="sense-layout"><section aria-label="Share your priority">{branches.length?<SenseBox client:load branches={branches} initialBranch={initialBranch} turnstileSiteKey={env.PUBLIC_TURNSTILE_SITE_KEY ?? ''}/>:<p role="status">Sense Box is not accepting submissions right now. Please check back soon.</p>}<noscript>Please enable JavaScript to share your priority.</noscript></section><aside><h2>From listening to action</h2><p>Your branch’s organisers can review local priorities, understand what matters to your community and identify shared concerns. Some ideas may also inform Engage proposals.</p><p>Submissions are private. Sharing an idea does not make it Fusion policy or guarantee action.</p><p>You don’t need to give your name or contact details.</p><a href="/proposals/">Explore current proposals →</a></aside></div>
</div></SiteLayout>
<style>.sense-page{max-width:68rem}.sense-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:4rem;margin-top:2rem}.sense-layout aside{border-top:3px solid var(--horizon-accent);padding-top:1.5rem}.sense-layout aside h2{font-size:1.7rem}.sense-layout aside p{margin:1rem 0;color:var(--horizon-muted)}@media(max-width:767px){.sense-layout{grid-template-columns:1fr;gap:2.5rem}}</style>
