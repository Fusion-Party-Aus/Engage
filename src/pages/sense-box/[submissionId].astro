---
import { getSessionUser } from '../../lib/auth.ts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Badge } from '../../components/ui/badge';
import { Button } from '../../components/ui/button';
import SenseDiscussion from '../../components/sense/SenseDiscussion';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { getPublicSense, senseDestinations } from '../../lib/sense-box.ts';
import { SENSE_TOPICS } from '../../lib/sense-box-options.ts';

export const prerender = false;
const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([getDatabase(env), getSessionUser(Astro.request, env)]);
const submissionId = Astro.params.submissionId ?? '';
const priority = await getPublicSense(db, submissionId, user);
if (!priority) return Astro.rewrite('/404/');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const branches = await senseDestinations(db);
const branchName = branches.find((branch) => branch.branchId === priority.branchId)?.name ?? 'Fusion';
const signInHref = `/member/?returnTo=${encodeURIComponent(`/sense-box/${priority.submissionId}/`)}&intent=discuss`;
const commentHref = user ? (user.canParticipate ? undefined : '/member/') : signInHref;
const commentLabel = user && !user.canParticipate ? 'Verify your membership to comment' : 'Sign in to discuss';
---
<SiteLayout
  title={`${priority.title} · Sense Box · Engage`}
  description={priority.detail.slice(0, 155)}
  canonical={`/sense-box/${priority.submissionId}/`}
>
  <div class="page-wrap section-space sense-detail">
    <Button href="/sense-box/#priorities" variant="ghost" size="sm">← All published priorities</Button>

    <header class="sense-detail__head">
      <div class="sense-detail__meta">
        <span>{branchName}</span>
        {priority.locality && <span>{priority.locality}</span>}
        <time datetime={priority.publishedAt ?? priority.createdAt}>Published {new Date(priority.publishedAt ?? priority.createdAt).toLocaleDateString('en-AU')}</time>
        <Badge variant="outline">{SENSE_TOPICS[priority.topic]}</Badge>
      </div>
      <h1>{priority.title}</h1>
      <p class="sense-detail__note">
        This is informal community input. It is not a proposal, ballot or adopted Fusion policy.
      </p>
    </header>

    <div class="sense-detail__layout">
      <article class="sense-detail__body">
        <p class="whitespace-pre-wrap">{priority.detail}</p>

        {priority.linkedProposal && (
          <aside class="sense-linked" aria-label="Related proposal">
            <span class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Linked proposal</span>
            <a href={`/proposals/${priority.linkedProposal.slug}/`}>{priority.linkedProposal.title}</a>
            <p>Organisers are developing this priority through the formal proposal process. The proposal is separate from this discussion.</p>
          </aside>
        )}
      </article>

      <aside class="sense-detail__rail">
        <h2>Discussion</h2>
        <p class="text-sm text-muted-foreground">
          Members can discuss this priority. Discussion does not create a formal amendment, vote or policy.
        </p>
        <SenseDiscussion
          client:idle
          submissionId={priority.submissionId}
          comments={priority.comments}
          canPost={Boolean(user?.canParticipate)}
          signInHref={commentHref}
          signInLabel={commentLabel}
          emptyText="No comments yet. Start the discussion."
        />
      </aside>
    </div>
  </div>
</SiteLayout>
<style>
  .sense-detail{max-width:68rem}
  .sense-detail__head{margin:1.5rem 0 2.5rem;border-bottom:1px solid var(--horizon-line);padding-bottom:1.5rem}
  .sense-detail__meta{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;color:var(--horizon-muted);font-size:.9rem}
  .sense-detail__head h1{margin:.75rem 0 .5rem;max-width:52rem}
  .sense-detail__note{margin:0;color:var(--horizon-muted);max-width:48rem}
  .sense-detail__layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:4rem}
  .sense-detail__body p{font-size:1.05rem;line-height:1.75}
  .sense-detail__rail h2{margin-top:0;font-size:1.6rem}
  .sense-linked{display:grid;gap:.35rem;margin-top:2rem;border:1px solid var(--horizon-line);border-radius:1rem;padding:1.25rem;background:var(--horizon-lavender-soft)}
  .sense-linked a{font-size:1.1rem;font-weight:600}
  .sense-linked p{margin:.25rem 0 0;font-size:.9rem;color:var(--horizon-muted)}
  @media(max-width:900px){.sense-detail__layout{grid-template-columns:1fr;gap:2.5rem}}
</style>
