---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listPolicies } from '../../lib/store.ts';
import type { PolicyStatus } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const legacyPolicyParam =
  Astro.url.searchParams.get('policy') || Astro.url.searchParams.get('policyId');
const allProposals = await listPolicies(db, { includeDrafts: Boolean(user?.isStaff) });

if (legacyPolicyParam) {
  const match = allProposals.find(
    (p) => p.policyId === legacyPolicyParam || p.slug === legacyPolicyParam,
  );
  if (match) {
    return Astro.redirect(`/policies/${match.slug}/`, 302);
  }
}

const initialQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const initialKind = (Astro.url.searchParams.get('kind') ?? 'all').trim();
const initialCategory = (Astro.url.searchParams.get('category') ?? 'all').trim();
const initialStatus = (Astro.url.searchParams.get('status') ?? 'all').trim();

const categories = [...new Set(allProposals.map((p) => p.category))].sort();

const statusLabel = (status: PolicyStatus) => {
  if (status === 'voting') return 'Voting open';
  if (status === 'open') return 'Open for discussion';
  if (status === 'adopted') return 'Adopted';
  if (status === 'draft') return 'Draft (staff only)';
  return 'Archived';
};
---
<SiteLayout
  title="Proposals & Policies · Engage"
  description="Browse, discuss, and vote on Fusion Party Australia proposals, organisational decisions, and policies."
  canonical={`${Astro.url.origin}/policies/`}
>
  <div class="page-wrap section-space">
    <header class="library-header">
      <div>
        <h1>Proposals &amp; policy library</h1>
        <p>
          Explore party proposals, visual identity and governance decisions, and national policies.
          Open any item to read it in full, share feedback, or vote when a decision is open.
        </p>
      </div>
      {user?.isStaff && (
        <a class="button button--outline" href="/admin/#create-policy">
          + New proposal
        </a>
      )}
    </header>

    <form class="filter-bar" role="search" method="get" action="/policies/">
      <label class="field">
        <span>Search</span>
        <input
          id="policy-search"
          name="q"
          type="search"
          value={initialQuery}
          placeholder="Search by keyword, topic, or ID (e.g. Horizon, housing, UBI)"
          autocomplete="off"
        />
      </label>

      <label class="field">
        <span>Type</span>
        <select id="policy-kind" name="kind">
          <option value="all" selected={initialKind === 'all'}>All proposals &amp; policies</option>
          <option value="proposal" selected={initialKind === 'proposal'}>
            Party &amp; general proposals
          </option>
          <option value="policy" selected={initialKind === 'policy'}>Policy proposals</option>
        </select>
      </label>

      <label class="field">
        <span>Area / topic</span>
        <select id="policy-category" name="category">
          <option value="all" selected={initialCategory === 'all'}>All areas</option>
          {categories.map((cat) => (
            <option value={cat} selected={initialCategory === cat}>
              {cat}
            </option>
          ))}
        </select>
      </label>

      <label class="field">
        <span>Stage</span>
        <select id="policy-status" name="status">
          <option value="all" selected={initialStatus === 'all'}>All stages</option>
          <option value="voting" selected={initialStatus === 'voting'}>Open for voting</option>
          <option value="open" selected={initialStatus === 'open'}>Open for discussion</option>
          <option value="adopted" selected={initialStatus === 'adopted'}>Adopted</option>
          {user?.isStaff && (
            <option value="draft" selected={initialStatus === 'draft'}>Drafts (staff)</option>
          )}
        </select>
      </label>

      <p id="filter-count" class="filter-count tabular" role="status" aria-live="polite">
        Showing {allProposals.length} items
      </p>
    </form>

    <ul class="policy-register" id="policy-list">
      {allProposals.map((item) => (
        <li
          class="register-item"
          data-policy-item
          data-kind={item.kind}
          data-category={item.category}
          data-status={item.status}
          data-search={`${item.policyId} ${item.title} ${item.category} ${item.division} ${item.statement}`.toLowerCase()}
        >
          <div class="register-item__body">
            <div class="register-item__meta">
              <span class={`badge badge--${item.status}`}>{statusLabel(item.status)}</span>
              <span class="badge">
                {item.kind === 'proposal' ? 'Party proposal' : 'Policy'}
              </span>
              <span>{item.category}</span>
              <span class="tabular">{item.policyId}</span>
            </div>

            <h2>
              <a href={`/policies/${item.slug}/`}>{item.title}</a>
            </h2>

            <p>{item.statement}</p>
          </div>

          <div class="register-item__actions">
            <div class="register-item__stats tabular">
              {(item.status === 'voting' || item.status === 'adopted' || item.votes.total > 0) && (
                <span>
                  {item.votes.approve} approve · {item.votes.reject} reject
                </span>
              )}
              <span>
                {item.commentCount} {item.commentCount === 1 ? 'comment' : 'comments'}
              </span>
            </div>

            <a
              class={`button button--small ${item.status === 'voting' ? '' : 'button--outline'}`}
              href={`/policies/${item.slug}/`}
            >
              {item.status === 'voting' ? 'Read & vote →' : 'Read & comment →'}
            </a>
          </div>
        </li>
      ))}
    </ul>

    <p id="empty-filter" class="callout" hidden>
      No proposals match your current filter. <a href="/policies/">Reset filters</a> to view all
      items.
    </p>
  </div>
</SiteLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#policy-search');
  const kindSelect = document.querySelector<HTMLSelectElement>('#policy-kind');
  const categorySelect = document.querySelector<HTMLSelectElement>('#policy-category');
  const statusSelect = document.querySelector<HTMLSelectElement>('#policy-status');
  const items = [...document.querySelectorAll<HTMLElement>('[data-policy-item]')];
  const countEl = document.querySelector<HTMLElement>('#filter-count');
  const emptyEl = document.querySelector<HTMLElement>('#empty-filter');

  function applyFilters() {
    const q = (searchInput?.value ?? '').trim().toLowerCase();
    const kind = kindSelect?.value ?? 'all';
    const cat = categorySelect?.value ?? 'all';
    const st = statusSelect?.value ?? 'all';
    let visible = 0;

    for (const item of items) {
      const matchKind = kind === 'all' || item.dataset.kind === kind;
      const matchCat = cat === 'all' || item.dataset.category === cat;
      const matchStatus = st === 'all' || item.dataset.status === st;
      const matchSearch = !q || (item.dataset.search ?? '').includes(q);
      const show = matchKind && matchCat && matchStatus && matchSearch;
      item.hidden = !show;
      if (show) visible += 1;
    }

    if (countEl) {
      countEl.textContent = `Showing ${visible} ${visible === 1 ? 'item' : 'items'}`;
    }
    if (emptyEl) {
      emptyEl.hidden = visible > 0;
    }
  }

  searchInput?.addEventListener('input', applyFilters);
  kindSelect?.addEventListener('change', applyFilters);
  categorySelect?.addEventListener('change', applyFilters);
  statusSelect?.addEventListener('change', applyFilters);
  applyFilters();
</script>

<style>
  .library-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
  }
  .library-header h1 {
    margin: 0 0 0.5rem;
  }
  .library-header p {
    margin: 0;
    max-width: 62ch;
    color: var(--horizon-muted);
    font-size: 1.1rem;
  }

  .filter-bar {
    display: grid;
    grid-template-columns: minmax(14rem, 1.4fr) repeat(3, minmax(11rem, 0.9fr));
    align-items: end;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    background: var(--horizon-lavender);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    margin-bottom: 2.25rem;
  }
  .filter-bar .field {
    margin: 0;
  }
  .filter-count {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--horizon-muted);
  }

  .policy-register {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--horizon-line);
  }
  .register-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem 2.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--horizon-line);
  }
  .register-item[hidden] {
    display: none;
  }
  .register-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-bottom: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--horizon-muted);
  }
  .register-item h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  }
  .register-item h2 a {
    text-decoration: none;
  }
  .register-item h2 a:hover {
    text-decoration: underline;
  }
  .register-item p {
    margin: 0;
    max-width: 68ch;
    color: var(--horizon-muted);
    font-size: 0.98rem;
  }
  .register-item__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }
  .register-item__stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--horizon-muted);
  }

  @media (max-width: 960px) {
    .filter-bar {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .filter-bar {
      grid-template-columns: 1fr;
    }
    .register-item {
      grid-template-columns: 1fr;
      align-items: flex-start;
    }
    .register-item__actions {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    .register-item__stats {
      align-items: flex-start;
    }
  }
</style>
