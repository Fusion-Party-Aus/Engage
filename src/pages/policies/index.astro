import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewNotice from '../../components/PreviewNotice.astro';
import policies from '../../data/policies.json';
import { loadPolicyCatalogue } from '../../lib/platform/catalogue.ts';
import { platformEnv } from '../../lib/platform/http.ts';

export const prerender = false;

const catalogue = await loadPolicyCatalogue(platformEnv(Astro.locals));
const economy = policies.filter((p) => p.slug.startsWith('/reclaim-our-economy/'));
const future = policies.filter((p) => p.slug.startsWith('/reclaim-our-future/'));
const economyProposals = catalogue.filter((p) => p.division === 'RECLAIM OUR ECONOMY');
const futureProposals = catalogue.filter((p) => p.division === 'RECLAIM OUR FUTURE');
const openPolicyIds = new Set(catalogue.filter((p) => p.consultationRounds.some((r) => r.status === 'open')).map((p) => p.policyId));
---
<SiteLayout title="Policy library · Fusion" description="Explore Reclaim's policy commitments and proposals by issue." canonical={`${Astro.url.origin}/policies/`}>
  <PreviewNotice slot="notice" />
  <div class="page-wrap">
    <header class="page-intro">
      <p class="eyebrow">The Reclaim policy library</p>
      <h1>What should a fairer Australia look like?</h1>
      <p>Browse the commitments and proposals by issue. Open a policy to understand its promise, how it would work, and the changes members are being asked to consider.</p>
    </header>
    <form class="filters" role="search" onsubmit="return false">
      <label class="field">
        <span>Find an issue or proposal</span>
        <input id="policy-search" type="search" placeholder="Try housing, health or democracy" autocomplete="off" />
      </label>
      <label class="field">
        <span>Browse by program</span>
        <select id="policy-area">
          <option value="all">All policy areas</option>
          <option value="economy">Reclaim our economy</option>
          <option value="future">Reclaim our future</option>
        </select>
      </label>
      <label class="field">
        <span>Member review</span>
        <select id="policy-review">
          <option value="all">All proposals</option>
          <option value="open">Open for comment</option>
        </select>
      </label>
      <p id="policy-results" aria-live="polite">Browse by issue or search by topic.</p>
    </form>

    {[{ id: 'economy', title: 'Reclaim our economy', domains: economy, proposals: economyProposals }, { id: 'future', title: 'Reclaim our future', domains: future, proposals: futureProposals }].map((group) => (
      <section class="policy-group" data-policy-area={group.id} aria-labelledby={`${group.id}-title`}>
        <header class="group-heading">
          <div><p class="eyebrow">{group.id === 'economy' ? 'Work, security and shared prosperity' : 'A future shaped by people and communities'}</p><h2 id={`${group.id}-title`}>{group.title}</h2></div>
        </header>
        <nav class="issue-list" aria-label={`${group.title} policy issues`}>
          {group.domains.map((domain) => <a href={domain.slug}><span>{domain.title}</span><span aria-hidden="true">↗</span></a>)}
        </nav>
        <div class="proposal-list" aria-label={`${group.title} proposals`}>
          {group.proposals.map((proposal) => (
            <article class="proposal-entry" data-policy-entry data-open={openPolicyIds.has(proposal.policyId) ? 'true' : 'false'} data-search={`${proposal.title} ${proposal.domain} ${proposal.domainSummary}`.toLocaleLowerCase()}>
              <p class="domain-name">{proposal.domain}</p>
              {openPolicyIds.has(proposal.policyId) && <span class="review-label">Open for comment</span>}
              <h3><a href={`${proposal.sectionPath}#${proposal.slug}`}>{proposal.title}</a></h3>
              <a class="text-link" href={`${proposal.sectionPath}#${proposal.slug}`}>Read the policy <span aria-hidden="true">→</span></a>
              {openPolicyIds.has(proposal.policyId) && <a class="consult-link" href={`/consultations/?policyId=${encodeURIComponent(proposal.policyId)}`}>Comment or suggest a change <span aria-hidden="true">↗</span></a>}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</SiteLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#policy-search');
  const area = document.querySelector<HTMLSelectElement>('#policy-area');
  const review = document.querySelector<HTMLSelectElement>('#policy-review');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-policy-entry]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-policy-area]')];
  const result = document.querySelector<HTMLElement>('#policy-results');
  const update = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    const selectedArea = area?.value ?? 'all';
    const selectedReview = review?.value ?? 'all';
    let visible = 0;
    for (const entry of entries) {
      const group = entry.closest<HTMLElement>('[data-policy-area]');
      const matches = (selectedArea === 'all' || group?.dataset.policyArea === selectedArea)
        && (selectedReview === 'all' || entry.dataset.open === 'true')
        && (entry.dataset.search ?? '').includes(query);
      entry.hidden = !matches;
      visible += Number(matches);
    }
    for (const group of groups) {
      const groupArea = group.dataset.policyArea ?? '';
      group.hidden = selectedArea !== 'all' && groupArea !== selectedArea;
      if (query || selectedReview === 'open') group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-policy-entry]')].some((entry) => !entry.hidden);
    }
    if (result) result.textContent = `${visible} ${visible === 1 ? 'proposal' : 'proposals'} found`;
  };
  search?.addEventListener('input', update);
  area?.addEventListener('change', update);
  review?.addEventListener('change', update);
</script>
<style>
  .filters{display:grid;grid-template-columns:minmax(16rem,1.5fr) minmax(13rem,.8fr) minmax(13rem,.8fr);align-items:end;gap:1rem;padding:1rem 1.25rem;background:#f2eef9;margin:0 0 4rem}.filters .field{margin:0}.filters p{grid-column:1/-1;margin:0;color:#54465f;font-size:.9rem}
  .policy-group{padding-bottom:4.5rem}.group-heading{border-bottom:1px solid #ded6e7;margin-bottom:1rem}.group-heading h2{margin:.1rem 0 1rem;font-size:clamp(1.8rem,3.4vw,2.8rem)}.group-heading .eyebrow{margin-bottom:.35rem}
  .issue-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:2rem;margin-bottom:2.5rem}.issue-list a{display:flex;justify-content:space-between;gap:.75rem;padding:.9rem 0;border-bottom:1px solid #ded6e7;font-weight:600;text-decoration:none}.issue-list a:hover span:first-child{text-decoration:underline;text-decoration-thickness:2px}
  .proposal-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:3rem}.proposal-entry{position:relative;padding:1rem 0 1.25rem;border-top:1px solid #ded6e7}.proposal-entry[hidden],.policy-group[hidden]{display:none}.domain-name{margin:0 0 .45rem;color:#625171;font-size:.78rem;font-weight:700}.proposal-entry h3{margin:.4rem 0 .65rem;font-size:1.42rem}.proposal-entry h3 a{text-decoration:none}.proposal-entry h3 a:hover{text-decoration:underline}.review-label{float:right;color:#0b4b50;background:#e4f9fa;padding:.18rem .55rem;border-radius:999px;font-size:.72rem;font-weight:700}.proposal-entry .text-link,.consult-link{font-size:.88rem}.consult-link{margin-left:1.25rem;font-weight:700;color:#32105a}
  @media(max-width:800px){.filters{grid-template-columns:1fr 1fr}.filters .field:first-child{grid-column:1/-1}.issue-list{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.filters{grid-template-columns:1fr}.filters .field:first-child{grid-column:auto}.issue-list,.proposal-list{grid-template-columns:1fr}.consult-link{display:block;margin:.7rem 0 0}}
</style>
