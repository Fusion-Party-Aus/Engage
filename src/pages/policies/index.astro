---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Button } from '../../components/ui/button';
import PolicyRegistry from '../../components/policy/PolicyRegistry.astro';
import { Card, CardContent } from '../../components/ui/card';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { groupRegistryByBranch, groupRegistryPolicies } from '../../lib/policy-registry.ts';
import { isPolicyRegistryRecordForResolution } from '../../lib/proposal-helpers.ts';
export const prerender = false;
const db = await getDatabase(runtimeEnv(Astro.locals));
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const needle = q.toLowerCase();
const branchFilter = Astro.url.searchParams.get('branch') ?? '';
const showHistory = Astro.url.searchParams.get('history') === '1';
const [rawRecords, branches, resolutionProposals] = await Promise.all([
  db.collection('policy_registry').find({ publicationStatus: { $in: ['published', 'withdrawn', 'superseded', 'repealed'] } }).sort({ title: 1 }).toArray(),
  db.collection('branches').find({ recognised: true }).sort({ name: 1 }).toArray(),
  db.collection('proposals').find({}, { projection: { proposalId: 1, kind: 1 } }).toArray(),
]);
const proposalKindMap = new Map(
  resolutionProposals.map((p: any) => [String(p.proposalId), { proposalId: String(p.proposalId), kind: p.kind ? String(p.kind) : undefined }]),
);
const records = rawRecords.filter(
  (policy: any) =>
    !isPolicyRegistryRecordForResolution(
      policy,
      proposalKindMap.get(String(policy.proposalId ?? policy.policyId ?? '')),
    ),
);
const scoped = branchFilter
  ? records.filter((policy: any) => policy.jurisdictionBranchId === branchFilter)
  : records;
const matches = (policy: any) =>
  !needle ||
  `${policy.title} ${policy.summary} ${policy.category ?? ''} ${policy.pillar ?? ''} ${policy.approvedWording ?? ''}`
    .toLowerCase()
    .includes(needle);
const policies = scoped.filter(
  (policy: any) =>
    (showHistory ? policy.publicationStatus !== 'published' : policy.publicationStatus === 'published') &&
    matches(policy),
);
const groupBy = showHistory ? 'status' as const : 'topic' as const;
const sections = branchFilter
  ? [{ key: branchFilter, label: null, groups: groupRegistryPolicies(policies, { groupBy }) }]
  : groupRegistryByBranch(policies, branches, { groupBy });
const currentCount = scoped.filter((policy: any) => policy.publicationStatus === 'published').length;
const pastCount = scoped.length - currentCount;
const hasRegistryRecords = records.length > 0;
const tabHref = (history: boolean) => {
  const params = new URLSearchParams();
  if (history) params.set('history', '1');
  if (branchFilter) params.set('branch', branchFilter);
  if (q) params.set('q', q);
  const query = params.toString();
  return query ? `/policies/?${query}` : '/policies/';
};
const clearHref = '/policies/';
const scopeName = branchFilter
  ? branches.find((branch: any) => branch.branchId === branchFilter)?.name ?? 'Selected branch'
  : null;
---
<SiteLayout title="Official policy registry · Engage" description="Fusion Party Australia's official policy registry and publication record." canonical="/policies/">
  <div class="page-wrap section-space policy-page">
    <header class="policy-intro">
      <h1>{showHistory ? 'Past policy records' : 'Policy registry'}</h1>
      <p>{showHistory
        ? 'Withdrawn, superseded and repealed records. They remain public for the record but are not current policy.'
        : hasRegistryRecords
          ? `Policy Fusion has formally adopted${scopeName ? ` in ${scopeName}` : ''}. Each record explains how it was adopted, whether through Engage or an authorised branch decision.`
          : 'No adopted policy has been added to this registry yet. You can still read Fusion’s policies through the party’s official channels.'}</p>
      <nav class="registry-tabs" aria-label="Policy status">
        <Button href={tabHref(false)} variant={!showHistory ? 'default' : 'ghost'} size="sm">Current policy <span class="tabular">{currentCount}</span></Button>
        <Button href={tabHref(true)} variant={showHistory ? 'default' : 'ghost'} size="sm">Past records <span class="tabular">{pastCount}</span></Button>
      </nav>
    </header>

    {hasRegistryRecords ? (
      <>
        <PolicyRegistry
          sections={sections}
          branches={branches}
          showHistory={showHistory}
          query={q}
          branchFilter={branchFilter}
          action="/policies/"
          clearHref={clearHref}
        />
        <p class="registry-footnote">
          <a href="/how-it-works/">How a proposal becomes adopted policy</a>
          <span>·</span>
          <a href="/proposals/">Ideas still under discussion</a>
        </p>
      </>
    ) : (
      <Card>
        <CardContent className="grid justify-items-start gap-3 py-10">
          <h2>{showHistory ? 'No past policy records in Engage yet' : 'No adopted policy in this registry yet'}</h2>
          <p>Policies remain available through the party’s official channels. Proposals in Engage are not ratified policy.</p>
          <div class="flex flex-wrap items-center gap-3">
            <Button href="https://www.fusionparty.org.au/policy/" target="_blank" rel="noreferrer noopener">
              Read Fusion’s policies ↗
            </Button>
            <Button href="/proposals/" variant="outline">Browse Engage proposals</Button>
          </div>
        </CardContent>
      </Card>
    )}
  </div>
</SiteLayout>

<style>
  .policy-page { max-width:84rem; }
  .policy-intro { max-width:64rem; margin:0 0 2rem; }
  .policy-intro h1 { margin:.25rem 0 .65rem; font:700 clamp(2.1rem,3.5vw,3.2rem)/1.1 Outfit,sans-serif; color:var(--horizon-purple); }
  .policy-intro > p { color:var(--horizon-muted); line-height:1.65; }
  .registry-tabs { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:1.5rem; }
  .registry-tabs :global(.tabular) { margin-left:.4rem; opacity:.7; font-size:.82em; }
  .registry-footnote { display:flex; flex-wrap:wrap; gap:.5rem .8rem; margin:2.5rem 0 0; color:var(--horizon-muted); font-size:.85rem; }
  .registry-footnote a { color:var(--horizon-muted); }
</style>
