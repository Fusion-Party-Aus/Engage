---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewNotice from '../../components/PreviewNotice.astro';
import initialRound from '../../data/initial-round.json';
const relevantPolicies = initialRound.policies;
---
<SiteLayout title="Consultations · Fusion" description="Share feedback and propose policy changes through Fusion consultations." canonical={`${Astro.url.origin}/consultations/`}>
  <PreviewNotice slot="notice" />
  <div class="page-wrap">
    <header class="page-intro"><p class="eyebrow">Member consultation</p><h1>Policy gets stronger when more people shape it.</h1><p>Share a comment, suggest an amendment, or make the case for a different direction. Consultation feedback is reviewed separately from formal voting.</p></header>
    <section class="round-panel" aria-labelledby="round-title">
      <div><p class="eyebrow">Intended first round · Draft schedule</p><h2 id="round-title">Four areas for member feedback</h2><p>Scheduled 26 October – 26 November 2026 (AEDT). The configured round remains draft until its release gates are complete.</p></div>
      <div class="round-grid">{initialRound.areas.map((area) => <article><span>{area.policies.length} proposals</span><h3>{area.domain}</h3></article>)}</div>
      <p class="schedule-note">Review meeting: {initialRound.meeting.date}, {initialRound.meeting.starts}–{initialRound.meeting.ends} AEDT.</p>
    </section>
    <section class="submission-panel section-space" aria-labelledby="submit-title">
      <div class="submission-copy"><p class="eyebrow">Contribute</p><h2 id="submit-title">What should change?</h2><p>Preview submissions use synthetic identities and data. Production participation is unavailable until Underground identity and eligibility verification is connected.</p><p id="sign-in-prompt"><a class="text-link" href="/member/">Sign in with a synthetic preview identity <span aria-hidden="true">→</span></a></p></div>
      <form id="consultation-form" class="consultation-form" hidden>
        <label class="field"><span>Policy proposal</span><select name="policyId" required><option value="">Choose a proposal</option>{relevantPolicies.map((policy) => <option value={policy.id} data-revision={policy.policyVersion}>{policy.title} · {policy.domain}</option>)}</select></label>
        <label class="field"><span>How would you like to contribute?</span><select name="kind" required><option value="comment">Comment</option><option value="amendment">Proposed amendment</option><option value="alternative">Alternative direction</option></select></label>
        <label class="field"><span>Title <small>(optional)</small></span><input name="title" maxlength="160" /></label>
        <label class="field"><span>Your feedback</span><textarea name="body" minlength="10" maxlength="10000" required placeholder="Explain the issue, the change you suggest, or the evidence you want considered."></textarea></label>
        <button class="button" type="submit">Submit feedback</button><p class="form-status" id="consultation-status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </div>
</SiteLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#consultation-form');
  const prompt = document.querySelector<HTMLElement>('#sign-in-prompt');
  const status = document.querySelector<HTMLElement>('#consultation-status');
  const selectedTitle = new URLSearchParams(location.search).get('policy');
  const session = await fetch('/api/session', { credentials: 'same-origin' }).then((response) => response.json()).catch(() => null);
  if (session?.identity?.source === 'synthetic' && form) { form.hidden = false; if (prompt) prompt.hidden = true; }
  if (selectedTitle && form) {
    const selection = form.elements.namedItem('policyId') as HTMLSelectElement;
    const option = [...selection.options].find((item) => item.textContent?.startsWith(selectedTitle));
    if (option) selection.value = option.value;
  }
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status) return;
    const values = Object.fromEntries(new FormData(form).entries());
    const policyId = String(values.policyId);
    const selection = form.elements.namedItem('policyId') as HTMLSelectElement;
    const request = { roundId: 'preview-demo-consultation', policyId, policyRevisionId: selection.selectedOptions[0]?.dataset.revision, kind: values.kind, title: values.title, body: values.body };
    status.textContent = 'Saving your synthetic preview submission…';
    const response = await fetch('/api/consultations', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify(request) });
    const result = await response.json().catch(() => ({}));
    status.textContent = response.ok ? 'Your preview submission was saved for moderator review.' : (result.error ?? 'We could not save that submission. Please try again.');
    if (response.ok) form.reset();
  });
</script>
<style>
  .round-panel{margin:0 0 2rem;padding:clamp(1.4rem,4vw,2.5rem);background:#f2eef9;border-radius:.9rem}.round-panel h2{margin:.1rem 0 .6rem}.round-panel>div:first-child>p:last-child{max-width:64ch;color:#54465f;line-height:1.65}
  .round-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-top:1.8rem}.round-grid article{padding:1.1rem;background:white;border-radius:.65rem}.round-grid span{font-size:.75rem;font-weight:700;color:#54465f;text-transform:uppercase;letter-spacing:.05em}.round-grid h3{margin:.55rem 0 .1rem;font-size:1.25rem}.schedule-note{margin:1.1rem 0 0;color:#54465f;font-size:.9rem}
  .submission-panel{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,6vw,6rem)}.submission-copy h2{margin:.1rem 0 .7rem}.submission-copy>p:not(.eyebrow){max-width:42ch;color:#54465f;line-height:1.7}.consultation-form{padding:1.5rem;background:#fff;border:1px solid #ded6e7;border-radius:.85rem}.consultation-form[hidden]{display:none}.consultation-form small{color:#54465f;font-weight:400}.form-status{margin-bottom:0}
  @media(max-width:850px){.round-grid{grid-template-columns:repeat(2,1fr)}.submission-panel{grid-template-columns:1fr}}@media(max-width:520px){.round-grid{grid-template-columns:1fr}.round-grid article{padding:.9rem}}
</style>
