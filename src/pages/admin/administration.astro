---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminPageDenial } from '../../lib/platform/admin-access';
import { resolveIdentity } from '../../lib/platform/auth';
import { canReadDiscussion } from '../../lib/platform/discussion-access';
import { getDatabase } from '../../lib/platform/database';
import { platformEnv } from '../../lib/platform/http';
export const prerender = false;
const env = platformEnv(Astro.locals);
const denial = await adminPageDenial(Astro.request, env, true);
if (denial) return denial;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const { identity } = await resolveIdentity(Astro.request, env);
const participation = await canReadDiscussion(await getDatabase(env), identity, env);
---
<AdminLayout title="Administration" description="Verify membership, inspect operational health and review the audit trail." area="Administration" administrator participation={participation}>
  <div class="admin-card"><h2>Membership verification</h2><p>Verify eligibility against authoritative party records. Keep sensitive membership notes out of Engage.</p><a class="button" href="/admin/members/">Review membership</a></div>
  <div class="admin-card"><h2>Permissions</h2><p>Current access uses the existing administrator and moderator assignments. Separate editor, independent wording reviewer, Election Officer and membership administrator controls are pending the next delivery.</p></div>
  <section class="admin-card"><h2>Operational health</h2><p id="health-summary" role="status" aria-live="polite">Loading operational health…</p></section>
  <section class="admin-card" id="audit-list"><h2>Recent operational activity</h2><p>Latest 25 events. Member vote choices and named member-to-vote links are omitted from this view.</p><p id="audit-status" role="status" aria-live="polite">Loading activity…</p><ul class="admin-list" id="audit-events"></ul></section>
  <button class="button button--outline" type="button" id="operations-retry" hidden>Retry operational reads</button>
</AdminLayout>
<script>
  const health = document.querySelector<HTMLElement>('#health-summary')!;
  const audit = document.querySelector<HTMLElement>('#audit-status')!;
  const events = document.querySelector<HTMLElement>('#audit-events')!;
  const retry = document.querySelector<HTMLButtonElement>('#operations-retry')!;
  async function loadOperations() {
    retry.hidden = true;
    const results = await Promise.allSettled([
      (async () => {
        const response = await fetch('/api/admin/health'); const data = await response.json();
        if (!response.ok) throw new Error(data.error ?? 'Operational health is unavailable.');
        health.textContent = `Service: ${data.health}. Membership verification: ${data.gates.membershipVerification}. Formal ballots: ${data.gates.formalBallotsEnabled ? 'enabled by configuration' : 'disabled'}. Configuration does not attest governance approval.`;
      })(),
      (async () => {
        const response = await fetch('/api/admin/audit?limit=25'); const data = await response.json();
        if (!response.ok) throw new Error(data.error ?? 'Audit activity is unavailable.');
        events.replaceChildren();
        for (const event of data.events) { const row = document.createElement('li'); row.textContent = `${new Date(event.createdAt).toLocaleString()} · ${event.action.replaceAll('_', ' ')} · ${event.targetType ?? ''} ${event.targetId ?? ''} ${event.status ?? ''}`; events.append(row); }
        audit.textContent = data.events.length ? 'Recent activity loaded.' : 'No operational events recorded.';
      })(),
    ]);
    results.forEach((result, index) => { if (result.status === 'rejected') { (index === 0 ? health : audit).textContent = 'This operational read is unavailable. Please retry.'; retry.hidden = false; } });
  }
  retry.addEventListener('click', loadOperations); await loadOperations();
</script>
