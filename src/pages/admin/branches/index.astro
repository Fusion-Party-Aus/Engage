---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BranchWork from '../../../components/BranchWork';
import Alert from '../../../components/admin/Alert.astro';
import AlertTitle from '../../../components/admin/AlertTitle.astro';
import AlertDescription from '../../../components/admin/AlertDescription.astro';
import { ShieldAlert } from 'lucide-react';
import { getSessionUser } from '../../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../../lib/db.ts';
import { listMembers } from '../../../lib/store.ts';
import {
  countBranchParticipation,
  listBranchPeople,
} from '../../../lib/branch-participation.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const user = await getSessionUser(Astro.request, env);
if (!user) return Astro.redirect('/member/', 302);
const allowed = Boolean(user.isAdmin || user.isBranchAdmin);
if (!allowed) Astro.response.status = 403;

const db = await getDatabase(env);
const adminBranchIds = user.isAdmin ? [] : (user.branchAdminIds ?? []);

let branches: any[] = [];
let people: any[] = [];
let counts: Record<string, any> = {};
let referrals: any[] = [];
let activity: Record<string, { proposals: number; openBallots: number }> = {};

if (allowed) {
  const branchFilter = user.isAdmin ? {} : { branchId: { $in: adminBranchIds } };
  const [branchRows, members] = await Promise.all([
    db.collection('branches').find(branchFilter).sort({ name: 1 }).toArray(),
    listMembers(db, ''),
  ]);
  // Branch administrators also need their parents' names to place themselves in the hierarchy.
  const known = new Set(branchRows.map((b: any) => b.branchId));
  const parentIds = [...new Set(branchRows.map((b: any) => b.parentBranchId).filter((id: unknown) => typeof id === 'string' && !known.has(id)))] as string[];
  const parentRows = parentIds.length
    ? await db.collection('branches').find({ branchId: { $in: parentIds } }).toArray()
    : [];
  branches = [...branchRows, ...parentRows].map((b: any) => ({
    branchId: String(b.branchId),
    name: String(b.name),
    kind: String(b.kind),
    parentBranchId: b.parentBranchId ?? null,
    recognised: b.recognised === true,
  }));

  const scopedBranchIds = branchRows.map((b: any) => String(b.branchId));
  const [peopleRows, countRows, activityRows] = await Promise.all([
    listBranchPeople(db, scopedBranchIds),
    countBranchParticipation(db, scopedBranchIds),
    Promise.all(
      scopedBranchIds.map(async (branchId) => {
        const [proposals, openBallots] = await Promise.all([
          db.collection('proposals').countDocuments({
            $or: [
              { originatingBranchId: branchId },
              { governanceAuthorityBranchId: branchId },
              { jurisdictionBranchId: branchId },
            ],
          }),
          db.collection('proposals').countDocuments({
            stage: 'decide',
            $or: [
              { originatingBranchId: branchId },
              { governanceAuthorityBranchId: branchId },
              { jurisdictionBranchId: branchId },
            ],
          }),
        ]);
        return [branchId, { proposals, openBallots }] as const;
      }),
    ),
  ]);
  people = peopleRows;
  counts = Object.fromEntries(countRows);
  activity = Object.fromEntries(activityRows);

  const referralRows = await db
    .collection('branch_referrals')
    .find(user.isAdmin ? {} : { $or: [{ targetBranchId: { $in: adminBranchIds } }, { sourceBranchId: { $in: adminBranchIds } }] })
    .sort({ referredAt: -1 })
    .limit(200)
    .toArray();
  const proposalIds = [...new Set(referralRows.map((r: any) => r.proposalId))];
  const proposalRows = proposalIds.length
    ? await db.collection('proposals').find({ proposalId: { $in: proposalIds } }).toArray()
    : [];
  const titleById = new Map(proposalRows.map((p: any) => [p.proposalId, p.title]));
  const memberById = new Map(members.map((m) => [m.memberId, m]));
  referrals = referralRows.map((r: any) => ({
    referralId: r.referralId,
    proposalId: r.proposalId,
    proposalTitle: titleById.get(r.proposalId) ?? '',
    sourceBranchId: r.sourceBranchId ?? null,
    targetBranchId: r.targetBranchId,
    reason: r.reason,
    status: r.status ?? 'referred',
    referredByName: memberById.get(r.referredBy)?.name ?? '',
    referredAt: r.referredAt ? new Date(r.referredAt).toISOString() : undefined,
  }));
}
---

<AdminLayout
  title="Branch governance"
  description="Manage branch participation, verified members and delegated governance access."
  section="branches"
  isAdmin={user.isAdmin}
  isBranchAdmin={Boolean(user.isBranchAdmin)}
>
  {!allowed ? (
    <Alert variant="destructive">
      <ShieldAlert />
      <AlertTitle>Access required</AlertTitle>
      <AlertDescription>A national or delegated branch administrator can manage branches.</AlertDescription>
    </Alert>
  ) : (
    <BranchWork
      client:load
      branches={branches}
      people={people}
      counts={counts}
      activity={activity}
      referrals={referrals}
      isAdmin={Boolean(user.isAdmin)}
      adminBranchIds={adminBranchIds}
      currentUserName={user.name || user.email}
    />
  )}
</AdminLayout>
