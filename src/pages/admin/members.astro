---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Input } from '../../components/ui/input';
import { NativeSelect } from '../../components/ui/native-select';
import { Checkbox } from '../../components/ui/checkbox';
import { Search, ShieldAlert, UserPlus, Users } from 'lucide-react';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listMembers } from '../../lib/store.ts';
import { listOpenVerificationReviews } from '../../lib/membership-verification.ts';
import {
  PLATFORM_ROLE_LABELS,
  PLATFORM_ROLE_OPTIONS,
  hasPermission,
} from '../../lib/rbac.ts';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import Card from '../../components/admin/Card.astro';
import CardContent from '../../components/admin/CardContent.astro';
import CardDescription from '../../components/admin/CardDescription.astro';
import CardHeader from '../../components/admin/CardHeader.astro';
import CardTitle from '../../components/admin/CardTitle.astro';
import Field from '../../components/admin/Field.astro';
import Alert from '../../components/admin/Alert.astro';
import AlertTitle from '../../components/admin/AlertTitle.astro';
import AlertDescription from '../../components/admin/AlertDescription.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const user = await getSessionUser(Astro.request, env);

if (!user) {
  return Astro.redirect('/member/', 302);
}
const canViewMembers = hasPermission(user, 'members.view');
const canVerifyMembers = hasPermission(user, 'members.verify');
const canManageRoles = hasPermission(user, 'roles.manage');
if (!canViewMembers) {
  Astro.response.status = 403;
}

const db = await getDatabase(env);
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const members = canViewMembers ? (await listMembers(db, query)).sort((a, b) => Number(a.status !== 'pending') - Number(b.status !== 'pending') || a.name.localeCompare(b.name)) : [];
const pendingCount = members.filter((member) => member.status === 'pending').length;
const verificationReviews = canVerifyMembers ? await listOpenVerificationReviews(db, 25) : [];
const initials = (name: string) => name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || '?';
---

<AdminLayout
  title="Member access"
  description="Review membership requests and account permissions."
  section="members"
  isAdmin={user.isAdmin}
>
  {!canViewMembers ? (
    <Alert variant="destructive">
      <ShieldAlert />
      <AlertTitle>Access required</AlertTitle>
      <AlertDescription>Member directory permission is required to view member accounts.</AlertDescription>
    </Alert>
  ) : (
    <div class="admin-stack">
      <Card class="gap-0">
        <CardContent class="p-5">
          <form method="get" action="/admin/members/" class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <Field label="Find member by name or email" htmlFor="member-search" class="flex-1">
              <div class="relative">
                <Search className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground" />
                <Input id="member-search" type="search" name="q" defaultValue={query} placeholder="Name or email address" className="pl-9" />
              </div>
            </Field>
            <Button type="submit" variant="outline">Search</Button>
          </form>
        </CardContent>
      </Card>

      {verificationReviews.length > 0 && (
        <Card class="gap-0">
          <CardHeader class="flex flex-wrap items-center justify-between gap-3 border-b pb-4">
            <div class="grid gap-1">
              <CardTitle class="text-base">Verification reviews</CardTitle>
              <CardDescription>Accounts whose CRM membership or geographic branch could not be resolved automatically.</CardDescription>
            </div>
            <Badge variant="warning">{verificationReviews.length}</Badge>
          </CardHeader>
          <CardContent class="p-0">
            <div class="divide-y">
              {verificationReviews.map((review) => (
                <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
                  <div class="grid min-w-0 gap-1">
                    <p class="m-0 text-sm font-semibold text-foreground">{review.name || review.email || 'Member account'}</p>
                    <p class="m-0 text-sm text-muted-foreground">{review.reasonLabel}</p>
                    <p class="m-0 text-xs text-muted-foreground">Opened {new Date(review.createdAt).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
                  </div>
                  <Button href={`/admin/members/?q=${encodeURIComponent(review.email || review.name || '')}`} variant="outline" size="sm">Review account</Button>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      <Card class="gap-0">
        <CardHeader class="flex flex-wrap items-center justify-between gap-3 border-b pb-4">
          <div class="grid gap-1">
            <CardTitle class="text-base">Member accounts</CardTitle>
            <CardDescription>{members.length} account{members.length === 1 ? '' : 's'} in this view{pendingCount ? ` · ${pendingCount} awaiting verification` : ''}. Platform roles are assigned here; branch and custom roles appear on each member.</CardDescription>
          </div>
          <Badge variant="muted"><Users />{members.length}</Badge>
        </CardHeader>
        <CardContent class="p-0">
          {members.length === 0 ? (
            <p class="admin-empty px-5 py-8">No member accounts match this search.</p>
          ) : (
            <div class="divide-y">
              {members.map((m) => {
                const isSelf = m.memberId === user.memberId;
                return (
                  <form class="member-update-form grid gap-3 px-5 py-4" data-member-id={m.memberId}>
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <div class="flex min-w-0 items-start gap-3">
                        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[var(--horizon-lavender)] text-sm font-semibold text-[var(--horizon-purple)]" aria-hidden="true">{initials(m.name || m.email)}</span>
                        <div class="grid min-w-0 gap-1.5">
                          <div class="flex flex-wrap items-center gap-2">
                            <h3 class="m-0 text-sm font-semibold text-foreground">{m.name || 'Name needed'}</h3>
                            {isSelf && <Badge variant="outline">You</Badge>}
                            <Badge variant={m.status === 'verified' ? 'success' : m.status === 'suspended' ? 'destructive' : 'warning'}>{m.status}</Badge>
                            {(m.roles ?? [m.role]).map((role) => (
                              <Badge variant={role === 'administrator' ? 'secondary' : role === 'moderator' ? 'info' : 'muted'}>{PLATFORM_ROLE_LABELS[role]}</Badge>
                            ))}
                            {m.disabled && <Badge variant="destructive">Disabled</Badge>}
                          </div>
                          <p class="m-0 truncate text-sm text-muted-foreground">{m.email}</p>
                          <p class="m-0 text-xs text-muted-foreground">{m.emailVerified ? 'Email confirmed' : 'Email not yet used'}</p>
                          {(m.branchAdministratorOf?.length || m.delegatedRoles?.length) && (
                            <p class="m-0 flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
                              <span>Also:</span>
                              {m.branchAdministratorOf?.map((branch) => (
                                <Badge variant="outline">Branch Administrator · {branch}</Badge>
                              ))}
                              {m.delegatedRoles?.map((role) => (
                                <Badge variant="outline">{role}</Badge>
                              ))}
                            </p>
                          )}
                        </div>
                      </div>
                    </div>

                    <details class="member-controls">
                      <summary>{m.status === 'pending' ? 'Review membership' : 'Manage access'}{m.disabled ? ' · disabled' : ''}</summary>
                      <div class="admin-form-grid pt-3">
                        <Field label="Membership status" htmlFor={`status-${m.memberId}`}>
                          <NativeSelect defaultValue={m.status} id={`status-${m.memberId}`} name="status" aria-label={`Membership status for ${m.name || m.email}`} disabled={isSelf || !canVerifyMembers}>
                            <option value="pending">Pending verification</option>
                            <option value="verified">Verified member</option>
                            <option value="suspended">Suspended</option>
                          </NativeSelect>
                        </Field>

                        {canManageRoles ? (
                          <Field label="Platform roles">
                            <input type="hidden" name="roles" value="member" />
                            <div class="grid gap-2" role="group" aria-label={`Platform roles for ${m.name || m.email}`}>
                              {PLATFORM_ROLE_OPTIONS.map((option) => {
                                const checked = (m.roles ?? [m.role]).includes(option.value);
                                return (
                                  <label class="flex items-start gap-2 text-sm">
                                    <Checkbox
                                      name="roles"
                                      value={option.value}
                                      defaultChecked={checked || option.value === 'member'}
                                      disabled={isSelf || option.value === 'member'}
                                    />
                                    <span class="grid gap-0.5">
                                      <span class="font-medium">{option.label}</span>
                                      <span class="text-xs text-muted-foreground">{option.description}</span>
                                    </span>
                                  </label>
                                );
                              })}
                            </div>
                          </Field>
                        ) : (
                          <Field label="Platform roles">
                            <div class="flex flex-wrap gap-1">
                              {(m.roles ?? [m.role]).map((role) => (
                                <Badge variant="outline">{PLATFORM_ROLE_LABELS[role]}</Badge>
                              ))}
                            </div>
                            <p class="m-0 text-xs text-muted-foreground">Role changes require role-management permission.</p>
                          </Field>
                        )}

                        <Field label="Access state" htmlFor={`disabled-${m.memberId}`}>
                          <NativeSelect defaultValue={String(m.disabled)} id={`disabled-${m.memberId}`} name="disabled" aria-label={`Access state for ${m.name || m.email}`} disabled={isSelf || !canVerifyMembers}>
                            <option value="false">Active</option>
                            <option value="true">Disabled</option>
                          </NativeSelect>
                        </Field>
                      </div>

                      <div class="admin-actions mt-3">
                        {!isSelf && (canVerifyMembers || canManageRoles) && <Button variant="outline" size="sm" type="submit">Save changes</Button>}
                        <span class="member-save-msg admin-status" role="status" aria-live="polite"></span>
                      </div>
                    </details>
                  </form>
                );
              })}
            </div>
          )}
        </CardContent>
      </Card>

      {canVerifyMembers && (
        <details class="admin-disclosure">
          <summary id="add-member-heading">
            <UserPlus className="size-4" aria-hidden="true" />
            Add a member account
          </summary>
          <div class="admin-disclosure__body">
            <form id="create-member-form" class="grid gap-4">
              <div class="admin-form-grid">
                <Field label="Full name" htmlFor="create-member-name">
                  <Input id="create-member-name" name="name" required minLength={2} maxLength={100} autoComplete="off" />
                </Field>
                <Field label="Email address" htmlFor="create-member-email">
                  <Input id="create-member-email" name="email" type="email" required maxLength={254} autoComplete="off" />
                </Field>
              </div>
              <div class="admin-form-grid">
                <Field label="Party membership status" htmlFor="create-member-status-select">
                  <NativeSelect defaultValue="verified" id="create-member-status-select" name="status">
                    <option value="verified">Verified member</option>
                    <option value="pending">Pending verification</option>
                    <option value="suspended">Suspended</option>
                  </NativeSelect>
                </Field>
                {canManageRoles && (
                  <Field label="Platform roles">
                    <input type="hidden" name="roles" value="member" />
                    <div class="grid gap-2" role="group" aria-label="Platform roles for the new member">
                      {PLATFORM_ROLE_OPTIONS.map((option) => (
                        <label class="flex items-start gap-2 text-sm">
                          <Checkbox
                            name="roles"
                            value={option.value}
                            defaultChecked={option.value === 'member'}
                            disabled={option.value === 'member'}
                          />
                          <span class="grid gap-0.5">
                            <span class="font-medium">{option.label}</span>
                            <span class="text-xs text-muted-foreground">{option.description}</span>
                          </span>
                        </label>
                      ))}
                    </div>
                  </Field>
                )}
              </div>
              <div class="admin-actions">
                <Button type="submit">Add member account</Button>
                <p id="create-member-status" class="form-status admin-status" role="status" aria-live="polite"></p>
              </div>
            </form>
          </div>
        </details>
      )}
    </div>
  )}
</AdminLayout>

<script>
  const createForm = document.querySelector<HTMLFormElement>('#create-member-form');
  const createStatus = document.querySelector<HTMLElement>('#create-member-status');

  createForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!createForm.reportValidity()) return;
    const btn = createForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    if (createStatus) createStatus.textContent = 'Creating…';

    try {
      const data = new FormData(createForm);
      const payload: Record<string, unknown> = {
        name: data.get('name'),
        email: data.get('email'),
        status: data.get('status'),
      };
      if (data.has('roles')) payload.roles = data.getAll('roles');
      const res = await fetch('/api/admin/members', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const responseBody = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(responseBody.error || 'Could not create account.');
      if (responseBody.notification === 'failed') {
        if (createStatus) createStatus.textContent = 'Account created, but the verification email could not be sent. Please notify the member and reload this page.';
        return;
      }
      location.reload();
    } catch (err) {
      if (createStatus) {
        createStatus.textContent = err instanceof Error ? err.message : 'Could not create account.';
      }
      btn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLFormElement>('.member-update-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const memberId = form.dataset.memberId;
      const msg = form.querySelector<HTMLElement>('.member-save-msg')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!memberId) return;
      if (btn) btn.disabled = true;
      msg.textContent = 'Saving…';

      try {
        const fd = new FormData(form);
        const payload: Record<string, unknown> = { memberId };
        if (fd.has('status')) payload.status = fd.get('status');
        if (fd.has('roles')) payload.roles = fd.getAll('roles').map(String);
        if (fd.has('disabled')) payload.disabled = fd.get('disabled') === 'true';
        const res = await fetch('/api/admin/members', {
          method: 'PATCH',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const responseBody = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(responseBody.error || 'Failed');
        msg.textContent = responseBody.notification === 'failed'
          ? 'Saved. Verification email could not be sent; please notify the member.'
          : responseBody.notification === 'sent' ? 'Saved. Verification email sent.' : 'Saved';
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'Error';
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  });
</script>

<style>
  .member-controls {
    border: 1px solid var(--horizon-line);
    border-radius: 0.6rem;
    background: var(--horizon-lavender-soft);
    padding: 0 0.85rem;
  }
  .member-controls > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.6rem;
    cursor: pointer;
    color: var(--horizon-purple);
    font-size: 0.86rem;
    font-weight: 600;
    list-style: none;
  }
  .member-controls > summary::-webkit-details-marker { display: none; }
  .member-controls > summary::after { content: '+'; margin-left: auto; font-size: 1.05rem; line-height: 1; }
  .member-controls[open] > summary::after { content: '−'; }
  .member-controls[open] > summary { border-bottom: 1px solid var(--horizon-line); }
  .member-controls > summary:focus-visible { outline: 3px solid var(--horizon-focus); outline-offset: -2px; }
  .member-save-msg { margin: 0; }
</style>
