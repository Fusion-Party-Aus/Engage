---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PlatformSettings from '../../../components/PlatformSettings';
import { getSessionUser } from '../../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../../lib/db.ts';
import { getSiteConfig, listSiteConfigEvents } from '../../../lib/site-config.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([getDatabase(env), getSessionUser(Astro.request, env)]);

if (!user) return Astro.redirect('/member/');
if (!user.isAdmin) return Astro.redirect('/admin/');

const [config, events] = await Promise.all([getSiteConfig(db, env), listSiteConfigEvents(db)]);
const plain = (value: unknown): any => JSON.parse(JSON.stringify(value));
---

<AdminLayout
  title="Platform settings"
  description="Manage how Engage appears and operates."
  section="settings"
  isAdmin={user.isAdmin}
  isBranchAdmin={user.isBranchAdmin}
>
  <PlatformSettings client:load initialConfig={plain(config)} initialEvents={plain(events)} />
</AdminLayout>
