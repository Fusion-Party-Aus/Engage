---
import { lifecycleConversion } from '../../lib/member-lifecycle.ts';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { digestEnabled, ensureDigestCohort, notificationEnabled } from '../../lib/digest-preferences.ts';
import { getDatabase,runtimeEnv } from '../../lib/db.ts';
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
const env=runtimeEnv(Astro.locals), user=await getSessionUser(Astro.request,env);
if (!user?.isAdmin) return new Response('Administrator access required',{status:403});
const db=await getDatabase(env);
const since=new Date(Date.now()-30*86400000);
const [messages, preferences, existingMembers, accounts, testMessages] = await Promise.all([
 db.collection('engagement_email_outbox').find({createdAt:{$gte:since},kind:{$nin:['test','verification']}}).project({status:1,providerId:1,deliveredAt:1,bouncedAt:1,complainedAt:1,failedAt:1,openedAt:1,clickedAt:1}).toArray(),
 db.collection('engagement_email_preferences').find({}).project({memberId:1,digestEnabled:1,accountNotificationsEnabled:1,generalCommunicationsEnabled:1,suppressed:1,unsubscribedAt:1}).toArray(),
 ensureDigestCohort(db),
 db.collection("user").find({}).project({_id:1}).toArray(),
 db.collection('engagement_email_outbox').find({kind:'test',memberId:user.memberId}).sort({createdAt:-1}).limit(5).project({status:1,providerId:1,createdAt:1,deliveredAt:1,bouncedAt:1,complainedAt:1,failedAt:1}).toArray(),
]);
const verificationMessages=await db.collection('engagement_email_outbox').find({kind:'verification',createdAt:{$gte:since}}).toArray();
const funnel=lifecycleConversion(await db.collection<any>('engagement_lifecycle_events').find({}).toArray());
const preferenceByMember = new Map(preferences.map(p=>[p.memberId,p]));
const subscribers = accounts.filter(a=>digestEnabled(preferenceByMember.get(String(a._id)) ?? null,existingMembers.has(String(a._id)))).length;
const accepted=messages.filter(m=>m.providerId).length;
const count=(field:string)=>messages.filter(m=>m[field]).length;
const rate=(n:number)=>accepted ? `${(100*n/accepted).toFixed(1)}%` : '—';
---
<AdminLayout title="Member engagement" description="Ballot reminder delivery over the last 30 days" section="overview" isAdmin>
 <section aria-labelledby="test-email-heading">
  <h2 id="test-email-heading">Send yourself a test digest</h2>
  <p>Send a Horizon-styled sample to {user.email}. This works while scheduled digests are disabled. It uses sample ballot data and a demo unsubscribe link; voting and notification preferences are unchanged.</p>
  <form id="test-digest-form" method="post" action="/api/admin/email/test"><button type="submit" id="test-digest-button" class="rounded-full bg-[#32105a] px-5 py-3 text-white">Send test email to me</button></form>
  <p id="test-digest-status" role="status" aria-live="polite"></p>
  {testMessages.length > 0 && <ul>{testMessages.map(m=><li>{new Date(m.createdAt).toLocaleString('en-AU',{timeZone:'Australia/Melbourne'})} (Melbourne) — {m.bouncedAt ? 'Bounced' : m.complainedAt ? 'Spam complaint' : m.failedAt ? 'Delivery failed' : m.deliveredAt ? 'Delivered' : m.status === 'sent' ? 'Accepted by provider · delivery pending' : 'Sending / uncertain delivery'}</li>)}</ul>}
  <p>Refresh to see delivery receipts. Tests are limited to one per minute per administrator and excluded from member digest rates.</p>
 </section>
 <h2>Verification and participation</h2>
 <p>{verificationMessages.length} notices claimed; {verificationMessages.filter(m=>m.deliveredAt).length} delivered; {verificationMessages.filter(m=>m.bouncedAt).length} bounced; {verificationMessages.filter(m=>m.failedAt).length} failed; {verificationMessages.filter(m=>['held','sending','queued'].includes(String(m.status))).length} pending or uncertain; {verificationMessages.filter(m=>m.status==='suppressed').length} suppressed.</p>
 <p>First vote within seven days: {funnel.sevenDayConverted} / {funnel.sevenDayEligible} mature verified accounts. Returning participation within 30 days: {funnel.thirtyDayReturned} / {funnel.thirtyDayEligible} mature first-vote accounts.</p>
 <p>Preview historical re-engagement counts with <code>/api/admin/email/reengagement?cutoff=YYYY-MM-DD</code>. This read-only report never sends messages.</p>
 <h2>Ballot reminders · last 30 days</h2>
 <p>Sending is {env.ENGAGE_DIGEST_ENABLED === 'true' ? 'enabled' : 'disabled'}. {subscribers} subscribed members; {preferences.filter(p=>p.suppressed).length} suppressed.</p>
 <p>{accounts.filter(a=>notificationEnabled(preferenceByMember.get(String(a._id)) ?? null,"essential")).length} account-notification subscriptions; {accounts.filter(a=>notificationEnabled(preferenceByMember.get(String(a._id)) ?? null,"general")).length} general-communication subscriptions. Security and sign-in mail is separate.</p>
 <table><thead><tr><th>Metric</th><th>Messages</th><th>Rate of accepted messages</th></tr></thead><tbody>
 <tr><td>Accepted by provider</td><td>{accepted}</td><td>—</td></tr>
 {(['delivered','bounced','complained','failed','opened','clicked'] as const).map(k=><tr><td>{k}</td><td>{count(`${k}At`)}</td><td>{rate(count(`${k}At`))}</td></tr>)}
 <tr><td>Held / uncertain send</td><td>{messages.filter(m=>['held','sending'].includes(m.status)).length}</td><td>—</td></tr>
 </tbody></table>
 <p>Rates count unique messages, not webhook retries. Delivery reporting requires the signed Resend webhook. Opens/clicks appear only if enabled at the provider and are estimates, affected by email scanners.</p>
 <p>{preferences.filter(p=>p.unsubscribedAt).length} members have unsubscribed using an email link. Opt-outs are preferences, separate from provider delivery failures.</p>
 <p>Bounces and complaints pause further reminder delivery. Unsubscribes never affect sign-in or membership.</p>
</AdminLayout>

<script>
const form=document.querySelector<HTMLFormElement>('#test-digest-form');
const button=document.querySelector<HTMLButtonElement>('#test-digest-button');
const status=document.querySelector<HTMLElement>('#test-digest-status');
form?.addEventListener('submit',async(event)=>{
 event.preventDefault();
 if (!button || !status || button.disabled) return;
 button.disabled=true;status.textContent='Sending your sample digest…';
 try {
  const response=await fetch('/api/admin/email/test',{method:'POST',credentials:'same-origin'});
  const result=await response.json() as {error?:string};
  status.textContent=response.ok ? 'Test accepted by the email provider. Check your inbox; refresh this page for delivery receipts.' : result.error || 'Test email could not be sent.';
 } catch {status.textContent='The request was interrupted. Check delivery status before trying again.';}
 finally {button.disabled=false;}
});
</script>
