---
import { lifecycleConversion } from '../../lib/member-lifecycle.ts';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Button } from '../../components/ui/button';
import { getSessionUser } from '../../lib/auth.ts';
import { digestEnabled, ensureDigestCohort } from '../../lib/digest-preferences.ts';
import { deliveryBreakdown, percentage, testDeliveryHistory } from '../../lib/admin-engagement.ts';
import { getDatabase,runtimeEnv } from '../../lib/db.ts';
import '../../styles/engagement.css';
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
const env=runtimeEnv(Astro.locals), user=await getSessionUser(Astro.request,env);
if (!user?.isAdmin) return new Response('Administrator access required',{status:403});
const period=Number(Astro.url.searchParams.get('days') || 30);
const days=[7,30,90].includes(period) ? period : 30;
const since=new Date(Date.now()-days*86400000);
let report:any=null;
let tests:Awaited<ReturnType<typeof testDeliveryHistory>>=[];
try {
 const db=await getDatabase(env);
 const [messages,preferences,existingMembers,accounts,memberships,events,history] = await Promise.all([
  db.collection('engagement_email_outbox').find({createdAt:{$gte:since},kind:{$nin:['test','verification']}}).toArray(),
  db.collection('engagement_email_preferences').find({}).toArray(), ensureDigestCohort(db),
  db.collection('user').find({}).project({_id:1,emailVerified:1,disabled:1}).toArray(),
  db.collection('memberships').find({status:'verified'}).project({memberId:1}).toArray(),
  db.collection<any>('engagement_lifecycle_events').find({}).toArray(), testDeliveryHistory(db,user.memberId),
 ]);
 const preferenceByMember=new Map(preferences.map(p=>[p.memberId,p]));
 const verified=new Set(memberships.map(m=>String(m.memberId)));
 const subscribers=accounts.filter(a=>a.emailVerified && !a.disabled && verified.has(String(a._id)) && digestEnabled(preferenceByMember.get(String(a._id)) ?? null,existingMembers.has(String(a._id)))).length;
 const accepted=messages.filter(m=>m.providerId).length;
 const recipients=new Set(messages.filter(m=>m.providerId).map(m=>m.memberId));
 const unsubscriptions=preferences.filter(p=>recipients.has(p.memberId) && p.unsubscribedAt && new Date(p.unsubscribedAt)>=since).length;
 report={subscribers,accepted,unsubscriptions,recipients:recipients.size,counts:deliveryBreakdown(messages),funnel:lifecycleConversion(events),total:messages.length,suppressed:preferences.filter(p=>p.suppressed).length};
 tests=history;
} catch { /* Render a useful recoverable page instead of a raw database exception. */ }
const counts=report?.counts;
const funnel=report?.funnel;
const kpis=[
 {label:'Eligible subscribers',value:report?.subscribers ?? 'Unavailable',detail:'Verified members with confirmed email and reminders enabled'},
 {label:'Messages sent',value:report?.accepted ?? 'Unavailable',detail:`Accepted by the provider · last ${days} days`},
 {label:'Delivery success',value:report ? percentage(counts.delivered,report.accepted) : 'Unavailable',detail:'Confirmed delivered / accepted messages'},
 {label:'Bounce rate',value:report ? percentage(counts.bounced,report.accepted) : 'Unavailable',detail:'Bounced / accepted messages'},
 {label:'Unsubscribe rate',value:report ? percentage(report.unsubscriptions,report.recipients) : 'Unavailable',detail:'Recipients unsubscribed in period / accepted recipients'},
 {label:'Returning voters',value:funnel ? percentage(funnel.thirtyDayReturned,funnel.thirtyDayEligible) : 'Unavailable',detail:'All mature tracked first-time voters · 30-day return'},
];
const labels={accepted:'Accepted · awaiting delivery',delivered:'Delivered',bounced:'Bounced',complained:'Spam complaints',failed:'Failed',held:'Held or awaiting acceptance'};
const date=(v:any)=>v ? new Date(v).toLocaleString('en-AU',{timeZone:'Australia/Melbourne'}) : 'Not recorded';
---
<AdminLayout title="Member engagement" description="Understand delivery and voting participation, and check a sample email." section="engagement" isAdmin>
 <div class="engagement-dashboard">
  <div class="engagement-toolbar">
   <span class="engagement-badge">Scheduled digests {env.ENGAGE_DIGEST_ENABLED === 'true' ? 'enabled' : 'disabled'}</span>
   <form method="get" class="engagement-controls"><label for="engagement-period">Email reporting period</label><select name="days" id="engagement-period">{[7,30,90].map(n=><option value={n} selected={n===days}>Last {n} days</option>)}</select><Button type="submit" size="sm" variant="outline">Apply</Button></form>
  </div>
  {!report && <p class="engagement-feedback" role="alert">Engagement data could not be loaded. Refresh this page to try again. The testing controls remain available.</p>}
  <section aria-label="Engagement overview" class="engagement-kpis">
   {kpis.map(k=><article class="engagement-card engagement-kpi"><h2>{k.label}</h2><p class="engagement-value">{k.value}</p><p>{k.detail}</p></article>)}
  </section>
  <div class="engagement-columns">
   <section class="engagement-card" aria-labelledby="delivery-heading">
    <header><h2 id="delivery-heading">Email delivery</h2><p>Member digests · last {days} days</p></header>
    {report?.total === 0 && <p class="engagement-empty">No member digests in this period. Admin test emails appear separately below.</p>}
    {!report && <p class="engagement-empty">Delivery figures are unavailable.</p>}
    {report && <ul class="engagement-breakdown">{Object.entries(labels).map(([key,label])=><li><div><span>{label}</span><strong>{counts[key]}</strong></div><progress aria-label={label} value={counts[key]} max={Math.max(report.total,1)}>{counts[key]} of {report.total}</progress></li>)}</ul>}
    <p class="engagement-caption">Each message appears in one current state. Acceptance does not confirm inbox delivery. Rates are unavailable until at least one message is accepted.</p>
   </section>
   <section class="engagement-card" aria-labelledby="participation-heading">
    <header><h2 id="participation-heading">Voting participation</h2><p>All tracked cohorts with a complete observation window</p></header>
    <dl class="engagement-metrics">
     <div><dt>Verified → first vote within 7 days</dt><dd>{funnel ? percentage(funnel.sevenDayConverted,funnel.sevenDayEligible) : 'Unavailable'}</dd><small>{funnel ? `${funnel.sevenDayConverted} of ${funnel.sevenDayEligible} mature verified accounts` : 'Data could not be loaded'}</small></div>
     <div><dt>Returned to vote within 30 days</dt><dd>{funnel ? percentage(funnel.thirtyDayReturned,funnel.thirtyDayEligible) : 'Unavailable'}</dd><small>{funnel ? `${funnel.thirtyDayReturned} of ${funnel.thirtyDayEligible} mature first-time voters` : 'Data could not be loaded'}</small></div>
    </dl>
    <p class="engagement-caption">A return requires a successful voting day at least 24 hours after the first vote and within 30 days. Opening the site or casting several votes in one session does not count.</p>
    <details class="engagement-availability"><summary>Was there a new ballot to vote on?</summary><p>Historical ballot availability was not recorded for each member. These groups cannot yet be measured reliably:</p><dl class="engagement-metrics"><div><dt>Eligible new ballot available</dt><dd>Unavailable</dd></div><div><dt>No eligible new ballot available</dt><dd>Unavailable</dd></div><div><dt>Availability unknown</dt><dd>{funnel?.thirtyDayEligible ?? 'Unavailable'}</dd></div></dl><p>Do not interpret a missing return as disengagement. The overall return rate includes members whose opportunity to return is unknown.</p></details>
   </section>
  </div>
  <div class="engagement-columns">
   <section class="engagement-card" aria-labelledby="test-email-heading">
    <header><h2 id="test-email-heading">Test email</h2><p>Preview the Horizon digest in your own inbox.</p></header>
    <p class="engagement-recipient"><span>Recipient</span><strong>{user.email}</strong></p>
    <form id="test-digest-form"><Button type="submit" id="test-digest-button">Send test email to me</Button></form>
    <noscript><p>Enable JavaScript to send a test email and view its confirmation.</p></noscript>
    <p id="test-digest-status" class="engagement-feedback" role="status" aria-live="polite" aria-atomic="true"></p>
    <div class="engagement-history-heading"><h3>Recent tests</h3><Button type="button" id="refresh-test-history" size="sm" variant="outline">Refresh status</Button></div>
    <div id="test-history">{tests.length ? tests.map(m=><article class="engagement-receipt"><strong>{m.status}</strong><time>{date(m.createdAt)} Melbourne</time><details><summary>Provider receipt</summary><dl><dt>Message ID</dt><dd>{m.providerId || 'Not accepted'}</dd><dt>Provider HTTP status</dt><dd>{m.providerHttpStatus ?? 'Not recorded'}</dd><dt>Accepted</dt><dd>{date(m.acceptedAt)}</dd><dt>Delivered</dt><dd>{date(m.deliveredAt)}</dd></dl></details></article>) : <p class="engagement-empty">{report ? 'No test emails recorded for your account.' : 'History unavailable. Use Refresh status to retry.'}</p>}</div>
    <p class="engagement-caption">Sample data only. Tests are limited to one per calendar minute per administrator and excluded from member statistics.</p>
   </section>
   <section class="engagement-card" aria-labelledby="historical-heading">
    <header><h2 id="historical-heading">Historical re-engagement</h2><p>Check who may qualify for a future participation reminder.</p></header>
    <form id="reengagement-preview-form" class="engagement-preview"><label for="reengagement-cutoff">Verified on or before</label><input type="date" id="reengagement-cutoff" name="cutoff" required max={new Date().toISOString().slice(0,10)} /><Button type="submit" variant="outline">Preview eligibility</Button></form>
    <p id="reengagement-status" class="engagement-feedback" role="status" aria-live="polite"></p>
    <div id="reengagement-results"><p class="engagement-empty">Choose a cutoff date to see eligible, excluded, suppressed and review counts.</p></div>
    <p class="engagement-caption">Read-only preview. This action never sends messages or changes member preferences.</p>
   </section>
  </div>
  <details class="engagement-card engagement-diagnostics"><summary>Delivery diagnostics</summary><div>
   <dl class="engagement-metrics"><div><dt>Email provider configuration</dt><dd>{env.RESEND_API_KEY && env.AUTH_EMAIL_FROM && env.ENGAGE_EMAIL_SECRET ? 'Present · acceptance still needs a test' : 'Incomplete'}</dd></div><div><dt>Signed delivery webhook</dt><dd>{env.RESEND_WEBHOOK_SECRET ? 'Secret present · receipt not yet verified' : 'Not configured'}</dd></div><div><dt>Suppressed accounts</dt><dd>{report?.suppressed ?? 'Unavailable'}</dd></div></dl>
   <p>Verify the sender address and its domain in Resend. Configuration being present does not prove the credentials or domain are valid.</p><p>Delivery receipts require the signed provider webhook. Without a receipt, accepted messages remain pending. The latest five tests for your account are shown above; message IDs can be inspected in Resend.</p><p>Timeouts and uncertain outcomes are held for inspection and are not retried automatically. Explicit provider rejection is recorded as failed. Check the provider before retrying a held message.</p><p>Bounces and spam complaints suppress further reminders. Unsubscribing affects Engage digests only. Tests do not add subscribers or enable scheduled delivery.</p>
  </div></details>
 </div>
</AdminLayout>
<script>
 import '../../scripts/admin-engagement.ts';
</script>
