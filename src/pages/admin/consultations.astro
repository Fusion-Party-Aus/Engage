---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ModerationQueue from '../../components/admin/ModerationQueue.astro';
import { adminPageContext } from '../../lib/platform/admin-access';
import { platformEnv } from '../../lib/platform/http';
import type { ConsultationRoundRecord } from '../../lib/platform/types';
import type { PolicyRevisionRecord } from '../../lib/platform/catalogue';
export const prerender = false;
const context = await adminPageContext(Astro.request, platformEnv(Astro.locals));
if (context instanceof Response) return context;
Astro.response.headers.set('Cache-Control', 'private, no-store');
let rounds: Array<ConsultationRoundRecord & { syntheticFixture?: boolean }> = []; let revisions: PolicyRevisionRecord[] = []; let error = false;
try {
  [rounds, revisions] = await Promise.all([
    context.db.collection<(typeof rounds)[number]>('consultation_rounds').find({}, { projection: { _id: 0, roundId: 1, program: 1, label: 1, status: 1, opensAt: 1, closesAt: 1, policyIds: 1, syntheticFixture: 1 } }).sort({ opensAt: -1 }).toArray(),
    context.db.collection<PolicyRevisionRecord>('policy_revisions').find({}, { projection: { _id: 0, policyId: 1, title: 1 } }).sort({ createdAt: 1 }).toArray(),
  ]);
} catch { error = true; Astro.response.status = 503; }
const policies = [...new Map(revisions.map(revision => [revision.policyId, { id: revision.policyId, title: revision.title }])).values()];
const selectedRound = rounds.find(round => round.roundId === Astro.url.searchParams.get('roundId'));
---
<AdminLayout title="Consultations" description="Keep member feedback and moderation in context. Manage participation windows separately from decisions." area="Consultations" administrator={context.administrator}>
  {error ? <p class="admin-error">Consultation records could not be loaded. Please reload to retry.</p> : <>
    <ModerationQueue policies={policies} rounds={rounds} roundId={selectedRound?.roundId} />
    <section id="round-schedule"><h2>Consultation rounds</h2><p class="admin-meta">Recorded dates below use UTC. Scheduling inputs use your device timezone. Only draft rounds can be rescheduled.</p>
      {!rounds.length && <p class="admin-empty">No consultation rounds yet.</p>}
      {rounds.map(round => <article class="admin-card" id={round.roundId}><h3>{round.program ?? round.label ?? 'Untitled consultation'}</h3><p>{round.status} · {round.policyIds?.length ?? 0} policies · {round.syntheticFixture ? 'Synthetic fixture' : 'Policy consultation'}</p><p class="admin-meta">{round.opensAt.toISOString()} → {round.closesAt.toISOString()}</p>
        <ul>{policies.filter(policy => round.policyIds?.includes(policy.id)).map(policy => <li><a href={`/admin/policies/${encodeURIComponent(policy.id)}/#feedback`}>{policy.title}</a></li>)}</ul>
        {round.status === 'draft' && <details><summary>Edit draft window</summary><form method="post" data-admin-api={`/api/admin/consultation-rounds/${encodeURIComponent(round.roundId)}`} data-method="PATCH"><div class="admin-grid"><label class="field"><span>Opens</span><input name="opensAt" type="datetime-local" data-utc={round.opensAt.toISOString()} required /></label><label class="field"><span>Closes</span><input name="closesAt" type="datetime-local" data-utc={round.closesAt.toISOString()} required /></label></div><button class="button button--outline" type="submit">Save draft window</button><p role="status" aria-live="polite"></p></form></details>}
        {(context.env.APP_MODE === 'preview' || (context.administrator && !round.syntheticFixture)) && round.status !== 'closed' && <form method="post" data-admin-api={`/api/admin/consultation-rounds/${encodeURIComponent(round.roundId)}`} data-method="PATCH"><input type="hidden" name="status" value={round.status === 'draft' ? 'open' : 'closed'} /><button class="button button--outline" type="submit">{round.status === 'draft' ? 'Open consultation' : 'Close consultation'}</button><p role="status" aria-live="polite"></p></form>}
      </article>)}
    </section>
    <details class="admin-card"><summary>Create a policy consultation</summary><p>Standalone organisational consultations are pending the later standalone delivery. Choose at least one policy for this existing consultation type.</p>
      <form method="post" data-admin-api="/api/admin/consultation-rounds"><input type="hidden" name="roundId" value={`consultation-${crypto.randomUUID()}`} /><label class="field"><span>Consultation title</span><input name="program" minlength="3" maxlength="200" required /></label>
        <label class="field"><span>Policies (select one or more)</span><select name="policyIds" multiple required size="8">{policies.map(policy => <option value={policy.id}>{policy.title}</option>)}</select></label>
        <div class="admin-grid"><label class="field"><span>Opens</span><input name="opensAt" type="datetime-local" required /></label><label class="field"><span>Closes</span><input name="closesAt" type="datetime-local" required /></label></div><button class="button" type="submit">Create draft consultation</button><p role="status" aria-live="polite"></p>
      </form>
    </details>
  </>}
</AdminLayout>
<script>
  import { bindAdminForms } from '../../scripts/admin-forms';
  bindAdminForms();
  for (const input of document.querySelectorAll<HTMLInputElement>('input[data-utc]')) { const date = new Date(input.dataset.utc!); input.value = new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 16); }
</script>
