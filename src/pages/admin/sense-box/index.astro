---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ArrowRight, LifeBuoy } from 'lucide-react';
import { getSessionUser } from '../../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../../lib/db.ts';
import { listSense, senseDestinations } from '../../../lib/sense-box.ts';
import { SENSE_TOPICS, SENSE_STATUSES } from '../../../lib/sense-box-options.ts';
import { Badge } from '../../../components/ui/badge';
import { Button } from '../../../components/ui/button';
import { NativeSelect } from '../../../components/ui/native-select';
import Card from '../../../components/admin/Card.astro';
import CardContent from '../../../components/admin/CardContent.astro';
import CardDescription from '../../../components/admin/CardDescription.astro';
import CardHeader from '../../../components/admin/CardHeader.astro';
import CardTitle from '../../../components/admin/CardTitle.astro';
import Field from '../../../components/admin/Field.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const user = await getSessionUser(Astro.request, env);
if (!user) return Astro.redirect('/member/');
if (!user.isAdmin && !user.branchAdminIds?.length) return Astro.rewrite('/403/');

const db = await getDatabase(env);
const inbox = await listSense(db, user, Object.fromEntries(Astro.url.searchParams));
const destinations = await senseDestinations(db);
const branches = user.isAdmin ? destinations : destinations.filter((branch) => user.branchAdminIds?.includes(branch.branchId));

const pageHref = (page: number) => {
  const params = new URLSearchParams(Object.fromEntries(Astro.url.searchParams));
  params.set('page', String(page));
  return `?${params.toString()}`;
};

const statusTone = (status: string) =>
  status === 'developing' ? 'warning' : status === 'reviewed' ? 'info' : status === 'archived' ? 'outline' : 'muted';
---
<AdminLayout
  title="Sense Box"
  description="Review community priorities and explore ideas for proposals."
  section="sense-box"
  isAdmin={user.isAdmin}
  isBranchAdmin={Boolean(user.isBranchAdmin)}
>
  <div class="admin-stack">
    <Card class="gap-0">
      <CardHeader>
        <CardTitle class="text-base">Community priorities</CardTitle>
        <CardDescription>Filter the inbox by branch, topic or review status.</CardDescription>
      </CardHeader>
      <CardContent>
        <form class="flex flex-wrap items-end gap-4" method="get">
          <Field label="Branch" htmlFor="sense-branch" class="min-w-52">
            <NativeSelect id="sense-branch" name="branchId" defaultValue={Astro.url.searchParams.get('branchId') ?? ''}>
              <option value="" selected={!Astro.url.searchParams.get('branchId')}>All your branches</option>
              {branches.map((branch) => (
                <option value={branch.branchId} selected={Astro.url.searchParams.get('branchId') === branch.branchId}>{branch.name}</option>
              ))}
            </NativeSelect>
          </Field>
          <Field label="Topic" htmlFor="sense-topic" class="min-w-52">
            <NativeSelect id="sense-topic" name="topic" defaultValue={Astro.url.searchParams.get('topic') ?? ''}>
              <option value="" selected={!Astro.url.searchParams.get('topic')}>All topics</option>
              {Object.entries(SENSE_TOPICS).map(([key, label]) => (
                <option value={key} selected={Astro.url.searchParams.get('topic') === key}>{label} ({inbox.topics[key] || 0})</option>
              ))}
            </NativeSelect>
          </Field>
          <Field label="Status" htmlFor="sense-status" class="min-w-44">
            <NativeSelect id="sense-status" name="status" defaultValue={Astro.url.searchParams.get('status') ?? ''}>
              <option value="" selected={!Astro.url.searchParams.get('status')}>All statuses</option>
              {Object.entries(SENSE_STATUSES).map(([key, label]) => (
                <option value={key} selected={Astro.url.searchParams.get('status') === key}>{label}</option>
              ))}
            </NativeSelect>
          </Field>
          <Button type="submit" size="sm">Filter</Button>
        </form>
      </CardContent>
    </Card>

    <p class="text-sm text-muted-foreground m-0">{inbox.total} {inbox.total === 1 ? 'submission' : 'submissions'}</p>

    {inbox.items.length ? (
      <Card class="gap-0">
        <CardHeader class="border-b pb-4">
          <CardTitle class="text-base">Inbox</CardTitle>
          <CardDescription>Review each priority, then record how it is being handled.</CardDescription>
        </CardHeader>
        <CardContent class="p-0">
          <ul class="divide-y m-0 list-none p-0">
            {inbox.items.map((item) => (
              <li class="grid gap-3 px-5 py-5">
                <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
                  <span>{branches.find((branch) => branch.branchId === item.branchId)?.name}</span>
                  <span aria-hidden="true">·</span>
                  <span>{item.locality}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={new Date(item.createdAt).toISOString()}>{new Date(item.createdAt).toLocaleDateString('en-AU')}</time>
                  <Badge variant="outline">{SENSE_TOPICS[item.topic]}</Badge>
                  <Badge variant={statusTone(item.status)}>{SENSE_STATUSES[item.status]}</Badge>
                </div>
                <div>
                  <h2 class="text-xl m-0">{item.title}</h2>
                  <p class="mt-1 mb-0 whitespace-pre-wrap break-words">{item.detail}</p>
                </div>
                <form data-review data-id={item.submissionId} data-branch={item.branchId} data-version={item.version} class="flex flex-wrap items-end gap-3">
                  <Field label="Status" htmlFor={`sense-item-status-${item.submissionId}`}>
                    <NativeSelect id={`sense-item-status-${item.submissionId}`} name="status" defaultValue={item.status} size="sm">
                      {Object.entries(SENSE_STATUSES).map(([key, label]) => (
                        <option value={key} selected={item.status === key}>{label}</option>
                      ))}
                    </NativeSelect>
                  </Field>
                  <Button type="submit" size="sm" variant="outline">Save status</Button>
                  <span role="status" class="text-sm text-muted-foreground" aria-live="polite"></span>
                </form>
              </li>
            ))}
          </ul>
        </CardContent>
      </Card>
    ) : (
      <Card>
        <CardContent class="flex items-start gap-3 p-5">
          <LifeBuoy className="mt-0.5" aria-hidden="true" />
          <div>
            <strong class="block text-foreground">No submissions match these filters</strong>
            <p class="mt-1 mb-0 text-sm text-muted-foreground">Clear a filter to review the rest of the inbox.</p>
          </div>
        </CardContent>
      </Card>
    )}

    <nav class="flex flex-wrap items-center gap-3" aria-label="Inbox pages">
      {inbox.page > 1 && <Button href={pageHref(inbox.page - 1)} variant="outline" size="sm">Previous</Button>}
      {inbox.page * 30 < inbox.total && <Button href={pageHref(inbox.page + 1)} variant="outline" size="sm">Next</Button>}
    </nav>

    <div>
      <Button href="/proposals/new/" variant="outline" size="sm">Develop a formal proposal<ArrowRight /></Button>
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-review]').forEach((form) => form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button')!;
    const message = form.querySelector('[role=status]')!;
    button.disabled = true;
    message.textContent = 'Saving…';
    try {
      const response = await fetch('/api/sense-box', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          submissionId: form.dataset.id,
          branchId: form.dataset.branch,
          version: Number(form.dataset.version),
          status: new FormData(form).get('status'),
        }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      form.dataset.version = String(Number(form.dataset.version) + 1);
      message.textContent = 'Saved';
    } catch (error) {
      message.textContent = error instanceof Error ? error.message : 'Could not save. Try again.';
    } finally {
      button.disabled = false;
    }
  }));
</script>
