---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { Button } from '../../../../components/ui/button';
import Card from '../../../../components/admin/Card.astro';
import CardContent from '../../../../components/admin/CardContent.astro';
import CardDescription from '../../../../components/admin/CardDescription.astro';
import CardHeader from '../../../../components/admin/CardHeader.astro';
import CardTitle from '../../../../components/admin/CardTitle.astro';
import InitiativeEditor from '../../../../components/collaboration/InitiativeEditor';
import { getSessionUser } from '../../../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../../../lib/db.ts';
import { getInitiative } from '../../../../lib/collaboration.ts';
import { isPublicInitiativeStatus } from '../../../../lib/collaboration-options.ts';
import { hasPermission } from '../../../../lib/rbac.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const user = await getSessionUser(Astro.request, env);
if (!user) return Astro.redirect('/member/');
if (!hasPermission(user, 'collaboration.manage')) return Astro.rewrite('/403/');

const db = await getDatabase(env);
const initiative = await getInitiative(db, String(Astro.params.slug ?? ''));
if (!initiative) Astro.response.status = 404;
---

<AdminLayout
  title={initiative ? initiative.title : 'Invitation'}
  description="Edit the public invitation, its questions and whether it is accepting contributions."
  section="stories"
  isAdmin={user.isAdmin}
  isBranchAdmin={Boolean(user.isBranchAdmin)}
>
  <div class="admin-stack">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="m-0 text-sm text-muted-foreground">/collaborate/{initiative?.slug ?? ''}/</p>
      <div class="flex flex-wrap gap-2">
        <Button href="/admin/collaboration/invitation/" size="sm" variant="outline">All invitations</Button>
        {initiative && isPublicInitiativeStatus(initiative.status) && (
          <Button href={`/collaborate/${initiative.slug}/`} size="sm" variant="outline">View public page</Button>
        )}
      </div>
    </div>

    {initiative ? (
      <Card>
        <CardHeader>
          <CardTitle class="text-base">Invitation</CardTitle>
          <CardDescription>
            Changes apply to the public page straight away. Existing contributions keep the questions they answered.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <InitiativeEditor
            client:load
            slug={initiative.slug}
            title={initiative.title}
            summary={initiative.summary}
            purpose={initiative.purpose}
            status={initiative.status}
            correctionEmail={initiative.correctionEmail}
            questions={initiative.questions}
            profile={initiative.profile}
          />
        </CardContent>
      </Card>
    ) : (
      <Card>
        <CardHeader>
          <CardTitle class="text-base">No invitation found</CardTitle>
          <CardDescription>No invitation exists with that address.</CardDescription>
        </CardHeader>
      </Card>
    )}
  </div>
</AdminLayout>
