---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals } from '../../lib/store.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const user = await getSessionUser(Astro.request, env);

if (!user) {
  return Astro.redirect('/member/', 302);
}
if (!user.isStaff) {
  Astro.response.status = 403;
}

const db = await getDatabase(env);
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const stageFilter = (Astro.url.searchParams.get('stage') ?? 'all').trim();
const editId = (Astro.url.searchParams.get('edit') ?? '').trim();

const allProposals = user.isStaff
  ? await listProposals(db, {
      includeArchived: true,
      search: query,
      stage: stageFilter,
    })
  : [];

const editingProposal = editId ? allProposals.find((p) => p.proposalId === editId) : null;
const spaces = [...new Set(allProposals.map((p) => p.space))].sort();

const stageOptions: Array<[ProposalStage, string]> = [
  ['propose', '1. Propose (Intake)'],
  ['deliberate', '2. Deliberate (Discussion)'],
  ['decide', '3. Decide (Voting)'],
  ['implement', '4. Implement (Adoption)'],
  ['archived', 'Archived'],
];
---
<AdminLayout
  title="Proposals & Decision Management"
  description="Manage party proposals, lifecycle stages, deliberation moderation, and implementation notes."
  section="policies"
  isAdmin={user.isAdmin}
>
  {!user.isStaff ? (
    <div class="admin-surface">
      <p>Moderator or Administrator access is required to view this workspace.</p>
    </div>
  ) : (
    <>
      <section id="create-policy" class="admin-surface" aria-labelledby="editor-heading">
        <div class="editor-head">
          <h2 id="editor-heading">
            {editingProposal
              ? `Edit ${editingProposal.proposalId}: ${editingProposal.title}`
              : 'Create a new proposal or resolution'}
          </h2>
          {editingProposal && (
            <a class="button button--outline" href="/admin/">
              Cancel editing
            </a>
          )}
        </div>

        <form id="proposal-editor-form" data-editing-id={editingProposal?.proposalId ?? ''}>
          <div class="admin-grid">
            <label class="field">
              <span>Lifecycle Stage</span>
              <select name="stage">
                {stageOptions.map(([val, label]) => (
                  <option
                    value={val}
                    selected={
                      editingProposal
                        ? editingProposal.stage === val
                        : val === 'deliberate'
                    }
                  >
                    {label}
                  </option>
                ))}
              </select>
            </label>

            <label class="field">
              <span>Space / Topic</span>
              <input
                name="space"
                list="space-options"
                required
                minlength="2"
                maxlength="100"
                value={editingProposal?.space ?? 'General'}
                placeholder="e.g. Governance, Economy, Climate, Digital Rights"
              />
              <datalist id="space-options">
                {spaces.map((sp) => (
                  <option value={sp} />
                ))}
              </datalist>
            </label>
          </div>

          <label class="field">
            <span>Title</span>
            <input
              name="title"
              required
              minlength="4"
              maxlength="200"
              value={editingProposal?.title ?? ''}
              placeholder="e.g. Adopt Horizon visual identity, or Universal Dental in Medicare"
            />
          </label>

          <label class="field">
            <span>Core Statement / Summary</span>
            <textarea
              name="summary"
              required
              minlength="10"
              maxlength="2000"
              rows="3"
            >{editingProposal?.summary ?? ''}</textarea>
          </label>

          <label class="field">
            <span>Key Commitments / Outcomes (one per line)</span>
            <textarea
              name="outcomes"
              rows="3"
            >{(editingProposal?.outcomes ?? []).join('\n')}</textarea>
          </label>

          <label class="field">
            <span>Detailed Background, Rationale &amp; Text</span>
            <textarea
              name="details"
              rows="6"
            >{editingProposal?.details ?? ''}</textarea>
          </label>

          <div class="admin-grid">
            <label class="field">
              <span>Attachment / Image URL (optional)</span>
              <input
                name="attachmentUrl"
                value={editingProposal?.attachmentUrl ?? ''}
                placeholder="e.g. /fusion_horizon_logo_light.svg or https://..."
              />
            </label>

            <label class="field">
              <span>Implementation Note (for Stage 4)</span>
              <input
                name="implementationNote"
                value={editingProposal?.implementationNote ?? ''}
                placeholder="e.g. Adopted at 2026 AGM; logo files released in brand pack."
              />
            </label>
          </div>

          <!-- Policy Provenance & Prior Approval -->
          <details class="admin-details" open={Boolean(editingProposal?.provenance)}>
            <summary class="admin-details__summary">
              <strong>Policy Provenance &amp; Prior Approval</strong>
              <span class="admin-details__hint">
                {editingProposal?.provenance?.label || 'Configure predecessor links, review notes, and values alignment'}
              </span>
            </summary>

            <div class="admin-details__body">
              <div class="admin-grid">
                <label class="field">
                  <span>Provenance Classification</span>
                  <select name="provCategory" id="prov-category-select">
                    <option value="none" selected={!editingProposal?.provenance}>None (Clear Provenance)</option>
                    <option value="existing-repackaged" selected={editingProposal?.provenance?.category === 'existing-repackaged'}>
                      Approved policy predecessor · Equivalence unverified
                    </option>
                    <option value="materially-revised" selected={editingProposal?.provenance?.category === 'materially-revised'}>
                      Approved policy predecessor · Materially revised
                    </option>
                    <option value="new-proposal" selected={editingProposal?.provenance?.category === 'new-proposal'}>
                      New proposal · No prior policy identified
                    </option>
                    <option value="party-governance" selected={editingProposal?.provenance?.category === 'party-governance'}>
                      Party Governance · Internal platform review
                    </option>
                    <option value="draft-derived" selected={editingProposal?.provenance?.category === 'draft-derived'}>
                      Draft branch predecessor · Unapproved
                    </option>
                    <option value="unverified" selected={editingProposal?.provenance?.category === 'unverified'}>
                      Mapping unverified
                    </option>
                  </select>
                </label>

                <label class="field">
                  <span>Custom Badge Label (optional)</span>
                  <input
                    name="provLabel"
                    id="prov-label-input"
                    value={editingProposal?.provenance?.label ?? ''}
                    placeholder="Defaults based on classification"
                  />
                </label>
              </div>

              <label class="field">
                <span>Provenance Summary</span>
                <textarea
                  name="provSummary"
                  rows="2"
                  placeholder="e.g. Cites a direct predecessor on a published Fusion policy page..."
                >{editingProposal?.provenance?.summary ?? ''}</textarea>
              </label>

              <label class="field">
                <span>What is Still Uncertain / Scrutiny Notes</span>
                <input
                  name="provUncertainty"
                  value={editingProposal?.provenance?.uncertaintyNote ?? ''}
                  placeholder="e.g. Links only to a top-level published policy page URL without a clause-level text comparison."
                />
              </label>

              <label class="field">
                <span>Prior Policy Predecessors (format: Title | URL | Description)</span>
                <textarea
                  name="provLineage"
                  rows="3"
                  placeholder="Fair + Inclusive Society | https://www.fusionparty.org.au/fair_inclusive_society | Direct predecessor: replacing stamp duty with land tax"
                >{(editingProposal?.provenance?.lineage ?? []).map((l) => [l.label, l.url, l.description].filter(Boolean).join(' | ')).join('\n')}</textarea>
              </label>

              <label class="field">
                <span>Values &amp; Principles Alignment (one per line)</span>
                <textarea
                  name="provValues"
                  rows="2"
                  placeholder="Principle: Sustainable Urban Prosperity — Replacing transaction taxes with land-value taxation..."
                >{(editingProposal?.provenance?.valuesAlignment ?? []).join('\n')}</textarea>
              </label>
            </div>
          </details>

          <div class="editor-actions">
            <button class="button" type="submit">
              {editingProposal ? 'Save changes' : 'Create proposal'}
            </button>
            {editingProposal && user.isAdmin && (
              <button
                id="delete-proposal-btn"
                class="button button--danger"
                type="button"
                data-delete-id={editingProposal.proposalId}
              >
                Delete proposal
              </button>
            )}
            <p id="editor-status" class="form-status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </section>

      <!-- Filter Toolbar -->
      <form method="get" action="/admin/" class="admin-toolbar">
        <label class="field">
          <span>Search proposals</span>
          <input
            type="search"
            name="q"
            value={query}
            placeholder="Search by title, ID, or space"
          />
        </label>

        <label class="field" style="max-width: 16rem">
          <span>Stage</span>
          <select name="stage">
            <option value="all" selected={stageFilter === 'all'}>
              All stages ({allProposals.length})
            </option>
            {stageOptions.map(([val, label]) => (
              <option value={val} selected={stageFilter === val}>
                {label}
              </option>
            ))}
          </select>
        </label>

        <button class="button button--outline" type="submit">Filter</button>
      </form>

      <!-- Proposals List -->
      <section class="admin-register" aria-label="Proposals register">
        {allProposals.length === 0 ? (
          <p style="padding: 1.25rem 0; margin: 0">No items match this filter.</p>
        ) : (
          allProposals.map((item) => (
            <article class="admin-row">
              <div>
                <h3>
                  <a href={`/proposals/${item.slug}/`}>{item.title}</a>
                </h3>
                <p class="tabular">
                  <strong>{item.proposalId}</strong> · {item.space}
                  {item.provenance && (
                    <> · <span class="prov-tag">{item.provenance.label}</span></>
                  )} ·{' '}
                  <span class="tabular">
                    {item.votes.approve} approve / {item.votes.abstain} abstain / {item.votes.reject} reject
                  </span>{' '}
                  · {item.commentCount} stances
                </p>
              </div>

              <div class="admin-row-actions">
                <select
                  class="inline-stage-select"
                  aria-label={`Stage for ${item.title}`}
                  data-quick-proposal-id={item.proposalId}
                >
                  {stageOptions.map(([val, label]) => (
                    <option value={val} selected={item.stage === val}>
                      {label}
                    </option>
                  ))}
                </select>
                <a class="button button--outline" href={`/admin/?edit=${encodeURIComponent(item.proposalId)}#create-policy`}>
                  Edit
                </a>
                <a class="button button--outline" href={`/proposals/${item.slug}/`}>
                  View
                </a>
              </div>
            </article>
          ))
        )}
      </section>
    </>
  )}
</AdminLayout>

<script>
  const editorForm = document.querySelector<HTMLFormElement>('#proposal-editor-form');
  const editorStatus = document.querySelector<HTMLElement>('#editor-status');

  editorForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!editorForm.reportValidity()) return;
    const editingId = editorForm.dataset.editingId;
    const submitBtn = editorForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submitBtn.disabled = true;
    if (editorStatus) editorStatus.textContent = 'Saving…';

    try {
      const formData = new FormData(editorForm);
      const outcomesRaw = String(formData.get('outcomes') ?? '');
      const outcomes = outcomesRaw
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean);

      const provCategory = String(formData.get('provCategory') || '').trim();
      let provenance = undefined;
      if (provCategory && provCategory !== 'none') {
        const lineageRaw = String(formData.get('provLineage') || '');
        const lineage = lineageRaw
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const parts = line.split('|').map((p) => p.trim());
            return {
              label: parts[0] || '',
              url: parts[1] || null,
              description: parts[2] || '',
            };
          })
          .filter((l) => l.label);

        const valuesRaw = String(formData.get('provValues') || '');
        const valuesAlignment = valuesRaw
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean);

        provenance = {
          category: provCategory,
          label: String(formData.get('provLabel') || '').trim(),
          summary: String(formData.get('provSummary') || '').trim(),
          uncertaintyNote: String(formData.get('provUncertainty') || '').trim() || undefined,
          lineage,
          valuesAlignment,
        };
      } else if (provCategory === 'none') {
        provenance = null;
      }

      const data = {
        proposalId: editingId || undefined,
        title: formData.get('title'),
        space: formData.get('space'),
        stage: formData.get('stage'),
        summary: formData.get('summary'),
        details: formData.get('details'),
        outcomes,
        attachmentUrl: formData.get('attachmentUrl') || undefined,
        implementationNote: formData.get('implementationNote') || undefined,
        provenance,
      };

      const url = editingId ? `/api/proposals/${encodeURIComponent(editingId)}` : '/api/proposals';
      const method = editingId ? 'PATCH' : 'POST';
      const res = await fetch(url, {
        method,
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(payload.error || 'Could not save proposal.');
      location.href = `/proposals/${payload.proposal.slug}/`;
    } catch (err) {
      if (editorStatus) {
        editorStatus.textContent = err instanceof Error ? err.message : 'Could not save proposal.';
      }
      submitBtn.disabled = false;
    }
  });

  document.querySelector<HTMLButtonElement>('#delete-proposal-btn')?.addEventListener('click', async (event) => {
    const btn = event.currentTarget as HTMLButtonElement;
    const proposalId = btn.dataset.deleteId;
    if (!proposalId || !confirm(`Delete ${proposalId}? This cannot be undone.`)) return;
    btn.disabled = true;
    try {
      const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId)}`, {
        method: 'DELETE',
        credentials: 'same-origin',
      });
      if (!res.ok) throw new Error();
      location.href = '/admin/';
    } catch {
      btn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLSelectElement>('[data-quick-proposal-id]').forEach((select) => {
    select.addEventListener('change', async () => {
      const proposalId = select.dataset.quickProposalId;
      if (!proposalId) return;
      select.disabled = true;
      try {
        await fetch(`/api/proposals/${encodeURIComponent(proposalId)}`, {
          method: 'PATCH',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ stage: select.value }),
        });
      } finally {
        select.disabled = false;
      }
    });
  });
</script>

<style>
  .editor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .editor-head h2 {
    margin: 0;
    font-family: Outfit, sans-serif;
    font-size: 1.3rem;
  }
  .editor-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .inline-stage-select {
    min-height: 2.65rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid #8a7b99;
    border-radius: 0.45rem;
    background: var(--horizon-white);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .admin-details {
    background: var(--horizon-lavender-soft);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    margin-top: 1rem;
    overflow: hidden;
  }

  .admin-details__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    cursor: pointer;
    background: var(--horizon-lavender);
    font-size: 0.95rem;
    color: var(--horizon-purple-deep);
  }

  .admin-details__hint {
    font-size: 0.82rem;
    color: var(--horizon-muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .admin-details__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid var(--horizon-line);
  }

  .prov-tag {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    background: var(--horizon-lavender);
    border: 1px solid var(--horizon-line);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--horizon-purple-deep);
    font-weight: 600;
  }
</style>
