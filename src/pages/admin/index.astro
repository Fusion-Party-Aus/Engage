---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminPageContext } from '../../lib/platform/admin-access';
import { platformEnv } from '../../lib/platform/http';
export const prerender = false;
const context = await adminPageContext(Astro.request, platformEnv(Astro.locals));
if (context instanceof Response) return context;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<AdminLayout title="Work requiring attention" description="Review contributions, prepare decisions and follow up incomplete outcomes. This queue reflects existing records; viewing it does not change them." area="Work" administrator={context.administrator}>
  <p id="work-status" role="status" aria-live="polite">Loading work items…</p>
  <button class="button button--outline" id="retry-work" hidden>Retry loading work</button>
  <div id="work-items" class="admin-grid" aria-busy="true"></div>
  {context.administrator && <p class="admin-empty">Membership verification, operational health and audit are in <a href="/admin/administration/">Administration</a>.</p>}
</AdminLayout>
<script>
  const container = document.querySelector<HTMLElement>('#work-items')!;
  const status = document.querySelector<HTMLElement>('#work-status')!;
  const retry = document.querySelector<HTMLButtonElement>('#retry-work')!;
  async function loadWork() {
    retry.hidden = true; container.setAttribute('aria-busy', 'true'); status.textContent = 'Loading work items…';
    try {
      const response = await fetch('/api/admin/work');
      const data = await response.json();
      if (!response.ok) throw new Error(data.error ?? 'Work is unavailable.');
      container.replaceChildren();
      for (const [key, title, description] of [
        ['pending', 'Contributions awaiting moderation', 'Keep the policy context visible while reviewing member feedback.'],
        ['incomplete', 'Outcomes requiring follow-up', 'Closure has not finished. Inspect the decision before retrying finalisation.'],
        ['expired', 'Voting windows elapsed', 'Admission has ended. Inspect the decision and record its outcome.'],
        ['drafts', 'Decisions in preparation', 'Drafts need settled wording, a voting window and appropriate authorisation.'],
      ]) {
        const section = document.createElement('section'); section.className = 'admin-card';
        const heading = document.createElement('h2'); heading.textContent = title;
        const detail = document.createElement('p'); detail.textContent = description;
        const list = document.createElement('ul'); list.className = 'admin-list';
        const page = data[key];
        for (const item of page.items) {
          const row = document.createElement('li'); const link = document.createElement('a');
          link.href = key === 'pending' ? `/admin/policies/${encodeURIComponent(item.policyId)}/#feedback` : `/admin/decisions/#${encodeURIComponent(item.ballotId)}`;
          link.textContent = item.title || 'Member feedback awaiting review'; row.append(link); list.append(row);
        }
        section.append(heading, detail, list);
        const note = document.createElement('p'); note.className = 'admin-meta';
        note.textContent = !page.items.length ? 'Nothing requiring attention here.' : page.hasMore ? 'Showing the first 20 items. Open the relevant area for the full list.' : `${page.items.length} item${page.items.length === 1 ? '' : 's'}.`;
        section.append(note); container.append(section);
      }
      status.textContent = 'Work items loaded.';
    } catch (error) { status.textContent = error instanceof Error ? error.message : 'Could not load work. Please retry.'; retry.hidden = false; }
    finally { container.setAttribute('aria-busy', 'false'); }
  }
  retry.addEventListener('click', loadWork); await loadWork();
  // Deliberately preserve links into the former single-page dashboard.
  const legacy: Record<string, string> = { '#settle-revision-form': '/admin/policies/', '#new-policy-form': '/admin/policies/#new-policy-form', '#round-schedule': '/admin/consultations/', '#draft-ballot-list': '/admin/decisions/', '#audit-list': '/admin/administration/#audit-list', '#operations-panel': '/admin/administration/', '#review-queue': '/admin/consultations/#feedback' };
  if (legacy[location.hash]) location.replace(legacy[location.hash]);
</script>
