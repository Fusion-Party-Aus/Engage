---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewNotice from '../../components/PreviewNotice.astro';
import initialRound from '../../data/initial-round.json';
---
<SiteLayout title="Moderation workspace · Fusion" description="Review synthetic policy consultation submissions." noIndex>
  <PreviewNotice slot="notice" />
  <div class="page-wrap admin-page"><header class="page-intro"><p class="eyebrow">Moderator workspace · Preview</p><h1>Review feedback.</h1><p>Only test submissions appear here. Reviews change the preview queue; they do not set policy or voting outcomes.</p></header>
    <section id="operations-panel" class="operations-panel" data-round-opens={initialRound.openingInclusiveUtc} data-round-closes={initialRound.closingExclusiveUtc} hidden><div class="operations-heading"><div><p class="eyebrow">Platform status</p><h2>Draft schedule and system health</h2></div><span class="preview-only">Preview only · voting disabled</span></div><div id="health-summary" class="health-summary">Loading system status…</div>
      <form id="round-schedule" class="schedule-form"><h3>Consultation schedule · Draft</h3><p>Times use your local timezone. The server saves them in UTC.</p><div class="schedule-fields"><label class="field"><span>Opens</span><input name="opensAt" type="datetime-local" required /></label><label class="field"><span>Closes</span><input name="closesAt" type="datetime-local" required /></label></div><button class="button" type="submit">Save draft schedule</button><p id="schedule-status" class="form-status" role="status" aria-live="polite"></p></form>
      <div class="draft-ballot-admin"><h3>Draft policy ballots</h3><p>Changes here do not open a binding vote.</p><div id="draft-ballot-list"><p>Loading draft ballots…</p></div></div>
      <div class="audit-panel"><h3>Recent system activity</h3><p>Vote choices are not shown here.</p><div id="audit-list">Loading activity…</div></div>
    </section>
    <div class="admin-toolbar"><label class="field"><span>Show submissions</span><select id="queue-status"><option value="pending">Awaiting review</option><option value="accepted">Accepted</option><option value="needs-changes">Changes requested</option><option value="declined">Declined</option></select></label><p id="queue-status-message" class="form-status" role="status" aria-live="polite"></p></div><div id="review-queue" class="review-queue"><p>Loading submissions…</p></div>
  </div>
</SiteLayout>
<script>
  const queue=document.querySelector<HTMLElement>('#review-queue');const status=document.querySelector<HTMLElement>('#queue-status-message');const selector=document.querySelector<HTMLSelectElement>('#queue-status');
  async function loadQueue(){if(!queue||!selector)return;queue.innerHTML='<p>Loading review queue…</p>';const response=await fetch(`/api/admin/consultations?status=${encodeURIComponent(selector.value)}`);const data=await response.json().catch(()=>({}));if(!response.ok){queue.innerHTML=`<p class="empty-state">${data.error??'The review queue is unavailable.'} <a href="/member/">Sign in as a synthetic moderator</a></p>`;return;}queue.replaceChildren();const rows=data.submissions??[];if(!rows.length){const p=document.createElement('p');p.className='empty-state';p.textContent='There are no submissions in this queue.';queue.append(p);return;}for(const item of rows){const article=document.createElement('article');article.className='review-item';const h=document.createElement('h2');h.textContent=item.title||`Policy feedback · ${item.kind}`;const label=document.createElement('p');label.className='review-meta';label.textContent=`${item.policyId} · ${item.kind} · ${new Date(item.createdAt).toLocaleString()} · ${item.synthetic?'Synthetic preview':'Member submission'}`;const body=document.createElement('p');body.className='review-body';body.textContent=item.body;article.append(h,label,body);if(item.status==='pending'){const response=document.createElement('textarea');response.placeholder='Optional response for the submitter';response.setAttribute('aria-label','Optional moderator response');const actions=document.createElement('div');actions.className='review-actions';for(const [state,text] of [['accepted','Accept'],['needs-changes','Request changes'],['declined','Decline']]){const button=document.createElement('button');button.className=state==='accepted'?'button':'button button--outline';button.textContent=text;button.addEventListener('click',async()=>{button.disabled=true;const result=await fetch(`/api/admin/consultations/${encodeURIComponent(item.submissionId)}/review`,{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({status:state,moderatorResponse:response.value})});const payload=await result.json().catch(()=>({}));if(!result.ok){if(status)status.textContent=payload.error??'Could not save this review.';button.disabled=false;return;}if(status)status.textContent='Review saved.';await loadQueue();});actions.append(button);}article.append(response,actions);}else if(item.moderatorResponse){const note=document.createElement('p');note.textContent=`Moderator response: ${item.moderatorResponse}`;article.append(note);}queue.append(article);}}
  async function loadOperations(){
    const panel=document.querySelector<HTMLElement>('#operations-panel');
    const session=await fetch('/api/session').then(r=>r.json()).catch(()=>null);
    if(!session?.identity?.roles?.includes('administrator')||!panel)return;
    panel.hidden=false;
    const summary=document.querySelector<HTMLElement>('#health-summary');
    const localValue=(iso:string)=>{const date=new Date(iso);return new Date(date.getTime()-date.getTimezoneOffset()*60000).toISOString().slice(0,16)};
    const roundForm=document.querySelector<HTMLFormElement>('#round-schedule');
    if(roundForm){(roundForm.elements.namedItem('opensAt') as HTMLInputElement).value=localValue(panel.dataset.roundOpens!);(roundForm.elements.namedItem('closesAt') as HTMLInputElement).value=localValue(panel.dataset.roundCloses!);roundForm.addEventListener('submit',async event=>{event.preventDefault();if(!roundForm.reportValidity())return;const opensAt=new Date((roundForm.elements.namedItem('opensAt') as HTMLInputElement).value).toISOString();const closesAt=new Date((roundForm.elements.namedItem('closesAt') as HTMLInputElement).value).toISOString();const response=await fetch('/api/admin/consultation-rounds/first-priority-policy-round-2026',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({opensAt,closesAt})});const result=await response.json().catch(()=>({}));const out=document.querySelector<HTMLElement>('#schedule-status');if(out)out.textContent=response.ok?'Draft consultation schedule saved.':(result.error??'Could not save the schedule.');});}
    const [healthResponse,ballotResponse,auditResponse]=await Promise.all([fetch('/api/admin/health'),fetch('/api/ballots'),fetch('/api/admin/audit?limit=25')]);
    const health=await healthResponse.json().catch(()=>({}));const ballotData=await ballotResponse.json().catch(()=>({}));const audit=await auditResponse.json().catch(()=>({}));
    if(summary){summary.replaceChildren();if(!healthResponse.ok){summary.textContent=health.error??'Health data unavailable.'}else{const values=[['Ballots by status',health.counts?.ballotStatus],['Consultations by status',health.counts?.submissionStatus],['Current formal selections',health.counts?.currentFormalVotes],['Synthetic simulation selections',health.counts?.syntheticSimulationVotes],['Audit events',health.counts?.auditEvents]];for(const [label,value] of values){const item=document.createElement('p');const b=document.createElement('strong');b.textContent=label;const span=document.createElement('span');span.textContent=typeof value==='object'?Object.entries(value??{}).map(([key,count])=>`${key}: ${count}`).join(' · '):String(value??'0');item.append(b,span);summary.append(item);}}}
    const ballots=document.querySelector<HTMLElement>('#draft-ballot-list');if(ballots){ballots.replaceChildren();const drafts=(ballotData.ballots??[]).filter((ballot:any)=>ballot.mode==='formal'&&ballot.status==='draft');if(!drafts.length){ballots.textContent='No formal draft ballots are loaded.';}for(const ballot of drafts){const form=document.createElement('form');form.className='draft-ballot-row';const title=document.createElement('h4');title.textContent=ballot.title;const version=document.createElement('p');version.textContent=`Pinned policy version: ${ballot.policyRevisionId}`;const opens=document.createElement('label');opens.className='field';opens.textContent='Opens';const openInput=document.createElement('input');openInput.name='opensAt';openInput.type='datetime-local';openInput.required=true;openInput.value=localValue(ballot.opensAt);opens.append(openInput);const closes=document.createElement('label');closes.className='field';closes.textContent='Closes';const closeInput=document.createElement('input');closeInput.name='closesAt';closeInput.type='datetime-local';closeInput.required=true;closeInput.value=localValue(ballot.closesAt);closes.append(closeInput);const priorityLabel=document.createElement('label');priorityLabel.className='field';priorityLabel.textContent='Priority';const priority=document.createElement('input');priority.type='number';priority.name='priority';priority.min='0';priority.max='999';priority.step='1';priority.value=String(ballot.priority??0);priorityLabel.append(priority);const save=document.createElement('button');save.className='button button--outline';save.type='submit';save.textContent='Save draft';const result=document.createElement('span');result.className='form-status';result.setAttribute('role','status');form.append(title,version,opens,closes,priorityLabel,save,result);form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;save.disabled=true;const response=await fetch(`/api/admin/ballots/${encodeURIComponent(ballot.ballotId)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({opensAt:new Date(openInput.value).toISOString(),closesAt:new Date(closeInput.value).toISOString(),priority:Number(priority.value)})});const data=await response.json().catch(()=>({}));result.textContent=response.ok?'Draft ballot updated.':(data.error??'Could not update ballot.');save.disabled=false;});ballots.append(form);}}
    const auditList=document.querySelector<HTMLElement>('#audit-list');if(auditList){auditList.replaceChildren();if(!auditResponse.ok){auditList.textContent=audit.error??'Audit records unavailable.'}else if(!(audit.events??[]).length){auditList.textContent='No operational events recorded.'}else for(const event of audit.events){const row=document.createElement('p');row.textContent=`${new Date(event.createdAt).toLocaleString()} · ${event.action} · ${event.targetType??''} ${event.targetId??''} · ${event.status??''}`;auditList.append(row);}}
  }
  selector?.addEventListener('change',loadQueue);await loadQueue();await loadOperations();
</script>
<style>
  .admin-page{max-width:75rem;padding-bottom:5rem}.admin-toolbar{display:flex;align-items:end;gap:1rem}.admin-toolbar .field{min-width:15rem}.review-queue{display:grid;gap:1rem}.review-item{padding:1.4rem;border:1px solid #ded6e7;border-radius:.8rem}.review-item h2{margin:.1rem 0;font-size:1.5rem}.review-meta{color:#625171;font-size:.82rem}.review-body{white-space:pre-wrap;line-height:1.65}.review-item textarea{width:100%;min-height:5rem;padding:.7rem;border:1px solid #776b80;border-radius:.4rem}.review-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1rem}.empty-state{padding:1.4rem;background:#f2eef9;border-radius:.7rem}.operations-panel{margin-bottom:3rem;padding:1.5rem;background:#f2eef9;border-radius:.85rem}.operations-panel[hidden]{display:none}.operations-heading{display:flex;justify-content:space-between;gap:1rem;align-items:center}.operations-heading h2{margin:.1rem 0 1rem;font-size:1.7rem}.preview-only{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.health-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.health-summary p{display:grid;gap:.3rem;margin:0;padding:.85rem;background:white;border-radius:.55rem}.health-summary span{color:#54465f;font-size:.9rem}.schedule-form,.draft-ballot-admin,.audit-panel{margin-top:1.7rem;padding-top:1.4rem;border-top:1px solid #d7cde2}.schedule-form h3,.draft-ballot-admin h3,.audit-panel h3{margin:.1rem 0 .5rem;font-size:1.3rem}.schedule-form>p,.draft-ballot-admin>p,.audit-panel>p{color:#54465f}.schedule-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.draft-ballot-list{display:grid;gap:.7rem}.draft-ballot-row{display:grid;grid-template-columns:1fr repeat(3,minmax(9rem,.5fr)) auto;align-items:end;gap:.7rem;padding:1rem;background:#fff;border-radius:.6rem}.draft-ballot-row h4{align-self:center;margin:0}.draft-ballot-row p{grid-column:1/-1;margin:0;color:#54465f;font-size:.85rem}.draft-ballot-row .field{margin:0}.draft-ballot-row .field input{min-height:2.7rem;padding:.45rem}.audit-panel>div{max-height:18rem;overflow:auto}.audit-panel>div p{padding:.55rem 0;margin:0;border-bottom:1px solid #ded6e7;font-size:.83rem;line-height:1.4}.review-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1rem}@media(max-width:850px){.health-summary{grid-template-columns:repeat(2,1fr)}.draft-ballot-row{grid-template-columns:1fr 1fr}.draft-ballot-row h4,.draft-ballot-row p{grid-column:1/-1}}@media(max-width:560px){.operations-heading{align-items:flex-start;flex-direction:column}.admin-toolbar{align-items:stretch;flex-direction:column}.health-summary,.schedule-fields{grid-template-columns:1fr}.draft-ballot-row{grid-template-columns:1fr}.draft-ballot-row h4,.draft-ballot-row p{grid-column:auto}.review-actions{flex-direction:column}.review-actions button{width:100%}}
</style>
