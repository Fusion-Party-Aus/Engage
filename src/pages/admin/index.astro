---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  ArrowRight,
  BookOpen,
  CheckCircle2,
  FileText,
  Gavel,
  GitBranch,
  Layers,
  MessageSquare,
  ShieldCheck,
  Users,
} from 'lucide-react';
import { canViewIdentifiableBallots, getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals } from '../../lib/store.ts';
import { groupParticipationFeed, type ParticipationActivity } from '../../lib/participation-feed.ts';
import { PROPOSAL_VOTES } from '../../lib/vote-storage.ts';
import { buildActivityTimeline, type ActivityTimelineEvent } from '../../lib/activity-timeline.ts';
import { buildBallotProgressRows, buildBranchSummaryRows } from '../../lib/admin-reporting.ts';
import ActivityTimeline from '../../components/blocks/timeline-3';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import Alert from '../../components/admin/Alert.astro';
import AlertTitle from '../../components/admin/AlertTitle.astro';
import AlertDescription from '../../components/admin/AlertDescription.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const user = await getSessionUser(Astro.request, env);
if (!user) return Astro.redirect('/member/', 302);
if (!user.isStaff && !user.isBranchAdmin) Astro.response.status = 403;

const db = await getDatabase(env);
const proposals = user.isStaff
  ? await listProposals(db, { includeArchived: true })
  : user.isBranchAdmin
    ? (await Promise.all((user.branchAdminIds ?? []).map((branch) => listProposals(db, { includeArchived: true, branch })))).flat()
    : [];

const stageCounts = {
  propose: proposals.filter((p) => p.stage === 'propose').length,
  deliberate: proposals.filter((p) => p.stage === 'deliberate').length,
  decide: proposals.filter((p) => p.stage === 'decide').length,
  implement: proposals.filter((p) => p.stage === 'implement').length,
};

const pipelineTotal = Math.max(proposals.length, 1);
const pipelineSegments = [
  { label: 'Intake', value: stageCounts.propose, color: '#b8a8d9', href: '/admin/proposals/?stage=propose' },
  { label: 'Deliberation', value: stageCounts.deliberate, color: '#7c5cb0', href: '/admin/proposals/?stage=deliberate' },
  { label: 'Active ballots', value: stageCounts.decide, color: '#05d4e5', href: '/admin/proposals/?stage=decide' },
  { label: 'Implement', value: stageCounts.implement, color: '#260b59', href: '/admin/proposals/?stage=implement' },
].map((segment) => ({ ...segment, percent: (segment.value / pipelineTotal) * 100 }));

const proposalMap = new Map(proposals.map((proposal) => [proposal.proposalId, proposal]));
const showIdentifiableBallots = canViewIdentifiableBallots(user);
const activityWindowStart = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const proposalScope = { proposalId: { $in: proposals.map((proposal) => proposal.proposalId) } };

const [recentVotes, recentComments] = await Promise.all([
  showIdentifiableBallots
    ? db.collection(PROPOSAL_VOTES).find({ ...proposalScope, ballotId: /^proposal:/, updatedAt: { $gte: activityWindowStart } }).sort({ updatedAt: -1 }).toArray()
    : Promise.resolve([]),
  db.collection('comments').find({ ...proposalScope, createdAt: { $gte: activityWindowStart } }).sort({ createdAt: -1 }).toArray(),
]);

const voteActivities: ParticipationActivity[] = recentVotes.flatMap((entry: any) => {
  const proposal = proposalMap.get(entry.proposalId);
  return proposal
    ? [{ id: String(entry._id), actorId: entry.memberId, actorName: entry.authorName || 'Member', kind: 'vote' as const, date: new Date(entry.updatedAt), proposalTitle: proposal.title, proposalSlug: proposal.slug }]
    : [];
});
const commentActivities: ParticipationActivity[] = recentComments.flatMap((entry: any) => {
  const proposal = proposalMap.get(entry.proposalId);
  return proposal
    ? [{ id: entry.commentId, actorId: entry.memberId, actorName: entry.authorName || 'Member', kind: 'contribution' as const, date: new Date(entry.createdAt), proposalTitle: proposal.title, proposalSlug: proposal.slug }]
    : [];
});
const proposalActivities: ParticipationActivity[] = proposals
  .filter((proposal) => proposal.authorId && new Date(proposal.createdAt).getTime() >= activityWindowStart.getTime())
  .map((proposal) => ({
    id: proposal.proposalId,
    actorId: proposal.authorId,
    actorName: proposal.authorName || 'Member',
    kind: 'proposal',
    date: new Date(proposal.createdAt),
    proposalTitle: proposal.title,
    proposalSlug: proposal.slug,
  }));

const recentEvents = [...voteActivities, ...commentActivities, ...proposalActivities];
const activeMemberIds = [...new Set(recentEvents.map((entry) => entry.actorId).filter((id): id is string => Boolean(id)))];
const priorActivity = activeMemberIds.length
  ? await Promise.all([
      showIdentifiableBallots
        ? db.collection(PROPOSAL_VOTES).find({ memberId: { $in: activeMemberIds }, ballotId: /^proposal:/, updatedAt: { $lt: activityWindowStart } }).toArray()
        : Promise.resolve([]),
      db.collection('comments').find({ memberId: { $in: activeMemberIds }, createdAt: { $lt: activityWindowStart } }).toArray(),
      db.collection('proposals').find({ authorId: { $in: activeMemberIds }, createdAt: { $lt: activityWindowStart } }).toArray(),
    ])
  : [[], [], []];

const priorParticipants = new Set<string>();
for (const entry of priorActivity[0] as any[]) if (entry.memberId) priorParticipants.add(entry.memberId);
for (const entry of priorActivity[1] as any[]) if (entry.memberId) priorParticipants.add(entry.memberId);
for (const entry of priorActivity[2] as any[]) if (entry.authorId) priorParticipants.add(entry.authorId);
const firstParticipants = new Set(activeMemberIds.filter((id) => !priorParticipants.has(id)));
const recentActivity = groupParticipationFeed(recentEvents, firstParticipants);

const adminTimelineEvents: ActivityTimelineEvent[] = recentActivity.slice(0, 30).map((entry) => {
  if (entry.kind === 'votes') {
    const first = entry.proposals[0];
    return {
      id: `votes-${entry.actorId}-${entry.lastDate.toISOString()}`,
      date: entry.lastDate,
      actor: entry.actorName,
      action: 'voted on',
      target: `${entry.count} proposal${entry.count === 1 ? '' : 's'}`,
      href: first ? `/proposals/${first.slug}/` : undefined,
      kind: 'vote' as const,
      badge: entry.firstParticipation ? 'First participation' : undefined,
      details: [
        ...entry.proposals.slice(0, 3).map((proposal) => ({
          label: proposal.title,
          href: `/proposals/${proposal.slug}/`,
        })),
        ...(entry.proposals.length > 3 ? [{ label: `and ${entry.proposals.length - 3} more` }] : []),
      ],
    };
  }
  if (entry.kind === 'contribution')
    return {
      id: `contribution-${entry.id}`,
      date: entry.date,
      actor: entry.actorName,
      action: 'contributed to',
      target: entry.proposalTitle,
      href: `/proposals/${entry.proposalSlug}/`,
      kind: 'contribution' as const,
      badge: entry.firstParticipation ? 'First participation' : undefined,
    };
  return {
    id: `proposal-${entry.id}`,
    date: entry.date,
    actor: entry.actorName,
    action: 'submitted',
    target: entry.proposalTitle,
    href: `/proposals/${entry.proposalSlug}/`,
    kind: 'proposal' as const,
    badge: entry.firstParticipation ? 'First participation' : undefined,
  };
});
const adminTimeline = buildActivityTimeline(adminTimelineEvents);

const activeBallotsNeedingReview = proposals.filter((proposal) => proposal.stage === 'decide' && !proposal.ballotRevisionId);
const [ballotResults, registry, scopedBranches, activeBranchMemberships] = await Promise.all([
  db.collection('ballot_results').find({ result: 'successful' }).toArray(),
  user.isAdmin ? db.collection('policy_registry').find({}).toArray() : Promise.resolve([]),
  user.isStaff
    ? db.collection('branches').find({ recognised: true }).sort({ name: 1 }).toArray()
    : user.isBranchAdmin
      ? db.collection('branches').find({ branchId: { $in: user.branchAdminIds ?? [] } }).sort({ name: 1 }).toArray()
      : Promise.resolve([]),
  db.collection('branch_memberships').find({ status: 'active' }).project({ branchId: 1 }).toArray(),
]);
const branchNames = new Map(scopedBranches.map((branch: any) => [String(branch.branchId), String(branch.name)]));
const verifiedCountsByBranch = new Map<string, number>();
for (const row of activeBranchMemberships as any[]) {
  const id = String(row.branchId ?? '');
  if (id) verifiedCountsByBranch.set(id, (verifiedCountsByBranch.get(id) ?? 0) + 1);
}
const ballotProgressRows = buildBallotProgressRows(proposals, branchNames);
const branchSummaryRows = buildBranchSummaryRows(proposals, scopedBranches as any[], verifiedCountsByBranch);
const ratifiedIds = new Set(registry.map((policy) => policy.proposalId));
const awaitingRatification = ballotResults
  .filter((result) => !ratifiedIds.has(result.proposalId))
  .map((result) => proposalMap.get(result.proposalId))
  .filter((proposal): proposal is NonNullable<typeof proposal> =>
    Boolean(proposal && proposal.kind !== 'resolution' && !proposal.proposalId.startsWith('GOV-')),
  );
const awaitingPublication = user.isAdmin ? registry.filter((policy) => policy.status === 'adopted' && policy.publicationStatus === 'unpublished') : [];
const proposalIds = proposals.map((proposal) => proposal.proposalId);
const unresolvedAmendments = proposalIds.length
  ? await db.collection('amendments').countDocuments({ proposalId: { $in: proposalIds }, status: { $in: ['proposed', 'conflict', 'endorsed'] } })
  : 0;
const membersAwaitingReview = user.isAdmin ? await db.collection('memberships').countDocuments({ status: 'pending' }) : 0;

type AttentionTone = 'warning' | 'info' | 'destructive' | 'success';
interface AttentionGroup {
  key: string;
  title: string;
  description: string;
  names: Array<{ title: string; href: string }>;
  href: string;
  cta: string;
  tone: AttentionTone;
  count: number;
}

const attentionGroups: AttentionGroup[] = [];
if (activeBallotsNeedingReview.length) {
  attentionGroups.push({
    key: 'ballot-wording',
    title: 'Ballot wording needs review',
    description: 'These ballots have no bound wording revision. Bind the reviewed revision before recording an outcome.',
    names: activeBallotsNeedingReview.map((proposal) => ({ title: proposal.title, href: `/admin/proposals/${proposal.slug}/` })),
    href: '/admin/proposals/?stage=decide',
    cta: 'Review ballots',
    tone: 'warning',
    count: activeBallotsNeedingReview.length,
  });
}
if (awaitingRatification.length) {
  attentionGroups.push({
    key: 'ratification',
    title: 'Successful ballots awaiting ratification',
    description: 'Ballot success and formal ratification are separate decisions. Review the exact wording before recording adoption.',
    names: awaitingRatification.map((proposal) => ({ title: String((proposal as any).title), href: `/admin/proposals/${(proposal as any).slug}/` })),
    href: user.isAdmin ? '/admin/policies/' : '/admin/proposals/',
    cta: user.isAdmin ? 'Open registry' : 'View decisions',
    tone: 'info',
    count: awaitingRatification.length,
  });
}
if (awaitingPublication.length) {
  attentionGroups.push({
    key: 'publication',
    title: 'Adopted policy not yet published',
    description: 'Ratified records stay private until an administrator authorises publication.',
    names: awaitingPublication.map((policy) => ({ title: String((policy as any).title), href: `/admin/policies/#policy-${(policy as any).policyId}` })),
    href: '/admin/policies/',
    cta: 'Authorise publication',
    tone: 'destructive',
    count: awaitingPublication.length,
  });
}
if (unresolvedAmendments > 0) {
  attentionGroups.push({
    key: 'amendments',
    title: 'Amendments need review',
    description: 'Proposed changes, conflicts, and endorsements remain separate from formal approval.',
    names: [],
    href: '/admin/proposals/',
    cta: 'Review amendments',
    tone: 'warning',
    count: unresolvedAmendments,
  });
}
if (user.isAdmin && membersAwaitingReview > 0) {
  attentionGroups.push({
    key: 'members',
    title: 'Member accounts need verification',
    description: 'Review membership before enabling participation.',
    names: [],
    href: '/admin/members/',
    cta: 'Review members',
    tone: 'info',
    count: membersAwaitingReview,
  });
}
const attentionCount = attentionGroups.reduce((total, group) => total + group.count, 0);
---

<AdminLayout
  title={user.isBranchAdmin && !user.isStaff ? 'Branch Governance Operations' : 'Governance Operations'}
  description="Manage proposals, active ballots, branch electorates, and formal policy publication."
  section="overview"
  isAdmin={user.isAdmin}
  isBranchAdmin={Boolean(user.isBranchAdmin)}
>
  {!user.isStaff && !user.isBranchAdmin ? (
    <Alert variant="destructive">
      <ShieldCheck />
      <AlertTitle>Access required</AlertTitle>
      <AlertDescription>Moderator or Administrator access is required to view this workspace.</AlertDescription>
    </Alert>
  ) : (
    <div class="admin-stack">
      <!-- Project Detail 1: 4-Stage Hairline Metric Strip -->
      <div class="project-detail-strip" aria-label="Proposal lifecycle stage counts">
        <a href="/admin/proposals/?stage=propose" class="project-stat-cell">
          <span class="project-stat-cell__label"><Layers aria-hidden="true" />1. Intake (Propose)</span>
          <div class="project-stat-cell__bottom">
            <strong class="project-stat-cell__value tabular">{stageCounts.propose}</strong>
            <span class="project-stat-cell__hint">New ideas</span>
          </div>
        </a>
        <a href="/admin/proposals/?stage=deliberate" class="project-stat-cell">
          <span class="project-stat-cell__label"><MessageSquare aria-hidden="true" />2. Deliberation</span>
          <div class="project-stat-cell__bottom">
            <strong class="project-stat-cell__value tabular">{stageCounts.deliberate}</strong>
            <span class="project-stat-cell__hint">Open discussion</span>
          </div>
        </a>
        <a href="/admin/proposals/?stage=decide" class="project-stat-cell">
          <span class="project-stat-cell__label"><Gavel aria-hidden="true" />3. Active ballots</span>
          <div class="project-stat-cell__bottom">
            <strong class="project-stat-cell__value tabular">{stageCounts.decide}</strong>
            <span class="project-stat-cell__hint">{activeBallotsNeedingReview.length ? `${activeBallotsNeedingReview.length} unbound` : 'Voting open'}</span>
          </div>
        </a>
        <a href="/admin/proposals/?stage=implement" class="project-stat-cell">
          <span class="project-stat-cell__label"><CheckCircle2 aria-hidden="true" />4. Implement</span>
          <div class="project-stat-cell__bottom">
            <strong class="project-stat-cell__value tabular">{stageCounts.implement}</strong>
            <span class="project-stat-cell__hint">Post-ballot</span>
          </div>
        </a>
      </div>

      <!-- Project Detail 1: Flat 2-Column Workspace Grid -->
      <div class="project-workspace-grid">
        <!-- Main Column: Needs Attention Action Queue + Recent Participation -->
        <div class="project-workspace-main">
          <!-- Section 1: Needs Attention Queue -->
          <section class="overview-section" aria-labelledby="attention-heading">
            <div class="overview-section__head">
              <div>
                <h2 id="attention-heading">Needs attention</h2>
                <p>Governance actions grouped by the decision or review they require.</p>
              </div>
              <Badge variant={attentionCount ? 'warning' : 'success'}>
                {attentionCount ? `${attentionCount} open` : 'All clear'}
              </Badge>
            </div>

            {attentionGroups.length ? (
              <ul class="attention-list">
                {attentionGroups.map((group) => (
                  <li class="attention-row">
                    <div class="attention-row__main">
                      <div class="attention-row__title">
                        <Badge variant={group.tone}>
                          {group.tone === 'destructive' ? 'Urgent' : group.tone === 'warning' ? 'Review' : 'Action'}
                        </Badge>
                        <strong>{group.title}</strong>
                        <span class="admin-attention-count tabular">{group.count}</span>
                      </div>
                      <p class="attention-row__desc">{group.description}</p>
                      {group.names.length > 0 && (
                        <p class="attention-row__links">
                          {group.names.slice(0, 3).map((item, index) => (
                            <>
                              {index > 0 && <span aria-hidden="true"> · </span>}
                              <a href={item.href}>{item.title}</a>
                            </>
                          ))}
                          {group.names.length > 3 ? ` · and ${group.names.length - 3} more` : ''}
                        </p>
                      )}
                    </div>
                    <Button href={group.href} variant="outline" size="sm" className="shrink-0">
                      {group.cta}<ArrowRight />
                    </Button>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="attention-empty">
                <strong>No outstanding governance actions</strong>
                <p>Ballots, ratifications, and member verifications are up to date.</p>
              </div>
            )}
          </section>

          <!-- Section 2: Recent Member Participation -->
          <section class="overview-section" aria-labelledby="participation-heading">
            <div class="overview-section__head">
              <div>
                <h2 id="participation-heading">Recent member participation</h2>
                <p>Verified votes, deliberation stances, and new proposals over the last 7 days.</p>
              </div>
              <Button href="/admin/proposals/" variant="outline" size="sm">Proposal register</Button>
            </div>

            <div class="participation-strip">
              <div>
                <strong class="tabular">{voteActivities.length}</strong>
                <span>Recent votes</span>
              </div>
              <div>
                <strong class="tabular">{commentActivities.length}</strong>
                <span>Deliberation stances</span>
              </div>
              <div>
                <strong class="tabular">{firstParticipants.size}</strong>
                <span>First-time participants</span>
              </div>
            </div>

            <div class="participation-timeline-wrap">
              <ActivityTimeline
                client:load
                groups={adminTimeline}
                filters={[
                  { id: 'all', label: 'All' },
                  { id: 'vote', label: 'Votes' },
                  { id: 'contribution', label: 'Contributions' },
                  { id: 'proposal', label: 'Proposals' },
                ]}
                searchable
                emptyMessage="No member activity in the last seven days."
              />
            </div>
          </section>

          <!-- Section 3: Open Ballot Progress & Branch Summary -->
          <section class="overview-section" aria-labelledby="reporting-heading">
            <div class="overview-section__head">
              <div>
                <h2 id="reporting-heading">Ballot progress &amp; branch summary</h2>
                <p>Aggregate proposal status, ballot totals, and branch activity. Individual votes remain confidential.</p>
              </div>
              <Button href="/api/admin/reports/proposals.csv" variant="outline" size="sm">Export CSV summary</Button>
            </div>

            {ballotProgressRows.length > 0 ? (
              <div class="admin-report-block">
                <h3>Open ballots ({ballotProgressRows.length})</h3>
                <div class="admin-report-table-wrap">
                  <table class="admin-report-table">
                    <thead>
                      <tr>
                        <th>Ballot</th>
                        <th>Scope</th>
                        <th>Wording</th>
                        <th class="tabular">Approve / Abstain / Reject</th>
                        <th class="tabular">Total</th>
                      </tr>
                    </thead>
                    <tbody>
                      {ballotProgressRows.map((row) => (
                        <tr>
                          <td>
                            <a href={`/admin/proposals/${row.slug}/`}>{row.proposalId} · {row.title}</a>
                          </td>
                          <td>{row.branchName}</td>
                          <td>
                            <Badge variant={row.bound ? (row.expired ? 'warning' : 'success') : 'destructive'}>
                              {row.bound ? (row.expired ? 'Closed' : 'Bound') : 'Unbound'}
                            </Badge>
                          </td>
                          <td class="tabular">{row.approve} / {row.abstain} / {row.reject}</td>
                          <td class="tabular"><strong>{row.total}</strong></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ) : (
              <p class="text-sm text-muted-foreground m-0 mb-4">No ballots are currently open in Stage 3 (Decide).</p>
            )}

            {branchSummaryRows.length > 0 && (
              <div class="admin-report-block">
                <h3>Branch summary</h3>
                <div class="admin-report-table-wrap">
                  <table class="admin-report-table">
                    <thead>
                      <tr>
                        <th>Branch</th>
                        <th class="tabular">Verified members</th>
                        <th class="tabular">Active proposals</th>
                        <th class="tabular">Open ballots</th>
                        <th class="tabular">Total votes</th>
                      </tr>
                    </thead>
                    <tbody>
                      {branchSummaryRows.map((row) => (
                        <tr>
                          <td>{row.branchName}</td>
                          <td class="tabular">{row.verifiedMembers}</td>
                          <td class="tabular">{row.propose + row.deliberate + row.decide + row.implement}</td>
                          <td class="tabular">{row.decide}</td>
                          <td class="tabular">{row.totalVotes}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </section>
        </div>

        <!-- Right Contextual Rail: Pipeline distribution, Workspaces, Authority summary -->
        <aside class="project-workspace-rail" aria-label="Pipeline distribution and administration workspaces">
          <div class="project-rail-block">
            <h3>
              <span>Pipeline distribution</span>
              <span class="tabular text-xs font-normal text-muted-foreground">{proposals.length} total</span>
            </h3>
            <div
              class="flex h-2.5 overflow-hidden rounded-full bg-muted"
              role="img"
              aria-label={`Pipeline: ${stageCounts.propose} intake, ${stageCounts.deliberate} deliberation, ${stageCounts.decide} active ballots, ${stageCounts.implement} implementation`}
            >
              {pipelineSegments.map((segment) => (
                <span
                  style={`width:${segment.percent}%;background:${segment.color}`}
                  title={`${segment.label}: ${segment.value}`}
                  class="h-full"
                ></span>
              ))}
            </div>
            <dl class="project-rail-props">
              {pipelineSegments.map((segment) => (
                <div>
                  <dt>
                    <span class="size-2 rounded-full" style={`background:${segment.color}`}></span>
                    <a href={segment.href} class="text-muted-foreground no-underline hover:underline">{segment.label}</a>
                  </dt>
                  <dd class="tabular">{segment.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="project-rail-block">
            <h3>Administration workspaces</h3>
            <div class="project-rail-notes">
              <a href="/admin/proposals/" class="project-rail-note">
                <span class="project-rail-note__icon"><FileText aria-hidden="true" /></span>
                <div class="project-rail-note__body">
                  <div class="project-rail-note__head">
                    <strong>Proposals &amp; Decisions</strong>
                    <span class="tabular">{proposals.length}</span>
                  </div>
                  <p>Manage stages, bind ballot wording, and review amendments.</p>
                </div>
              </a>

              {user.isAdmin && (
                <a href="/admin/policies/" class="project-rail-note">
                  <span class="project-rail-note__icon"><BookOpen aria-hidden="true" /></span>
                  <div class="project-rail-note__body">
                    <div class="project-rail-note__head">
                      <strong>Policy Registry</strong>
                      <span class="tabular">{registry.length}</span>
                    </div>
                    <p>Ratify successful ballots and authorise public publication.</p>
                  </div>
                </a>
              )}

              {user.isAdmin && (
                <a href="/admin/members/" class="project-rail-note">
                  <span class="project-rail-note__icon"><Users aria-hidden="true" /></span>
                  <div class="project-rail-note__body">
                    <div class="project-rail-note__head">
                      <strong>Members &amp; Access</strong>
                      {membersAwaitingReview > 0 && <span class="tabular">{membersAwaitingReview} pending</span>}
                    </div>
                    <p>Verify member eligibility and assign platform roles.</p>
                  </div>
                </a>
              )}

              <a href="/admin/branches/" class="project-rail-note">
                <span class="project-rail-note__icon"><GitBranch aria-hidden="true" /></span>
                <div class="project-rail-note__body">
                  <div class="project-rail-note__head">
                    <strong>Branches &amp; Electorates</strong>
                  </div>
                  <p>Configure branch recognition, electorates, and referrals.</p>
                </div>
              </a>
            </div>
          </div>

          <div class="project-rail-block">
            <h3>Your authority scope</h3>
            <p class="admin-inline-note">
              {user.isAdmin
                ? 'National administrator: full authority across proposals, ballot binding, policy ratification, and member verification.'
                : user.isBranchAdmin
                  ? 'Branch administrator: delegated authority for your assigned branches.'
                  : 'Moderator: deliberation and proposal review access.'}
            </p>
          </div>
        </aside>
      </div>
    </div>
  )}
</AdminLayout>

