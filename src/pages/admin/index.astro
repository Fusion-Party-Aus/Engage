---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listProposals } from '../../lib/store.ts';
import type { ProposalStage } from '../../lib/types.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const user = await getSessionUser(Astro.request, env);

if (!user) {
  return Astro.redirect('/member/', 302);
}
if (!user.isStaff) {
  Astro.response.status = 403;
}

const db = await getDatabase(env);
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const stageFilter = (Astro.url.searchParams.get('stage') ?? 'all').trim();
const editId = (Astro.url.searchParams.get('edit') ?? '').trim();
const reviseId = (Astro.url.searchParams.get('revise') ?? '').trim();

const allProposals = user.isStaff
  ? await listProposals(db, {
      includeArchived: true,
      search: query,
      stage: stageFilter,
    })
  : [];

const editingProposal = editId ? allProposals.find((p) => p.proposalId === editId) : null;
const revisingProposal = reviseId ? allProposals.find((p) => p.proposalId === reviseId) : null;
const isRevision = Boolean(revisingProposal && !editingProposal);

const isLocked = editingProposal
  ? editingProposal.stage === 'decide' || editingProposal.votes.total > 0
  : false;
const voteCount = editingProposal?.votes.total ?? 0;
const currentKind = editingProposal
  ? (editingProposal.kind ?? (editingProposal.proposalId.startsWith('GOV-') ? 'resolution' : 'policy'))
  : (revisingProposal ? (revisingProposal.kind ?? 'policy') : 'policy');
const isResolution = currentKind === 'resolution';

const initialTitle = editingProposal
  ? editingProposal.title
  : (revisingProposal ? `${revisingProposal.title} (Revised)` : '');
const initialSpace = editingProposal
  ? editingProposal.space
  : (revisingProposal ? revisingProposal.space : 'General');
const initialSummary = editingProposal
  ? editingProposal.summary
  : (revisingProposal ? revisingProposal.summary : '');
const initialOutcomes = editingProposal
  ? editingProposal.outcomes
  : (revisingProposal ? revisingProposal.outcomes : []);
const initialDetails = editingProposal
  ? editingProposal.details
  : (revisingProposal ? revisingProposal.details : '');
const initialAttachmentUrl = editingProposal
  ? (editingProposal.attachmentUrl ?? '')
  : (revisingProposal ? (revisingProposal.attachmentUrl ?? '') : '');
const initialAttachmentDescription = editingProposal
  ? (editingProposal.attachmentDescription ?? '')
  : (revisingProposal ? (revisingProposal.attachmentDescription ?? '') : '');
const initialImplementationNote = editingProposal ? (editingProposal.implementationNote ?? '') : '';

const initialProvenance = editingProposal
  ? editingProposal.provenance
  : (revisingProposal
      ? {
          category: 'materially-revised',
          label: `${revisingProposal.kind === 'resolution' ? 'Preceding resolution' : 'Approved policy predecessor'} · Materially revised`,
          summary: `Substantive revision of ${revisingProposal.proposalId} (${revisingProposal.title}) following member deliberation and voting.`,
          uncertaintyNote: revisingProposal.provenance?.uncertaintyNote,
          lineage: [
            {
              label: revisingProposal.title,
              url: `/proposals/${revisingProposal.slug}/`,
              description: `Preceding ballot: ${revisingProposal.proposalId}`,
            },
            ...(revisingProposal.provenance?.lineage ?? []),
          ],
          valuesAlignment: revisingProposal.provenance?.valuesAlignment ?? [],
        }
      : null);

const spaces = [...new Set(allProposals.map((p) => p.space))].sort();

const stageOptions: Array<[ProposalStage, string]> = [
  ['propose', '1. Propose (Intake)'],
  ['deliberate', '2. Deliberate (Discussion)'],
  ['decide', '3. Decide (Voting)'],
  ['implement', '4. Implement (Adoption)'],
  ['archived', 'Archived'],
];
---
<AdminLayout
  title="Proposals & Decision Management"
  description="Manage party proposals, lifecycle stages, deliberation moderation, and implementation notes."
  section="policies"
  isAdmin={user.isAdmin}
>
  {!user.isStaff ? (
    <div class="admin-surface">
      <p>Moderator or Administrator access is required to view this workspace.</p>
    </div>
  ) : (
    <>
      <section id="create-policy" class="admin-surface" aria-labelledby="editor-heading">
        <div class="editor-head">
          <h2 id="editor-heading">
            {editingProposal
              ? `Edit ${editingProposal.proposalId}: ${editingProposal.title}`
              : isRevision
                ? `Branch Revision of ${revisingProposal?.proposalId}`
                : 'Create a new proposal or resolution'}
          </h2>
          {(editingProposal || isRevision) && (
            <a class="button button--outline" href="/admin/">
              Cancel
            </a>
          )}
        </div>

        {isRevision && (
          <div class="revision-notice-banner">
            <strong>🌿 Substantive Revision Mode</strong>
            <p>
              Creating a revised motion based on <strong>{revisingProposal?.proposalId}</strong> ({revisingProposal?.title}).
              The original proposal and its {revisingProposal?.votes.total} vote(s) remain untouched in the archives.
            </p>
          </div>
        )}

        {isLocked && (
          <div class="ballot-locked-alert">
            <div class="ballot-locked-alert__icon">🔒</div>
            <div class="ballot-locked-alert__body">
              <strong>Substantive Motion Text Locked</strong>
              <p>
                This proposal is {editingProposal?.stage === 'decide' ? 'currently active in the Decide (voting) stage' : `in the ${editingProposal?.stage} stage`} with <strong>{voteCount} member vote{voteCount === 1 ? '' : 's'}</strong> cast.
                To protect ballot integrity, the title, summary, commitments, rationale, classification, and attachments cannot be altered.
                Lifecycle stage, topic space, provenance metadata, and implementation notes remain editable.
              </p>
              <div class="ballot-locked-alert__actions">
                <a class="button button--small button--outline" href={`/admin/?revise=${encodeURIComponent(editingProposal!.proposalId)}#create-policy`}>
                  Branch / Revise as New Proposal ↗
                </a>
              </div>
            </div>
          </div>
        )}

        <form id="proposal-editor-form" data-editing-id={editingProposal?.proposalId ?? ''}>
          <div class="admin-grid admin-grid--3">
            <label class="field">
              <span>Lifecycle Stage</span>
              <select name="stage">
                {stageOptions.map(([val, label]) => (
                  <option
                    value={val}
                    selected={
                      editingProposal
                        ? editingProposal.stage === val
                        : isRevision
                          ? val === 'deliberate'
                          : val === 'deliberate'
                    }
                  >
                    {label}
                  </option>
                ))}
              </select>
            </label>

            <label class="field">
              <span>Classification</span>
              <select name="kind" id="proposal-kind-select" disabled={isLocked}>
                <option value="policy" selected={!isResolution}>Policy Proposal</option>
                <option value="resolution" selected={isResolution}>Governance Resolution</option>
              </select>
              {isLocked && <input type="hidden" name="kind" value={isResolution ? 'resolution' : 'policy'} />}
            </label>

            <label class="field">
              <span>Space / Topic</span>
              <input
                name="space"
                list="space-options"
                required
                minlength="2"
                maxlength="100"
                value={initialSpace}
                placeholder="e.g. Governance, Economy, Climate, Digital Rights"
              />
              <datalist id="space-options">
                {spaces.map((sp) => (
                  <option value={sp} />
                ))}
              </datalist>
            </label>
          </div>

          <label class="field">
            <span>
              Title {isLocked && <span class="locked-hint">🔒 locked</span>}
            </span>
            <input
              name="title"
              required
              minlength="4"
              maxlength="200"
              value={initialTitle}
              readonly={isLocked}
              class:list={[{ 'is-locked': isLocked }]}
              placeholder="e.g. Adopt Horizon visual identity, or Universal Dental in Medicare"
            />
          </label>

          <label class="field">
            <span>
              Core Statement / Summary {isLocked && <span class="locked-hint">🔒 locked</span>}
            </span>
            <textarea
              name="summary"
              required
              minlength="10"
              maxlength="2000"
              rows="3"
              readonly={isLocked}
              class:list={[{ 'is-locked': isLocked }]}
            >{initialSummary}</textarea>
          </label>

          <label class="field">
            <span>
              Key Commitments / Outcomes (one per line) {isLocked && <span class="locked-hint">🔒 locked</span>}
            </span>
            <textarea
              name="outcomes"
              rows="3"
              readonly={isLocked}
              class:list={[{ 'is-locked': isLocked }]}
            >{initialOutcomes.join('\n')}</textarea>
          </label>

          <label class="field">
            <span>
              Detailed Background, Rationale &amp; Text {isLocked && <span class="locked-hint">🔒 locked</span>}
            </span>
            <textarea
              name="details"
              rows="6"
              readonly={isLocked}
              class:list={[{ 'is-locked': isLocked }]}
            >{initialDetails}</textarea>
          </label>

          <div class="admin-grid admin-grid--3">
            <label class="field">
              <span>Supporting Attachment URL (optional) {isLocked && <span class="locked-hint">🔒 locked</span>}</span>
              <input
                name="attachmentUrl"
                value={initialAttachmentUrl}
                readonly={isLocked}
                class:list={[{ 'is-locked': isLocked }]}
                placeholder="e.g. /fusion_horizon_logo_light.svg or https://..."
              />
            </label>

            <label class="field">
              <span>Attachment Description (optional) {isLocked && <span class="locked-hint">🔒 locked</span>}</span>
              <input
                name="attachmentDescription"
                value={initialAttachmentDescription}
                readonly={isLocked}
                class:list={[{ 'is-locked': isLocked }]}
                placeholder="e.g. Official Horizon identity emblem: vector marks and palette tokens"
              />
            </label>

            <label class="field">
              <span>Implementation Note (for Stage 4)</span>
              <input
                name="implementationNote"
                value={initialImplementationNote}
                placeholder="e.g. Adopted at 2026 AGM; logo files released in brand pack."
              />
            </label>
          </div>

          <!-- Policy Provenance or Resolution Context -->
          <details class="admin-details" open={Boolean(initialProvenance)}>
            <summary class="admin-details__summary">
              <strong>{isResolution ? 'Resolution Context & Authority' : 'Policy Provenance & Prior Approval'}</strong>
              <span class="admin-details__hint">
                {initialProvenance?.label || 'Configure predecessor links, review notes, and values alignment'}
              </span>
            </summary>

            <div class="admin-details__body">
              <div class="admin-grid">
                <label class="field">
                  <span>Provenance Classification</span>
                  <select name="provCategory" id="prov-category-select">
                    <option value="none" selected={!initialProvenance}>None (Clear Provenance)</option>
                    <option value="existing-repackaged" selected={initialProvenance?.category === 'existing-repackaged'}>
                      {isResolution ? 'Preceding resolution · Equivalence unverified' : 'Approved policy predecessor · Equivalence unverified'}
                    </option>
                    <option value="materially-revised" selected={initialProvenance?.category === 'materially-revised'}>
                      {isResolution ? 'Preceding resolution · Materially revised' : 'Approved policy predecessor · Materially revised'}
                    </option>
                    <option value="new-proposal" selected={initialProvenance?.category === 'new-proposal'}>
                      {isResolution ? 'New resolution · No prior authority identified' : 'New proposal · No prior policy identified'}
                    </option>
                    <option value="party-governance" selected={initialProvenance?.category === 'party-governance'}>
                      Party Governance · Internal platform review
                    </option>
                    <option value="draft-derived" selected={initialProvenance?.category === 'draft-derived'}>
                      Draft branch predecessor · Unapproved
                    </option>
                    <option value="unverified" selected={initialProvenance?.category === 'unverified'}>
                      Mapping unverified
                    </option>
                  </select>
                </label>

                <label class="field">
                  <span>Custom Badge Label (optional)</span>
                  <input
                    name="provLabel"
                    id="prov-label-input"
                    value={initialProvenance?.label ?? ''}
                    placeholder="Defaults based on classification"
                  />
                </label>
              </div>

              <label class="field">
                <span>{isResolution ? 'Resolution Context Summary' : 'Provenance Summary'}</span>
                <textarea
                  name="provSummary"
                  rows="2"
                  placeholder={isResolution ? "e.g. Internal governance motion to adopt..." : "e.g. Cites a direct predecessor on a published Fusion policy page..."}
                >{initialProvenance?.summary ?? ''}</textarea>
              </label>

              <label class="field">
                <span>What is Still Uncertain / Scrutiny Notes</span>
                <input
                  name="provUncertainty"
                  value={initialProvenance?.uncertaintyNote ?? ''}
                  placeholder="e.g. Specific clause or operational wording comparison notes."
                />
              </label>

              <label class="field">
                <span>{isResolution ? 'Preceding Documents & Authorities (format: Title | URL | Description)' : 'Prior Policy Predecessors (format: Title | URL | Description)'}</span>
                <textarea
                  name="provLineage"
                  rows="3"
                  placeholder="Fair + Inclusive Society | https://www.fusionparty.org.au/fair_inclusive_society | Direct predecessor: replacing stamp duty with land tax"
                >{(initialProvenance?.lineage ?? []).map((l) => [l.label, l.url, l.description].filter(Boolean).join(' | ')).join('\n')}</textarea>
              </label>

              <label class="field">
                <span>Values &amp; Principles Alignment (one per line)</span>
                <textarea
                  name="provValues"
                  rows="2"
                  placeholder="Principle: Sustainable Urban Prosperity — Replacing transaction taxes with land-value taxation..."
                >{(initialProvenance?.valuesAlignment ?? []).join('\n')}</textarea>
              </label>
            </div>
          </details>

          <div class="editor-actions">
            <button class="button" type="submit">
              {editingProposal ? 'Save changes' : isRevision ? 'Create revised proposal' : 'Create proposal'}
            </button>
            {editingProposal && user.isAdmin && (
              <button
                id="delete-proposal-btn"
                class="button button--danger"
                type="button"
                data-delete-id={editingProposal.proposalId}
                data-vote-count={voteCount}
              >
                Delete proposal
              </button>
            )}
            <p id="editor-status" class="form-status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </section>

      <!-- Filter Toolbar -->
      <form method="get" action="/admin/" class="admin-toolbar">
        <label class="field">
          <span>Search proposals</span>
          <input
            type="search"
            name="q"
            value={query}
            placeholder="Search by title, ID, or space"
          />
        </label>

        <label class="field" style="max-width: 16rem">
          <span>Stage</span>
          <select name="stage">
            <option value="all" selected={stageFilter === 'all'}>
              All stages ({allProposals.length})
            </option>
            {stageOptions.map(([val, label]) => (
              <option value={val} selected={stageFilter === val}>
                {label}
              </option>
            ))}
          </select>
        </label>

        <button class="button button--outline" type="submit">Filter</button>
      </form>

      <!-- Proposals List -->
      <section class="admin-register" aria-label="Proposals register">
        {allProposals.length === 0 ? (
          <p style="padding: 1.25rem 0; margin: 0">No items match this filter.</p>
        ) : (
          allProposals.map((item) => (
            <article class="admin-row">
              <div>
                <h3>
                  <a href={`/proposals/${item.slug}/`}>{item.title}</a>
                </h3>
                <p class="tabular">
                  <strong>{item.proposalId}</strong> · {item.space} · <span class="kind-tag">{item.kind === 'resolution' || item.proposalId.startsWith('GOV-') ? 'Resolution' : 'Policy'}</span>
                  {item.provenance && (
                    <> · <span class="prov-tag">{item.provenance.label}</span></>
                  )} ·{' '}
                  <span class="tabular">
                    {item.votes.approve} approve / {item.votes.abstain} abstain / {item.votes.reject} reject
                  </span>{' '}
                  {item.votes.total > 0 && <span class="vote-count-badge">{item.votes.total} vote{item.votes.total === 1 ? '' : 's'}</span>} · {item.commentCount} stances
                </p>
              </div>

              <div class="admin-row-actions">
                <select
                  class="inline-stage-select"
                  aria-label={`Stage for ${item.title}`}
                  data-quick-proposal-id={item.proposalId}
                  data-current-stage={item.stage}
                  data-vote-count={item.votes.total}
                  data-title={item.title}
                >
                  {stageOptions.map(([val, label]) => (
                    <option value={val} selected={item.stage === val}>
                      {label}
                    </option>
                  ))}
                </select>
                <a class="button button--outline" href={`/admin/?edit=${encodeURIComponent(item.proposalId)}#create-policy`}>
                  Edit
                </a>
                <a class="button button--outline" href={`/proposals/${item.slug}/`}>
                  View
                </a>
              </div>
            </article>
          ))
        )}
      </section>
    </>
  )}
</AdminLayout>

<script>
  const editorForm = document.querySelector<HTMLFormElement>('#proposal-editor-form');
  const editorStatus = document.querySelector<HTMLElement>('#editor-status');

  editorForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!editorForm.reportValidity()) return;
    const editingId = editorForm.dataset.editingId;
    const submitBtn = editorForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submitBtn.disabled = true;
    if (editorStatus) editorStatus.textContent = 'Saving…';

    try {
      const formData = new FormData(editorForm);
      const outcomesRaw = String(formData.get('outcomes') ?? '');
      const outcomes = outcomesRaw
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean);

      const provCategory = String(formData.get('provCategory') || '').trim();
      let provenance = undefined;
      if (provCategory && provCategory !== 'none') {
        const lineageRaw = String(formData.get('provLineage') || '');
        const lineage = lineageRaw
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const parts = line.split('|').map((p) => p.trim());
            return {
              label: parts[0] || '',
              url: parts[1] || null,
              description: parts[2] || '',
            };
          })
          .filter((l) => l.label);

        const valuesRaw = String(formData.get('provValues') || '');
        const valuesAlignment = valuesRaw
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean);

        provenance = {
          category: provCategory,
          label: String(formData.get('provLabel') || '').trim(),
          summary: String(formData.get('provSummary') || '').trim(),
          uncertaintyNote: String(formData.get('provUncertainty') || '').trim() || undefined,
          lineage,
          valuesAlignment,
        };
      } else if (provCategory === 'none') {
        provenance = null;
      }

      const data = {
        proposalId: editingId || undefined,
        title: formData.get('title'),
        space: formData.get('space'),
        stage: formData.get('stage'),
        kind: formData.get('kind') || undefined,
        summary: formData.get('summary'),
        details: formData.get('details'),
        outcomes,
        attachmentUrl: formData.get('attachmentUrl') || undefined,
        attachmentDescription: formData.get('attachmentDescription') || undefined,
        implementationNote: formData.get('implementationNote') || undefined,
        provenance,
      };

      const url = editingId ? `/api/proposals/${encodeURIComponent(editingId)}` : '/api/proposals';
      const method = editingId ? 'PATCH' : 'POST';
      const res = await fetch(url, {
        method,
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(payload.error || 'Could not save proposal.');
      location.href = `/proposals/${payload.proposal.slug}/`;
    } catch (err) {
      if (editorStatus) {
        editorStatus.textContent = err instanceof Error ? err.message : 'Could not save proposal.';
      }
      submitBtn.disabled = false;
    }
  });

  document.querySelector<HTMLButtonElement>('#delete-proposal-btn')?.addEventListener('click', async (event) => {
    const btn = event.currentTarget as HTMLButtonElement;
    const proposalId = btn.dataset.deleteId;
    const voteCount = parseInt(btn.dataset.voteCount || '0', 10);
    if (!proposalId) return;

    let confirmMsg = `Delete ${proposalId}? This cannot be undone.`;
    if (voteCount > 0) {
      confirmMsg = `WARNING: This proposal has ${voteCount} member vote(s) recorded! Deleting it will permanently delete the voting record. Consider archiving instead.\n\nAre you sure you want to delete ${proposalId}?`;
    }

    if (!confirm(confirmMsg)) return;
    btn.disabled = true;
    try {
      const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId)}`, {
        method: 'DELETE',
        credentials: 'same-origin',
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Could not delete proposal.');
      location.href = '/admin/';
    } catch (err: any) {
      alert(err.message || 'Could not delete proposal.');
      btn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLSelectElement>('[data-quick-proposal-id]').forEach((select) => {
    select.addEventListener('change', async () => {
      const proposalId = select.dataset.quickProposalId;
      const title = select.dataset.title || proposalId;
      const currentStage = select.dataset.currentStage || select.value;
      const voteCount = parseInt(select.dataset.voteCount || '0', 10);
      const newStage = select.value;
      if (!proposalId || currentStage === newStage) return;

      let confirmMsg = '';
      if (newStage === 'decide') {
        confirmMsg = `Open ballot for "${title}" (Stage 3: Decide)? Once voting begins, substantive content will be locked to protect ballot integrity.`;
      } else if (currentStage === 'decide' && voteCount > 0) {
        confirmMsg = `This proposal currently has ${voteCount} member vote(s). Moving it to "${newStage}" will conclude or pause active voting. All cast votes will remain safely preserved. Proceed?`;
      } else if (newStage === 'implement') {
        confirmMsg = `Mark "${title}" as Adopted / Stage 4 Implementation?`;
      } else if (newStage === 'archived') {
        confirmMsg = `Archive "${title}"? It will no longer be visible to general members.`;
      }

      if (confirmMsg && !confirm(confirmMsg)) {
        select.value = currentStage;
        return;
      }

      select.disabled = true;
      try {
        const res = await fetch(`/api/proposals/${encodeURIComponent(proposalId)}`, {
          method: 'PATCH',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ stage: newStage }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(data.error || 'Failed to update stage');
        }
        select.dataset.currentStage = newStage;
        location.reload();
      } catch (err: any) {
        alert(err.message || 'Failed to update stage');
        select.value = currentStage;
      } finally {
        select.disabled = false;
      }
    });
  });
</script>

<style>
  .editor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .editor-head h2 {
    margin: 0;
    font-family: Outfit, sans-serif;
    font-size: 1.3rem;
  }
  .editor-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .inline-stage-select {
    min-height: 2.65rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid #8a7b99;
    border-radius: 0.45rem;
    background: var(--horizon-white);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .admin-grid--3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }

  .ballot-locked-alert {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    background: #fffbeb;
    border: 1px solid #fcd34d;
    border-radius: 0.65rem;
    margin-bottom: 1.25rem;
    color: #92400e;
  }

  .ballot-locked-alert__icon {
    font-size: 1.5rem;
    line-height: 1;
