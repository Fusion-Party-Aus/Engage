---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewNotice from '../../components/PreviewNotice.astro';
import PolicyCard from '../../components/PolicyCard.astro';
import policies from '../../data/policies.json';
const section = policies.filter((p) => p.slug.startsWith('/reclaim-our-future/'));
---
<SiteLayout title="Reclaim our future · Fusion" description="Policies to strengthen democracy and build thriving communities." noIndex>
  <PreviewNotice slot="notice" />
  <div class="page-wrap"><header class="page-intro"><p class="eyebrow">Policy area · Future</p><h1>Reclaim our future.</h1><p>Renew democracy, strengthen communities, and prepare for the world ahead.</p></header><div class="policy-grid">{section.map((p) => <PolicyCard title={p.title} href={p.slug} area="Future" summary={p.summary} />)}</div></div>
</SiteLayout>
<style>.page-wrap{padding-bottom:5rem}.policy-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.policy-entry{display:flex;min-height:16rem;flex-direction:column;padding:1.4rem;border:1px solid #ded6e7;border-radius:.8rem}.policy-entry h3{margin:.2rem 0 .6rem}.policy-entry h3 a{text-decoration:none}.policy-entry__summary{color:#54465f;line-height:1.55}.policy-entry .text-link{margin-top:auto}@media(max-width:800px){.policy-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:580px){.policy-grid{grid-template-columns:1fr}}</style>
