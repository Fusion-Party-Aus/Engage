---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewNotice from '../../components/PreviewNotice.astro';
import policies from '../../data/policies.json';
const route = `/reclaim-our-future/${Astro.params.slug ?? ''}/`;
const policy = policies.find((p) => p.slug === route);
if (!policy) Astro.response.status = 404;
---
{policy ? <SiteLayout title={`${policy.metaTitle}`} description={policy.description} canonical={`${Astro.url.origin}${policy.slug}`}>
  <PreviewNotice slot="notice" />
  <article class="policy-document page-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/policies/">Policies</a><span aria-hidden="true">/</span><a href="/reclaim-our-future/">Reclaim our future</a></nav>
    <header class="policy-head"><p class="eyebrow">Reclaim our future · Policy</p><h1>{policy.title}</h1><p>{policy.summary}</p></header>
    <div class="policy-actions"><span class="draft-tag">Published policy text</span><a class="button" href={`/consultations/?policy=${encodeURIComponent(policy.title)}`}>Give feedback</a></div>
    <div class="policy-body" set:html={policy.bodyHtml} />
    <aside class="policy-followup"><h2>Help shape the next revision.</h2><p>Consultation feedback and proposed alternatives are reviewed separately from any formal approval ballot.</p><a class="text-link" href={`/consultations/?policy=${encodeURIComponent(policy.title)}`}>Join the consultation <span aria-hidden="true">→</span></a></aside>
  </article>
</SiteLayout> : <SiteLayout title="Policy not found · Fusion" noIndex><div class="page-wrap section-space"><h1>We couldn’t find that policy.</h1><a href="/policies/">Return to the policy library</a></div></SiteLayout>}
<style>.policy-document{max-width:58rem;padding-block:2rem 6rem}.breadcrumbs{display:flex;gap:.6rem;align-items:center;margin:1.3rem 0;color:#54465f;font-size:.9rem}.policy-head{padding-block:2rem 1.6rem}.policy-head h1{max-width:14ch;margin:.15rem 0 1rem;font-size:clamp(2.5rem,5vw,4.7rem)}.policy-head>p:last-child{max-width:70ch;color:#54465f;line-height:1.65}.policy-actions{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-block:1px solid #ded6e7}.draft-tag{color:#54465f;font-size:.88rem;font-weight:600}.policy-body{padding-top:2rem;color:#362743;font-size:1.05rem;line-height:1.8}.policy-body h1{display:none}.policy-body h2{margin:2.8rem 0 .9rem;font-size:clamp(1.6rem,3vw,2.3rem)}.policy-body h3{margin:2.2rem 0 .65rem;font-size:1.4rem}.policy-body p,.policy-body li{max-width:72ch}.policy-body ul,.policy-body ol{padding-left:1.5rem}.policy-body li+li{margin-top:.45rem}.policy-body strong{font-weight:700}.policy-body blockquote{margin:2rem 0;padding:1.4rem 1.6rem;background:#f2eef9;border-radius:.7rem}.policy-followup{margin-top:3rem;padding:2rem;background:#f2eef9;border-radius:.8rem}.policy-followup h2{margin:.1rem 0 .6rem}.policy-followup p{max-width:65ch;color:#54465f;line-height:1.65}</style>
