---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  emailLoginConfigured,
  getSessionUser,
  googleLoginConfigured,
  isProduction,
} from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listUserActivity } from '../../lib/store.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const activity = user ? await listUserActivity(db, user.memberId) : null;
const emailAvailable = emailLoginConfigured(env);
const googleAvailable = googleLoginConfigured(env);
const devLoginAvailable = !isProduction(env);
---
<SiteLayout
  title="Member Account · Engage"
  description="Sign in to comment on Fusion policy proposals and vote on open decisions."
  noIndex
>
  <div class="page-wrap section-space member-page">
    {!user ? (
      <>
        <header class="page-intro">
          <h1>Sign in to take part.</h1>
          <p>
            Use the email address and full name on your Fusion Party membership. After your first
            sign-in, an administrator verifies your membership so you can comment and vote.
          </p>
        </header>

        <div class="signin-grid">
          {emailAvailable && (
            <section class="signin-box" aria-labelledby="email-signin-heading">
              <h2 id="email-signin-heading">Sign in with an email link</h2>
              <p>We’ll email you a one-click sign-in link—no password required.</p>
              <form id="email-signin-form">
                <label class="field" for="signin-email">
                  <span>Email address</span>
                  <input
                    id="signin-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    maxlength="254"
                    required
                  />
                </label>
                <label class="field" for="signin-name">
                  <span>Full name (required for first sign-in)</span>
                  <input
                    id="signin-name"
                    name="name"
                    autocomplete="name"
                    minlength="2"
                    maxlength="100"
                  />
                </label>
                <button class="button" type="submit">Email me a sign-in link</button>
                <p id="email-status" class="form-status" role="status" aria-live="polite"></p>
              </form>
            </section>
          )}

          {googleAvailable && (
            <section class="signin-box" aria-labelledby="google-signin-heading">
              <h2 id="google-signin-heading">Sign in with Google</h2>
              <p>Continue using your Google account.</p>
              <button id="google-signin" class="button button--outline" type="button">
                Continue with Google
              </button>
              <p id="google-status" class="form-status" role="status" aria-live="polite"></p>
            </section>
          )}

          {devLoginAvailable && (
            <section class="signin-box" aria-labelledby="dev-signin-heading">
              <h2 id="dev-signin-heading">Local development sign-in</h2>
              <p>Sign in locally as a verified member or administrator to test the platform.</p>
              <form id="dev-signin-form">
                <label class="field">
                  <span>Account role</span>
                  <select name="role">
                    <option value="member">Verified Member</option>
                    <option value="administrator">Administrator</option>
                  </select>
                </label>
                <button class="button" type="submit">Sign in locally</button>
                <p id="dev-status" class="form-status" role="status" aria-live="polite"></p>
              </form>
            </section>
          )}

          {!emailAvailable && !googleAvailable && !devLoginAvailable && (
            <div class="callout">
              <p>Member sign-in is temporarily unavailable. Please try again shortly.</p>
            </div>
          )}
        </div>
      </>
    ) : (
      <>
        <header class="account-header">
          <div>
            <h1>{user.name || 'Your member account'}</h1>
            <p>{user.email}</p>
          </div>
          <div class="account-header__actions">
            {user.isStaff && (
              <a class="button button--outline" href="/admin/">
                Open Admin Workspace →
              </a>
            )}
            <a class="button" href="/policies/?status=voting">
              View open votes →
            </a>
          </div>
        </header>

        <div class="callout status-banner">
          <p>
            {user.status === 'verified' ? (
              <>
                <strong>Membership verified.</strong> You can propose new motions, deliberate with structured stances, and vote on open party decisions.
              </>
            ) : user.status === 'suspended' ? (
              <>
                <strong>Participation suspended.</strong> Please contact a party administrator
                regarding your membership status.
              </>
            ) : (
              <>
                <strong>Membership verification pending.</strong> You can browse all proposals and decisions while
                an administrator confirms your Fusion Party membership. Make sure your full name
                below matches your party membership record.
              </>
            )}
          </p>
        </div>

        <section class="account-section" aria-labelledby="profile-heading">
          <h2 id="profile-heading">Your display name</h2>
          <form id="profile-form" class="profile-form">
            <label class="field" for="profile-name">
              <span>Full name</span>
              <input
                id="profile-name"
                name="name"
                value={user.name}
                autocomplete="name"
                required
                minlength="2"
                maxlength="100"
              />
            </label>
            <button class="button button--outline" type="submit">Save name</button>
            <p id="profile-status" class="form-status" role="status" aria-live="polite"></p>
          </form>
        </section>

        {activity?.proposals && activity.proposals.length > 0 && (
          <section class="account-section" aria-labelledby="proposals-heading">
            <h2 id="proposals-heading">Proposals you authored ({activity.proposals.length})</h2>
            <ul class="activity-list">
              {activity.proposals.map((p) => (
                <li class="activity-row">
                  <div>
                    <a class="activity-title" href={`/proposals/${p.slug}/`}>
                      {p.title}
                    </a>
                    <span class="activity-sub">
                      Stage: {p.stage} · {p.space}
                    </span>
                  </div>
                  <a class="button button--small button--outline" href={`/proposals/${p.slug}/`}>
                    View
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="account-section" aria-labelledby="votes-heading">
          <h2 id="votes-heading">Your recorded votes ({activity?.votes.length ?? 0})</h2>
          {!activity?.votes.length ? (
            <p class="muted-note">
              You have not voted on any decisions yet. Visit{' '}
              <a href="/proposals/?stage=decide">Decisions (Open Votes)</a> to participate.
            </p>
          ) : (
            <ul class="activity-list">
              {activity.votes.map((v) => (
                <li class="activity-row">
                  <div>
                    <a class="activity-title" href={`/proposals/${v.proposalSlug}/`}>
                      {v.proposalTitle}
                    </a>
                    <span class="activity-sub">
                      Updated{' '}
                      {new Date(v.updatedAt).toLocaleDateString('en-AU', { dateStyle: 'medium' })}
                      {v.reason ? ` · Reason: "${v.reason}"` : ''}
                    </span>
                  </div>
                  <span class={`badge ${v.choice === 'approve' ? 'badge--adopted' : v.choice === 'abstain' ? 'badge--open' : 'badge--draft'}`}>
                    Voted: {v.choice.toUpperCase()}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="account-section" aria-labelledby="comments-heading">
          <h2 id="comments-heading">Your deliberation stances ({activity?.comments.length ?? 0})</h2>
          {!activity?.comments.length ? (
            <p class="muted-note">
              You have not posted any deliberation stances yet. Open any item in{' '}
              <a href="/proposals/">Proposals</a> to share your feedback or suggested amendments.
            </p>
          ) : (
            <ul class="activity-list">
              {activity.comments.map((c) => (
                <li class="activity-row">
                  <div>
                    <a class="activity-title" href={`/proposals/${c.proposalSlug}/#deliberation`}>
                      {c.proposalTitle}
                    </a>
                    <p class="activity-body">{c.body}</p>
                  </div>
                  <span class="badge">
                    Stance: {c.stance}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )}
  </div>
</SiteLayout>

<script>
  import { createAuthClient } from 'better-auth/client';
  import { magicLinkClient } from 'better-auth/client/plugins';

  const authClient = createAuthClient({ plugins: [magicLinkClient()] });

  const emailForm = document.querySelector<HTMLFormElement>('#email-signin-form');
  const emailStatus = document.querySelector<HTMLElement>('#email-status');
  if (emailStatus && new URLSearchParams(location.search).has('error')) {
    emailStatus.textContent =
      'That sign-in link has expired or was already used. Request a new link below.';
  }

  emailForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailStatus || !emailForm.reportValidity()) return;
    const btn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    emailStatus.textContent = 'Sending sign-in link…';

    try {
      const data = new FormData(emailForm);
      const result = await authClient.signIn.magicLink({
        email: String(data.get('email')).trim(),
        name: String(data.get('name')).trim() || undefined,
        callbackURL: '/member/',
        errorCallbackURL: '/member/?error=link',
      });
      if (result.error) {
        if (result.error.code === 'NAME_REQUIRED') {
          emailStatus.textContent = 'Please enter your full name for your first sign-in.';
          const nameInput = emailForm.querySelector<HTMLInputElement>('[name="name"]')!;
          nameInput.required = true;
          nameInput.focus();
        } else if (result.error.status === 429) {
          emailStatus.textContent = 'Too many attempts. Please wait a minute and try again.';
        } else {
          emailStatus.textContent = 'Could not send sign-in link. Please try again shortly.';
        }
      } else {
        emailStatus.textContent =
          'Check your email inbox for your sign-in link (valid for 10 minutes).';
      }
    } catch {
      emailStatus.textContent = 'Could not send sign-in link. Please try again shortly.';
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelector('#google-signin')?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#google-status')!;
    status.textContent = 'Redirecting to Google…';
    try {
      const result = await authClient.signIn.social({
        provider: 'google',
        callbackURL: '/member/',
      });
      if (result.error) {
        status.textContent = 'Google sign-in is unavailable right now.';
      }
    } catch {
      status.textContent = 'Google sign-in is unavailable right now.';
    }
  });

  const devForm = document.querySelector<HTMLFormElement>('#dev-signin-form');
  devForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const role = new FormData(devForm).get('role');
    const res = await fetch('/api/session', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ role }),
    });
    if (res.ok) location.reload();
  });

  const profileForm = document.querySelector<HTMLFormElement>('#profile-form');
  profileForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!profileForm.reportValidity()) return;
    const status = document.querySelector<HTMLElement>('#profile-status')!;
    const btn = profileForm.querySelector<HTMLButtonElement>('button')!;
    btn.disabled = true;
    status.textContent = 'Saving…';
    try {
      const name = String(new FormData(profileForm).get('name')).trim();
      const result = await authClient.updateUser({ name });
      status.textContent = result.error ? 'Could not save name.' : 'Name saved.';
    } catch {
      status.textContent = 'Could not save name.';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .member-page {
    max-width: 62rem;
  }
  .signin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .signin-box {
    padding: 1.75rem;
    background: var(--horizon-lavender-soft);
    border: 1px solid var(--horizon-line);
    border-radius: 0.85rem;
  }
  .signin-box h2 {
    margin: 0 0 0.45rem;
    font-size: 1.55rem;
  }
  .signin-box p {
    margin: 0 0 1rem;
    color: var(--horizon-muted);
  }

  .account-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 1.5rem;
  }
  .account-header h1 {
    margin: 0 0 0.25rem;
  }
  .account-header p {
    margin: 0;
    color: var(--horizon-muted);
    font-size: 1.05rem;
  }
  .account-header__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .status-banner {
    margin-bottom: 2rem;
  }

  .account-section {
    padding-top: 2rem;
    margin-top: 2rem;
    border-top: 1px solid var(--horizon-line);
  }
  .account-section h2 {
    margin: 0 0 1rem;
    font-size: 1.65rem;
  }
  .profile-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.85rem 1rem;
  }
  .profile-form .field {
    margin: 0;
    min-width: min(100%, 20rem);
  }
  .profile-form .form-status {
    width: 100%;
    margin: 0;
  }

  .muted-note {
    color: var(--horizon-muted);
    margin: 0;
  }
  .activity-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--horizon-line);
  }
  .activity-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--horizon-line);
  }
  .activity-title {
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    display: block;
  }
  .activity-title:hover {
    text-decoration: underline;
  }
  .activity-sub {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--horizon-muted);
  }
  .activity-body {
    margin: 0.35rem 0 0;
    color: var(--horizon-muted);
    font-size: 0.94rem;
    max-width: 62ch;
  }
</style>
