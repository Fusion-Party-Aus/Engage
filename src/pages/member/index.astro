---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewNotice from '../../components/PreviewNotice.astro';
---
<SiteLayout title="Member portal · Fusion" description="Sign in to the synthetic preview member portal." noIndex>
  <PreviewNotice slot="notice" />
  <div class="page-wrap member-page">
    <header class="page-intro"><p class="eyebrow">Member portal · Preview</p><h1>Take part in shaping policy.</h1><p>Preview access uses synthetic identities only. It does not connect to Underground or represent a real membership record.</p></header>
    <section id="signin-panel" class="panel" aria-labelledby="signin-title"><div><p class="eyebrow">Synthetic sign-in</p><h2 id="signin-title">Choose a preview identity</h2><p>Use a member identity to test consultations and simulated ballots, or a moderator identity to review synthetic submissions.</p></div>
      <form id="signin-form"><label class="field"><span>Preview role</span><select name="memberId" required><option value="preview-member-01">Synthetic member 01</option><option value="preview-member-02">Synthetic member 02</option><option value="preview-admin-01">Synthetic moderator</option></select></label><button class="button" type="submit">Sign in to preview</button><p id="signin-status" class="form-status" role="status" aria-live="polite"></p></form>
    </section>
    <section id="dashboard" class="dashboard" hidden aria-labelledby="dashboard-title"><div class="dashboard-head"><div><p class="eyebrow">Synthetic preview session</p><h2 id="dashboard-title">Your participation</h2></div><button id="signout" class="button button--outline" type="button">Sign out</button></div><p class="callout">This dashboard displays synthetic activity only. It cannot establish eligibility for a real Fusion ballot.</p><div id="dashboard-content" class="dashboard-content"><p>Loading your preview activity…</p></div><a id="admin-link" class="text-link" href="/admin/" hidden>Open moderation workspace <span aria-hidden="true">→</span></a></section>
  </div>
</SiteLayout>
<script>
  const panel = document.querySelector<HTMLElement>('#signin-panel');
  const dashboard = document.querySelector<HTMLElement>('#dashboard');
  const form = document.querySelector<HTMLFormElement>('#signin-form');
  const status = document.querySelector<HTMLElement>('#signin-status');
  const content = document.querySelector<HTMLElement>('#dashboard-content');
  const adminLink = document.querySelector<HTMLElement>('#admin-link');
  async function refresh() {
    const session = await fetch('/api/session', { credentials: 'same-origin' }).then((r) => r.json()).catch(() => null);
    if (!session?.identity || !dashboard || !panel) return;
    panel.hidden = true; dashboard.hidden = false;
    const roleNames = session.identity.roles?.join(', ') ?? 'member';
    dashboard.querySelector('#dashboard-title')!.textContent = `${session.identity.memberId} · ${roleNames}`;
    if (session.identity.roles?.some((role:string) => ['administrator','moderator'].includes(role)) && adminLink) adminLink.hidden = false;
    const [submissionsResponse, ballotsResponse] = await Promise.all([fetch('/api/consultations'), fetch('/api/ballots')]);
    const submissionsData = await submissionsResponse.json().catch(() => ({}));
    const ballotData = await ballotsResponse.json().catch(() => ({}));
    if (!content) return;
    content.replaceChildren();
    const submissionsHeading = document.createElement('h3'); submissionsHeading.textContent = 'Consultation submissions'; content.append(submissionsHeading);
    const submissions = submissionsData.submissions ?? [];
    if (!submissions.length) { const p=document.createElement('p');p.textContent='No feedback submitted yet. Visit an open consultation to contribute.';content.append(p); }
    for (const submission of submissions) { const row=document.createElement('article');row.className='activity-row';const title=document.createElement('strong');title.textContent=submission.title||submission.kind;const meta=document.createElement('span');meta.textContent=`${submission.status} · ${new Date(submission.createdAt).toLocaleDateString()}`;row.append(title,meta);content.append(row); }
    const ballotsHeading = document.createElement('h3'); ballotsHeading.textContent = 'Ballots'; content.append(ballotsHeading);
    const ballots = ballotData.ballots ?? [];
    if (!ballots.length) { const p=document.createElement('p');p.textContent='No synthetic ballot simulations are loaded.';content.append(p); }
    for (const ballot of ballots) {
      const row=document.createElement('article');row.className='activity-row';const title=document.createElement('strong');title.textContent=ballot.title;const meta=document.createElement('span');meta.textContent=`${ballot.mode === 'simulation' ? 'Synthetic simulation' : 'Formal'} · ${ballot.status}`;row.append(title,meta);
      if (ballot.mode === 'simulation') { const response=await fetch(`/api/ballots/${encodeURIComponent(ballot.ballotId)}/participation`);const participation=await response.json().catch(()=>({}));const state=document.createElement('span');state.textContent=participation.participated?'You participated in this synthetic simulation.':'You have not participated in this synthetic simulation.';row.append(state); }
      content.append(row);
    }
  }
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if(!status||!form.reportValidity()) return; status.textContent='Starting synthetic preview session…'; const memberId=String(new FormData(form).get('memberId'));const response=await fetch('/api/auth/demo',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({memberId})});const result=await response.json().catch(()=>({}));if(!response.ok){status.textContent=result.error??'Preview sign-in is unavailable.';return;}status.textContent='Signed in to synthetic preview.';await refresh(); });
  document.querySelector<HTMLButtonElement>('#signout')?.addEventListener('click',async()=>{await fetch('/api/session',{method:'DELETE',credentials:'same-origin'});location.reload();});
  await refresh();
</script>
<style>
  .member-page{max-width:72rem;padding-bottom:5rem}.panel{display:grid;grid-template-columns:1fr minmax(16rem,.8fr);gap:2.5rem;padding:clamp(1.4rem,4vw,2.5rem);border:1px solid #ded6e7;border-radius:.9rem}.panel h2,.dashboard h2{margin:.1rem 0 .7rem}.panel p:not(.eyebrow){max-width:48ch;color:#54465f;line-height:1.65}.panel form{align-self:center}.panel[hidden],.dashboard[hidden]{display:none}.dashboard{padding-block:1rem 4rem}.dashboard-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}.dashboard-content{padding-top:1.3rem}.dashboard-content h3{font-family:Outfit,sans-serif;font-size:1.05rem;margin:1.8rem 0 .7rem}.activity-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid #ded6e7}.activity-row span{color:#54465f;font-size:.9rem}
  @media(max-width:700px){.panel{grid-template-columns:1fr}.dashboard-head{align-items:flex-start}.activity-row{align-items:flex-start;flex-direction:column}}
</style>
