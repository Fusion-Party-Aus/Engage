---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalAcceptanceGate from '../../components/legal/LegalAcceptanceGate.astro';
import { Badge } from '../../components/ui/badge';
import { Button } from '../../components/ui/button';
import { Alert, AlertDescription } from '../../components/ui/alert';
import { Field } from '../../components/ui/field';
import { Input } from '../../components/ui/input';
import { NativeSelect } from '../../components/ui/native-select';
import MemberSettings from '../../components/member/MemberSettings';
import ActivityTimeline from '../../components/blocks/timeline-3';
import AttentionQueue from '../../components/member/AttentionQueue.astro';
import CatchUpDigest from '../../components/member/CatchUpDigest.astro';
import GovernanceLog from '../../components/member/GovernanceLog.astro';
import { buildActivityTimeline, type ActivityTimelineEvent } from '../../lib/activity-timeline.ts';
import { buildMemberCatchUp, listMemberActivityStream, type MemberCatchUpGroup } from '../../lib/member-activity.ts';
import {
  devLoginEnabled,
  emailLoginConfigured,
  getSessionUser,
  googleLoginConfigured,
} from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listOutstandingDecisions, listProposals, listUserActivity } from '../../lib/store.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const activity = user ? await listUserActivity(db, user.memberId) : null;
const memberTimelineEvents: ActivityTimelineEvent[] = user
  ? await listMemberActivityStream(db, user.memberId)
  : [];
const memberTimeline = buildActivityTimeline(memberTimelineEvents);
const memberTimelineCount = memberTimelineEvents.length;
const awaitingDecision = user?.canParticipate ? await listOutstandingDecisions(db, user.memberId, user) : [];
const memberBranches = user?.activeBranchIds?.length
  ? await db.collection('branches').find({ branchId: { $in: user.activeBranchIds }, recognised: true }).sort({ name: 1 }).toArray()
  : [];
const visibleProposals = user ? await listProposals(db, { user }) : [];
const deliberationOpportunities = visibleProposals
  .filter((proposal) => proposal.stage === 'deliberate')
  .sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime());

const branchPriority = { decide: 0, deliberate: 1, propose: 2, implement: 3, archived: 4 };

const now = new Date();
const LAST_SEEN_COOKIE = 'engage_member_last_seen';
const rawLastSeen = Astro.cookies.get(LAST_SEEN_COOKIE)?.value;
const parsedLastSeen = rawLastSeen ? new Date(rawLastSeen) : null;
const lastSeen =
  parsedLastSeen && !Number.isNaN(parsedLastSeen.getTime()) && parsedLastSeen <= now
    ? parsedLastSeen
    : null;
const catchUpSince = lastSeen ?? new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
const allCatchUpGroups: MemberCatchUpGroup[] = user
  ? await buildMemberCatchUp(db, user.memberId, new Date(0), user)
  : [];
const catchUpGroups = allCatchUpGroups
  .map((group) => {
    const items = group.items.filter((item) => item.date >= catchUpSince);
    return items.length
      ? { ...group, items, lastDate: items[0]!.date }
      : null;
  })
  .filter((group): group is MemberCatchUpGroup => Boolean(group));
const catchUpTotal = catchUpGroups.reduce((total, group) => total + group.items.length, 0);
const governanceChanges = allCatchUpGroups
  .flatMap((group) => group.items)
  .filter((item) => ['decision', 'policy', 'amendment'].includes(item.kind))
  .sort((left, right) => right.date.getTime() - left.date.getTime())
  .slice(0, 10);

if (user && (!lastSeen || now.getTime() - lastSeen.getTime() > 30 * 60 * 1000)) {
  Astro.cookies.set(LAST_SEEN_COOKIE, now.toISOString(), {
    path: '/member',
    httpOnly: true,
    sameSite: 'lax',
    secure: Astro.url.protocol === 'https:',
    maxAge: 60 * 60 * 24 * 180,
  });
}

const branchNameById = new Map(memberBranches.map((branch: any) => [branch.branchId, String(branch.name)]));
const outstandingItems = awaitingDecision.map((proposal) => ({
  proposalId: proposal.proposalId,
  slug: proposal.slug,
  title: proposal.title,
  space: proposal.space,
  branchName: proposal.jurisdictionBranchId ? branchNameById.get(proposal.jurisdictionBranchId) : undefined,
}));
const ballotScopes = [...new Set(outstandingItems.map((item) => item.branchName ?? 'All verified members'))];
const eligibilityNote =
  ballotScopes.length === 0
    ? 'Open ballots appear here when you are eligible.'
    : ballotScopes.length === 1
      ? ballotScopes[0] === 'All verified members'
        ? 'Eligible across all open party-wide ballots.'
        : `Open to ${ballotScopes[0]} members.`
      : 'Includes party-wide and branch-scoped ballots.';

const catchUpSinceLabel = lastSeen
  ? `Updates since ${lastSeen.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}.`
  : 'Showing updates from the last seven days.';

const branchActivity = memberBranches.map((branch: any) => ({
  branch,
  proposals: visibleProposals
    .filter((proposal) => [proposal.originatingBranchId, proposal.governanceAuthorityBranchId, proposal.jurisdictionBranchId].includes(branch.branchId))
    .sort((a, b) => branchPriority[a.stage] - branchPriority[b.stage] || new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime())
    .slice(0, 4),
}));

const emailAvailable = emailLoginConfigured(env);
const googleAvailable = googleLoginConfigured(env);
const devLoginAvailable = devLoginEnabled(env);
const requestedView = Astro.url.searchParams.get('view');
const memberView = requestedView === 'activity' || requestedView === 'account' ? requestedView : 'overview';
---
<SiteLayout
  title="My Engage · Fusion Party Australia"
  description="Your votes, ideas, contributions and member account."
  noIndex
>
  <div class="page-wrap section-space member-page" data-view={memberView}>
    {!user ? (
      <>
        <header class="page-intro">
          <h1>Sign in to take part.</h1>
          <p>
            Use the email address and full name on your Fusion Party membership. After your first
            sign-in, an administrator verifies your membership so you can comment and vote.
          </p>
          <p class="signin-legal">
            Member participation is subject to the{' '}
            <a href="/terms/">Terms of Use</a> and{' '}
            <a href="/privacy/">Privacy Policy</a>.
          </p>
        </header>

        <div class="signin-grid">
          {emailAvailable && (
            <section class="signin-box" aria-labelledby="email-signin-heading">
              <h2 id="email-signin-heading">Sign in with an email link</h2>
              <p>We’ll email you a one-click sign-in link—no password required.</p>
              <form id="email-signin-form" class="grid gap-4">
                <Field label="Email address" htmlFor="signin-email">
                  <Input
                    id="signin-email"
                    name="email"
                    type="email"
                    autoComplete="email"
                    maxLength={254}
                    required
                  />
                </Field>
                <Field label="Full name (required for first sign-in)" htmlFor="signin-name">
                  <Input
                    id="signin-name"
                    name="name"
                    autoComplete="name"
                    minLength={2}
                    maxLength={100}
                  />
                </Field>
                <div>
                  <Button type="submit">Email me a sign-in link</Button>
                  <p id="email-status" class="form-status" role="status" aria-live="polite"></p>
                </div>
              </form>
            </section>
          )}

          {googleAvailable && (
            <section class="signin-box" aria-labelledby="google-signin-heading">
              <h2 id="google-signin-heading">Sign in with Google</h2>
              <p>Continue using your Google account.</p>
              <Button id="google-signin" variant="outline">
                Continue with Google
              </Button>
              <p id="google-status" class="form-status" role="status" aria-live="polite"></p>
            </section>
          )}

          {devLoginAvailable && (
            <section class="signin-box" aria-labelledby="dev-signin-heading">
              <h2 id="dev-signin-heading">Local development sign-in</h2>
              <p>Sign in locally as a verified member or administrator to test the platform.</p>
              <form id="dev-signin-form" class="grid gap-4">
                <Field label="Account role" htmlFor="dev-role">
                  <NativeSelect id="dev-role" name="role">
                    <option value="member">Verified Member</option>
                    <option value="administrator">Administrator</option>
                  </NativeSelect>
                </Field>
                <div>
                  <Button type="submit">Sign in locally</Button>
                  <p id="dev-status" class="form-status" role="status" aria-live="polite"></p>
                </div>
              </form>
            </section>
          )}

          {!emailAvailable && !googleAvailable && !devLoginAvailable && (
            <Alert variant="warning">
              <AlertDescription>Member sign-in is temporarily unavailable. Please try again shortly.</AlertDescription>
            </Alert>
          )}
        </div>
      </>
    ) : (
      <>
        <header class="member-header">
          <div class="member-header__main">
            <div class="member-header__title-row">
              <h1>{memberView === 'activity' ? 'Activity & Governance Log' : memberView === 'account' ? 'My Account' : 'My Engage'}</h1>
              <Badge variant={user.status === 'verified' ? 'success' : user.status === 'suspended' ? 'destructive' : 'warning'}>
                {user.status === 'verified' ? 'Verified member' : user.status === 'suspended' ? 'Suspended' : 'Verification pending'}
              </Badge>
              {memberBranches.map((branch: any) => (
                <Badge variant="outline">{branch.name}</Badge>
              ))}
            </div>
            <p class="member-identity">
              {user.name || user.email} · {user.email}
            </p>
          </div>

          <div class="member-header__actions">
            {user.isStaff && (
              <Button href="/admin/" variant="outline" size="sm">
                Admin workspace
              </Button>
            )}
            {user.canParticipate && (
              <Button href="/proposals/new/" variant="outline" size="sm">
                Suggest an idea
              </Button>
            )}
            <Button href="/proposals/?stage=decide" size="sm">
              Browse ballots ({awaitingDecision.length})
            </Button>
          </div>
        </header>

        {user.status !== 'verified' && (
          <Alert className="status-banner" variant={user.status === 'suspended' ? 'destructive' : 'warning'}>
            <AlertDescription>
              {user.status === 'suspended' ? (
                <>
                  <strong>Participation suspended.</strong> Please contact a party administrator regarding your membership status.
                </>
              ) : (
                <>
                  <strong>Membership verification pending.</strong> You can browse all proposals and decisions while an administrator confirms your Fusion Party membership.
                </>
              )}
            </AlertDescription>
          </Alert>
        )}

        <LegalAcceptanceGate />

        <!-- Top 4-Cell Hairline Metric Strip -->
        <div class="member-stat-strip" aria-label="Your participation summary">
          <a href="#awaiting-heading" class="member-stat">
            <span class="member-stat__label">Open votes for you</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{awaitingDecision.length}</strong>
              <span class="member-stat__hint">Eligible unvoted ballots</span>
            </div>
          </a>
          <a href="#opportunities-heading" class="member-stat">
            <span class="member-stat__label">Open for deliberation</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{deliberationOpportunities.length}</strong>
              <span class="member-stat__hint">Active discussions</span>
            </div>
          </a>
          <a href="#catchup-heading" class="member-stat">
            <span class="member-stat__label">Catch-up updates</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{catchUpTotal}</strong>
              <span class="member-stat__hint">{lastSeen ? 'Since last visit' : 'Last 7 days'}</span>
            </div>
          </a>
          <a href="/member/?view=activity#activity-heading" class="member-stat">
            <span class="member-stat__label">Your contributions</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{(activity?.votes.length ?? 0) + (activity?.comments.length ?? 0) + (activity?.proposals.length ?? 0)}</strong>
              <span class="member-stat__hint tabular">{activity?.votes.length ?? 0} votes · {activity?.comments.length ?? 0} stances</span>
            </div>
          </a>
        </div>

        <!-- Underline Workspace Tabs -->
        <nav class="member-tabs" aria-label="My Engage sections">
          <a href="/member/" class="member-tab" aria-current={memberView === 'overview' ? 'page' : undefined}>
            Overview
          </a>
          <a href="/member/?view=activity" class="member-tab" aria-current={memberView === 'activity' ? 'page' : undefined}>
            Activity &amp; Log
            <span class="member-tab__count tabular">{memberTimelineCount}</span>
          </a>
          <a href="/member/?view=account" class="member-tab" aria-current={memberView === 'account' ? 'page' : undefined}>
            Account &amp; Access
          </a>
        </nav>

        <!-- VIEW 1: OVERVIEW (Outstanding votes, Participation opportunities, Catch-up, Status changes) -->
        <div class="overview-only member-overview-grid">
          <!-- Left Column: Actionable Queues -->
          <div class="member-col-main">
            <!-- 1. Open Ballots Queue -->
            <AttentionQueue
              items={outstandingItems}
              canParticipate={Boolean(user.canParticipate)}
              eligibilityNote={eligibilityNote}
            />

            <!-- 2. Relevant Participation Opportunities (Deliberation & Amendments) -->
            <section class="member-panel" aria-labelledby="opportunities-heading">
              <div class="member-panel__head">
                <div>
                  <div class="member-panel__title-row">
                    <h2 id="opportunities-heading">Open for deliberation &amp; amendments</h2>
                    <Badge variant="secondary" className="tabular">{deliberationOpportunities.length}</Badge>
                  </div>
                  <p>Proposals currently in Stage 2 (Deliberate) where your stance or wording suggestion can shape the final ballot.</p>
                </div>
                <Button href="/proposals/?stage=deliberate" variant="ghost" size="sm">All discussions</Button>
              </div>

              {deliberationOpportunities.length === 0 ? (
                <p class="member-panel__empty">No proposals are currently in active deliberation.</p>
              ) : (
                <>
                  <ul class="opportunity-list">
                    {deliberationOpportunities.slice(0, 6).map((item) => (
                      <li class="opportunity-row">
                        <div class="opportunity-row__body">
                          <div class="opportunity-row__meta">
                            <span class="tabular opportunity-id">{item.proposalId}</span>
                            <span class="opportunity-space">{item.space}</span>
                            <span class="tabular opportunity-count">{item.commentCount} {item.commentCount === 1 ? 'stance' : 'stances'}</span>
                          </div>
                          <a class="opportunity-title" href={`/proposals/${item.slug}/`}>{item.title}</a>
                        </div>
                        <Button href={`/proposals/${item.slug}/#deliberation`} variant="outline" size="sm">
                          Contribute
                        </Button>
                      </li>
                    ))}
                  </ul>
                  {deliberationOpportunities.length > 6 && (
                    <div class="member-panel__footer">
                      <a href="/proposals/?stage=deliberate">
                        Explore all {deliberationOpportunities.length} proposals in discussion →
                      </a>
                    </div>
                  )}
                </>
              )}
            </section>

            <!-- 3. Branch Activity & Authored Ideas (if applicable) -->
            {branchActivity.length > 0 && (
              <section class="member-panel" aria-labelledby="branch-activity-heading">
                <div class="member-panel__head">
                  <div>
                    <h2 id="branch-activity-heading">Activity in your branches</h2>
                    <p>Proposals originating in or governed by your recognised branch memberships.</p>
                  </div>
                </div>
                <div class="branch-groups">
                  {branchActivity.map(({ branch, proposals }) => (
                    <div class="branch-group" aria-labelledby={`branch-activity-${branch.branchId}`}>
                      <div class="branch-group__head">
                        <h3 id={`branch-activity-${branch.branchId}`}>{branch.name}</h3>
                        <a href={`/proposals/?branch=${encodeURIComponent(branch.branchId)}`}>All branch proposals →</a>
                      </div>
                      {proposals.length ? (
                        <ul class="opportunity-list">
                          {proposals.map((proposal) => (
                            <li class="opportunity-row">
                              <div class="opportunity-row__body">
                                <div class="opportunity-row__meta">
                                  <span class="tabular opportunity-id">{proposal.proposalId}</span>
                                  <Badge variant="outline">
                                    {proposal.stage === 'decide' ? 'Open vote' : proposal.stage === 'deliberate' ? 'In discussion' : proposal.stage === 'implement' ? 'Implement' : 'New idea'}
                                  </Badge>
                                </div>
                                <a class="opportunity-title" href={`/proposals/${proposal.slug}/`}>{proposal.title}</a>
                              </div>
                              <Button href={`/proposals/${proposal.slug}/`} size="sm" variant="ghost">Open</Button>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="member-panel__empty">No active proposals currently involve this branch.</p>
                      )}
                    </div>
                  ))}
                </div>
              </section>
            )}

            {activity?.proposals && activity.proposals.length > 0 && (
              <section class="member-panel" aria-labelledby="proposals-heading">
                <div class="member-panel__head">
                  <div>
                    <h2 id="proposals-heading">Ideas you authored ({activity.proposals.length})</h2>
                    <p>Proposals you submitted to the platform.</p>
                  </div>
                </div>
                <ul class="opportunity-list">
                  {activity.proposals.map((p) => (
                    <li class="opportunity-row">
                      <div class="opportunity-row__body">
                        <div class="opportunity-row__meta">
                          <span class="opportunity-space">{p.space}</span>
                          <Badge variant="outline">
                            {p.stage === 'decide' ? 'Open vote' : p.stage === 'deliberate' ? 'In discussion' : p.stage === 'implement' ? 'Implement' : 'New idea'}
                          </Badge>
                        </div>
                        <a class="opportunity-title" href={`/proposals/${p.slug}/`}>{p.title}</a>
                      </div>
                      <Button href={`/proposals/${p.slug}/`} size="sm" variant="outline">View</Button>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>

          <!-- Right Column: Catch-Up Digest & Governance Status Change Log -->
          <div class="member-col-rail">
            <CatchUpDigest
              groups={catchUpGroups}
              total={catchUpTotal}
              sinceLabel={catchUpSinceLabel}
              hasLastVisit={Boolean(lastSeen)}
            />

            <GovernanceLog items={governanceChanges} />
          </div>
        </div>

        <!-- VIEW 2: ACTIVITY & LOG -->
        <div class="activity-only member-activity-view">
          <div class="member-overview-grid">
            <div class="member-col-main">
              {activity && (
                <div class="member-timeline-card">
                  <ActivityTimeline
                    client:load
                    groups={memberTimeline}
                    title="Your participation log"
                    description="Votes, ideas, contributions, amendments, and endorsements you recorded, newest first."
                    badge={`${memberTimelineCount} ${memberTimelineCount === 1 ? 'entry' : 'entries'}`}
                    headingId="activity-heading"
                    filters={[
                      { id: 'all', label: 'All' },
                      { id: 'vote', label: 'Votes' },
                      { id: 'contribution', label: 'Contributions' },
                      { id: 'proposal', label: 'Ideas' },
                      { id: 'amendment', label: 'Amendments' },
                      { id: 'endorsement', label: 'Endorsements' },
                      { id: 'governance', label: 'Outcomes' },
                    ]}
                    searchable
                    emptyMessage="Your votes, contributions, and ideas will appear here as you participate."
                  />
                </div>
              )}
            </div>

            <div class="member-col-rail">
              <GovernanceLog items={governanceChanges} />
              <CatchUpDigest
                groups={catchUpGroups}
                total={catchUpTotal}
                sinceLabel={catchUpSinceLabel}
                hasLastVisit={Boolean(lastSeen)}
                idPrefix="activity-catchup"
              />
            </div>
          </div>
        </div>

        <!-- VIEW 3: ACCOUNT & ACCESS -->
        {memberView === 'account' && (
          <div class="account-settings" id="account-settings">
            <MemberSettings
              client:load
              name={user.name}
              email={user.email}
              role={user.role}
              status={user.status}
              canParticipate={user.canParticipate}
              branches={memberBranches.map((branch: any) => ({ id: branch.branchId, name: branch.name }))}
              stats={{
                votes: activity?.votes.length ?? 0,
                contributions: activity?.comments.length ?? 0,
                ideas: activity?.proposals.length ?? 0,
              }}
            />
          </div>
        )}
      </>
    )}
  </div>
</SiteLayout>

<script>
  import { createAuthClient } from 'better-auth/client';
  import { magicLinkClient } from 'better-auth/client/plugins';

  const authClient = createAuthClient({ plugins: [magicLinkClient()] });

  const emailForm = document.querySelector<HTMLFormElement>('#email-signin-form');
  const emailStatus = document.querySelector<HTMLElement>('#email-status');
  const googleStatus = document.querySelector<HTMLElement>('#google-status');
  const errorCode = new URLSearchParams(location.search).get('error');
  if (errorCode) {
    if (errorCode === 'link') {
      if (emailStatus) {
        emailStatus.textContent =
          'That sign-in link has expired or was already used. Request a new link below.';
      }
    } else if (errorCode === 'google' || errorCode === 'invalid_code') {
      if (googleStatus) {
        googleStatus.textContent =
          'Google sign-in could not be completed. Please try again or use email sign-in.';
      }
    } else if (emailStatus) {
      emailStatus.textContent =
        'Sign-in could not be completed. Please try again.';
    }
  }

  emailForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailStatus || !emailForm.reportValidity()) return;
    const btn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    emailStatus.textContent = 'Sending sign-in link…';

    try {
      const data = new FormData(emailForm);
      const result = await authClient.signIn.magicLink({
        email: String(data.get('email')).trim(),
        name: String(data.get('name')).trim() || undefined,
        callbackURL: '/member/',
        errorCallbackURL: '/member/?error=link',
      });
      if (result.error) {
        if (result.error.code === 'NAME_REQUIRED') {
          emailStatus.textContent = 'Please enter your full name for your first sign-in.';
          const nameInput = emailForm.querySelector<HTMLInputElement>('[name="name"]')!;
          nameInput.required = true;
          nameInput.focus();
        } else if (result.error.status === 429) {
          emailStatus.textContent = 'Too many attempts. Please wait a minute and try again.';
        } else {
          emailStatus.textContent = 'Could not send sign-in link. Please try again shortly.';
        }
      } else {
        emailStatus.textContent =
          'Check your email inbox for your sign-in link (valid for 10 minutes).';
      }
    } catch {
      emailStatus.textContent = 'Could not send sign-in link. Please try again shortly.';
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelector('#google-signin')?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#google-status')!;
    status.textContent = 'Redirecting to Google…';
    try {
      const result = await authClient.signIn.social({
        provider: 'google',
        callbackURL: '/member/',
        errorCallbackURL: '/member/?error=google',
      });
      if (result.error) {
        status.textContent = 'Google sign-in is unavailable right now.';
      }
    } catch {
      status.textContent = 'Google sign-in is unavailable right now.';
    }
  });

  const devForm = document.querySelector<HTMLFormElement>('#dev-signin-form');
  devForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const role = new FormData(devForm).get('role');
    const res = await fetch('/api/session', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ role }),
    });
    if (res.ok) location.reload();
  });
</script>

<style>
  .member-page {
    max-width: 84rem;
    padding-top: 1.5rem;
    padding-bottom: 3.5rem;
  }

  .member-page[data-view="activity"] .overview-only,
  .member-page[data-view="activity"] .account-only {
    display: none;
  }

  .member-page[data-view="account"] .overview-only,
  .member-page[data-view="account"] .activity-only {
    display: none;
  }

  .member-page[data-view="overview"] .activity-only,
  .member-page[data-view="overview"] .account-only {
    display: none;
  }

  /* Sign-in Views */
  .signin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
