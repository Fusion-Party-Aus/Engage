---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Card } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Alert, AlertDescription } from '../../components/ui/alert';
import { Badge } from '../../components/ui/badge';
import { Field } from '../../components/ui/field';
import { Input } from '../../components/ui/input';
import { NativeSelect } from '../../components/ui/native-select';
import {
  devLoginEnabled,
  emailLoginConfigured,
  getSessionUser,
  googleLoginConfigured,
} from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { listOutstandingDecisions, listProposals, listUserActivity } from '../../lib/store.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const activity = user ? await listUserActivity(db, user.memberId) : null;
const awaitingDecision = user?.canParticipate ? await listOutstandingDecisions(db, user.memberId, user) : [];
const memberBranches = user?.activeBranchIds?.length
  ? await db.collection('branches').find({ branchId: { $in: user.activeBranchIds }, recognised: true }).sort({ name: 1 }).toArray()
  : [];
const branchProposals = memberBranches.length ? await listProposals(db, { user }) : [];
const branchPriority = { decide: 0, deliberate: 1, propose: 2, implement: 3, archived: 4 };
const branchActivity = memberBranches.map((branch: any) => ({
  branch,
  proposals: branchProposals
    .filter((proposal) => [proposal.originatingBranchId, proposal.governanceAuthorityBranchId, proposal.jurisdictionBranchId].includes(branch.branchId))
    .sort((a, b) => branchPriority[a.stage] - branchPriority[b.stage] || new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime())
    .slice(0, 3),
}));
const emailAvailable = emailLoginConfigured(env);
const googleAvailable = googleLoginConfigured(env);
const devLoginAvailable = devLoginEnabled(env);
const requestedView = Astro.url.searchParams.get('view');
const memberView = requestedView === 'activity' || requestedView === 'account' ? requestedView : 'overview';
---
<SiteLayout
  title="My Engage · Fusion Party Australia"
  description="Your votes, ideas, contributions and member account."
  noIndex
>
  <div class="page-wrap section-space member-page" data-view={memberView}>
    {!user ? (
      <>
        <header class="page-intro">
          <h1>Sign in to take part.</h1>
          <p>
            Use the email address and full name on your Fusion Party membership. After your first
            sign-in, an administrator verifies your membership so you can comment and vote.
          </p>
        </header>

        <div class="signin-grid">
          {emailAvailable && (
            <section class="signin-box" aria-labelledby="email-signin-heading">
              <h2 id="email-signin-heading">Sign in with an email link</h2>
              <p>We’ll email you a one-click sign-in link—no password required.</p>
              <form id="email-signin-form" class="grid gap-4">
                <Field label="Email address" htmlFor="signin-email">
                  <Input
                    id="signin-email"
                    name="email"
                    type="email"
                    autoComplete="email"
                    maxLength={254}
                    required
                  />
                </Field>
                <Field label="Full name (required for first sign-in)" htmlFor="signin-name">
                  <Input
                    id="signin-name"
                    name="name"
                    autoComplete="name"
                    minLength={2}
                    maxLength={100}
                  />
                </Field>
                <div>
                  <Button type="submit">Email me a sign-in link</Button>
                  <p id="email-status" class="form-status" role="status" aria-live="polite"></p>
                </div>
              </form>
            </section>
          )}

          {googleAvailable && (
            <section class="signin-box" aria-labelledby="google-signin-heading">
              <h2 id="google-signin-heading">Sign in with Google</h2>
              <p>Continue using your Google account.</p>
              <Button id="google-signin" variant="outline">
                Continue with Google
              </Button>
              <p id="google-status" class="form-status" role="status" aria-live="polite"></p>
            </section>
          )}

          {devLoginAvailable && (
            <section class="signin-box" aria-labelledby="dev-signin-heading">
              <h2 id="dev-signin-heading">Local development sign-in</h2>
              <p>Sign in locally as a verified member or administrator to test the platform.</p>
              <form id="dev-signin-form" class="grid gap-4">
                <Field label="Account role" htmlFor="dev-role">
                  <NativeSelect id="dev-role" name="role">
                    <option value="member">Verified Member</option>
                    <option value="administrator">Administrator</option>
                  </NativeSelect>
                </Field>
                <div>
                  <Button type="submit">Sign in locally</Button>
                  <p id="dev-status" class="form-status" role="status" aria-live="polite"></p>
                </div>
              </form>
            </section>
          )}

          {!emailAvailable && !googleAvailable && !devLoginAvailable && (
            <Alert variant="warning">
              <AlertDescription>Member sign-in is temporarily unavailable. Please try again shortly.</AlertDescription>
            </Alert>
          )}
        </div>
      </>
    ) : (
      <>
        <header class="account-header">
          <div>
            <h1>{memberView === 'activity' ? 'Activity' : memberView === 'account' ? 'My account' : 'My Engage'}</h1>
            <p>{user.email}</p>
          </div>
          <div class="account-header__actions">
            {user.isStaff && (
              <Button href="/admin/" variant="outline">
                Review admin tasks →
              </Button>
            )}
            <Button href="/proposals/?stage=decide">
              See open votes →
            </Button>
          </div>
        </header>

        <div class="member-overview" aria-label="Your participation at a glance"><a href="#awaiting-heading"><svg class="nav-icon" aria-hidden="true"><use href="#icon-vote" /></svg><strong>{awaitingDecision.length}</strong><span>Votes for you</span></a><a href="/member/?view=activity#comments-heading"><svg class="nav-icon" aria-hidden="true"><use href="#icon-files" /></svg><strong>{activity?.comments.length ?? 0}</strong><span>Contributions</span></a><a href="/member/#proposals-heading"><svg class="nav-icon" aria-hidden="true"><use href="#icon-home" /></svg><strong>{activity?.proposals.length ?? 0}</strong><span>Your ideas</span></a></div>
        <nav class="account-shortcuts" aria-label="My Engage sections"><Button href="/member/" variant={memberView === 'overview' ? 'secondary' : 'ghost'} size="sm" aria-current={memberView === 'overview' ? 'page' : undefined}>Overview</Button><Button href="/member/?view=activity" variant={memberView === 'activity' ? 'secondary' : 'ghost'} size="sm" aria-current={memberView === 'activity' ? 'page' : undefined}>Activity</Button><Button href="/member/?view=account" variant={memberView === 'account' ? 'secondary' : 'ghost'} size="sm" aria-current={memberView === 'account' ? 'page' : undefined}>My account</Button></nav>

        <Alert className="status-banner" variant={user.status === 'verified' ? 'success' : user.status === 'suspended' ? 'destructive' : 'warning'}>
          <AlertDescription>
            {user.status === 'verified' ? (
              <>
                <strong>Membership verified.</strong> You can suggest ideas and join discussions. Voting also depends on the eligibility rules for each ballot.
              </>
            ) : user.status === 'suspended' ? (
              <>
                <strong>Participation suspended.</strong> Please contact a party administrator
                regarding your membership status.
              </>
            ) : (
              <>
                <strong>Membership verification pending.</strong> You can browse all proposals and decisions while
                an administrator confirms your Fusion Party membership. Make sure your full name
                below matches your party membership record.
              </>
            )}
          </AlertDescription>
        </Alert>

        <Card className="account-section overview-only" aria-labelledby="awaiting-heading">
          <h2 id="awaiting-heading">Votes for you ({awaitingDecision.length})</h2>
          {!user.canParticipate ? <p class="muted-note">Your membership must be verified before you can vote.</p> : awaitingDecision.length === 0 ? <p class="muted-note">You’re up to date on open decisions.</p> : (
            <><ul class="activity-list">{awaitingDecision.slice(0, 5).map((p) => <li class="activity-row"><div><a class="activity-title" href={`/proposals/${p.slug}/`}>{p.title}</a><span class="activity-sub">{p.space}</span></div><Button href={`/proposals/${p.slug}/`} size="sm">Review &amp; vote</Button></li>)}</ul>{awaitingDecision.length > 5 && <details class="more-votes"><summary>Show {awaitingDecision.length - 5} more votes</summary><ul class="activity-list">{awaitingDecision.slice(5).map((p) => <li class="activity-row"><div><a class="activity-title" href={`/proposals/${p.slug}/`}>{p.title}</a><span class="activity-sub">{p.space}</span></div><Button href={`/proposals/${p.slug}/`} size="sm" variant="outline">Review</Button></li>)}</ul></details>}</>
          )}
        </Card>

        {branchActivity.length > 0 && <Card className="account-section overview-only" aria-labelledby="branch-activity-heading">
          <h2 id="branch-activity-heading">Activity in your branches</h2>
          {branchActivity.map(({ branch, proposals }) => <section class="branch-activity" aria-labelledby={`branch-activity-${branch.branchId}`}>
            <div class="branch-activity__heading"><h3 id={`branch-activity-${branch.branchId}`}>{branch.name}</h3><a href={`/proposals/?branch=${encodeURIComponent(branch.branchId)}`}>All branch activity →</a></div>
            {proposals.length ? <ul class="activity-list">{proposals.map((proposal) => <li class="activity-row"><div><a class="activity-title" href={`/proposals/${proposal.slug}/`}>{proposal.title}</a><span class="activity-sub">{proposal.stage === 'decide' ? 'Open vote' : proposal.stage === 'deliberate' ? 'In discussion' : proposal.stage === 'implement' ? 'Implement' : 'New idea'}</span></div><Button href={`/proposals/${proposal.slug}/`} size="sm" variant="outline">View</Button></li>)}</ul> : <p class="muted-note">No current proposals involve this branch.</p>}
          </section>)}
        </Card>}

        {activity?.proposals && activity.proposals.length > 0 && (
          <Card className="account-section overview-only" aria-labelledby="proposals-heading">
          <h2 id="proposals-heading">Ideas you started ({activity.proposals.length})</h2>
            <ul class="activity-list">
              {activity.proposals.map((p) => (
                <li class="activity-row">
                  <div>
                    <a class="activity-title" href={`/proposals/${p.slug}/`}>
                      {p.title}
                    </a>
                    <span class="activity-sub">
                      {p.space} · {p.stage === 'decide' ? 'Open vote' : p.stage === 'deliberate' ? 'In discussion' : p.stage === 'implement' ? 'Implement' : 'New idea'}
                    </span>
                  </div>
                  <Button href={`/proposals/${p.slug}/`} size="sm" variant="outline">
                    View
                  </Button>
                </li>
              ))}
            </ul>
          </Card>
        )}

        <Card className="account-section activity-only" aria-labelledby="votes-heading">
          <h2 id="votes-heading">Your recorded votes ({activity?.votes.length ?? 0})</h2>
          {!activity?.votes.length ? (
            <p class="muted-note">
              You have not voted on any decisions yet. Visit{' '}
              <a href="/proposals/?stage=decide">See open votes</a> to participate.
            </p>
          ) : (
            <ul class="activity-list">
              {activity.votes.map((v) => (
                <li class="activity-row">
                  <div>
                    <a class="activity-title" href={`/proposals/${v.proposalSlug}/`}>
                      {v.proposalTitle}
                    </a>
                    <span class="activity-sub">
                      Updated{' '}
                      {new Date(v.updatedAt).toLocaleDateString('en-AU', { dateStyle: 'medium' })}
                      {v.reason ? ` · Reason: "${v.reason}"` : ''}
                    </span>
                  </div>
                  <Badge variant={v.choice === 'approve' ? 'success' : v.choice === 'abstain' ? 'info' : 'destructive'}>
                    Voted: {v.choice.toUpperCase()}
                  </Badge>
                </li>
              ))}
            </ul>
          )}
        </Card>

        <Card className="account-section activity-only" aria-labelledby="comments-heading">
          <h2 id="comments-heading">Your contributions ({activity?.comments.length ?? 0})</h2>
          {!activity?.comments.length ? (
            <p class="muted-note">
              You have not joined a discussion yet. Open an idea in{' '}
              <a href="/proposals/">Browse proposals</a> to share your feedback or suggest a wording change.
            </p>
          ) : (
            <ul class="activity-list">
              {activity.comments.map((c) => (
                <li class="activity-row">
                  <div>
                    <a class="activity-title" href={`/proposals/${c.proposalSlug}/#deliberation`}>
                      {c.proposalTitle}
                    </a>
                    <p class="activity-body">{c.body}</p>
                  </div>
                  <Badge variant="outline">
                    Stance: {c.stance}
                  </Badge>
                </li>
              ))}
            </ul>
          )}
        </Card>
        <details class="account-section account-settings account-only" id="account-settings" open={memberView === 'account'}><summary>Account settings</summary><section aria-labelledby="profile-heading">
          <h2 id="profile-heading">Your display name</h2>
          <form id="profile-form" class="profile-form">
            <Field label="Full name" htmlFor="profile-name">
              <Input
                id="profile-name"
                name="name"
                defaultValue={user.name}
                autoComplete="name"
                required
                minLength={2}
                maxLength={100}
              />
            </Field>
            <Button type="submit" variant="outline">Save name</Button>
            <p id="profile-status" class="form-status" role="status" aria-live="polite"></p>
          </form>
        </section></details>

      </>
    )}
  </div>
</SiteLayout>

<script>
  import { createAuthClient } from 'better-auth/client';
  import { magicLinkClient } from 'better-auth/client/plugins';

  const authClient = createAuthClient({ plugins: [magicLinkClient()] });

  const emailForm = document.querySelector<HTMLFormElement>('#email-signin-form');
  const emailStatus = document.querySelector<HTMLElement>('#email-status');
  const googleStatus = document.querySelector<HTMLElement>('#google-status');
  const errorCode = new URLSearchParams(location.search).get('error');
  if (errorCode) {
    if (errorCode === 'link') {
      if (emailStatus) {
        emailStatus.textContent =
          'That sign-in link has expired or was already used. Request a new link below.';
      }
    } else if (errorCode === 'google' || errorCode === 'invalid_code') {
      if (googleStatus) {
        googleStatus.textContent =
          'Google sign-in could not be completed. Please try again or use email sign-in.';
      }
    } else if (emailStatus) {
      emailStatus.textContent =
        'Sign-in could not be completed. Please try again.';
    }
  }

  emailForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailStatus || !emailForm.reportValidity()) return;
    const btn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    emailStatus.textContent = 'Sending sign-in link…';

    try {
      const data = new FormData(emailForm);
      const result = await authClient.signIn.magicLink({
        email: String(data.get('email')).trim(),
        name: String(data.get('name')).trim() || undefined,
        callbackURL: '/member/',
        errorCallbackURL: '/member/?error=link',
      });
      if (result.error) {
        if (result.error.code === 'NAME_REQUIRED') {
          emailStatus.textContent = 'Please enter your full name for your first sign-in.';
          const nameInput = emailForm.querySelector<HTMLInputElement>('[name="name"]')!;
          nameInput.required = true;
          nameInput.focus();
        } else if (result.error.status === 429) {
          emailStatus.textContent = 'Too many attempts. Please wait a minute and try again.';
        } else {
          emailStatus.textContent = 'Could not send sign-in link. Please try again shortly.';
        }
      } else {
        emailStatus.textContent =
          'Check your email inbox for your sign-in link (valid for 10 minutes).';
      }
    } catch {
      emailStatus.textContent = 'Could not send sign-in link. Please try again shortly.';
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelector('#google-signin')?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#google-status')!;
    status.textContent = 'Redirecting to Google…';
    try {
      const result = await authClient.signIn.social({
        provider: 'google',
        callbackURL: '/member/',
        errorCallbackURL: '/member/?error=google',
      });
      if (result.error) {
        status.textContent = 'Google sign-in is unavailable right now.';
      }
    } catch {
      status.textContent = 'Google sign-in is unavailable right now.';
    }
  });

  const devForm = document.querySelector<HTMLFormElement>('#dev-signin-form');
  devForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const role = new FormData(devForm).get('role');
    const res = await fetch('/api/session', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ role }),
    });
    if (res.ok) location.reload();
  });

  const profileForm = document.querySelector<HTMLFormElement>('#profile-form');
  profileForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!profileForm.reportValidity()) return;
    const status = document.querySelector<HTMLElement>('#profile-status')!;
    const btn = profileForm.querySelector<HTMLButtonElement>('button')!;
    btn.disabled = true;
    status.textContent = 'Saving…';
    try {
      const name = String(new FormData(profileForm).get('name')).trim();
      const result = await authClient.updateUser({ name });
      status.textContent = result.error ? 'Could not save name.' : 'Name saved.';
    } catch {
      status.textContent = 'Could not save name.';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .account-shortcuts { display:flex; flex-wrap:wrap; gap:.55rem 1.5rem; padding:.8rem 0; margin:1rem 0; border-block:1px solid var(--horizon-line); font-weight:600; }
  .account-settings summary { cursor:pointer; font-weight:700; font-size:1.15rem; }
  .account-settings[open] summary { margin-bottom:1.5rem; }
  .more-votes { margin-top:1rem; }
  .more-votes summary { cursor:pointer; font-weight:700; }
  .more-votes .activity-list { margin-top:1rem; }
  .member-page {
    max-width: 62rem;
  }
  .signin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .signin-box {
    padding: 1.75rem;
    background: var(--horizon-lavender-soft);
    border: 1px solid var(--horizon-line);
    border-radius: 0.85rem;
  }
  .signin-box h2 {
    margin: 0 0 0.45rem;
    font-size: 1.55rem;
  }
  .signin-box p {
    margin: 0 0 1rem;
    color: var(--horizon-muted);
  }

  .account-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 1.5rem;
  }
  .account-header h1 {
    margin: 0 0 0.25rem;
  }
  .account-header p {
    margin: 0;
    color: var(--horizon-muted);
    font-size: 1.05rem;
  }
  .account-header__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .status-banner {
    margin-bottom: 2rem;
  }

  .account-section {
    padding-top: 2rem;
    margin-top: 2rem;
    border-top: 1px solid var(--horizon-line);
  }
  .account-section h2 {
    margin: 0 0 1rem;
    font-size: 1.65rem;
  }
  .profile-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.85rem 1rem;
  }
  .profile-form [data-slot="field"] {
    margin: 0;
    min-width: min(100%, 20rem);
  }
  .profile-form .form-status {
    width: 100%;
    margin: 0;
  }

  .muted-note {
    color: var(--horizon-muted);
    margin: 0;
  }
  .activity-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--horizon-line);
  }
  .activity-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--horizon-line);
  }
  .activity-row > div { min-width: 0; overflow-wrap: anywhere; }
  .activity-title {
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    display: block;
  }
  .activity-title:hover {
    text-decoration: underline;
  }
  .activity-sub {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--horizon-muted);
  }
  .activity-body {
    margin: 0.35rem 0 0;
    color: var(--horizon-muted);
    font-size: 0.94rem;
    max-width: 62ch;
  }
  @media (max-width: 520px) {
    .activity-row { flex-wrap: wrap; gap: 0.65rem; }
    .activity-row > :last-child { max-width: 100%; }
  }

  .member-page { max-width:84rem; }
  .member-page[data-view="activity"] .overview-only,.member-page[data-view="activity"] .account-only,.member-page[data-view="activity"] .member-overview,.member-page[data-view="activity"] .status-banner { display:none; }
  .member-page[data-view="account"] .overview-only,.member-page[data-view="account"] .activity-only,.member-page[data-view="account"] .member-overview { display:none; }
  .member-page[data-view="overview"] .activity-only,.member-page[data-view="overview"] .account-only { display:none; }
  .account-shortcuts { display:flex; flex-wrap:wrap; gap:1.4rem; }
  .account-shortcuts a { text-decoration:none; padding:.55rem .15rem; font-weight:700; }
  .account-shortcuts a[aria-current="page"] { border-bottom:3px solid #6b48db; }
  .account-header { margin-bottom:1.2rem; }
  .account-header h1 { font:700 clamp(2rem,4vw,3rem)/1.1 Outfit,sans-serif; }
  .member-overview { display:grid; grid-template-columns:repeat(3,1fr); gap:.8rem; }
  .member-overview a { display:grid; gap:.15rem; padding:1.2rem; background:#fff; border:1px solid var(--horizon-line); border-radius:.7rem; text-decoration:none; }
  .member-overview .nav-icon { width:1.5rem; height:1.5rem; color:#613bcd; }
  .member-overview strong { font-size:1.6rem; line-height:1.1; }
  .member-overview span { font-size:.85rem; }
  .account-shortcuts { border-bottom:1px solid var(--horizon-line); padding-block:.9rem; }
  .account-section { background:#fff; border:1px solid var(--horizon-line); border-radius:.7rem; padding:1.3rem 1.5rem; margin-top:1rem; }
  .account-section h2 { font-size:1.25rem; }
  .activity-list { border-top:0; }
  .activity-row:last-child { border-bottom:0; }
  .branch-activity + .branch-activity { margin-top:1rem; padding-top:1rem; border-top:1px solid var(--horizon-line); }
  .branch-activity__heading { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:.5rem 1rem; }
  .branch-activity__heading h3 { margin:0; font-size:1rem; }
  .branch-activity__heading a { font-size:.88rem; font-weight:600; }
  .status-banner { margin:1rem 0; }
  @media(max-width:600px){.member-overview{grid-template-columns:1fr;gap:.45rem}.member-overview a{display:flex;align-items:center;gap:.7rem;padding:.7rem 1rem}.member-overview strong{font-size:1.3rem}.member-overview span{font-size:.85rem}.account-section{padding:1rem}}
</style>
