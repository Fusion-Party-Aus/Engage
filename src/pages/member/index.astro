---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalAcceptanceGate from '../../components/legal/LegalAcceptanceGate.astro';
import { Badge } from '../../components/ui/badge';
import { Button } from '../../components/ui/button';
import { Alert, AlertDescription } from '../../components/ui/alert';
import { Field } from '../../components/ui/field';
import { Input } from '../../components/ui/input';
import { NativeSelect } from '../../components/ui/native-select';
import MemberSettings from '../../components/member/MemberSettings';
import MemberOnboarding from '../../components/member/MemberOnboarding';
import ActivityTimeline from '../../components/blocks/timeline-3';
import AttentionQueue from '../../components/member/AttentionQueue.astro';
import CatchUpDigest from '../../components/member/CatchUpDigest.astro';
import GovernanceLog from '../../components/member/GovernanceLog.astro';
import {
  ArrowRight,
  Compass,
  Fingerprint,
  KeyRound,
  Mail,
  Sparkles,
} from 'lucide-react';
import { buildActivityTimeline, type ActivityTimelineEvent } from '../../lib/activity-timeline.ts';
import { buildMemberCatchUp, listMemberActivityStream, type MemberCatchUpGroup } from '../../lib/member-activity.ts';
import {
  devLoginEnabled,
  emailLoginConfigured,
  getSessionUser,
  googleLoginConfigured,
  passkeyLoginConfigured,
} from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import EmailPreferences from '../../components/member/EmailPreferences.astro';
import { ballotExpired, ballotDeadlineLabel } from '../../lib/ballot-deadline.ts';
import { digestBallots } from '../../lib/engagement-email.ts';
import { listOutstandingDecisions, listProposals, listUserActivity } from '../../lib/store.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const [db, user] = await Promise.all([
  getDatabase(env),
  getSessionUser(Astro.request, env),
]);

const [
  activity,
  memberTimelineEvents,
  awaitingDecision,
  memberBranches,
  visibleProposals,
  allCatchUpGroups,
  userPasskeyCount,
] = user
  ? await Promise.all([
      listUserActivity(db, user.memberId),
      listMemberActivityStream(db, user.memberId),
      user.canParticipate ? listOutstandingDecisions(db, user.memberId, user) : Promise.resolve([]),
      user.activeBranchIds?.length
        ? db
            .collection('branches')
            .find({ branchId: { $in: user.activeBranchIds }, recognised: true })
            .sort({ name: 1 })
            .toArray()
        : Promise.resolve([]),
      listProposals(db, { user }),
      buildMemberCatchUp(db, user.memberId, new Date(0), user),
      db
        .collection('passkey')
        .countDocuments({ userId: user.memberId })
        .catch(() => 0),
    ])
  : [null, [] as ActivityTimelineEvent[], [], [], [], [] as MemberCatchUpGroup[], 0];

const [emailPreference, closingSoon] = user ? await Promise.all([
 db.collection('engagement_email_preferences').findOne({memberId:user.memberId}),
 digestBallots(db,user,visibleProposals),
]) : [null, []];
const involvedIds = new Set([...(activity?.proposals ?? []).map(p=>p.proposalId), ...(activity?.votes ?? []).map(v=>v.proposalId), ...(activity?.comments ?? []).map(c=>c.proposalId)]);
const lifecycleItems = visibleProposals.filter(p=>involvedIds.has(p.proposalId) && (p.stage === 'implement' || p.stage === 'archived' || ballotExpired(p))).sort((a,b)=>new Date(b.updatedAt).getTime()-new Date(a.updatedAt).getTime()).slice(0,8);
const memberTimeline = buildActivityTimeline(memberTimelineEvents);
const memberTimelineCount = memberTimelineEvents.length;
const deliberationOpportunities = visibleProposals
  .filter((proposal) => proposal.stage === 'deliberate')
  .sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime());

const branchPriority = { decide: 0, deliberate: 1, propose: 2, implement: 3, archived: 4 };

const now = new Date();
const LAST_SEEN_COOKIE = 'engage_member_last_seen';
const rawLastSeen = Astro.cookies.get(LAST_SEEN_COOKIE)?.value;
const parsedLastSeen = rawLastSeen ? new Date(rawLastSeen) : null;
const lastSeen =
  parsedLastSeen && !Number.isNaN(parsedLastSeen.getTime()) && parsedLastSeen <= now
    ? parsedLastSeen
    : null;
const catchUpSince = lastSeen ?? new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
const catchUpGroups = allCatchUpGroups
  .map((group) => {
    const items = group.items.filter((item) => item.date >= catchUpSince);
    return items.length
      ? { ...group, items, lastDate: items[0]!.date }
      : null;
  })
  .filter((group): group is MemberCatchUpGroup => Boolean(group));
const catchUpTotal = catchUpGroups.reduce((total, group) => total + group.items.length, 0);
const governanceChanges = allCatchUpGroups
  .flatMap((group) => group.items)
  .filter((item) => ['decision', 'policy', 'amendment'].includes(item.kind))
  .sort((left, right) => right.date.getTime() - left.date.getTime())
  .slice(0, 10);

if (user && (!lastSeen || now.getTime() - lastSeen.getTime() > 30 * 60 * 1000)) {
  Astro.cookies.set(LAST_SEEN_COOKIE, now.toISOString(), {
    path: '/member',
    httpOnly: true,
    sameSite: 'lax',
    secure: Astro.url.protocol === 'https:',
    maxAge: 60 * 60 * 24 * 180,
  });
}

const branchNameById = new Map(memberBranches.map((branch: any) => [branch.branchId, String(branch.name)]));
const outstandingItems = awaitingDecision.map((proposal) => ({
  proposalId: proposal.proposalId,
  slug: proposal.slug,
  title: proposal.title,
  space: proposal.space,
  ballotClosesAt: proposal.ballotClosesAt,
  branchName: proposal.jurisdictionBranchId ? branchNameById.get(proposal.jurisdictionBranchId) : undefined,
}));
const ballotScopes = [...new Set(outstandingItems.map((item) => item.branchName ?? 'All verified members'))];
const eligibilityNote =
  ballotScopes.length === 0
    ? 'Open ballots appear here when you are eligible.'
    : ballotScopes.length === 1
      ? ballotScopes[0] === 'All verified members'
        ? 'Eligible across all open party-wide ballots.'
        : `Open to ${ballotScopes[0]} members.`
      : 'Includes party-wide and branch-scoped ballots.';

const catchUpSinceLabel = lastSeen
  ? `Updates since ${lastSeen.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}.`
  : 'Showing updates from the last seven days.';

const branchActivity = memberBranches.map((branch: any) => ({
  branch,
  proposals: visibleProposals
    .filter((proposal) => [proposal.originatingBranchId, proposal.governanceAuthorityBranchId, proposal.jurisdictionBranchId].includes(branch.branchId))
    .sort((a, b) => branchPriority[a.stage] - branchPriority[b.stage] || new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime())
    .slice(0, 4),
}));

const emailAvailable = emailLoginConfigured(env);
const googleAvailable = googleLoginConfigured(env);
const devLoginAvailable = devLoginEnabled(env);
const passkeyAvailable = passkeyLoginConfigured(env) || devLoginAvailable;
const totalContributions =
  (activity?.votes.length ?? 0) +
  (activity?.comments.length ?? 0) +
  (activity?.proposals.length ?? 0);
const completedOpenBallotsCount =
  new Set(activity?.votes.filter(v => visibleProposals.some(p => p.proposalId === v.proposalId && p.stage === 'decide' && !ballotExpired(p) && v.ballotId === `proposal:${p.proposalId}` && v.revisionId === p.ballotRevisionId)).map(v=>v.proposalId) ?? []).size;
const totalEligibleOpenBallotsCount = completedOpenBallotsCount + awaitingDecision.length;
const requestedView = Astro.url.searchParams.get('view');
const memberView = requestedView === 'activity' || requestedView === 'account' ? requestedView : 'overview';

// Contextual Intent Preservation (Message Match & Safe Same-Origin Redirect)
const rawReturnTo = Astro.url.searchParams.get('returnTo')?.trim() ?? '';
const safeReturnTo =
  rawReturnTo.startsWith('/') && !rawReturnTo.startsWith('//') && !rawReturnTo.startsWith('/api/')
    ? rawReturnTo
    : '/member/';
const rawIntent = Astro.url.searchParams.get('intent')?.trim() ?? '';
const intentLabel =
  rawIntent === 'vote'
    ? 'Cast your formal ballot'
    : rawIntent === 'deliberate'
      ? 'Join the member discussion'
      : rawIntent === 'propose'
        ? 'Suggest a new proposal'
        : safeReturnTo !== '/member/'
          ? 'Continue where you left off'
          : '';
const rawTargetTitle = Astro.url.searchParams.get('title')?.trim().slice(0, 140) ?? '';
---
<SiteLayout
  title="My Engage · Fusion Party Australia"
  description="Your votes, ideas, contributions and member account."
  noIndex
>
  <div class="page-wrap section-space member-page" data-view={memberView}>
    {!user ? (
      <div class="signin-shell" data-return-to={safeReturnTo}>
        <div class="signin-main">
          {intentLabel && (
            <div class="signin-intent-banner" role="region" aria-label="Sign-in destination">
              <div class="signin-intent-banner__body">
                <Badge variant="info">{intentLabel}</Badge>
                <p class="signin-intent-banner__text">
                  {rawTargetTitle ? (
                    <>
                      Sign in to continue to <strong>{rawTargetTitle}</strong>—you’ll be returned directly to your place.
                    </>
                  ) : (
                    <>Sign in below and we’ll take you straight back to where you were.</>
                  )}
                </p>
              </div>
              <a href={safeReturnTo} class="signin-intent-banner__back">
                Return without signing in <ArrowRight className="size-3.5" aria-hidden="true" />
              </a>
            </div>
          )}

          <header class="signin-hero">
            <div class="signin-hero__badges">
              <Badge variant="info">Passwordless member access</Badge>
              <Badge variant="outline">Passkey · Email link · Google</Badge>
            </div>
            <h1>{intentLabel ? `${intentLabel}.` : 'Sign in to take part.'}</h1>
            <p class="signin-hero__lead">
              Explore proposals, shape policy wording, and vote on bound revisions. Returning members can sign in with a passkey or email link; first-time members only need the email and full name on their Fusion Party membership.
            </p>
          </header>

          {!emailAvailable && !googleAvailable && !devLoginAvailable && !passkeyAvailable ? (
            <Alert variant="warning">
              <AlertDescription>Member sign-in is temporarily unavailable. Please try again shortly.</AlertDescription>
            </Alert>
          ) : (
            <div class="signin-methods">
              {/* Primary Card: Email Link + Instant Passkey / Google */}
              <section class="signin-card signin-card--primary" aria-labelledby="primary-signin-heading">
                <div class="signin-card__header">
                  <div>
                    <h2 id="primary-signin-heading">Member sign-in</h2>
                    <p id="signin-card-subtitle">No password to remember—choose your fastest sign-in method below.</p>
                  </div>
                  <Badge variant="secondary" id="signin-speed-badge">Takes 30 sec</Badge>
                </div>

                {/* Fast 1-Tap Methods: Passkey & Google */}
                {(passkeyAvailable || googleAvailable) && (
                  <div class="signin-quick-actions" aria-label="One-tap sign-in options">
                    {passkeyAvailable && (
                      <div class="signin-quick-block">
                        <Button id="passkey-signin" type="button" variant="outline" className="signin-passkey-btn">
                          <Fingerprint className="size-4" aria-hidden="true" />
                          <span id="passkey-btn-label">Sign in with a passkey</span>
                          <span class="signin-btn-hint">Face ID · Touch ID · Security key</span>
                        </Button>
                        <div class="signin-passkey-meta">
                          <p id="passkey-status" class="form-status" role="status" aria-live="polite"></p>
                          <label class="signin-autoprompt-toggle" id="passkey-autoprompt-wrap" hidden>
                            <input type="checkbox" id="passkey-autoprompt" checked />
                            <span>Auto-prompt passkey on this device</span>
                          </label>
                        </div>
                      </div>
                    )}

                    {googleAvailable && (
                      <div class="signin-quick-block">
                        <Button id="google-signin" type="button" variant="outline" className="signin-google-btn">
                          <KeyRound className="size-4" aria-hidden="true" />
                          <span>Continue with Google</span>
                          <span class="signin-btn-hint">Verified matching membership email</span>
                        </Button>
                        <p id="google-status" class="form-status" role="status" aria-live="polite"></p>
                      </div>
                    )}
                  </div>
                )}

                {emailAvailable && (passkeyAvailable || googleAvailable) && (
                  <div class="signin-divider" role="separator">
                    <span>or receive a one-click email link</span>
                  </div>
                )}

                {emailAvailable && (
                  <form id="email-signin-form" class="signin-email-form" novalidate>
                    <Field label="Membership email address" htmlFor="signin-email">
                      <Input
                        id="signin-email"
                        name="email"
                        type="email"
                        autoComplete="username webauthn"
                        placeholder="you@example.org.au"
                        maxLength={254}
                        required
                      />
                    </Field>

                    <details class="signin-name-disclosure" id="signin-name-details" open>
                      <summary class="signin-name-head">
                        <span class="signin-name-label">Full name (first sign-in only)</span>
                        <span class="signin-name-badge" id="signin-name-badge">First sign-in only</span>
                      </summary>
                      <div class="signin-name-body">
                        <Input
                          id="signin-name"
                          name="name"
                          autoComplete="name"
                          aria-label="Full name (first sign-in only)"
                          placeholder="Required on your first sign-in so an admin can verify your membership"
                          minLength={2}
                          maxLength={100}
                        />
                        <p class="signin-field-hint">
                          Already signed in before? Leave your name blank—we’ll recognise your email automatically.
                        </p>
                      </div>
                    </details>

                    <div class="signin-submit-row">
                      <Button type="submit" className="signin-submit-btn">
                        <Mail className="size-4" aria-hidden="true" />
                        Email me a sign-in link
                      </Button>
                      <span class="signin-expiry-note">Link valid for 10 minutes · Single use</span>
                    </div>

                    <div id="email-status-box" class="signin-status-banner" hidden>
                      <p id="email-status" class="form-status" role="status" aria-live="polite"></p>
                    </div>
                  </form>
                )}
              </section>

              {devLoginAvailable && (
                <section class="signin-card signin-card--dev" aria-labelledby="dev-signin-heading">
                  <div class="signin-card__header">
                    <div>
                      <h2 id="dev-signin-heading">Local development sign-in</h2>
                      <p>Instant sandbox session to test member onboarding, deliberation, and admin workflows.</p>
                    </div>
                    <Badge variant="warning">Dev / Preview</Badge>
                  </div>
                  <form id="dev-signin-form" class="signin-dev-form">
                    <Field label="Simulated account role" htmlFor="dev-role">
                      <NativeSelect id="dev-role" name="role">
                        <option value="member">Verified Member (member@local.test)</option>
                        <option value="administrator">National Administrator (admin@local.test)</option>
                      </NativeSelect>
                    </Field>
                    <div class="signin-submit-row">
                      <Button type="submit" variant="outline">Sign in locally</Button>
                      <p id="dev-status" class="form-status" role="status" aria-live="polite"></p>
                    </div>
                  </form>
                </section>
              )}

              <p class="signin-legal">
                Member participation is subject to the <a href="/terms/">Terms of Use</a> and{' '}
                <a href="/privacy/">Privacy Policy</a>. Engage uses strictly necessary session cookies and never sells or tracks personal data for advertising.
              </p>
            </div>
          )}
        </div>

        <!-- Right Onboarding Preview Rail: What happens when you sign in -->
        <aside class="signin-onboarding-rail" aria-label="How member onboarding works">
          <div class="onboarding-preview-card">
            <div class="onboarding-preview-card__head">
              <span class="onboarding-preview-kicker">
                <Sparkles className="size-3.5" aria-hidden="true" />
                New to Engage?
              </span>
              <h2>From first sign-in to your first vote.</h2>
              <p>Engage is designed so you can read everything immediately and participate without learning parliamentary procedure.</p>
            </div>

            <ol class="onboarding-roadmap">
              <li class="onboarding-roadmap__step">
                <span class="onboarding-roadmap__num tabular">1</span>
                <div>
                  <strong>Sign in without a password</strong>
                  <p>Request a 1-click email link or continue with Google using your Fusion membership email.</p>
                </div>
              </li>
              <li class="onboarding-roadmap__step">
                <span class="onboarding-roadmap__num tabular">2</span>
                <div>
                  <strong>Save a passkey for 1-tap return access</strong>
                  <p>Enroll Face ID, Touch ID, Windows Hello, or your password manager in 15 seconds from your dashboard.</p>
                </div>
              </li>
              <li class="onboarding-roadmap__step">
                <span class="onboarding-roadmap__num tabular">3</span>
                <div>
                  <strong>Automatic membership &amp; branch check</strong>
                  <p>An administrator confirms your Fusion membership and branch electorate so you can comment, amend, and vote.</p>
                </div>
              </li>
              <li class="onboarding-roadmap__step">
                <span class="onboarding-roadmap__num tabular">4</span>
                <div>
                  <strong>Shape wording &amp; vote on bound revisions</strong>
                  <p>Post stances during Stage 2 (Deliberate) and cast your ballot on frozen wording in Stage 3 (Decide).</p>
                </div>
              </li>
            </ol>

            <div class="onboarding-preview-card__public">
              <div class="onboarding-public-row">
                <Compass className="size-4 shrink-0 text-[var(--horizon-purple)]" aria-hidden="true" />
                <div>
                  <strong>Just browsing today? No account needed.</strong>
                  <p>All public proposals, revision diffs, ballot tallies, and published policies are open to everyone.</p>
                </div>
              </div>
              <div class="onboarding-public-links">
                <Button href="/proposals/" variant="outline" size="sm">Browse proposals</Button>
                <Button href="/how-it-works/" variant="ghost" size="sm">60-second walkthrough →</Button>
              </div>
            </div>
          </div>
        </aside>
      </div>
    ) : (
      <>
        <header class="member-header">
          <div class="member-header__main">
            <div class="member-header__title-row">
              <h1>{memberView === 'activity' ? 'Activity & Governance Log' : memberView === 'account' ? 'My Account' : 'My Engage'}</h1>
              <Badge variant={user.status === 'verified' ? 'success' : user.status === 'suspended' ? 'destructive' : 'warning'}>
                {user.status === 'verified' ? 'Verified member' : user.status === 'suspended' ? 'Suspended' : 'Verification pending'}
              </Badge>
              {memberBranches.map((branch: any) => (
                <Badge variant="outline">{branch.name}</Badge>
              ))}
            </div>
            <p class="member-identity">
              {user.name || user.email} · {user.email}
            </p>
          </div>

          <div class="member-header__actions">
            {user.isStaff && (
              <Button href="/admin/" variant="outline" size="sm">
                Admin workspace
              </Button>
            )}
            {user.canParticipate && (
              <Button href="/proposals/new/" variant="outline" size="sm">
                Suggest an idea
              </Button>
            )}
            <Button href="/proposals/?stage=decide" size="sm">
              Browse ballots ({awaitingDecision.length})
            </Button>
          </div>
        </header>

        {user.status !== 'verified' && (
          <Alert className="status-banner" variant={user.status === 'suspended' ? 'destructive' : 'warning'}>
            <AlertDescription>
              {user.status === 'suspended' ? (
                <>
                  <strong>Participation suspended.</strong> Please contact a party administrator regarding your membership status.
                </>
              ) : (
                <>
                  <strong>Membership verification pending.</strong> You can browse all proposals and decisions while an administrator confirms your Fusion Party membership.
                </>
              )}
            </AlertDescription>
          </Alert>
        )}

        <LegalAcceptanceGate />

        <!-- Guided Member Onboarding & Activation Flow -->
        <div class="overview-only">
          <MemberOnboarding
            client:load
            name={user.name}
            email={user.email}
            status={user.status}
            canParticipate={Boolean(user.canParticipate)}
            branches={memberBranches.map((branch: any) => ({ id: branch.branchId, name: branch.name }))}
            openBallotsCount={awaitingDecision.length}
            firstBallotHref={awaitingDecision[0] ? `/proposals/${awaitingDecision[0].slug}/` : undefined}
            firstBallotTitle={awaitingDecision[0]?.title}
            deliberationsCount={deliberationOpportunities.length}
            firstDeliberationHref={deliberationOpportunities[0] ? `/proposals/${deliberationOpportunities[0].slug}/` : undefined}
            firstDeliberationTitle={deliberationOpportunities[0]?.title}
            totalContributions={totalContributions}
            initialPasskeyCount={userPasskeyCount}
          />
        </div>

        <!-- Top 4-Cell Hairline Metric Strip -->
        <div class="member-stat-strip" aria-label="Your participation summary">
          <a href="#awaiting-heading" class="member-stat">
            <span class="member-stat__label">Open votes for you</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{awaitingDecision.length}</strong>
              <span class="member-stat__hint">Eligible unvoted ballots</span>
            </div>
          </a>
          <a href="#opportunities-heading" class="member-stat">
            <span class="member-stat__label">Open for deliberation</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{deliberationOpportunities.length}</strong>
              <span class="member-stat__hint">Active discussions</span>
            </div>
          </a>
          <a href="#catchup-heading" class="member-stat">
            <span class="member-stat__label">Catch-up updates</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{catchUpTotal}</strong>
              <span class="member-stat__hint">{lastSeen ? 'Since last visit' : 'Last 7 days'}</span>
            </div>
          </a>
          <a href="/member/?view=activity#activity-heading" class="member-stat">
            <span class="member-stat__label">Your contributions</span>
            <div class="member-stat__bottom">
              <strong class="member-stat__value tabular">{(activity?.votes.length ?? 0) + (activity?.comments.length ?? 0) + (activity?.proposals.length ?? 0)}</strong>
              <span class="member-stat__hint tabular">{activity?.votes.length ?? 0} votes · {activity?.comments.length ?? 0} stances</span>
            </div>
          </a>
        </div>

        <!-- Underline Workspace Tabs -->
        <nav class="member-tabs" aria-label="My Engage sections">
          <a href="/member/" class="member-tab" aria-current={memberView === 'overview' ? 'page' : undefined}>
            Overview
          </a>
          <a href="/member/?view=activity" class="member-tab" aria-current={memberView === 'activity' ? 'page' : undefined}>
            Activity &amp; Log
            <span class="member-tab__count tabular">{memberTimelineCount}</span>
          </a>
          <a href="/member/?view=account" class="member-tab" aria-current={memberView === 'account' ? 'page' : undefined}>
            Account &amp; Access
          </a>
        </nav>

        <div class="account-only"><EmailPreferences preference={emailPreference} saved={Astro.url.searchParams.get('emailPreferences') === 'saved'} /></div>
        <!-- VIEW 1: OVERVIEW (Outstanding votes, Participation opportunities, Catch-up, Status changes) -->
        <div class="overview-only member-overview-grid">
          <!-- Left Column: Actionable Queues -->
          <div class="member-col-main">
            <section class="member-panel" aria-labelledby="closing-soon-heading">
              <h2 id="closing-soon-heading">Closing within seven days</h2>
              {closingSoon.length ? <ul>{closingSoon.map(b=><li><a href={b.href}>{b.title}</a><p>Closes {ballotDeadlineLabel(b.closesAt)}</p></li>)}</ul> : <p>You have no unvoted eligible ballots closing within seven days.</p>}
            </section>
            <!-- 1. Open Ballots Queue -->
            <AttentionQueue
              items={outstandingItems}
              canParticipate={Boolean(user.canParticipate)}
              eligibilityNote={eligibilityNote}
              completedCount={completedOpenBallotsCount}
              totalEligibleCount={totalEligibleOpenBallotsCount}
            />

            <section class="member-panel" aria-label="Decisions you took part in">
              <h2>After your participation</h2>
              <p>Follow what happened to proposals you authored, discussed or voted on.</p>
              {lifecycleItems.length ? <ul>{lifecycleItems.map(p=><li><a href={`/proposals/${p.slug}/`}>{p.title}</a> — {p.stage === 'implement' ? 'Implementation · inspect the recorded decision' : p.stage === 'archived' ? 'Archived' : 'Voting closed · inspect the recorded decision'}</li>)}</ul> : <p>Closed ballots and implementation updates will appear here.</p>}
            </section>
            <EmailPreferences preference={emailPreference} saved={Astro.url.searchParams.get('emailPreferences') === 'saved'} />
            <!-- 2. Relevant Participation Opportunities (Deliberation & Amendments) -->
            <section class="member-panel" aria-labelledby="opportunities-heading">
              <div class="member-panel__head">
                <div>
                  <div class="member-panel__title-row">
                    <h2 id="opportunities-heading">Open for deliberation &amp; amendments</h2>
                    <Badge variant="secondary" className="tabular">{deliberationOpportunities.length}</Badge>
                  </div>
                  <p>Proposals currently in Stage 2 (Deliberate) where your stance or wording suggestion can shape the final ballot.</p>
                </div>
                <Button href="/proposals/?stage=deliberate" variant="ghost" size="sm">All discussions</Button>
              </div>

              {deliberationOpportunities.length === 0 ? (
                <p class="member-panel__empty">No proposals are currently in active deliberation.</p>
              ) : (
                <>
                  <ul class="opportunity-list">
                    {deliberationOpportunities.slice(0, 6).map((item) => (
                      <li class="opportunity-row">
                        <div class="opportunity-row__body">
                          <div class="opportunity-row__meta">
                            <span class="tabular opportunity-id">{item.proposalId}</span>
                            <span class="opportunity-space">{item.space}</span>
                            <span class="tabular opportunity-count">{item.commentCount} {item.commentCount === 1 ? 'stance' : 'stances'}</span>
                          </div>
                          <a class="opportunity-title" href={`/proposals/${item.slug}/`}>{item.title}</a>
                        </div>
                        <Button href={`/proposals/${item.slug}/#deliberation`} variant="outline" size="sm">
                          Contribute
                        </Button>
                      </li>
                    ))}
                  </ul>
                  {deliberationOpportunities.length > 6 && (
                    <div class="member-panel__footer">
                      <a href="/proposals/?stage=deliberate">
                        Explore all {deliberationOpportunities.length} proposals in discussion →
                      </a>
                    </div>
                  )}
                </>
              )}
            </section>

            <!-- 3. Branch Activity & Authored Ideas (if applicable) -->
            {branchActivity.length > 0 && (
              <section class="member-panel" aria-labelledby="branch-activity-heading">
                <div class="member-panel__head">
                  <div>
                    <h2 id="branch-activity-heading">Activity in your branches</h2>
                    <p>Proposals originating in or governed by your recognised branch memberships.</p>
                  </div>
                </div>
                <div class="branch-groups">
                  {branchActivity.map(({ branch, proposals }) => (
                    <div class="branch-group" aria-labelledby={`branch-activity-${branch.branchId}`}>
                      <div class="branch-group__head">
                        <h3 id={`branch-activity-${branch.branchId}`}>{branch.name}</h3>
                        <a href={`/proposals/?branch=${encodeURIComponent(branch.branchId)}`}>All branch proposals →</a>
                      </div>
                      {proposals.length ? (
                        <ul class="opportunity-list">
                          {proposals.map((proposal) => (
                            <li class="opportunity-row">
                              <div class="opportunity-row__body">
                                <div class="opportunity-row__meta">
                                  <span class="tabular opportunity-id">{proposal.proposalId}</span>
                                  <Badge variant="outline">
                                    {proposal.stage === 'decide' ? 'Open vote' : proposal.stage === 'deliberate' ? 'In discussion' : proposal.stage === 'implement' ? 'Implement' : 'New idea'}
                                  </Badge>
                                </div>
                                <a class="opportunity-title" href={`/proposals/${proposal.slug}/`}>{proposal.title}</a>
                              </div>
                              <Button href={`/proposals/${proposal.slug}/`} size="sm" variant="ghost">Open</Button>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="member-panel__empty">No active proposals currently involve this branch.</p>
                      )}
                    </div>
                  ))}
                </div>
              </section>
            )}

            {activity?.proposals && activity.proposals.length > 0 && (
              <section class="member-panel" aria-labelledby="proposals-heading">
                <div class="member-panel__head">
                  <div>
                    <h2 id="proposals-heading">Ideas you authored ({activity.proposals.length})</h2>
                    <p>Proposals you submitted to the platform.</p>
                  </div>
                </div>
                <ul class="opportunity-list">
                  {activity.proposals.map((p) => (
                    <li class="opportunity-row">
                      <div class="opportunity-row__body">
                        <div class="opportunity-row__meta">
                          <span class="opportunity-space">{p.space}</span>
                          <Badge variant="outline">
                            {p.stage === 'decide' ? 'Open vote' : p.stage === 'deliberate' ? 'In discussion' : p.stage === 'implement' ? 'Implement' : 'New idea'}
                          </Badge>
                        </div>
                        <a class="opportunity-title" href={`/proposals/${p.slug}/`}>{p.title}</a>
                      </div>
                      <Button href={`/proposals/${p.slug}/`} size="sm" variant="outline">View</Button>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>

          <!-- Right Column: Catch-Up Digest & Governance Status Change Log -->
          <div class="member-col-rail">
            <CatchUpDigest
              groups={catchUpGroups}
              total={catchUpTotal}
              sinceLabel={catchUpSinceLabel}
              hasLastVisit={Boolean(lastSeen)}
            />

            <GovernanceLog items={governanceChanges} />
          </div>
        </div>

        <!-- VIEW 2: ACTIVITY & LOG -->
        <div class="activity-only member-activity-view">
          <div class="member-overview-grid">
            <div class="member-col-main">
              {activity && (
                <div class="member-timeline-card">
                  <ActivityTimeline
                    client:load
                    groups={memberTimeline}
                    title="Your participation log"
                    description="Votes, ideas, contributions, amendments, and endorsements you recorded, newest first."
                    badge={`${memberTimelineCount} ${memberTimelineCount === 1 ? 'entry' : 'entries'}`}
                    headingId="activity-heading"
                    filters={[
                      { id: 'all', label: 'All' },
                      { id: 'vote', label: 'Votes' },
                      { id: 'contribution', label: 'Contributions' },
                      { id: 'proposal', label: 'Ideas' },
                      { id: 'amendment', label: 'Amendments' },
                      { id: 'endorsement', label: 'Endorsements' },
                      { id: 'governance', label: 'Outcomes' },
                    ]}
                    searchable
                    emptyMessage="Your votes, contributions, and ideas will appear here as you participate."
                  />
                </div>
              )}
            </div>

            <div class="member-col-rail">
              <GovernanceLog items={governanceChanges} />
              <CatchUpDigest
                groups={catchUpGroups}
                total={catchUpTotal}
                sinceLabel={catchUpSinceLabel}
                hasLastVisit={Boolean(lastSeen)}
                idPrefix="activity-catchup"
              />
            </div>
          </div>
        </div>

        <!-- VIEW 3: ACCOUNT & ACCESS -->
        {memberView === 'account' && (
          <div class="account-settings" id="account-settings">
            <MemberSettings
              client:load
              name={user.name}
              email={user.email}
              role={user.role}
              status={user.status}
              canParticipate={user.canParticipate}
              branches={memberBranches.map((branch: any) => ({ id: branch.branchId, name: branch.name }))}
              stats={{
                votes: activity?.votes.length ?? 0,
                contributions: activity?.comments.length ?? 0,
                ideas: activity?.proposals.length ?? 0,
              }}
            />
          </div>
        )}
      </>
    )}
  </div>
</SiteLayout>

<script>
  import { trackEngage } from '../../lib/analytics.ts';
  import { createAuthClient } from 'better-auth/client';
  import { magicLinkClient } from 'better-auth/client/plugins';
  import { passkeyClient } from '@better-auth/passkey/client';

  const authClient = createAuthClient({
    plugins: [magicLinkClient(), passkeyClient()],
  });

  const PASSKEY_ENROLLED_KEY = 'engage_passkey_enrolled';
  const PASSKEY_AUTOPROMPT_KEY = 'engage_passkey_autoprompt';
  const KNOWN_EMAIL_KEY = 'engage_known_member_email';

  const signinShell = document.querySelector<HTMLElement>('.signin-shell');
  const rawReturnAttr = signinShell?.dataset.returnTo || '/member/';
  const safeCallbackURL =
    rawReturnAttr.startsWith('/') && !rawReturnAttr.startsWith('//') && !rawReturnAttr.startsWith('/api/')
      ? rawReturnAttr
      : '/member/';

  function analyticsCallback(method: 'email' | 'google') {
    const callback = new URL(safeCallbackURL, location.origin);
    callback.searchParams.set('analytics_signin', method);
    return `${callback.pathname}${callback.search}${callback.hash}`;
  }

  const emailForm = document.querySelector<HTMLFormElement>('#email-signin-form');
  const emailInput = document.querySelector<HTMLInputElement>('#signin-email');
  const nameDetails = document.querySelector<HTMLDetailsElement>('#signin-name-details');
  const nameBadge = document.querySelector<HTMLElement>('#signin-name-badge');
  const emailStatus = document.querySelector<HTMLElement>('#email-status');
  const emailStatusBox = document.querySelector<HTMLElement>('#email-status-box');
  const googleStatus = document.querySelector<HTMLElement>('#google-status');
  const passkeyStatus = document.querySelector<HTMLElement>('#passkey-status');
  const passkeyBtn = document.querySelector<HTMLButtonElement>('#passkey-signin');
  const passkeyBtnLabel = document.querySelector<HTMLElement>('#passkey-btn-label');
  const passkeyAutoWrap = document.querySelector<HTMLElement>('#passkey-autoprompt-wrap');
  const passkeyAutoCheckbox = document.querySelector<HTMLInputElement>('#passkey-autoprompt');
  const signinSubtitle = document.querySelector<HTMLElement>('#signin-card-subtitle');
  const signinSpeedBadge = document.querySelector<HTMLElement>('#signin-speed-badge');

  function completeSignInRedirect() {
    if (safeCallbackURL && safeCallbackURL !== '/member/') {
      location.href = safeCallbackURL;
    } else {
      location.reload();
    }
  }

  function setEmailMessage(message: string, tone: 'info' | 'success' | 'error' = 'info') {
    if (!emailStatus) return;
    emailStatus.textContent = message;
    if (emailStatusBox) {
      emailStatusBox.hidden = !message;
      emailStatusBox.dataset.tone = tone;
    }
  }

  const searchParams = new URLSearchParams(location.search);
  const errorCode = searchParams.get('error');
  if (errorCode) {
    if (errorCode === 'link' || errorCode === 'google' || errorCode === 'invalid_code') {
      trackEngage('signin_result', { method: errorCode === 'link' ? 'email' : 'google', outcome: 'failed' });
    }
    if (errorCode === 'link') {
      setEmailMessage(
        'That sign-in link has expired or was already used. Request a fresh link below or sign in with your passkey.',
        'error',
      );
    } else if (errorCode === 'google' || errorCode === 'invalid_code') {
      if (googleStatus) {
        googleStatus.textContent =
          'Google sign-in could not be completed. Please try again or use an email link.';
      }
    } else {
      setEmailMessage('Sign-in could not be completed. Please try again.', 'error');
    }
  }

  // Returning member personalization (Status-Quo & Activation Energy Reduction)
  let hasEnrolledPasskeyOnDevice = false;
  let autoPromptEnabled = true;
  try {
    hasEnrolledPasskeyOnDevice = localStorage.getItem(PASSKEY_ENROLLED_KEY) === 'true';
    const storedAuto = localStorage.getItem(PASSKEY_AUTOPROMPT_KEY);
    if (storedAuto === 'false') {
      autoPromptEnabled = false;
    }
    const rememberedEmail = localStorage.getItem(KNOWN_EMAIL_KEY);
    if (rememberedEmail && emailInput && !emailInput.value) {
      emailInput.value = rememberedEmail;
      if (nameDetails) {
        nameDetails.open = false;
      }
      if (nameBadge) {
        nameBadge.textContent = 'Optional for returning members';
      }
    }
  } catch {
    // Ignore localStorage restrictions
  }

  if (hasEnrolledPasskeyOnDevice) {
    if (passkeyBtnLabel) {
      passkeyBtnLabel.textContent = 'Sign in with your saved passkey';
    }
    if (signinSubtitle) {
      signinSubtitle.textContent = 'Welcome back—use your saved device passkey for 1-tap access.';
    }
    if (signinSpeedBadge) {
      signinSpeedBadge.textContent = '1-tap passkey ready';
    }
    if (passkeyAutoWrap && passkeyAutoCheckbox) {
      passkeyAutoWrap.hidden = false;
      passkeyAutoCheckbox.checked = autoPromptEnabled;
      passkeyAutoCheckbox.addEventListener('change', () => {
        try {
          localStorage.setItem(PASSKEY_AUTOPROMPT_KEY, passkeyAutoCheckbox.checked ? 'true' : 'false');
        } catch {
          // Ignore
        }
      });
    }
  }

  async function runPasskeySignIn(isAutoPrompt = false) {
    if (!passkeyStatus || !passkeyBtn) return;
    if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') {
      if (!isAutoPrompt) {
        passkeyStatus.textContent =
          'This browser does not support passkeys. Please use an email sign-in link instead.';
      }
      return;
    }
    const method = isAutoPrompt ? 'passkey_auto' : 'passkey';
    trackEngage('signin_attempted', { method });
    passkeyBtn.disabled = true;
    passkeyStatus.textContent = isAutoPrompt
      ? 'Prompting your saved device passkey…'
      : 'Waiting for your device passkey…';
    try {
      const result = await authClient.signIn.passkey();
      trackEngage('signin_result', { method, outcome: result.error ? 'failed' : 'success' });
      if (result.error) {
        const errCode = 'code' in result.error ? result.error.code : undefined;
        if (errCode === 'PASSKEY_NOT_FOUND') {
          passkeyStatus.textContent =
            'No Engage passkey matched that credential. Sign in with an email link first, then add a passkey in Account & Access.';
        } else if (
          errCode === 'AUTH_CANCELLED' ||
          errCode === 'ERROR_CEREMONY_ABORTED'
        ) {
          passkeyStatus.textContent = isAutoPrompt
            ? 'Auto-prompt dismissed. Click "Sign in with your saved passkey" when ready, or use an email link.'
            : 'Passkey prompt cancelled. Click again or request an email sign-in link below.';
        } else if (result.error.status === 503) {
          passkeyStatus.textContent =
            'Passkey verification requires a live authentication server. Use Local development sign-in below in local preview mode.';
        } else {
          passkeyStatus.textContent =
            result.error.message || 'Could not sign in with a passkey. Try an email sign-in link below.';
        }
      } else {
        try {
          localStorage.setItem(PASSKEY_ENROLLED_KEY, 'true');
        } catch {
          // Ignore
        }
        passkeyStatus.textContent = 'Passkey verified. Signing you in…';
        completeSignInRedirect();
      }
    } catch {
      trackEngage('signin_result', { method, outcome: 'failed' });
      if (!isAutoPrompt) {
        passkeyStatus.textContent =
          'Could not complete passkey sign-in. Try an email sign-in link below.';
      } else {
        passkeyStatus.textContent = '';
      }
    } finally {
      passkeyBtn.disabled = false;
    }
  }

  // Automatic Passkey Prompting on Sign-In:
  // 1. If this device has an enrolled Engage passkey and auto-prompt is enabled, trigger immediate WebAuthn modal prompt.
  // 2. Otherwise, arm WebAuthn Conditional UI (`autoFill: true`) so focusing the email input surfaces the OS passkey sheet.
  if (
    passkeyBtn &&
    hasEnrolledPasskeyOnDevice &&
    autoPromptEnabled &&
    !errorCode &&
    searchParams.get('noAutoPasskey') !== '1'
  ) {
    void runPasskeySignIn(true);
  } else if (
    emailForm &&
    typeof window !== 'undefined' &&
    typeof window.PublicKeyCredential !== 'undefined' &&
    typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
  ) {
    window.PublicKeyCredential.isConditionalMediationAvailable()
      .then((available) => {
        if (!available) return;
        trackEngage('signin_attempted', { method: 'passkey_autofill' });
        return authClient.signIn.passkey({ autoFill: true });
      })
      .then((res) => {
        if (res && !res.error && res.data?.session) {
          trackEngage('signin_result', { method: 'passkey_autofill', outcome: 'success' });
          try {
            localStorage.setItem(PASSKEY_ENROLLED_KEY, 'true');
          } catch {
            // Ignore
          }
          completeSignInRedirect();
        }
      })
      .catch(() => {
        // Ignore silent autofill cancellation
      });
  }

  passkeyBtn?.addEventListener('click', () => {
    void runPasskeySignIn(false);
  });

  emailForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailStatus || !emailForm.reportValidity()) return;
    const btn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    trackEngage('signin_attempted', { method: 'email' });
    setEmailMessage('Sending your one-click sign-in link…', 'info');

    try {
      const data = new FormData(emailForm);
      const emailValue = String(data.get('email')).trim();
      const result = await authClient.signIn.magicLink({
        email: emailValue,
        name: String(data.get('name')).trim() || undefined,
        callbackURL: analyticsCallback('email'),
        errorCallbackURL: `/member/?error=link&returnTo=${encodeURIComponent(safeCallbackURL)}`,
      });
      trackEngage('signin_result', { method: 'email', outcome: result.error ? result.error.code === 'NAME_REQUIRED' ? 'name_required' : 'failed' : 'link_sent' });
      if (result.error) {
        if (result.error.code === 'NAME_REQUIRED') {
          setEmailMessage(
            'Welcome! Because this is your first sign-in with this email, please enter your full name so an administrator can verify your Fusion membership.',
            'error',
          );
          if (nameDetails) {
            nameDetails.open = true;
          }
          const nameInput = emailForm.querySelector<HTMLInputElement>('[name="name"]')!;
          nameInput.required = true;
          nameInput.focus();
        } else if (result.error.status === 429) {
          setEmailMessage('Too many attempts. Please wait a minute and try again.', 'error');
        } else {
          setEmailMessage('Could not send sign-in link. Please try again shortly.', 'error');
        }
      } else {
        try {
          localStorage.setItem(KNOWN_EMAIL_KEY, emailValue);
        } catch {
          // Ignore
        }
        setEmailMessage(
          `Check ${emailValue} for your sign-in link (valid for 10 minutes, single use). Tip: once signed in, we’ll help you save a passkey for 1-tap access next time.`,
          'success',
        );
      }
    } catch {
      trackEngage('signin_result', { method: 'email', outcome: 'failed' });
      setEmailMessage('Could not send sign-in link. Please try again shortly.', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelector('#google-signin')?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#google-status')!;
    trackEngage('signin_attempted', { method: 'google' });
    status.textContent = 'Redirecting to Google…';
    try {
      const result = await authClient.signIn.social({
        provider: 'google',
        callbackURL: analyticsCallback('google'),
        errorCallbackURL: `/member/?error=google&returnTo=${encodeURIComponent(safeCallbackURL)}`,
      });
      if (result.error) {
        trackEngage('signin_result', { method: 'google', outcome: 'failed' });
        status.textContent = 'Google sign-in is unavailable right now.';
      }
    } catch {
      trackEngage('signin_result', { method: 'google', outcome: 'failed' });
      status.textContent = 'Google sign-in is unavailable right now.';
    }
  });

  const devForm = document.querySelector<HTMLFormElement>('#dev-signin-form');
  devForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const role = new FormData(devForm).get('role');
    const res = await fetch('/api/session', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ role }),
    });
    if (res.ok) completeSignInRedirect();
  });
</script>

<style>
  .member-page {
    max-width: 84rem;
    padding-top: 1.5rem;
    padding-bottom: 3.5rem;
  }

  .member-page[data-view="activity"] .overview-only,
  .member-page[data-view="activity"] .account-only {
    display: none;
  }

  .member-page[data-view="account"] .overview-only,
  .member-page[data-view="account"] .activity-only {
    display: none;
  }

  .member-page[data-view="overview"] .activity-only,
  .member-page[data-view="overview"] .account-only {
    display: none;
  }

  /* Sign-in Views & Onboarding Preview */
  .signin-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr);
    gap: 2rem;
    align-items: start;
  }

  .signin-main {
    display: grid;
    gap: 1.35rem;
    min-width: 0;
  }

  .signin-intent-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.9rem 1.15rem;
    border-radius: 0.75rem;
    background: var(--horizon-lavender-soft);
    border: 1px solid var(--horizon-line);
  }

  .signin-intent-banner__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .signin-intent-banner__text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--horizon-purple-deep);
  }

  .signin-intent-banner__back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--horizon-purple-deep);
    text-decoration: none;
  }

  .signin-intent-banner__back:hover {
    text-decoration: underline;
  }

  .signin-hero {
    display: grid;
    gap: 0.7rem;
  }

  .signin-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .signin-hero h1 {
    margin: 0;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.4rem, 5vw, 4.1rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--horizon-purple-deep);
  }

  .signin-hero__lead {
    margin: 0;
    max-width: 60ch;
    color: var(--horizon-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .signin-methods {
    display: grid;
    gap: 1.25rem;
  }

  .signin-card {
    padding: 1.5rem;
    background: var(--horizon-white);
    border: 1px solid var(--horizon-line);
    border-radius: 0.75rem;
    display: grid;
    gap: 1.25rem;
  }

  .signin-card--dev {
    background: var(--horizon-lavender-soft);
  }

  .signin-card__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--horizon-line);
  }

  .signin-card__header h2 {
    margin: 0;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.85rem, 3.4vw, 2.75rem);
    line-height: 1.1;
    color: var(--horizon-purple-deep);
  }

  .signin-card__header p {
    margin: 0.2rem 0 0;
    color: var(--horizon-muted);
    font-size: 0.92rem;
  }

  .signin-quick-actions {
    display: grid;
    gap: 0.75rem;
  }

  .signin-quick-block {
    display: grid;
    gap: 0.25rem;
  }

  .signin-passkey-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.75rem;
  }

  .signin-autoprompt-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.92rem;
    color: var(--horizon-muted);
    cursor: pointer;
  }

  .signin-autoprompt-toggle input {
    accent-color: var(--horizon-purple);
  }

  .signin-quick-block :global(.signin-passkey-btn),
  .signin-quick-block :global(.signin-google-btn) {
    width: 100%;
    min-height: 3rem;
    justify-content: flex-start;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    border-radius: 0.45rem;
    border-color: var(--horizon-line);
    background: var(--horizon-lavender-soft);
    color: var(--horizon-purple-deep);
