---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContributionForm from '../../components/collaboration/ContributionForm';
import FunnelBeacon from '../../components/collaboration/FunnelBeacon';
import { Button } from '../../components/ui/button';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { countPublishedContributions, getPublicInitiative } from '../../lib/collaboration.ts';
import {
  readCollaborationOwners,
  resolveCorrectionEmail,
} from '../../lib/collaboration-operations.ts';
import { turnstileEnforced } from '../../lib/turnstile.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = runtimeEnv(Astro.locals);
const db = await getDatabase(env);
// Draft and archived invitations have no public page.
const initiative = await getPublicInitiative(db, String(Astro.params.slug ?? ''));
const publishedCount = initiative ? await countPublishedContributions(db, initiative.slug) : 0;
const owners = await readCollaborationOwners(db);
// The invitation may override the operations default; empty means inherit.
const correctionEmail = resolveCorrectionEmail(initiative?.correctionEmail, owners.correctionEmail);
if (!initiative) Astro.response.status = 404;
---

<SiteLayout
  title={initiative ? `${initiative.title} · Engage` : 'Invitation not found · Engage'}
  description={initiative?.summary ?? 'This invitation is not available.'}
  canonical={initiative ? `/collaborate/${initiative.slug}/` : '/collaborate/'}
>
  {initiative ? (
    <div class="page-wrap section-space collaborate-page">
      <header class="page-intro">
        <p class="text-sm font-semibold uppercase tracking-widest">Take part</p>
        <h1>{initiative.title}</h1>
        <p>{initiative.summary}</p>
      </header>

      <div class="collaborate-layout">
        <section aria-label="Share your story">
          {initiative.status === 'open' ? (
            <>
              <p class="collaborate-purpose">{initiative.purpose}</p>
              {publishedCount > 0 && (
                <p class="collaborate-gallery-link">
                  <Button href={`/collaborate/${initiative.slug}/stories/`} variant="outline" size="sm">
                    Read {publishedCount === 1 ? 'the published story' : `the ${publishedCount} published stories`}
                  </Button>
                </p>
              )}
              <FunnelBeacon client:load initiativeSlug={initiative.slug} />
              <ContributionForm
                client:load
                initiativeSlug={initiative.slug}
                questions={initiative.questions}
                profile={initiative.profile}
                turnstileSiteKey={turnstileEnforced(env) ? (env.PUBLIC_TURNSTILE_SITE_KEY ?? '') : ''}
              />
              <noscript><p>Please enable JavaScript to send a contribution.</p></noscript>
            </>
          ) : (
            <div class="collaborate-closed">
              <h2>This invitation is closed</h2>
              <p>We are not collecting new stories here. Thank you to everyone who contributed.</p>
              {correctionEmail && (
                <p>
                  To correct or remove something you sent, email{' '}
                  <a href={`mailto:${correctionEmail}`}>{correctionEmail}</a>.
                </p>
              )}
              <Button href="/proposals/">See what members are deciding</Button>
            </div>
          )}
        </section>

        <aside>
          <h2>What happens next</h2>
          <ul>
            <li>A person reads every contribution. Nothing is published automatically.</li>
            <li>
              We only use your words{initiative.profile === 'story' ? ' or photos' : ''} in the places you tick.
            </li>
            <li>If we want to check something, we will reply only if you asked us to.</li>
            {correctionEmail && (
              <li>
                You can ask us to correct or remove it at any time: email{' '}
                <a href={`mailto:${correctionEmail}`}>{correctionEmail}</a>.
              </li>
            )}
          </ul>
          <h2>What we will not do</h2>
          <ul>
            {initiative.profile === 'story' && <li>Publish a photo of you without your permission.</li>}
            <li>Invent events, attendance or endorsements.</li>
            <li>
              Treat your {initiative.profile === 'story' ? 'story' : 'response'} as a policy position or as proof
              of party membership.
            </li>
          </ul>
          <p class="text-sm text-muted-foreground">
            Your email, if you give one, stays private and is used only to reply about this contribution. Read the{' '}
            <a href="/privacy/">privacy policy</a>.
          </p>
        </aside>
      </div>
    </div>
  ) : (
    <div class="page-wrap section-space">
      <header class="page-intro">
        <p class="text-sm font-semibold uppercase tracking-widest">Take part</p>
        <h1>This invitation isn't here</h1>
        <p>The link may be old, or the invitation may have closed.</p>
      </header>
      <Button href="/collaborate/">See open invitations</Button>
    </div>
  )}
</SiteLayout>

<style>
  .collaborate-page { max-width: 68rem; }
  .collaborate-layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 4rem; margin-top: 2rem; }
  .collaborate-purpose { margin: 0 0 1.25rem; font-size: 1.05rem; }
  .collaborate-gallery-link { margin: 0 0 2rem; }
  .collaborate-layout aside { border-top: 3px solid var(--horizon-accent); padding-top: 1.5rem; align-self: start; }
  .collaborate-layout aside h2 { font-size: 1.35rem; margin: 0 0 0.75rem; }
  .collaborate-layout aside h2 + ul { margin-top: 0; }
  .collaborate-layout aside ul { margin: 0 0 1.75rem; padding-left: 1.1rem; display: grid; gap: 0.6rem; color: var(--horizon-muted); }
  .collaborate-layout aside p { color: var(--horizon-muted); }
  .collaborate-closed { display: grid; gap: 1rem; justify-items: start; }
  .collaborate-closed h2, .collaborate-closed p { margin: 0; }
  @media (max-width: 767px) {
    .collaborate-layout { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
