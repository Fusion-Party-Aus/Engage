---
interface Props { accent?: string; variant?: 'hero' | 'band' }
const { accent = 'var(--horizon-accent)', variant = 'hero' } = Astro.props;
---
<svg class:list={['horizon-ribbon', `horizon-ribbon--${variant}`]} style={`--ribbon-accent:${accent}`} viewBox="0 0 600 900" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path class="ribbon__accent" d="M600 0H443C365 176 367 307 493 437 579 526 566 699 424 900h176V0Z" />
  <path class="ribbon__light" d="M600 0h-74c-68 187-50 313 52 419 82 85 68 271-87 481h109V0Z" />
  <path class="ribbon__base" d="M600 0h-36c-53 189-29 308 63 394 83 77 75 270-27 506h0V0Z" />
</svg>
<style>
  .horizon-ribbon { position:absolute; z-index:1; inset:0 0 0 auto; width:clamp(10rem,24vw,26rem); height:100%; pointer-events:none; }
  .horizon-ribbon--hero { right:43%; transform:translateX(30%); }
  .ribbon__accent { fill:var(--ribbon-accent); }
  .ribbon__light { fill:#fff; }
  .ribbon__base { fill:#32105a; }
  .horizon-ribbon--band { right:0; width:12rem; opacity:.95; }
  @media(max-width:720px){.horizon-ribbon--hero{top:auto;right:0;bottom:0;width:clamp(8rem,36vw,13rem);height:42%;transform:none}}
</style>
