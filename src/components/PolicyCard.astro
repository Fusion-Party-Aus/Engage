---
interface Props { title: string; href: string; area: string; summary: string; }
const { title, href, area, summary } = Astro.props;
---
<article class="policy-entry" data-policy-card data-area={area.toLowerCase()} data-search={`${title} ${area} ${summary}`.toLowerCase()}>
  <p class="eyebrow">{area}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="policy-entry__summary">{summary}</p>
  <a class="text-link" href={href} aria-label={`Read ${title}`}>Read policy <span aria-hidden="true">↗</span></a>
</article>
