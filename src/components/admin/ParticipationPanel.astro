---
import Card from './Card.astro';
import CardAction from './CardAction.astro';
import CardContent from './CardContent.astro';
import CardDescription from './CardDescription.astro';
import CardHeader from './CardHeader.astro';
import CardTitle from './CardTitle.astro';
import { Button } from '../ui/button';
import ActivityTimeline from '../blocks/timeline-3';
import { canViewIdentifiableBallots, getSessionUser } from '../../lib/auth.ts';
import { getDatabase, runtimeEnv } from '../../lib/db.ts';
import { canIncludeProposalInAdminReport } from '../../lib/admin-reporting.ts';
import { listProposals } from '../../lib/store.ts';
import { loadAdminParticipation } from '../../lib/admin-participation.ts';
import { buildActivityTimeline } from '../../lib/activity-timeline.ts';

interface ProposalSummary {
  proposalId: string;
  slug: string;
  title: string;
  authorId?: string;
  authorName?: string;
  createdAt: string;
}

interface Props {
  proposals: ProposalSummary[];
}

const env = runtimeEnv(Astro.locals);
const [user, db] = await Promise.all([
  getSessionUser(Astro.request, env),
  getDatabase(env),
]);
if (!user || (!user.isStaff && !user.isBranchAdmin)) {
  return;
}

const authorizedProposals = (
  await listProposals(db, { includeArchived: true, user, includeDetails: false })
).filter((proposal) => canIncludeProposalInAdminReport(user, proposal));

const proposalMap = new Map(
  authorizedProposals.map((proposal) => [
    proposal.proposalId,
    {
      proposalId: proposal.proposalId,
      slug: proposal.slug,
      title: proposal.title,
      authorId: proposal.authorId,
      authorName: proposal.authorName,
      createdAt:
        proposal.createdAt instanceof Date
          ? proposal.createdAt.toISOString()
          : String(proposal.createdAt),
    },
  ]),
);
const showIdentifiableBallots = canViewIdentifiableBallots(user);
const activityWindowStart = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const participation = await loadAdminParticipation(
  db,
  [...proposalMap.values()],
  { showIdentifiableBallots, windowStart: activityWindowStart },
);
const adminTimeline = buildActivityTimeline(participation.events);
const summary = participation.summary;
---

<Card class="gap-0">
  <CardHeader class="border-b pb-4">
    <CardTitle class="text-base">Recent member participation</CardTitle>
    <CardDescription>Votes, contributions and new proposals over the last 7 days.</CardDescription>
    <CardAction>
      <Button href="/admin/proposals/" variant="outline" size="sm">Proposals &amp; motions</Button>
    </CardAction>
  </CardHeader>
  <CardContent class="grid gap-4 p-5">
    <div class="participation-strip">
      <div>
        <strong class="tabular">{summary.votes}</strong>
        <span>Votes</span>
      </div>
      <div>
        <strong class="tabular">{summary.contributions}</strong>
        <span>Contributions</span>
      </div>
      <div>
        <strong class="tabular">{summary.firstTimeParticipants}</strong>
        <span>First-time participants</span>
      </div>
    </div>

    {adminTimeline.length > 0 ? (
      <ActivityTimeline
        client:visible
        groups={adminTimeline}
        filters={[
          { id: 'all', label: 'All' },
          { id: 'vote', label: 'Votes' },
          { id: 'contribution', label: 'Contributions' },
          { id: 'proposal', label: 'Proposals' },
        ]}
        searchable
        emptyMessage="No member activity in the last seven days."
      />
    ) : (
      <div class="rounded-lg border bg-muted/30 p-4 text-sm">
        <strong class="block text-foreground">No member activity in the last seven days</strong>
        <p class="mt-1 mb-0 text-muted-foreground">New votes, comments, and proposals will appear here as members participate.</p>
      </div>
    )}
  </CardContent>
</Card>

<style>
  .participation-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--horizon-line);
    border-radius: 0.6rem;
    background: var(--horizon-surface);
    overflow: hidden;
  }

  .participation-strip > div {
    padding: 0.7rem 1rem;
    border-right: 1px solid var(--horizon-line);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .participation-strip > div:last-child {
    border-right: 0;
  }

  .participation-strip strong {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--horizon-ink);
  }

  .participation-strip span {
    font-size: 0.8rem;
    color: var(--horizon-muted);
  }

  @media (max-width: 640px) {
    .participation-strip {
      grid-template-columns: 1fr;
    }

    .participation-strip > div {
      border-right: 0;
      border-bottom: 1px solid var(--horizon-line);
    }

    .participation-strip > div:last-child {
      border-bottom: 0;
    }
  }
</style>
