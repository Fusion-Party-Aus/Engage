---
import { cn } from '../../lib/utils';
interface Props extends astroHTML.JSX.HTMLAttributes {}
const { class: className, ...props } = Astro.props;
---
<div data-slot="card" class={cn('flex flex-col gap-4 rounded-lg border border-border bg-card text-card-foreground', className)} {...props}>
  <slot />
</div>
