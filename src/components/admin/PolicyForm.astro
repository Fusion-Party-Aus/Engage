---
import type { PolicyLifecycleView } from '../../lib/platform/catalogue';
interface Props { policy?: PolicyLifecycleView; rounds?: Array<{ roundId: string; program?: string; label?: string }> }
const { policy, rounds = [] } = Astro.props;
const api = policy ? `/api/admin/policies/${encodeURIComponent(policy.id)}/revisions` : '/api/admin/policies';
---
<form method="post" class="admin-card" data-admin-api={api} id={policy ? 'settle-revision-form' : 'new-policy-form'}>
  <h2>{policy ? 'Prepare revised wording' : 'Create a policy draft'}</h2>
  <p>{policy ? 'Start from the current wording. Saving creates an immutable revision; it does not publish wording or authorise a ballot.' : 'A new draft is separate from published policy and does not create a ballot.'}</p>
  {!policy && <input type="hidden" name="policyId" value={`POL-${crypto.randomUUID()}`} />}
  <label class="field"><span>Version label</span><input name="version" required value={`draft-${Date.now()}`} pattern="[A-Za-z0-9][A-Za-z0-9._-]*" /></label>
  <label class="field"><span>1 · Policy title</span><input name="title" required value={policy?.title} /></label>
  <label class="field"><span>2 · Policy statement</span><textarea name="statement" required rows="3">{policy?.statement}</textarea></label>
  <label class="field"><span>3 · Key outcomes (one per line)</span><textarea name="outcomes" required rows="4">{policy?.outcomes.join('\n')}</textarea></label>
  <label class="field"><span>4 · Further detail</span><textarea name="details" required rows="8">{policy?.details}</textarea></label>
  {policy && <label class="field"><span>Change summary — how feedback was incorporated</span><textarea name="changeSummary" rows="2"></textarea></label>}
  <details><summary>Taxonomy and consultation context</summary><p>Attaching a consultation does not publish wording. New unpublished policies are not yet selectable in the member consultation catalogue.</p>
    <div class="admin-grid">
      <label class="field"><span>Programme (optional)</span><input name="programme" maxlength="120" value={policy?.programme ?? ''} /></label>
      <label class="field"><span>Editorial pillar (optional)</span><input name="pillar" maxlength="120" value={policy?.pillar ?? ''} /></label>
      <label class="field"><span>Editorial heading (optional)</span><input name="editorialHeading" maxlength="120" value={policy?.editorialHeading ?? ''} /></label>
      <label class="field"><span>Subject domain (optional)</span><input name="domain" maxlength="120" value={policy?.domain ?? ''} /></label>
    </div>
    {!policy && <label class="field"><span>Include in a consultation (optional)</span><select name="roundId"><option value="">No consultation yet</option>{rounds.map(round => <option value={round.roundId}>{round.program ?? round.label ?? 'Untitled consultation'}</option>)}</select></label>}
  </details>
  <button class="button" type="submit">{policy ? 'Save immutable revision' : 'Create policy draft'}</button>
  <p role="status" aria-live="polite" class="admin-status"></p>
</form>
<script>
  import { bindAdminForms } from '../../scripts/admin-forms';
  bindAdminForms();
</script>
