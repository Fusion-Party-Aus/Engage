---
import { cn } from '../../lib/utils';
interface Props extends astroHTML.JSX.HTMLAttributes {
  label?: string;
  htmlFor?: string;
  hint?: string;
  error?: string;
  /** Render an empty error element for a script to fill in place. */
  errorId?: string;
}
const { class: className, label, htmlFor, hint, error, errorId, ...props } = Astro.props;
---
<div data-slot="field" class={cn('grid min-w-0 gap-2', className)} {...props}>
  {label && <label for={htmlFor} class="flex items-center gap-2 text-sm font-semibold leading-none select-none">{label}</label>}
  <slot />
  {hint && !error && <p id={htmlFor ? `${htmlFor}-hint` : undefined} data-slot="field-description" class="text-sm text-muted-foreground">{hint}</p>}
  {error && <p id={errorId ?? (htmlFor ? `${htmlFor}-error` : undefined)} data-slot="field-error" role="alert" class="text-sm font-medium text-destructive">{error}</p>}
  {!error && errorId && <p id={errorId} data-slot="field-error" role="alert" class="text-sm font-medium text-destructive" hidden></p>}
</div>
