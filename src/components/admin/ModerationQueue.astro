---
interface Props { policyId?: string; policies: Array<{ id: string; title: string }>; rounds: Array<{ roundId: string; program?: string; label?: string }>; roundId?: string }
const { policyId, policies, rounds, roundId } = Astro.props;
---
<section id="feedback" data-policy-id={policyId}>
  <h2>Member feedback</h2>
  <p>Contributions and moderator responses are visible only to verified members under the existing discussion rules.</p>
  <div class="admin-grid">
    <label class="field" hidden={Boolean(policyId)}><span>Policy context</span><select id="queue-policy"><option value="">All policies</option>{policies.map(policy => <option value={policy.id} selected={policy.id === policyId}>{policy.title}</option>)}</select></label>
    <label class="field"><span>Consultation</span><select id="queue-round"><option value="">All consultations</option>{rounds.map(round => <option value={round.roundId} selected={round.roundId === roundId}>{round.program ?? round.label ?? 'Untitled consultation'}</option>)}</select></label>
    <label class="field"><span>Review status</span><select id="queue-status"><option value="pending">Awaiting moderation</option><option value="accepted">Accepted for members</option><option value="needs-changes">Changes requested</option><option value="declined">Declined</option></select></label>
  </div>
  <p id="queue-message" role="status" aria-live="polite">Loading contributions…</p>
  <button type="button" class="button button--outline" id="queue-retry" hidden>Retry loading contributions</button>
  <div id="review-queue" aria-busy="true"></div>
  <div class="admin-actions"><button type="button" class="button button--outline" id="queue-previous" hidden>Previous contributions</button><button type="button" class="button button--outline" id="queue-next" hidden>Next contributions</button></div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('#feedback')!;
  const queue = document.querySelector<HTMLElement>('#review-queue')!;
  const message = document.querySelector<HTMLElement>('#queue-message')!;
  const policy = document.querySelector<HTMLSelectElement>('#queue-policy')!;
  const round = document.querySelector<HTMLSelectElement>('#queue-round')!;
  const state = document.querySelector<HTMLSelectElement>('#queue-status')!;
  const previous = document.querySelector<HTMLButtonElement>('#queue-previous')!;
  const next = document.querySelector<HTMLButtonElement>('#queue-next')!;
  const retry = document.querySelector<HTMLButtonElement>('#queue-retry')!;
  let offset = 0; let generation = 0;
  const optionLabel = (select: HTMLSelectElement, value: string) => Array.from(select.options).find(option => option.value === value)?.textContent;
  async function loadQueue() {
    const current = ++generation;
    queue.setAttribute('aria-busy', 'true'); message.textContent = 'Loading contributions…'; retry.hidden = true; previous.hidden = true; next.hidden = true;
    const query = new URLSearchParams({ status: state.value, offset: String(offset) });
    if (root.dataset.policyId || policy.value) query.set('policyId', root.dataset.policyId || policy.value);
    if (round.value) query.set('roundId', round.value);
    try {
      const response = await fetch('/api/admin/consultations?' + query);
      const data = await response.json();
      if (current !== generation) return;
      if (!response.ok) throw new Error(data.error ?? 'Contributions could not be loaded.');
      queue.replaceChildren();
      for (const item of data.submissions) {
        const article = document.createElement('article'); article.className = 'admin-card'; article.id = 'submission-' + item.submissionId;
        const title = document.createElement('h3'); title.textContent = item.title || `${item.kind} for review`;
        const context = document.createElement('p'); context.className = 'admin-context';
        const link = document.createElement('a'); link.href = `/admin/policies/${encodeURIComponent(item.policyId)}/#feedback`;
        link.textContent = optionLabel(policy, item.policyId) || 'Open policy workspace';
        context.append(link, document.createTextNode(` · ${optionLabel(round, item.roundId) || 'Consultation'} · ${item.kind} · ${new Date(item.createdAt).toLocaleString()}`));
        const body = document.createElement('p'); body.className = 'admin-wording'; body.textContent = item.body;
        const technical = document.createElement('details'); const summary = document.createElement('summary'); summary.textContent = 'Revision and record references';
        const references = document.createElement('p'); references.textContent = `Revision: ${item.policyRevisionId} · Submission: ${item.submissionId}`; technical.append(summary, references);
        article.append(title, context, body, technical);
        if (item.status === 'pending') {
          const label = document.createElement('label'); label.className = 'field'; const caption = document.createElement('span'); caption.textContent = 'Moderator response (optional; shared with accepted or changes-requested feedback)';
          const note = document.createElement('textarea'); label.append(caption, note);
          const actions = document.createElement('div'); actions.className = 'admin-actions';
          const result = document.createElement('p'); result.setAttribute('role', 'status'); result.setAttribute('aria-live', 'polite');
          for (const [value, text] of [['accepted', 'Accept for members'], ['needs-changes', 'Request changes'], ['declined', 'Decline']]) {
            const button = document.createElement('button'); button.type = 'button'; button.className = 'button button--outline'; button.textContent = text;
            button.addEventListener('click', async () => {
              actions.querySelectorAll('button').forEach(control => control.disabled = true); result.textContent = 'Saving review…';
              try {
                const response = await fetch(`/api/admin/consultations/${encodeURIComponent(item.submissionId)}/review`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ status: value, moderatorResponse: note.value }) });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error ?? 'Could not save review.');
                offset = 0; await loadQueue(); message.textContent = 'Review saved. Queue refreshed from the first page.';
              } catch (error) { result.textContent = error instanceof Error ? error.message : 'Could not save review. Please retry.'; actions.querySelectorAll('button').forEach(control => control.disabled = false); }
            }); actions.append(button);
          }
          article.append(label, actions, result);
        } else if (item.moderatorResponse) {
          const note = document.createElement('p'); note.className = 'admin-context'; note.textContent = 'Moderator response: ' + item.moderatorResponse; article.append(note);
        }
        queue.append(article);
      }
      message.textContent = data.submissions.length ? `Showing contributions ${offset + 1}–${offset + data.submissions.length}.` : 'No contributions in this view.';
      previous.hidden = offset === 0; next.hidden = !data.hasMore;
    } catch (error) { if (current === generation) { queue.replaceChildren(); message.textContent = error instanceof Error ? error.message : 'Could not load contributions. Please retry.'; retry.hidden = false; } }
    finally { if (current === generation) queue.setAttribute('aria-busy', 'false'); }
  }
  for (const select of [policy, round, state]) select.addEventListener('change', () => { offset = 0; void loadQueue(); });
  previous.addEventListener('click', () => { offset = Math.max(0, offset - 100); void loadQueue(); });
  next.addEventListener('click', () => { offset += 100; void loadQueue(); });
  retry.addEventListener('click', loadQueue); await loadQueue();
</script>
