<div id="nav-progress-bar" class="nav-progress-bar" aria-hidden="true"></div>

<script>
  const progressBar = document.getElementById('nav-progress-bar');

  function startNavigationFeedback() {
    progressBar?.classList.add('is-active');
  }

  // Keep the current page visible until the browser commits the navigation.
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented) return;
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const anchor = (event.target as Element | null)?.closest?.('a') as HTMLAnchorElement | null;
    if (!anchor || !anchor.href) return;
    if (anchor.target && anchor.target !== '_self') return;
    if (anchor.hasAttribute('download')) return;

    let url: URL;
    try {
      url = new URL(anchor.href, location.origin);
    } catch {
      return;
    }
    if (url.origin !== location.origin) return;
    // Ignore same-page hash jumps
    if (url.pathname === location.pathname && url.search === location.search) return;

    startNavigationFeedback();
  });

  // Observe GET form submissions that navigate the current page.
  document.addEventListener('submit', (event) => {
    if (event.defaultPrevented) return;
    const form = event.target;
    if (!(form instanceof HTMLFormElement)) return;

    const method = event.submitter?.getAttribute('formmethod') ?? form.method;
    const target = event.submitter?.getAttribute('formtarget') ?? form.target;
    const action = event.submitter?.getAttribute('formaction') ?? form.action;
    if (method.toLowerCase() !== 'get' || (target && target.toLowerCase() !== '_self')) return;
    try {
      if (new URL(action || location.href, document.baseURI).origin === location.origin) {
        startNavigationFeedback();
      }
    } catch {
      // A malformed action cannot start a navigation.
    }
  });

  // Reset if restored from back/forward cache
  window.addEventListener('pageshow', () => {
    progressBar?.classList.remove('is-active');
  });
</script>

<style>
  @keyframes nav-progress-indeterminate {
    0% {
      transform: translateX(-100%) scaleX(0.2);
    }
    50% {
      transform: translateX(0%) scaleX(0.6);
    }
    100% {
      transform: translateX(100%) scaleX(0.9);
    }
  }

  .nav-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    overflow: hidden;
    background: rgba(5, 212, 229, 0.18);
    transition: opacity 120ms ease;
  }

  .nav-progress-bar::after {
    content: '';
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--horizon-purple), var(--horizon-accent), var(--horizon-purple));
    transform-origin: left center;
  }

  .nav-progress-bar.is-active {
    opacity: 1;
  }

  .nav-progress-bar.is-active::after {
    animation: nav-progress-indeterminate 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-progress-bar {
      transition: none;
    }

    .nav-progress-bar.is-active::after {
      animation: none;
    }
  }
</style>
