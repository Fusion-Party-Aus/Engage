---
import type { SessionUser } from '../../lib/types.ts';
import type { SiteConfig } from '../../lib/site-config.ts';
import { DEFAULT_SOCIAL_LINKS, DEFAULT_STATE_SITES } from '../../lib/site-config.ts';

interface Props {
  user: SessionUser | null;
  siteConfig?: SiteConfig;
}

const { user, siteConfig } = Astro.props;
const year = new Date().getFullYear();
const isStaff = Boolean(user?.isStaff || user?.isBranchAdmin);
const primaryCtaLabel = siteConfig?.primaryCtaLabel || 'Suggest an idea';
const primaryCtaHref = siteConfig?.primaryCtaHref || '/proposals/new/';
const socialLinks = siteConfig?.socialLinks?.length ? siteConfig.socialLinks : DEFAULT_SOCIAL_LINKS;
const stateSites = siteConfig?.stateSites?.length ? siteConfig.stateSites : DEFAULT_STATE_SITES;

const groups = [
  {
    id: 'explore',
    label: 'Explore',
    links: [
      { href: primaryCtaHref, label: primaryCtaLabel, external: false },
      { href: '/proposals/', label: 'Browse proposals', external: false },
      { href: '/proposals/?stage=deliberate', label: 'Join discussions', external: false },
      { href: '/proposals/?stage=decide', label: 'See open votes', external: false },
    ],
  },
  {
    id: 'governance',
    label: 'Governance & Source',
    links: [
      { href: '/policies/', label: 'Policy registry', external: false },
      { href: '/sense-box/', label: 'Sense Box', external: false },
      { href: '/branches/', label: 'Branches & state sites', external: false },
      { href: '/how-it-works/', label: 'How it works (60s guide)', external: false },
      { href: '/changelog/', label: 'Platform changelog', external: false },
      { href: '/api/v1/policies', label: 'Public API v1', external: false },
    ],
  },
  {
    id: 'social',
    label: 'Community & Social',
    links: socialLinks.map((item) => ({
      href: item.href,
      label: item.label,
      external: /^https?:\/\//i.test(item.href),
    })),
  },
  {
    id: 'account',
    label: 'Your account',
    links: [
      { href: '/member/', label: user ? 'My Engage' : 'Sign in', external: false },
      { href: '/how-it-works/#operations', label: 'Backup & handover', external: false },
      ...(isStaff ? [{ href: '/admin/', label: 'Admin workspace', external: false }] : []),
    ],
  },
];
---

<footer class="site-footer" id="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="footer-brand" href="/" aria-label="Engage home">
          <img src="/fusion_horizon_logo_light.svg" alt="" width="36" height="36" />
          <span>
            <strong>{siteConfig?.siteName || 'Engage'}</strong>
            <small>{siteConfig?.organizationName || 'Fusion Party Australia'}</small>
          </span>
        </a>
        <p class="site-footer__tagline">
          {siteConfig?.tagline || 'Explore ideas, join discussions, and vote on the decisions that shape Fusion.'}
        </p>
        <p class="site-footer__note">
          A participatory governance platform for Fusion Party Australia. Anyone can inspect proposals and revisions; voting and formal motions require verified membership.
        </p>
      </div>

      <div class="site-footer__groups">
        {groups.map((group) => (
          <nav class="footer-group" aria-labelledby={`footer-${group.id}`}>
            <h2 class="footer-group__title" id={`footer-${group.id}`}>{group.label}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}{link.external ? ' ↗' : ''}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="site-footer__states" aria-labelledby="footer-states-heading">
      <div class="site-footer__states-head">
        <h2 id="footer-states-heading">State &amp; Territory Sites &amp; Facebook Pages</h2>
        <a href="/branches/">All branches &amp; electorates →</a>
      </div>
      <ul class="state-links-strip">
        {stateSites.map((state) => (
          <li class="state-link-chip">
            <a href={state.websiteHref} target="_blank" rel="noopener noreferrer" class="state-link-chip__main">
              <strong>{state.code}</strong>
              <span>{state.name}</span>
            </a>
            {state.facebookHref && (
              <a
                href={state.facebookHref}
                target="_blank"
                rel="noopener noreferrer"
                class="state-link-chip__fb"
                aria-label={`${state.name} Facebook page`}
                title={`${state.name} Facebook page`}
              >
                FB ↗
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {siteConfig?.organizationName || 'Fusion Party Australia'}</p>
      <nav aria-label="Legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/api/v1/openapi.json">OpenAPI</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background:
      radial-gradient(65% 120% at 12% -10%, rgba(124, 74, 209, 0.55), transparent 62%),
      radial-gradient(50% 90% at 92% 0%, rgba(0, 201, 210, 0.16), transparent 66%),
      #240a59;
    color: #d9d0ea;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--horizon-accent), #7b4ad1 55%, transparent);
  }

  .site-footer__inner {
    width: min(var(--content-width), calc(100% - 3rem));
    margin-inline: auto;
    padding: clamp(2.75rem, 5vw, 4.25rem) 0 1.5rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.95fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
    text-decoration: none;
  }

  .footer-brand img {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
  }

  .footer-brand strong {
    display: block;
    font-size: 1.08rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .footer-brand small {
    display: block;
    margin-top: 0.18rem;
    color: #b9a9d6;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .site-footer__tagline {
    max-width: 34ch;
    margin: 1.35rem 0 0.55rem;
    color: #efe9ff;
    font-size: 1rem;
    line-height: 1.55;
  }

  .site-footer__note {
    max-width: 42ch;
    margin: 0;
    color: #b3a4cf;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .site-footer__groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .footer-group__title {
    margin: 0 0 0.85rem;
    color: #fff;
    font-family: Outfit, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .footer-group ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-group a {
    color: #c5b9dd;
    font-size: 0.86rem;
    text-decoration: none;
  }

  .footer-group a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--horizon-accent);
    text-decoration-thickness: 2px;
  }

  .site-footer__states {
    margin-top: 2.25rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    gap: 0.75rem;
  }

  .site-footer__states-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .site-footer__states-head h2 {
    margin: 0;
    color: #ffffff;
    font-family: Outfit, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .site-footer__states-head a {
    color: #cfc3e4;
    font-size: 0.8rem;
    text-decoration: none;
  }

  .site-footer__states-head a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .state-links-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .state-link-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
    font-size: 0.78rem;
  }

  .state-link-chip__main {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.6rem;
    color: #ebe4fa;
    text-decoration: none;
  }

  .state-link-chip__main strong {
    color: #8cf3fc;
    font-weight: 700;
  }

  .state-link-chip__main:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .state-link-chip__fb {
    padding: 0.32rem 0.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.14);
    color: #c5b9dd;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.72rem;
  }

  .state-link-chip__fb:hover {
    background: rgba(5, 212, 229, 0.2);
    color: #fff;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .site-footer__bottom p {
    margin: 0;
    color: #a99bc6;
    font-size: 0.8rem;
  }

  .site-footer__bottom nav {
    display: flex;
    gap: 1.25rem;
  }

  .site-footer__bottom a {
    color: #cfc3e4;
    font-size: 0.8rem;
    text-decoration: none;
  }

  .site-footer__bottom a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--horizon-accent);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 960px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .site-footer__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .site-footer__inner {
      width: calc(100% - 2rem);
      padding-top: 2.5rem;
    }

    .site-footer__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }

    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
