---
import { NotificationCenter, type InAppNotificationItem, type PushSubscriptionSummary } from './NotificationCenter';
import { resolveUnifiedPreferences } from '../../lib/notifications.ts';

interface Props {
  preference: Record<string, any> | null;
  saved?: boolean;
  existingMember?: boolean;
  inAppNotifications?: InAppNotificationItem[];
  pushSubscriptions?: PushSubscriptionSummary[];
  pushConfigured?: boolean;
  vapidPublicKey?: string | null;
}

const {
  preference,
  saved = false,
  existingMember = false,
  inAppNotifications = [],
  pushSubscriptions = [],
  pushConfigured = false,
  vapidPublicKey = null,
} = Astro.props;

const initialPreferences = resolveUnifiedPreferences(preference, existingMember);
---

<section class="grid gap-4" aria-labelledby="notifications-center-heading">
  <div class="sr-only">
    <h2 id="notifications-center-heading">Notifications &amp; Delivery Preferences</h2>
  </div>
  {saved && (
    <p role="status" class="text-sm font-medium text-foreground m-0">
      Preferences saved.
    </p>
  )}
  <NotificationCenter
    client:load
    initialPreferences={initialPreferences}
    initialNotifications={inAppNotifications}
    initialSubscriptions={pushSubscriptions}
    pushConfigured={pushConfigured}
    vapidPublicKey={vapidPublicKey}
  />
</section>
