---
import { ballotDeadlineLabel } from '../../lib/ballot-deadline.ts';
import { ArrowRight, CheckCircle2, Vote } from 'lucide-react';
import Card from '../admin/Card.astro';
import { Badge } from '../ui/badge';
import { Button } from '../ui/button';

interface OutstandingItem {
  proposalId: string;
  slug: string;
  title: string;
  space: string;
  branchName?: string;
  ballotClosesAt?: Date;
}

interface Props {
  items: OutstandingItem[];
  canParticipate: boolean;
  eligibilityNote: string;
  completedCount?: number;
  totalEligibleCount?: number;
}

const {
  items,
  canParticipate,
  eligibilityNote,
  completedCount = 0,
  totalEligibleCount = items.length + completedCount,
} = Astro.props;
const visible = items.slice(0, 6);
const remaining = items.slice(6);
const progressPct = totalEligibleCount > 0 ? Math.round((completedCount / totalEligibleCount) * 100) : 0;
---

<Card class="member-attention" role="region" aria-labelledby="awaiting-heading">
  <div class="attention-head">
    <div class="attention-head__copy">
      <div class="attention-title-row">
        <Vote className="size-5 text-[var(--horizon-voting-ink)]" aria-hidden="true" /><h2 id="awaiting-heading">Open ballots for you</h2>
        <Badge variant={items.length ? 'warning' : 'success'}>
          {items.length ? `${items.length} remaining` : 'None waiting'}
        </Badge>
      </div>
      <p class="attention-lead">
        {canParticipate
          ? totalEligibleCount > 0
            ? `You have voted in ${completedCount} of ${totalEligibleCount} open ballots you are eligible for. ${eligibilityNote}`
            : eligibilityNote
          : 'You need verified membership and ballot eligibility to vote. You can still read public ballots.'}
      </p>
    </div>
    <div class="attention-head__right">
      {canParticipate && totalEligibleCount > 0 && (
        <div class="attention-progress" aria-label={`${completedCount} of ${totalEligibleCount} ballots voted in`}>
          <div class="attention-progress__bar" aria-hidden="true">
            <span style={`width: ${progressPct}%`}></span>
          </div>
          <span class="attention-progress__label tabular">{completedCount}/{totalEligibleCount} voted in</span>
        </div>
      )}
      {items.length > 0 && (
        <Button href="/proposals/?stage=decide" variant="ghost" size="sm">
          All ballots
        </Button>
      )}
    </div>
  </div>

  {!canParticipate ? (
    <div class="attention-empty">
      <p>Check your membership status in My Engage. If verification is pending, you can save a choice on an open ballot. It can count after verification only if you are eligible and the ballot is still open on matching wording.</p>
      <Button href="/proposals/?stage=decide" variant="outline" size="sm">Browse open ballots</Button>
    </div>
  ) : items.length === 0 ? (
    <div class="attention-empty attention-empty--clear">
      <CheckCircle2 aria-hidden="true" className="size-4" />
      <div>
        <p>You are caught up on all eligible ballots.</p>
        <span>New decisions appear here when you are eligible and have not yet voted.</span>
        <div class="attention-empty__actions">
          <Button href="/proposals/?stage=deliberate" variant="outline" size="sm">Join open discussions</Button>
          <Button href="/sense-box/" variant="ghost" size="sm">Share a local priority</Button>
        </div>
      </div>
    </div>
  ) : (
    <>
      <ol class="attention-list">
        {visible.map((item) => (
          <li class="attention-item">
            <div class="attention-item__body">
              <div class="attention-item__meta">
                <span class="tabular attention-id">{item.proposalId}</span>
                <Badge variant="outline">{item.space}</Badge>
                {item.branchName && <Badge variant="outline">{item.branchName}</Badge>}
              </div>
              <a class="attention-title" href={`/proposals/${item.slug}/`}>{item.title}</a>
              {item.ballotClosesAt && <p><time datetime={new Date(item.ballotClosesAt).toISOString()} data-ballot-deadline data-prefix="Closes">Closes {ballotDeadlineLabel(item.ballotClosesAt)}</time></p>}
            </div>
            <Button href={`/proposals/${item.slug}/#proposal-vote`} size="sm" variant="outline">
              Read ballot
              <ArrowRight aria-hidden="true" />
            </Button>
          </li>
        ))}
      </ol>

      {remaining.length > 0 && (
        <details class="attention-more">
          <summary>Show {remaining.length} more open ballot{remaining.length === 1 ? '' : 's'}</summary>
          <ol class="attention-list attention-list--compact">
            {remaining.map((item) => (
              <li class="attention-item">
                <div class="attention-item__body">
                  <div class="attention-item__meta">
                    <span class="tabular attention-id">{item.proposalId}</span>
                    <Badge variant="outline">{item.space}</Badge>
                    {item.branchName && <Badge variant="outline">{item.branchName}</Badge>}
                  </div>
                  <a class="attention-title" href={`/proposals/${item.slug}/`}>{item.title}</a>
              {item.ballotClosesAt && <p><time datetime={new Date(item.ballotClosesAt).toISOString()} data-ballot-deadline data-prefix="Closes">Closes {ballotDeadlineLabel(item.ballotClosesAt)}</time></p>}
                </div>
                <Button href={`/proposals/${item.slug}/#proposal-vote`} size="sm" variant="ghost">Vote →</Button>
              </li>
            ))}
          </ol>
        </details>
      )}
    </>
  )}
</Card>

<style>
  .member-attention {
    gap: 0;
    border-radius: 1.1rem;
    overflow: hidden;
  }

  .attention-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.4rem 1.5rem;
    border-bottom: 1px solid var(--horizon-line);
    background: var(--horizon-blue-soft);
  }

  .attention-head__copy {
    max-width: 58ch;
  }

  .attention-head__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .attention-progress {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .attention-progress__bar {
    width: 5.5rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--horizon-line);
    overflow: hidden;
  }

  .attention-progress__bar > span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--horizon-purple);
  }

  .attention-progress__label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--horizon-purple-deep);
  }

  .attention-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .attention-head h2 {
    margin: 0;
    color: var(--horizon-ink);
    font-family: var(--font-outfit);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .attention-lead {
    margin: 0.25rem 0 0;
    color: var(--horizon-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .attention-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .attention-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 1.3rem 1.5rem;
    border-bottom: 1px solid var(--horizon-line);
  }

  .attention-item:last-child {
    border-bottom: 0;
  }

  .attention-item:hover {
    background: var(--horizon-lavender-soft);
  }

  .attention-list--compact .attention-item {
    padding-block: 0.6rem;
  }

  .attention-item__body {
    display: grid;
    min-width: 0;
    gap: 0.5rem;
  }

  .attention-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
  }

  .attention-id {
    font-weight: 700;
    color: var(--horizon-muted);
  }

  .attention-title {
    color: var(--horizon-ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }

  .attention-title:hover {
    color: var(--horizon-purple);
    text-decoration: underline;
  }

  .attention-empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.5rem;
    color: var(--horizon-muted);
    font-size: 0.94rem;
  }

  .attention-empty p {
    margin: 0;
    color: var(--horizon-ink);
    font-weight: 600;
  }

  .attention-empty--clear {
    justify-content: flex-start;
  }

  .attention-empty--clear > svg {
    color: var(--horizon-success-ink);
  }

  .attention-empty--clear span {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.82rem;
  }

  .attention-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.15rem;
    margin-top: 0.55rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .attention-empty__actions a {
    color: var(--horizon-purple);
    text-decoration: none;
  }

  .attention-empty__actions a:hover {
    text-decoration: underline;
  }

  .attention-more {
    border-top: 1px solid var(--horizon-line);
  }

  .attention-more > summary {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.8rem 1.5rem;
    background: var(--horizon-surface);
    color: var(--horizon-ink);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    list-style: none;
  }

  .attention-more > summary::-webkit-details-marker {
    display: none;
  }

  .attention-more > summary::after {
    content: '+';
    margin-left: auto;
    color: var(--horizon-purple);
    font-size: 1rem;
  }

  .attention-more[open] > summary::after {
    content: '−';
  }

  .attention-more > summary:focus-visible {
    outline: 3px solid var(--horizon-focus);
    outline-offset: -2px;
  }

  @media (max-width: 700px) {
    .attention-head,
    .attention-item,
    .attention-more > summary {
      padding-inline: 1rem;
    }
  }
</style>

