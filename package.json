{
  "name": "fusion-engage",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "changelog": "node scripts/generate-changelog.mjs",
    "dev": "node scripts/generate-changelog.mjs && astro dev",
    "build": "node scripts/generate-changelog.mjs && astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "ballots:schedule": "node --experimental-strip-types scripts/schedule-open-ballots.ts",
    "ballots:migrate": "node --experimental-strip-types scripts/ballot-migration.ts",
    "branches:migrate": "node --experimental-strip-types scripts/seed-branches.ts",
    "branches:participation-migrate": "node --experimental-strip-types scripts/migrate-branch-participation.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "^7.1.4",
    "@better-auth/mongo-adapter": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@plausible-analytics/tracker": "0.4.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "astro": "7.4.2",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "mongodb": "6.21.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.3.4",
    "typescript": "6.0.3"
  }
}
