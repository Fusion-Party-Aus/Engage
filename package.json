  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@better-auth/mongo-adapter": "1.7.12",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "astro": "7.4.2",
    "better-auth": "1.7.12",
    "mongodb": "6.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
