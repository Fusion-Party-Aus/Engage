[Unit]
Description=Trigger Coolify deploy when the Engage Git branch changes
Documentation=file:/opt/engage-coolify/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/engage-coolify-poll
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/engage-coolify-poll
