APP_MODE=preview
FORMAL_BALLOTS_ENABLED=false
MONGODB_DB_NAME=fusion_horizon_policy_preview
MONGO_INITDB_ROOT_USERNAME=fusion_root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-64-character-hex-secret
MONGO_APP_USER=fusion_app
MONGO_APP_PASSWORD=replace-with-a-different-64-character-hex-secret
MONGODB_URI=mongodb://fusion_app:replace-with-a-different-64-character-hex-secret@127.0.0.1:27017/fusion_horizon_policy_preview?authSource=fusion_horizon_policy_preview
SESSION_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters
MONGO_PORT=27017
MONGO_BIND_ADDRESS=127.0.0.1
APP_PORT=4321
APP_BIND_ADDRESS=127.0.0.1
APP_IMAGE_TAG=local
