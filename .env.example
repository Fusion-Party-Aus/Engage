APP_MODE=development
MONGODB_DB_NAME=engage
MONGO_INITDB_ROOT_USERNAME=fusion_root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-64-character-hex-secret
MONGO_APP_USER=fusion_app
MONGO_APP_PASSWORD=replace-with-a-different-64-character-hex-secret
MONGODB_URI="mongodb://fusion_app:replace-with-a-different-64-character-hex-secret@127.0.0.1:27017/engage?authSource=engage&replicaSet=engage&directConnection=true"
SESSION_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters
MONGO_PORT=27017
MONGO_BIND_ADDRESS=127.0.0.1
APP_PORT=4321
APP_BIND_ADDRESS=127.0.0.1
APP_IMAGE_TAG=local
BETTER_AUTH_URL=http://localhost:4321
# Trusted public origin for canonical metadata and public API Link headers.
# Production: https://engage.fusionparty.org.au
PUBLIC_ORIGIN=http://localhost:4321
BETTER_AUTH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional platform-wide UI & SEO configuration (also editable in /admin/settings/)
ENGAGE_ALLOW_INDEXING=false
ENGAGE_DEFAULT_OG_IMAGE=/engage-og-card.png
ENGAGE_PUBLIC_PULSE_POLL=false
ENGAGE_PRIMARY_CTA_LABEL="Suggest an idea"
ENGAGE_PRIMARY_CTA_HREF=/proposals/new/
ENGAGE_REPO_URL=https://github.com/Fusion-Party-Aus/Engage

# Opt-in MongoDB driver command counters for scripts/rendering-performance.mjs.
# Only read from the development-only /api/dev/render-metrics route; ignored in production.
ENGAGE_DB_COMMAND_MONITOR=0


# Ballot reminder defaults are explained in My Engage; enable only after cron/webhook setup.
ENGAGE_DIGEST_ENABLED=false
ENGAGE_CRON_SECRET=
ENGAGE_EMAIL_SECRET=
RESEND_WEBHOOK_SECRET=

# Cloudflare Turnstile on abuse-prone unauthenticated actions.
# Mandatory in production: if either key is missing, protected routes fail closed
# with 503 unless TURNSTILE_ENFORCEMENT=off. Leave both empty locally.
# TURNSTILE_ENFORCEMENT may be "on" (force) or "off" (incident control).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCEMENT=
# Optional expected hostname reported by siteverify, e.g. engage.fusionparty.org.au
TURNSTILE_EXPECTED_HOSTNAME=
# Optional dedicated key for hashing rate-limit subjects (falls back to BETTER_AUTH_SECRET).
RATE_LIMIT_SECRET=

# Optional automatic membership verification from Underground CRM.
# Leave disabled until the CRM API is reachable, the token is verified, and a
# dry run of `pnpm membership:verify` has been reviewed. The CRM token only
# needs the people:read scope. The membership type IDs identify Fusion membership;
# the electorate map is Engage-owned and maps CRM electorate values to Engage
# state or territory branch IDs.
ENGAGE_CRM_VERIFICATION_ENABLED=false
ENGAGE_CRM_BASE_URL=https://crm.example.org
ENGAGE_CRM_TOKEN=replace-with-the-crm-people-read-token
ENGAGE_CRM_FUSION_MEMBERSHIP_TYPE_IDS=[]
ENGAGE_CRM_ELECTORATE_BRANCH_MAP={}
ENGAGE_CRM_VERIFICATION_CRON_SECRET=
ENGAGE_CRM_VERIFICATION_BATCH_SIZE=25
ENGAGE_CRM_RECONCILE_INTERVAL_MINUTES=1440
ENGAGE_CRM_OUTAGE_ALERT_AFTER_ATTEMPTS=3
ENGAGE_CRM_TIMEOUT_MS=10000

# Optional self-hosted VAPID Web Push configuration
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:engage@fusionparty.org.au

# Optional application-level ballot encryption (keep off until key recovery and dry-run migration are verified)
BALLOT_ENCRYPTION_MODE=off
BALLOT_ENCRYPTION_KEYS=
BALLOT_ENCRYPTION_ACTIVE_KEY_ID=
BALLOT_BLIND_INDEX_KEY=
BALLOT_BLIND_INDEX_ACTIVE_KEY_ID=
